# Copier vers .env (ne jamais committer .env)
# cp .env.example .env

# Port public distant de l'API sur l'hôte (VPS / Docker Cloud)
API_HOST_PORT=1804

# Chaîne SQL vers la base cloud (obligatoire)
# Exemple VPS existant :
# SQL_CONNECTION_STRING=Server=161.97.105.22,1433;Database=SchoolManagementRDC;User Id=sa;Password=VOTRE_MDP;TrustServerCertificate=True;Encrypt=True
#
# Exemple avec le service sql du profil "full" :
# SQL_CONNECTION_STRING=Server=sql,1433;Database=SchoolManagementRDC;User Id=sa;Password=Your_strong_Password123;TrustServerCertificate=True;Encrypt=False
SQL_CONNECTION_STRING=Server=161.97.105.22,1433;Database=SchoolManagementRDC;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True;Encrypt=True

# JWT (min. 32 caractères)
JWT_SECRET_KEY=CHANGE_ME_USE_A_LONG_RANDOM_SECRET_KEY_32PLUS
JWT_ISSUER=SchoolManagementRDC
JWT_AUDIENCE=SchoolManagementClients

# Clé AES pour éventuels fichiers de config sous Linux (optionnel si SQL_CONNECTION_STRING est utilisé)
ERP_CONFIG_ENCRYPTION_KEY=CHANGE_ME_DOCKER_AES_KEY

# CORS (origine autorisée)
CORS_ORIGIN=*

# Uniquement si docker compose --profile full
MSSQL_SA_PASSWORD=Your_strong_Password123
SQL_HOST_PORT=1433
