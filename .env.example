# Copier vers .env (ne jamais committer .env)
# cp .env.example .env

# Port public distant de l'API Cloud (pas le port SQL)
API_HOST_PORT=1804

# Chaîne SQL vers la base cloud (obligatoire) — SQL officiel VPS : 169.58.93.203
# Le port SQL reste en général 1433 (indépendant du 1804 de l'API) :
# SQL_CONNECTION_STRING=Server=169.58.93.203,1433;Database=SchoolManagementRDC;User Id=sa;Password=VOTRE_MDP;TrustServerCertificate=True;Encrypt=True
#
# Exemple avec le service sql du profil "full" :
# SQL_CONNECTION_STRING=Server=sql,1433;Database=SchoolManagementRDC;User Id=sa;Password=Your_strong_Password123;TrustServerCertificate=True;Encrypt=False
SQL_CONNECTION_STRING=Server=169.58.93.203,1433;Database=SchoolManagementRDC;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True;Encrypt=True

# Bootstrap (profil bootstrap / Coolify) — DB distincte SchoolManagementBootstrap sur le même SQL officiel.
# Mot de passe : à configurer (Coolify Runtime env) — ne pas inventer de secret ici.
# BOOTSTRAP_CONNECTION_STRING=Server=169.58.93.203,1433;Database=SchoolManagementBootstrap;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True;Encrypt=True

# JWT (min. 32 caractères)
JWT_SECRET_KEY=CHANGE_ME_USE_A_LONG_RANDOM_SECRET_KEY_32PLUS
JWT_ISSUER=SchoolManagementRDC
JWT_AUDIENCE=SchoolManagementClients

# Clé AES — obligatoire en Docker/Cloud Production (ServerIdentity + config Linux).
# En développement local (ASPNETCORE_ENVIRONMENT=Development), une clé de secours peut être utilisée si absente.
# Ne jamais committer une vraie clé ; ne pas réutiliser CHANGE_ME en production.
ERP_CONFIG_ENCRYPTION_KEY=CHANGE_ME_DOCKER_AES_KEY

# Mobile parent (build production connexion — voir docs/architecture/inventaire-feature-flags-v2.md)
# BOOTSTRAP_API_BASE_URL=https://bootstrap.example
# JWT_BINDING_MIGRATION_END_UTC=2026-12-31T23:59:59Z
# STRICT_SCHOOL_DISCOVERY=true

# CORS (origine autorisée)
CORS_ORIGIN=*

# Uniquement si docker compose --profile full
MSSQL_SA_PASSWORD=Your_strong_Password123
SQL_HOST_PORT=1433
