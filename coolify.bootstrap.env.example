# Coolify — Environment Variables (RUNTIME) pour SchoolManagement.Bootstrap.API
# Dockerfile Location = Dockerfile.bootstrap
# Ports Exposes = 1805 (interne conteneur ; HTTPS public via proxy Coolify :443)
#
# TEMPORAIRE (sans domaine payant) — sslip.io vérifié DNS :
#   Domaine Coolify = bootstrap.169.58.93.203.sslip.io
#   URL publique   = https://bootstrap.169.58.93.203.sslip.io
# Cible future     = https://bootstrap.erp-scolaire.com

PORT=1805
ASPNETCORE_URLS=http://0.0.0.0:1805
ASPNETCORE_ENVIRONMENT=Production

# MÊME secret que Activation__BootstrapRelayKey sur l'API Cloud (et API école locale).
# Ne jamais committer la valeur réelle.
Bootstrap__RelayApiKey=CHANGE_ME_PROD_RELAY_KEY_MIN_32_CHARS

# Registre école #0 — SchoolId = GUID école du JWT Desktop qui émet le QR.
# ActivationBaseUrl / CloudBaseUrl : joignables DEPUIS le conteneur Bootstrap → API Cloud.
Bootstrap__Schools__0__SchoolId=00000000-0000-0000-0000-000000000000
Bootstrap__Schools__0__ActivationBaseUrl=http://169.58.93.203:1804
Bootstrap__Schools__0__CloudBaseUrl=http://169.58.93.203:1804
# Optionnel (ops / futur pinning) :
# Bootstrap__Schools__0__PublicKeyFingerprint=sha256:...
# Bootstrap__Schools__0__KeyVersion=1
# Bootstrap__Schools__0__ServerInstanceId=...
