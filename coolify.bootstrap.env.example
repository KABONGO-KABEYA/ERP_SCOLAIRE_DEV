# Coolify — Environment Variables (RUNTIME) pour SchoolManagement.Bootstrap.API
# Dockerfile Location = Dockerfile.bootstrap
# Ports Exposes = 1805 (interne conteneur ; HTTPS public via proxy Coolify :443)
#
# Domaine labo actuel (NE PAS changer) :
#   https://gopvetrs5vjo1v6z0fdh57ty.169.58.93.203.sslip.io
# Cible future :
#   https://bootstrap.erp-scolaire.com

PORT=1805
ASPNETCORE_URLS=http://0.0.0.0:1805
ASPNETCORE_ENVIRONMENT=Production

# MÊME secret que Activation__BootstrapRelayKey sur l'API Cloud (et API école locale).
Bootstrap__RelayApiKey=CHANGE_ME_PROD_RELAY_KEY_MIN_32_CHARS

# SQL dédiée registre Bootstrap — même SQL officiel VPS (169.58.93.203),
# DB distincte SchoolManagementBootstrap (≠ SchoolManagementRDC_Production).
# Mot de passe SA : configurer dans Coolify Runtime (ne pas inventer ici).
Bootstrap__ConnectionString=Server=169.58.93.203,1433;Database=SchoolManagementBootstrap;User Id=sa;Password=TON_MDP_SA;TrustServerCertificate=True;Encrypt=True

# Phase 8 cutover FINAL : SQL fait foi. Legacy env retiré.
Bootstrap__AllowLegacyEnvSchoolRegistry=false

# RETIRÉ après validation establishment (ne plus définir) :
# Bootstrap__Schools__0__SchoolId
# Bootstrap__Schools__0__ActivationBaseUrl
# Bootstrap__Schools__0__CloudBaseUrl
#
# ECOLE TEST vit uniquement dans :
#   BootstrapSchoolRegistry + BootstrapSchoolEstablishmentCredentials
# Seed : tools/bootstrap/seed-ecole-test.ps1 ou upsert école Desktop/Setup.
