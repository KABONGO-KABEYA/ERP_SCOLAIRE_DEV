# Variables Coolify (Runtime Environment) — coller telles quelles, puis Redeploy.
# Ne pas mettre ça seulement dans "Build Variables" : il faut des Runtime/Environment Variables.

PORT=1804
ASPNETCORE_URLS=http://0.0.0.0:1804
ASPNETCORE_ENVIRONMENT=Production
Deployment__Role=Cloud
Deployment__ReadOnly=true
FILE_STORAGE_ROOT=/app/data/files

# OBLIGATOIRE — sinon healthcheck unhealthy
SQL_CONNECTION_STRING=Server=161.97.105.22,1433;Database=SchoolManagementRDC;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True;Encrypt=True

# OBLIGATOIRE — min. 32 caractères (Jwt__SecretKey ou JWT_SECRET_KEY)
Jwt__SecretKey=CHANGE_ME_USE_A_LONG_RANDOM_SECRET_KEY_32PLUS
Jwt__Issuer=SchoolManagementRDC
Jwt__Audience=SchoolManagementClients

# Optionnel
Cors__AllowedOrigins__0=*
ERP_CONFIG_ENCRYPTION_KEY=CHANGE_ME_DOCKER_AES_KEY
