# Coolify — Environment Variables (RUNTIME ONLY) pour l'application API
# Service SQL Coolify = conteneur "sqlserver" (port interne 1433)
# Remplace TON_MDP_SA par la valeur exacte de MSSQL_SA_PASSWORD du service SQL.

PORT=1804
ASPNETCORE_URLS=http://0.0.0.0:1804
ASPNETCORE_ENVIRONMENT=Production
Deployment__Role=Cloud
Deployment__ReadOnly=true
FILE_STORAGE_ROOT=/app/data/files

SQL_CONNECTION_STRING=Server=sqlserver,1433;Database=SchoolManagementRDC;User Id=sa;Password=TON_MDP_SA;TrustServerCertificate=True;Encrypt=True

Jwt__SecretKey=ErpScolaireCloudJwtSecretKey_2026_ChangeMe_Min32Chars
Jwt__Issuer=SchoolManagementRDC
Jwt__Audience=SchoolManagementClients

Cors__AllowedOrigins__0=*
ERP_CONFIG_ENCRYPTION_KEY=ErpScolaireDockerAesKey_ChangeMe_32Chars

# Premier démarrage (base vide) : crée admin / Admin@2026 etc. Puis passer à false.
SEED_DATABASE=true
