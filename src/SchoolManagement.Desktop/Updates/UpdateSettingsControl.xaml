<UserControl x:Class="SchoolManagement.Desktop.Updates.UpdateSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
        <StackPanel MaxWidth="820">
            <TextBlock Text="Mises à jour" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock Text="Vérification automatique, préférences et publication des versions."
                       Foreground="#667085" Margin="0,0,0,16"/>

            <Border Background="White" CornerRadius="8" Padding="16" BorderBrush="#E4E7EC" BorderThickness="1" Margin="0,0,0,12">
                <StackPanel>
                    <CheckBox x:Name="AutoCheckBox" Content="Vérifier automatiquement les mises à jour" Margin="0,0,0,8"/>
                    <CheckBox x:Name="AutoDownloadBox" Content="Télécharger automatiquement les mises à jour facultatives" Margin="0,0,0,8"/>
                    <CheckBox x:Name="AutoInstallBox" Content="Installer automatiquement au prochain redémarrage"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Padding="16" BorderBrush="#E4E7EC" BorderThickness="1" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Version actuelle" Foreground="#667085"/>
                        <TextBlock x:Name="CurrentVersionText" FontWeight="SemiBold" FontSize="16"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Dernière vérification" Foreground="#667085"/>
                        <TextBlock x:Name="LastCheckText" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Dernière mise à jour" Foreground="#667085"/>
                        <TextBlock x:Name="LastUpdateText" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button Content="Enregistrer" Padding="16,8" Margin="0,0,8,0" Click="Save_OnClick"
                        Background="#1B4F72" Foreground="White" BorderThickness="0"/>
                <Button Content="Vérifier maintenant" Padding="16,8" Click="CheckNow_OnClick"/>
            </StackPanel>

            <TextBlock Text="Historique local" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <ListBox x:Name="HistoryList" MinHeight="120" MaxHeight="180" BorderBrush="#E4E7EC" Margin="0,0,0,20"/>

            <TextBlock Text="Publier une version (admin)" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock Text="Remplit ApplicationVersions sans SQL manuel. Active=oui désactive les autres versions."
                       Foreground="#667085" TextWrapping="Wrap" Margin="0,0,0,12"/>

            <Border Background="White" CornerRadius="8" Padding="16" BorderBrush="#E4E7EC" BorderThickness="1" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Text="Version *"/>
                        <TextBox x:Name="PubVersionBox" Text="1.0.1"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,8">
                        <TextBlock Text="Version minimale"/>
                        <TextBox x:Name="PubMinVersionBox" Text="1.0.0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,0,8,8">
                        <TextBlock Text="URL Desktop"/>
                        <TextBox x:Name="PubDesktopUrlBox"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,8">
                        <TextBlock Text="URL Mobile (APK)"/>
                        <TextBox x:Name="PubMobileUrlBox"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,0,8,8">
                        <TextBlock Text="SHA256 * (si active)"/>
                        <TextBox x:Name="PubShaBox"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,8">
                        <TextBlock Text="Taille (octets)"/>
                        <TextBox x:Name="PubSizeBox"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,8">
                        <TextBlock Text="Notes (une par ligne)"/>
                        <TextBox x:Name="PubNotesBox" AcceptsReturn="True" Height="72" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,8">
                        <CheckBox x:Name="PubMandatoryBox" Content="Obligatoire" Margin="0,0,16,0"/>
                        <CheckBox x:Name="PubActiveBox" Content="Activer maintenant" IsChecked="True"/>
                    </StackPanel>

                    <StackPanel Grid.Row="5" Orientation="Horizontal">
                        <Button Content="Publier" Padding="16,8" Margin="0,0,8,0" Click="Publish_OnClick"
                                Background="#1B4F72" Foreground="White" BorderThickness="0"/>
                        <Button Content="Rafraîchir la liste" Padding="16,8" Click="RefreshVersions_OnClick"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="Versions publiées" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <DataGrid x:Name="VersionsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" HeadersVisibility="Column" MinHeight="160"
                      BorderBrush="#E4E7EC">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="90"/>
                    <DataGridTextColumn Header="Min" Binding="{Binding MinimumVersion}" Width="70"/>
                    <DataGridCheckBoxColumn Header="Actif" Binding="{Binding Active}" Width="50"/>
                    <DataGridCheckBoxColumn Header="Oblig." Binding="{Binding Mandatory}" Width="55"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding ReleaseDate}" Width="100"/>
                    <DataGridTextColumn Header="SHA256" Binding="{Binding Sha256}" Width="*"/>
                    <DataGridTemplateColumn Header="" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Activer" Padding="8,2" Click="ActivateVersion_OnClick"
                                        Tag="{Binding Id}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
