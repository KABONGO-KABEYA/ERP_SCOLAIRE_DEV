<Window x:Class="SchoolManagement.Desktop.Updates.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mise à jour"
        Width="520" Height="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F7F8FA">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Border Width="44" Height="44" CornerRadius="22" Background="#1B4F72" VerticalAlignment="Center">
                <TextBlock Text="↑" Foreground="White" FontSize="22" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="TitleText" Margin="14,0,0,0" FontSize="20" FontWeight="SemiBold"
                       VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="400"
                       Foreground="#1A1A1A"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Version actuelle" Foreground="#667085" FontSize="12"/>
                <TextBlock x:Name="CurrentVersionText" FontSize="16" FontWeight="SemiBold"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Nouvelle version" Foreground="#667085" FontSize="12"/>
                <TextBlock x:Name="LatestVersionText" FontSize="16" FontWeight="SemiBold" Foreground="#1B4F72"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="12" BorderBrush="#E4E7EC" BorderThickness="1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Nouveautés" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock DockPanel.Dock="Bottom" x:Name="SizeText" Foreground="#667085" Margin="0,8,0,0"/>
                <ListBox x:Name="NotesList" BorderThickness="0" Background="Transparent"/>
            </DockPanel>
        </Border>

        <StackPanel x:Name="ProgressPanel" Grid.Row="3" Margin="0,14,0,0" Visibility="Collapsed">
            <TextBlock x:Name="StatusText" Margin="0,0,0,6"/>
            <ProgressBar x:Name="ProgressBar" Height="10" Minimum="0" Maximum="100"/>
            <Grid Margin="0,6,0,0">
                <TextBlock x:Name="BytesText" HorizontalAlignment="Left" Foreground="#667085" FontSize="12"/>
                <TextBlock x:Name="SpeedText" HorizontalAlignment="Center" Foreground="#667085" FontSize="12"/>
                <TextBlock x:Name="EtaText" HorizontalAlignment="Right" Foreground="#667085" FontSize="12"/>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelDownloadButton" Content="Annuler le téléchargement"
                    Margin="0,0,8,0" Padding="14,8" Click="CancelDownloadButton_OnClick" Visibility="Collapsed"/>
            <Button x:Name="LaterButton" Content="Plus tard" Margin="0,0,8,0" Padding="16,8"
                    Click="LaterButton_OnClick"/>
            <Button x:Name="UpdateButton" Content="Mettre à jour" Padding="18,8"
                    Background="#1B4F72" Foreground="White" BorderThickness="0"
                    Click="UpdateButton_OnClick"/>
        </StackPanel>
    </Grid>
</Window>
