<UserControl x:Class="SchoolManagement.Desktop.Controls.CloudSyncDashboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <Grid Style="{StaticResource ErpFadeIn}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,12"
                Padding="16"
                Style="{StaticResource SchoolFeeStudentsLikePanel}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Margin="0,0,8,0"
                            Command="{Binding LoadCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            ToolTip="Actualiser">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Margin="0,0,6,0" Kind="Refresh" VerticalAlignment="Center" />
                            <TextBlock Text="Actualiser" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SynchronizeNowCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            ToolTip="Pousser immédiatement la file locale vers le cloud">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Margin="0,0,6,0" Kind="CloudUpload" VerticalAlignment="Center" />
                            <TextBlock Text="Synchroniser maintenant" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel>
                    <TextBlock Style="{StaticResource SchoolFeeSectionTitle}" Text="Synchronisation cloud" />
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource ErpBody}"
                               Text="{Binding ConnectionLabel}" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{StaticResource ErpPrimaryBrush}"
                               Text="{Binding StatusMessage}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <UniformGrid Columns="3" Margin="0,0,0,12">
                    <Border Margin="0,0,8,8" Padding="14" Style="{StaticResource SchoolFeeStudentsLikePanel}">
                        <StackPanel>
                            <TextBlock Opacity="0.7" Text="En attente" />
                            <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding PendingUnits}" />
                            <TextBlock Opacity="0.7" Text="{Binding PendingCriticalUnits, StringFormat=Critiques : {0}}" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,0,8,8" Padding="14" Style="{StaticResource SchoolFeeStudentsLikePanel}">
                        <StackPanel>
                            <TextBlock Opacity="0.7" Text="Échecs / dead-letter" />
                            <TextBlock FontSize="22" FontWeight="SemiBold"
                                       Text="{Binding FailedUnits, StringFormat={}{0}}" />
                            <TextBlock Opacity="0.7" Text="{Binding DeadLetterUnits, StringFormat=Dead-letter : {0}}" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,0,0,8" Padding="14" Style="{StaticResource SchoolFeeStudentsLikePanel}">
                        <StackPanel>
                            <TextBlock Opacity="0.7" Text="Durée moyenne" />
                            <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding AverageDurationText}" />
                            <TextBlock Opacity="0.7" Text="30 dernières exécutions" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Margin="0,0,0,12" Padding="14" Style="{StaticResource SchoolFeeStudentsLikePanel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Opacity="0.7" Text="Dernière sync réussie" />
                            <TextBlock FontWeight="SemiBold" Text="{Binding LastSuccessText}" />
                            <TextBlock Margin="0,8,0,0" Opacity="0.7" Text="Dernière tentative" />
                            <TextBlock FontWeight="SemiBold" Text="{Binding LastAttemptText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Opacity="0.7" Text="Serveur cloud" />
                            <TextBlock FontWeight="SemiBold" Text="{Binding CloudServer}" />
                            <TextBlock Margin="0,8,0,0" Opacity="0.7" Text="Dernier message" />
                            <TextBlock Text="{Binding LastMessage}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Padding="14" Style="{StaticResource SchoolFeeStudentsLikePanel}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Margin="0,0,0,8"
                                   Style="{StaticResource SchoolFeeSectionTitle}"
                                   Text="Journal récent" />
                        <DataGrid AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  IsReadOnly="True"
                                  ItemsSource="{Binding RecentJournal}"
                                  MaxHeight="360">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="140"
                                                    Binding="{Binding StartedAt, StringFormat=dd/MM HH:mm:ss}"
                                                    Header="Date" />
                                <DataGridTextColumn Width="70"
                                                    Binding="{Binding DurationMs}"
                                                    Header="ms" />
                                <DataGridCheckBoxColumn Width="50"
                                                        Binding="{Binding Success}"
                                                        Header="OK" />
                                <DataGridTextColumn Width="60"
                                                    Binding="{Binding UnitsSucceeded}"
                                                    Header="Unités OK" />
                                <DataGridTextColumn Width="60"
                                                    Binding="{Binding UnitsFailed}"
                                                    Header="Échecs" />
                                <DataGridTextColumn Width="*"
                                                    Binding="{Binding ErrorSummary}"
                                                    Header="Erreur" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
