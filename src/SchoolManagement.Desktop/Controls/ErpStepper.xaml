<UserControl x:Class="SchoolManagement.Desktop.Controls.ErpStepper"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:SchoolManagement.Desktop.ViewModels"
             x:Name="Root">
    <UserControl.Resources>
        <Style x:Key="ErpStepLayout" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Vertical" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompact, ElementName=Root}" Value="True">
                    <Setter Property="Orientation" Value="Horizontal" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ErpStepCircleStyle" BasedOn="{StaticResource ErpV2StepCircle}" TargetType="Border">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompact, ElementName=Root}" Value="True">
                    <Setter Property="Width" Value="22" />
                    <Setter Property="Height" Value="22" />
                    <Setter Property="CornerRadius" Value="11" />
                    <Setter Property="Margin" Value="0,0,6,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ErpStepNumberStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompact, ElementName=Root}" Value="True">
                    <Setter Property="FontSize" Value="10" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ErpStepTitleStyle" BasedOn="{StaticResource ErpV2StepTitle}" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompact, ElementName=Root}" Value="True">
                    <Setter Property="FontSize" Value="10" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="TextAlignment" Value="Left" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ErpStepSubtitleStyle" BasedOn="{StaticResource ErpV2StepSubtitle}" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompact, ElementName=Root}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Subtitle, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" Value="Collapsed">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ItemsControl ItemsSource="{Binding Steps, ElementName=Root}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <UniformGrid Columns="{Binding Columns, ElementName=Root}" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:EnrollmentWizardStepItem}">
                <StackPanel Margin="2,0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center">
                    <StackPanel Style="{StaticResource ErpStepLayout}">
                        <Border HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Style="{StaticResource ErpStepCircleStyle}">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <Grid>
                                <TextBlock Style="{StaticResource ErpStepNumberStyle}"
                                           Foreground="{Binding State, Converter={StaticResource WizardStepStateToForegroundConverter}}"
                                           Text="{Binding Number}"
                                           Visibility="{Binding State, Converter={StaticResource WizardStepStateToVisibilityConverter}, ConverterParameter=number}" />
                                <materialDesign:PackIcon Width="12"
                                                         Height="12"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Foreground="White"
                                                         Kind="Check"
                                                         Visibility="{Binding State, Converter={StaticResource WizardStepStateToVisibilityConverter}, ConverterParameter=check}" />
                            </Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center"
                                       Style="{StaticResource ErpStepTitleStyle}"
                                       Text="{Binding Title}" />
                            <TextBlock HorizontalAlignment="Center"
                                       Style="{StaticResource ErpStepSubtitleStyle}"
                                       Text="{Binding Subtitle}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
