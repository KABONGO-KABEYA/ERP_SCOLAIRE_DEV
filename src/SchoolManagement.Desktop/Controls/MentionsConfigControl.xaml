<UserControl x:Class="SchoolManagement.Desktop.Controls.MentionsConfigControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
            <TextBlock Style="{StaticResource ErpSubtitle}" Text="Mentions selon le pourcentage" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Margin="0,0,8,0" Content="Actualiser" Command="{Binding LoadCommand}"
                        Style="{StaticResource ErpSecondaryButton}" />
                <Button Content="Nouvelle mention" Command="{Binding NewMentionCommand}"
                        Style="{StaticResource ErpPrimaryButton}" />
            </StackPanel>
        </DockPanel>

        <DataGrid Grid.Row="1"
                  Style="{StaticResource ErpDataGrid}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  ItemsSource="{Binding Mentions}"
                  SelectedItem="{Binding SelectedMention}"
                  MinHeight="220"
                  MaxHeight="360">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ordre" Binding="{Binding SortOrder}" Width="60" />
                <DataGridTextColumn Header="Libellé" Binding="{Binding Label}" Width="*" />
                <DataGridTextColumn Header="Plage %" Binding="{Binding RangeDisplay}" Width="160" />
                <DataGridTextColumn Header="Min" Binding="{Binding MinPercentageInclusive}" Width="70" />
                <DataGridTextColumn Header="Max" Binding="{Binding MaxPercentageInclusive}" Width="70" />
                <DataGridCheckBoxColumn Header="Actif" Binding="{Binding IsActive}" Width="60" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Margin="0,16,0,0" Padding="14"
                Background="#F9FAFB" BorderBrush="{StaticResource ErpBorderBrush}"
                BorderThickness="1" CornerRadius="10">
            <StackPanel>
                <TextBlock Style="{StaticResource ErpBody}" Text="{Binding FormTitle}" FontWeight="SemiBold" />
                <TextBlock Margin="0,4,0,8" Foreground="{StaticResource ErpTextSecondaryBrush}" TextWrapping="Wrap"
                           Text="Exemple : Satisfaction de 55 % à 69 %, Distinction de 70 % à 79 %, etc. Les plages actives ne doivent pas se chevaucher." />
                <WrapPanel>
                    <TextBox Width="200" Margin="4"
                             materialDesign:HintAssist.Hint="Libellé"
                             Style="{StaticResource ErpTextBox}"
                             Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Width="100" Margin="4"
                             materialDesign:HintAssist.Hint="% minimum"
                             Style="{StaticResource ErpTextBox}"
                             Text="{Binding MinPercentageText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Width="100" Margin="4"
                             materialDesign:HintAssist.Hint="% maximum"
                             Style="{StaticResource ErpTextBox}"
                             Text="{Binding MaxPercentageText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Width="80" Margin="4"
                             materialDesign:HintAssist.Hint="Ordre"
                             Style="{StaticResource ErpTextBox}"
                             Text="{Binding SortOrderText, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Margin="8,12,8,4" Content="Actif" IsChecked="{Binding IsActive}" />
                    <Button Margin="4" Content="Enregistrer" Command="{Binding SaveCommand}"
                            Style="{StaticResource ErpPrimaryButton}" />
                    <Button Margin="4" Content="Supprimer" Command="{Binding DeleteCommand}"
                            Style="{StaticResource ErpSecondaryButton}" />
                </WrapPanel>
                <TextBlock Margin="4,8,0,0" Text="{Binding StatusMessage}" TextWrapping="Wrap"
                           Foreground="{StaticResource ErpTextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <Grid Grid.RowSpan="3" Background="#80FFFFFF"
              Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ProgressBar Width="160" Height="4" IsIndeterminate="True" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
