<UserControl x:Class="SchoolManagement.Desktop.Controls.Encaissements.PaymentSummaryCards"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             SizeChanged="OnSizeChanged">
    <UniformGrid x:Name="CardsPanel" Columns="2">
        <Border Margin="0,0,8,8"
                Padding="20"
                Background="#FFFFFF"
                BorderBrush="#BBF7D0"
                BorderThickness="1"
                CornerRadius="16"
                Effect="{StaticResource ErpCardShadow}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <materialDesign:PackIcon Width="22"
                                             Height="22"
                                             Margin="0,0,8,0"
                                             Foreground="#16A34A"
                                             Kind="CashCheck" />
                    <TextBlock VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="#64748B"
                               Text="Total des versements" />
                </StackPanel>
                <TextBlock FontSize="26"
                           FontWeight="Bold"
                           Foreground="#16A34A"
                           Text="{Binding TotalTodayDisplay}" />
            </StackPanel>
        </Border>

        <Border Margin="8,0,0,8"
                Padding="20"
                Background="#FFFFFF"
                BorderBrush="#FDE68A"
                BorderThickness="1"
                CornerRadius="16"
                Effect="{StaticResource ErpCardShadow}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <materialDesign:PackIcon Width="22"
                                             Height="22"
                                             Margin="0,0,8,0"
                                             Foreground="#D97706"
                                             Kind="CashMinus" />
                    <TextBlock VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="#64748B"
                               Text="Reste après paiement" />
                </StackPanel>
                <TextBlock FontSize="26"
                           FontWeight="Bold"
                           Foreground="#D97706"
                           Text="{Binding RemainingAfterDisplay}" />
            </StackPanel>
        </Border>
    </UniformGrid>
</UserControl>
