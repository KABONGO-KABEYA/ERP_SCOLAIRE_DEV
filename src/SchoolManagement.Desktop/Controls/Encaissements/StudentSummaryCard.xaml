<UserControl x:Class="SchoolManagement.Desktop.Controls.Encaissements.StudentSummaryCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Border Style="{StaticResource ErpCard}" Padding="16,14">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Grid Width="52" Height="52" Margin="0,0,14,0">
                <Ellipse Fill="#EEF2FF" />
                <Ellipse>
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="{Binding PhotoSource}" Stretch="UniformToFill" />
                    </Ellipse.Fill>
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPhoto}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <materialDesign:PackIcon Width="30"
                                         Height="30"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Foreground="#94A3B8"
                                         Kind="AccountCircle">
                    <materialDesign:PackIcon.Style>
                        <Style TargetType="materialDesign:PackIcon">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPhoto}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </materialDesign:PackIcon.Style>
                </materialDesign:PackIcon>
            </Grid>

            <TextBlock VerticalAlignment="Center"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Foreground="#0F172A"
                       Text="{Binding StudentDisplayLabel}"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
