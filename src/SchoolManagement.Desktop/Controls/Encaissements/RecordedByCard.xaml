<UserControl x:Class="SchoolManagement.Desktop.Controls.Encaissements.RecordedByCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Border Style="{StaticResource ErpCard}" Padding="16,14">
        <StackPanel Orientation="Horizontal">
            <Border Width="44"
                    Height="44"
                    Margin="0,0,14,0"
                    Background="#EEF2FF"
                    CornerRadius="22">
                <materialDesign:PackIcon Width="24"
                                         Height="24"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Foreground="{StaticResource ErpPrimaryBrush}"
                                         Kind="Account" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock FontSize="12" Foreground="#64748B" Text="Enregistré par" />
                <TextBlock Margin="0,2,0,0"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Text="{Binding RecordedByName}" />
                <TextBlock FontSize="12"
                           Foreground="#64748B"
                           Text="{Binding RecordedByRole}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
