<UserControl x:Class="SchoolManagement.Desktop.Controls.Encaissements.PaymentAmountCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Border Style="{StaticResource ErpCard}" Padding="16,14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Width="22"
                                             Height="22"
                                             Margin="0,0,8,0"
                                             VerticalAlignment="Center"
                                             Foreground="{StaticResource ErpPrimaryBrush}"
                                             Kind="Cash" />
                    <TextBlock VerticalAlignment="Center"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Text="Montant à répartir" />
                </StackPanel>
                <TextBlock Margin="30,4,0,0"
                           Style="{StaticResource ErpBodySecondary}"
                           Text="Répartition automatique sur les tranches selon les règles définies."
                           TextWrapping="Wrap" />
                <TextBlock Margin="30,6,0,0"
                           Foreground="{StaticResource ErpDangerBrush}"
                           TextWrapping="Wrap"
                           Text="Aucune tranche configurée pour cette classe / catégorie / type de frais">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasNoInstallments}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <Border Grid.Column="1"
                    Width="180"
                    Height="44"
                    VerticalAlignment="Center"
                    Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="10">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Left"
                            MinWidth="52"
                            Padding="10,0"
                            Background="#EEF2FF"
                            CornerRadius="10,0,0,10">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ErpPrimaryBrush}"
                                   Text="{Binding CurrencyLabel}" />
                    </Border>
                    <TextBox Margin="6,0,10,0"
                             FontSize="18"
                             FontWeight="SemiBold"
                             Background="Transparent"
                             BorderThickness="0"
                             VerticalContentAlignment="Center"
                             Text="{Binding AmountToDistributeText, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
