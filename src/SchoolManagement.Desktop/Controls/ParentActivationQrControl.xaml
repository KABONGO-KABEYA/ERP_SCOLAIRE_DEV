<UserControl x:Class="SchoolManagement.Desktop.Controls.ParentActivationQrControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:ui="clr-namespace:SchoolManagement.Desktop.UI"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <UserControl.Resources>
        <ui:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </UserControl.Resources>

    <Grid Style="{StaticResource ErpFadeIn}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,12"
                Padding="16"
                Style="{StaticResource SchoolFeeStudentsLikePanel}">
            <StackPanel>
                <TextBlock Style="{StaticResource SchoolFeeSectionTitle}"
                           Text="Activation mobile parent (QR)" />
                <TextBlock Margin="0,4,0,0"
                           Style="{StaticResource ErpBody}"
                           TextWrapping="Wrap"
                           Text="Génère un QR / lien d'activation pour lier le téléphone d'un parent à cette école (Bootstrap). Compte admin requis." />
                <TextBlock Margin="0,8,0,0"
                           Foreground="{StaticResource ErpPrimaryBrush}"
                           Text="{Binding StatusMessage}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Margin="0,0,12,0"
                        Padding="16"
                        Style="{StaticResource SchoolFeeStudentsLikePanel}"
                        VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,6" Opacity="0.75" Text="Nom d'utilisateur suggéré (optionnel)" />
                        <TextBox Margin="0,0,0,12"
                                 Text="{Binding SuggestedUserName, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="ex. parent.mukendi" />

                        <TextBlock Margin="0,0,0,6" Opacity="0.75" Text="Validité (minutes, 5–120)" />
                        <TextBox Margin="0,0,0,16"
                                 Text="{Binding ValidityMinutesText, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="60" />

                        <Button Command="{Binding GenerateCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Margin="0,0,6,0" Kind="Qrcode" VerticalAlignment="Center" />
                                <TextBlock Text="Générer le QR" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Padding="16"
                        Style="{StaticResource SchoolFeeStudentsLikePanel}"
                        Visibility="{Binding HasQr, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center">
                        <Image Width="280"
                               Height="280"
                               Stretch="Uniform"
                               Source="{Binding QrImage}" />
                        <TextBlock Margin="0,12,0,4"
                                   HorizontalAlignment="Center"
                                   Opacity="0.75"
                                   Text="{Binding ExpiresAtText, StringFormat=Expire le {0}}" />
                        <TextBox Margin="0,8,0,8"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 Text="{Binding DeepLinkUri}"
                                 MaxWidth="480" />
                        <Button HorizontalAlignment="Center"
                                Command="{Binding CopyDeepLinkCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Margin="0,0,6,0" Kind="ContentCopy" VerticalAlignment="Center" />
                                <TextBlock Text="Copier le lien" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
