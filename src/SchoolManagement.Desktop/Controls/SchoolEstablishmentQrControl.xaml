<UserControl x:Class="SchoolManagement.Desktop.Controls.SchoolEstablishmentQrControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:ui="clr-namespace:SchoolManagement.Desktop.UI"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <UserControl.Resources>
        <ui:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </UserControl.Resources>

    <Grid Style="{StaticResource ErpFadeIn}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,12"
                Padding="16"
                Style="{StaticResource SchoolFeeStudentsLikePanel}">
            <StackPanel>
                <TextBlock Style="{StaticResource SchoolFeeSectionTitle}"
                           Text="QR établissement" />
                <TextBlock Margin="0,4,0,0"
                           Style="{StaticResource ErpBody}"
                           TextWrapping="Wrap"
                           Text="QR de liaison téléphone ↔ établissement (tous rôles mobile). Distinct de l'invitation parent." />
                <TextBlock Margin="0,10,0,0"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Text="{Binding SchoolName}" />
                <TextBlock Margin="0,2,0,0"
                           Opacity="0.7"
                           FontSize="12"
                           Text="{Binding SchoolId, StringFormat=SchoolId : {0}}" />
                <TextBlock Margin="0,8,0,0"
                           Foreground="{StaticResource ErpPrimaryBrush}"
                           Text="{Binding StatusMessage}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Margin="0,0,12,0"
                        Padding="16"
                        Style="{StaticResource SchoolFeeStudentsLikePanel}"
                        VerticalAlignment="Top">
                    <StackPanel>
                        <Button Margin="0,0,0,10"
                                Command="{Binding LoadCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Margin="0,0,6,0" Kind="Refresh" VerticalAlignment="Center" />
                                <TextBlock Text="Charger le QR" />
                            </StackPanel>
                        </Button>

                        <Button Margin="0,0,0,10"
                                Command="{Binding RotateCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Margin="0,0,6,0" Kind="QrcodePlus" VerticalAlignment="Center" />
                                <TextBlock Text="Régénérer le QR…" />
                            </StackPanel>
                        </Button>

                        <Button Margin="0,0,0,10"
                                Command="{Binding RetryBootstrapSyncCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Visibility="{Binding CanRetryBootstrapSync, Converter={StaticResource BooleanToVisibilityConverter}}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Margin="0,0,6,0" Kind="CloudSync" VerticalAlignment="Center" />
                                <TextBlock Text="Réessayer la sync Bootstrap" />
                            </StackPanel>
                        </Button>

                        <TextBlock Margin="0,8,0,0"
                                   Opacity="0.75"
                                   TextWrapping="Wrap"
                                   Text="La régénération révoque l'ancien QR pour les nouvelles installations. Les appareils déjà liés restent liés." />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Padding="16"
                        Style="{StaticResource SchoolFeeStudentsLikePanel}"
                        Visibility="{Binding HasQr, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Padding="8,4"
                                CornerRadius="4"
                                Background="#F5F5F5"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="16" Height="16"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,6,0"
                                                         Kind="CloudOutline" />
                                <TextBlock VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Text="{Binding BootstrapSyncStatusLabel}" />
                            </StackPanel>
                        </Border>

                        <TextBlock HorizontalAlignment="Center"
                                   Opacity="0.75"
                                   Text="{Binding CredentialVersion, StringFormat=Credential version {0}}" />
                        <TextBlock HorizontalAlignment="Center"
                                   Margin="0,4,0,8"
                                   Opacity="0.65"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   MaxWidth="420"
                                   Text="{Binding BootstrapSyncMessage}"
                                   Visibility="{Binding BootstrapSyncPending, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <Image Width="280"
                               Height="280"
                               Stretch="Uniform"
                               Source="{Binding QrImage}" />

                        <TextBox Margin="0,12,0,8"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 Text="{Binding QrPayload}"
                                 MaxWidth="480"
                                 ToolTip="Deep link / payload QR (pas le secret brut)" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Margin="0,0,8,0"
                                    Command="{Binding CopyPayloadCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Margin="0,0,6,0" Kind="ContentCopy" VerticalAlignment="Center" />
                                    <TextBlock Text="Copier le payload" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding PrintPreviewCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Margin="0,0,6,0" Kind="PrinterOutline" VerticalAlignment="Center" />
                                    <TextBlock Text="Imprimer / aperçu" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
