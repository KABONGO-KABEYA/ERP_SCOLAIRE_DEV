<UserControl x:Class="SchoolManagement.Desktop.Controls.ErpSearchField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             x:Name="Root"
             HorizontalAlignment="Stretch">
    <Border HorizontalAlignment="Stretch" Style="{StaticResource ErpInputBorder}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <materialDesign:PackIcon Grid.Column="0"
                                     Margin="14,0,8,0"
                                     VerticalAlignment="Center"
                                     Foreground="{StaticResource ErpTextSecondaryBrush}"
                                     Kind="Magnify" />
            <TextBox x:Name="SearchTextBox"
                     Grid.Column="1"
                     materialDesign:HintAssist.Hint="{Binding Placeholder, ElementName=Root}"
                     KeyDown="SearchTextBox_OnKeyDown"
                     Style="{StaticResource ErpInputTextBoxCore}"
                     Text="{Binding Text, ElementName=Root, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="2"
                    Margin="0,0,6,0"
                    Padding="8,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="ClearButton_OnClick"
                    Content="Effacer"
                    Cursor="Hand"
                    FontFamily="{StaticResource ErpFontFamily}"
                    FontSize="12"
                    Foreground="{StaticResource ErpTextSecondaryBrush}"
                    Visibility="{Binding Text, ElementName=Root, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" />
        </Grid>
    </Border>
</UserControl>
