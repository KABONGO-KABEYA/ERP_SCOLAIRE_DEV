<UserControl x:Class="SchoolManagement.Desktop.Controls.CourseConfigurationControl"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:erp="clr-namespace:SchoolManagement.Desktop.Controls"

             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"

             xmlns:ui="clr-namespace:SchoolManagement.Desktop.UI"

             xmlns:vm="clr-namespace:SchoolManagement.Desktop.ViewModels"

             HorizontalAlignment="Stretch"

             VerticalAlignment="Stretch">

    <UserControl.Resources>

        <ui:InverseBooleanConverter x:Key="InverseBooleanConverter" />

    </UserControl.Resources>



    <Grid Style="{StaticResource ErpFadeIn}">

        <Grid.RowDefinitions>

            <RowDefinition Height="*" />

            <RowDefinition Height="Auto" />

            <RowDefinition Height="Auto" />

        </Grid.RowDefinitions>



        <StackPanel Grid.Row="0">

            <Border Style="{StaticResource SchoolFeeStudentsLikePanel}">

                <StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">

                        <materialDesign:PackIcon Kind="BookEducationOutline"

                                                 Width="20"

                                                 Height="20"

                                                 Margin="0,0,8,0"

                                                 VerticalAlignment="Center"

                                                 Foreground="{StaticResource ErpPrimaryBrush}" />

                        <TextBlock Text="Configuration des cours"

                                   FontSize="14"

                                   FontWeight="SemiBold"

                                   Foreground="#1F2937" />

                    </StackPanel>



                    <Border Style="{StaticResource SchoolFeeSectionCard}" Margin="0,0,0,12">

                        <UniformGrid Columns="4">

                            <erp:ErpComboField Margin="0,0,8,0"

                                               Label="Année académique"

                                               IconKind="CalendarRange"

                                               DisplayMemberPath="Label"

                                               ItemsSource="{Binding AcademicYears}"

                                               SelectedItem="{Binding SelectedAcademicYear, Mode=TwoWay}" />

                            <erp:ErpComboField Margin="0,0,8,0"

                                               Label="Section"

                                               IconKind="LayersOutline"

                                               DisplayMemberPath="Name"

                                               ItemsSource="{Binding Sections}"

                                               SelectedItem="{Binding SelectedSection, Mode=TwoWay}" />

                            <erp:ErpComboField Margin="0,0,8,0"

                                               Label="Classe"

                                               IconKind="GoogleClassroom"

                                               DisplayMemberPath="DisplayName"

                                               ItemsSource="{Binding PedagogicalClasses}"

                                               SelectedItem="{Binding SelectedPedagogicalClass, Mode=TwoWay}" />

                            <erp:ErpComboField Label="Salle de classe"

                                               IconKind="Door"

                                               DisplayMemberPath="Name"

                                               ItemsSource="{Binding ClassRooms}"

                                               SelectedItem="{Binding SelectedClassRoom, Mode=TwoWay}" />

                        </UniformGrid>

                    </Border>



                    <TextBlock Margin="0,0,0,12"

                               Foreground="{StaticResource ErpTextSecondaryBrush}"

                               Text="{Binding ConfigurationSourceLabel}" />



                    <CheckBox Margin="0,0,0,12"

                              Content="Utiliser le même enseignant pour tous les cours"

                              IsChecked="{Binding UseSameTeacherForAll}"

                              Visibility="{Binding IsPrimaryLevel, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <erp:ErpSearchComboField Margin="0,0,0,12"

                                             Placeholder="Rechercher un enseignant..."

                                             DisplayMemberPath="DisplayName"

                                             ItemsSource="{Binding Teachers}"

                                             SelectedItem="{Binding SharedTeacher, Mode=TwoWay}"

                                             Visibility="{Binding UseSameTeacherForAll, Converter={StaticResource BooleanToVisibilityConverter}}" />



                    <Grid Height="420">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*" />

                            <ColumnDefinition Width="Auto" />

                            <ColumnDefinition Width="*" />

                        </Grid.ColumnDefinitions>



                        <Border Grid.Column="0"

                                Style="{StaticResource SchoolFeeSectionCard}"

                                Margin="0,0,8,0">

                            <Grid>

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="Auto" />

                                    <RowDefinition Height="Auto" />

                                    <RowDefinition Height="Auto" />

                                    <RowDefinition Height="*" MinHeight="120" />

                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">

                                    <Button DockPanel.Dock="Right"

                                            Command="{Binding ShowNewCoursePanelCommand}"

                                            Content="+ Nouveau cours"

                                            Style="{StaticResource ErpSecondaryButton}" />

                                    <TextBlock Style="{StaticResource SchoolFeeSectionTitle}"

                                               VerticalAlignment="Center"

                                               Text="Cours disponibles" />

                                </DockPanel>

                                <erp:ErpSearchField Grid.Row="1"

                                                    Margin="0,0,0,8"

                                                    Placeholder="Rechercher un cours ou une branche..."

                                                    Text="{Binding AvailableSearchText, UpdateSourceTrigger=PropertyChanged}" />

                                <Border Grid.Row="2"

                                        Margin="0,0,0,8"

                                        Padding="12"

                                        Background="#F9FAFB"

                                        BorderBrush="#E5E7EB"

                                        BorderThickness="1"

                                        CornerRadius="8"

                                        Visibility="{Binding IsNewCoursePanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}">

                                    <StackPanel>

                                        <TextBlock Margin="0,0,0,8"

                                                   FontWeight="SemiBold"

                                                   Foreground="#374151"

                                                   Text="Nouveau cours" />

                                        <UniformGrid Columns="3" Margin="0,0,0,12">

                                            <erp:ErpTextField Margin="0,0,8,0"

                                                              Label="Nom du cours"

                                                              IconKind="BookOpenPageVariant"

                                                              Text="{Binding NewCourseName, UpdateSourceTrigger=PropertyChanged}" />

                                            <erp:ErpComboField Margin="0,0,8,0"

                                                               Label="Branche (facultatif)"

                                                               IconKind="TagOutline"

                                                               DisplayMemberPath="Name"

                                                               ItemsSource="{Binding BranchOptions}"

                                                               SelectedItem="{Binding SelectedNewCourseBranch, Mode=TwoWay}" />

                                            <erp:ErpTextField Label="Max/P"

                                                              IconKind="Numeric"

                                                              Text="{Binding NewCourseMaxScore, UpdateSourceTrigger=PropertyChanged}" />

                                        </UniformGrid>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                                            <Button Command="{Binding CancelNewCoursePanelCommand}"

                                                    Content="Fermer"

                                                    Margin="0,0,8,0"

                                                    Style="{StaticResource ErpSecondaryButton}" />

                                            <Button Command="{Binding ConfirmCreateCourseCommand}"

                                                    Content="Créer"

                                                    Style="{StaticResource ErpPrimaryButton}" />

                                        </StackPanel>

                                    </StackPanel>

                                </Border>

                                <Border Grid.Row="3"

                                        Background="#F9FAFB"

                                        BorderBrush="#E5E7EB"

                                        BorderThickness="1"

                                        CornerRadius="8"

                                        Padding="4,4">

                                    <ScrollViewer VerticalScrollBarVisibility="Auto"

                                                  HorizontalScrollBarVisibility="Disabled">

                                        <StackPanel>

                                            <Border Margin="0,0,0,8"

                                                    Background="White"

                                                    BorderBrush="#E5E7EB"

                                                    BorderThickness="1"

                                                    CornerRadius="8">

                                                <Grid Height="32">

                                                    <Grid.ColumnDefinitions>

                                                        <ColumnDefinition Width="40" />

                                                        <ColumnDefinition Width="*" />

                                                        <ColumnDefinition Width="60" />

                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="1"

                                                               Margin="8,0"

                                                               VerticalAlignment="Center"

                                                               FontWeight="SemiBold"

                                                               Foreground="#374151"

                                                               Text="Cours" />

                                                    <TextBlock Grid.Column="2"

                                                               Margin="8,0"

                                                               VerticalAlignment="Center"

                                                               FontWeight="SemiBold"

                                                               Foreground="#374151"

                                                               Text="Max/P" />

                                                </Grid>

                                            </Border>

                                            <ItemsControl ItemsSource="{Binding AvailableBranchGroups}">

                                                <ItemsControl.ItemTemplate>

                                                    <DataTemplate>

                                                        <Border Margin="0,0,0,8"

                                                                Background="White"

                                                                BorderBrush="#E5E7EB"

                                                                BorderThickness="1"

                                                                CornerRadius="8"

                                                                ClipToBounds="True"

                                                                Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">

                                                            <StackPanel>

                                                                <Border Padding="8,6"

                                                                        Background="#EEF2FF"

                                                                        BorderBrush="#E5E7EB"

                                                                        BorderThickness="0,0,0,1"

                                                                        Cursor="Hand">

                                                                    <Border.InputBindings>

                                                                        <MouseBinding Command="{Binding ToggleExpandCommand}" MouseAction="LeftClick" />

                                                                    </Border.InputBindings>

                                                                    <DockPanel LastChildFill="True">

                                                                        <TextBlock DockPanel.Dock="Right"

                                                                                   Margin="12,0,0,0"

                                                                                   VerticalAlignment="Center"

                                                                                   FontSize="12"

                                                                                   FontWeight="SemiBold"

                                                                                   Foreground="#1E3A8A"

                                                                                   Text="{Binding CourseCount, StringFormat={}{0} cours}" />

                                                                        <StackPanel Orientation="Horizontal">

                                                                            <materialDesign:PackIcon Margin="0,0,8,0"

                                                                                                     VerticalAlignment="Center"

                                                                                                     Foreground="{StaticResource ErpPrimaryBrush}"

                                                                                                     Kind="{Binding ExpandIconKind}" />

                                                                            <materialDesign:PackIcon Margin="0,0,8,0"

                                                                                                     VerticalAlignment="Center"

                                                                                                     Foreground="{StaticResource ErpPrimaryBrush}"

                                                                                                     Kind="TagOutline" />

                                                                            <TextBlock VerticalAlignment="Center"

                                                                                       FontSize="13"

                                                                                       FontWeight="SemiBold"

                                                                                       Foreground="#1F2937"

                                                                                       Text="{Binding BranchName, StringFormat=Branche : {0}}" />

                                                                        </StackPanel>

                                                                    </DockPanel>

                                                                </Border>

                                                                <ItemsControl ItemsSource="{Binding Courses}"

                                                                              Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">

                                                                    <ItemsControl.ItemTemplate>

                                                                        <DataTemplate>

                                                                            <Border Padding="8,2"

                                                                                    BorderBrush="#F3F4F6"

                                                                                    BorderThickness="0,0,0,1"

                                                                                    Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">

                                                                                <Grid MinHeight="32">

                                                                                    <Grid.ColumnDefinitions>

                                                                                        <ColumnDefinition Width="40" />

                                                                                        <ColumnDefinition Width="*" />

                                                                                        <ColumnDefinition Width="60" />

                                                                                    </Grid.ColumnDefinitions>

                                                                                    <CheckBox Grid.Column="0"

                                                                                              VerticalAlignment="Center"

                                                                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"

                                                                                              IsEnabled="{Binding CanSelect}" />

                                                                                    <TextBlock Grid.Column="1"

                                                                                               Margin="8,0"

                                                                                               VerticalAlignment="Center"

                                                                                               Text="{Binding DisplayName}"

                                                                                               TextTrimming="CharacterEllipsis">

                                                                                        <TextBlock.Style>

                                                                                            <Style TargetType="TextBlock">

                                                                                                <Style.Triggers>

                                                                                                    <DataTrigger Binding="{Binding IsAlreadyAssigned}" Value="True">

                                                                                                        <Setter Property="Opacity" Value="0.55" />

                                                                                                    </DataTrigger>

                                                                                                </Style.Triggers>

                                                                                            </Style>

                                                                                        </TextBlock.Style>

                                                                                    </TextBlock>

                                                                                    <TextBlock Grid.Column="2"

                                                                                               Margin="8,0"

                                                                                               VerticalAlignment="Center"

                                                                                               HorizontalAlignment="Center"

                                                                                               FontWeight="SemiBold"

                                                                                               Foreground="#374151"

                                                                                               Text="{Binding MaxPerPeriod}" />

                                                                                </Grid>

                                                                            </Border>

                                                                        </DataTemplate>

                                                                    </ItemsControl.ItemTemplate>

                                                                </ItemsControl>

                                                            </StackPanel>

                                                        </Border>

                                                    </DataTemplate>

                                                </ItemsControl.ItemTemplate>

                                            </ItemsControl>

                                        </StackPanel>

                                    </ScrollViewer>

                                </Border>

                            </Grid>

                        </Border>



                        <StackPanel Grid.Column="1"

                                    VerticalAlignment="Center"

                                    Margin="8,0">

                            <Button Command="{Binding AddSelectedCoursesCommand}"

                                    Content="&gt;&gt;"

                                    Width="44"

                                    Margin="0,0,0,8"

                                    Style="{StaticResource ErpPrimaryButton}" />

                            <Button Command="{Binding RemoveSelectedCoursesCommand}"

                                    Content="&lt;&lt;"

                                    Width="44"

                                    Style="{StaticResource ErpSecondaryButton}" />

                        </StackPanel>



                        <Border Grid.Column="2"

                                Style="{StaticResource SchoolFeeSectionCard}"

                                Margin="8,0,0,0">

                            <Grid>

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="Auto" />

                                    <RowDefinition Height="*" MinHeight="360" />

                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"

                                           Style="{StaticResource SchoolFeeSectionTitle}"

                                           Text="Cours de la classe"

                                           Margin="0,0,0,8" />

                                <Border Grid.Row="1"

                                        Background="#F9FAFB"

                                        BorderBrush="#E5E7EB"

                                        BorderThickness="1"

                                        CornerRadius="8"

                                        Padding="4,4">

                                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                                        <StackPanel>

                                            <Border Margin="0,0,0,8"

                                                    Background="White"

                                                    BorderBrush="#E5E7EB"

                                                    BorderThickness="1"

                                                    CornerRadius="8">

                                                <Grid Height="32">

                                                    <Grid.ColumnDefinitions>

                                                        <ColumnDefinition Width="40" />

                                                        <ColumnDefinition Width="*" />

                                                        <ColumnDefinition Width="180" />

                                                        <ColumnDefinition Width="60" />

                                                        <ColumnDefinition Width="60" />

                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="1"

                                                               Margin="8,0"

                                                               VerticalAlignment="Center"

                                                               FontWeight="SemiBold"

                                                               Foreground="#374151"

                                                               Text="Cours" />

                                                    <TextBlock Grid.Column="2"

                                                               Margin="8,0"

                                                               VerticalAlignment="Center"

                                                               FontWeight="SemiBold"

                                                               Foreground="#374151"

                                                               Text="Enseignant" />

                                                    <TextBlock Grid.Column="3"

                                                               Margin="8,0"

                                                               VerticalAlignment="Center"

                                                               FontWeight="SemiBold"

                                                               Foreground="#374151"

                                                               Text="Max/P" />

                                                    <TextBlock Grid.Column="4"

                                                               Margin="8,0"

                                                               VerticalAlignment="Center"

                                                               FontWeight="SemiBold"

                                                               Foreground="#374151"

                                                               Text="Actif" />

                                                </Grid>

                                            </Border>

                                            <ItemsControl ItemsSource="{Binding AssignedBranchGroups}">

                                                <ItemsControl.ItemTemplate>

                                                    <DataTemplate>

                                                        <Border Margin="0,0,0,8"

                                                                Background="White"

                                                                BorderBrush="#E5E7EB"

                                                                BorderThickness="1"

                                                                CornerRadius="8"

                                                                ClipToBounds="True">

                                                            <StackPanel>

                                                                <Border Padding="8,6"

                                                                        Background="#EEF2FF"

                                                                        BorderBrush="#E5E7EB"

                                                                        BorderThickness="0,0,0,1"

                                                                        Cursor="Hand">

                                                                    <Border.InputBindings>

                                                                        <MouseBinding Command="{Binding ToggleExpandCommand}" MouseAction="LeftClick" />

                                                                    </Border.InputBindings>

                                                                    <DockPanel LastChildFill="True">

                                                                        <TextBlock DockPanel.Dock="Right"

                                                                                   Margin="12,0,0,0"

                                                                                   VerticalAlignment="Center"

                                                                                   FontSize="12"

                                                                                   FontWeight="SemiBold"

                                                                                   Foreground="#1E3A8A"

                                                                                   Text="{Binding CourseCount, StringFormat={}{0} cours}" />

                                                                        <StackPanel Orientation="Horizontal">

                                                                            <materialDesign:PackIcon Margin="0,0,8,0"

                                                                                                     VerticalAlignment="Center"

                                                                                                     Foreground="{StaticResource ErpPrimaryBrush}"

                                                                                                     Kind="{Binding ExpandIconKind}" />

                                                                            <materialDesign:PackIcon Margin="0,0,8,0"

                                                                                                     VerticalAlignment="Center"

                                                                                                     Foreground="{StaticResource ErpPrimaryBrush}"

                                                                                                     Kind="TagOutline" />

                                                                            <TextBlock VerticalAlignment="Center"

                                                                                       FontSize="13"

                                                                                       FontWeight="SemiBold"

                                                                                       Foreground="#1F2937"

                                                                                       Text="{Binding BranchName, StringFormat=Branche : {0}}" />

                                                                        </StackPanel>

                                                                    </DockPanel>

                                                                </Border>

                                                                <ItemsControl ItemsSource="{Binding Courses}"

                                                                              Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">

                                                                    <ItemsControl.ItemTemplate>

                                                                        <DataTemplate>

                                                                            <Border Padding="8,2"

                                                                                    BorderBrush="#F3F4F6"

                                                                                    BorderThickness="0,0,0,1">

                                                                                <Grid MinHeight="36">

                                                                                    <Grid.ColumnDefinitions>

                                                                                        <ColumnDefinition Width="40" />

                                                                                        <ColumnDefinition Width="*" />

                                                                                        <ColumnDefinition Width="180" />

                                                                                        <ColumnDefinition Width="60" />

                                                                                        <ColumnDefinition Width="60" />

                                                                                    </Grid.ColumnDefinitions>

                                                                                    <CheckBox Grid.Column="0"

                                                                                              VerticalAlignment="Center"

                                                                                              IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" />

                                                                                    <TextBlock Grid.Column="1"

                                                                                               Margin="8,0"

                                                                                               VerticalAlignment="Center"

                                                                                               Text="{Binding CourseName}"

                                                                                               TextTrimming="CharacterEllipsis" />

                                                                                    <erp:ErpSearchComboField Grid.Column="2"

                                                                                                             Margin="4,0"

                                                                                                             Placeholder="Rechercher un enseignant..."

                                                                                                             DisplayMemberPath="DisplayName"

                                                                                                             ItemsSource="{Binding Teachers}"

                                                                                                             SelectedItem="{Binding Teacher, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"

                                                                                                             IsEnabled="{Binding DataContext.UseSameTeacherForAll, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBooleanConverter}}" />

                                                                                    <TextBox Grid.Column="3"

                                                                                             Margin="4,0"

                                                                                             VerticalContentAlignment="Center"

                                                                                             HorizontalContentAlignment="Center"

                                                                                             Text="{Binding Maximum, UpdateSourceTrigger=PropertyChanged}" />

                                                                                    <CheckBox Grid.Column="4"

                                                                                              Margin="8,0"

                                                                                              VerticalAlignment="Center"

                                                                                              HorizontalAlignment="Center"

                                                                                              IsChecked="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}" />

                                                                                </Grid>

                                                                            </Border>

                                                                        </DataTemplate>

                                                                    </ItemsControl.ItemTemplate>

                                                                </ItemsControl>

                                                            </StackPanel>

                                                        </Border>

                                                    </DataTemplate>

                                                </ItemsControl.ItemTemplate>

                                            </ItemsControl>

                                        </StackPanel>

                                    </ScrollViewer>

                                </Border>

                            </Grid>

                        </Border>

                    </Grid>

                </StackPanel>

            </Border>

        </StackPanel>



        <Border Grid.Row="1"

                Margin="0,12,0,0"

                Padding="12,10"

                Style="{StaticResource SchoolFeeActionBar}">

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                <Button Command="{Binding RefreshConfigurationCommand}"

                        Content="Actualiser"

                        Margin="0,0,8,0"

                        Style="{StaticResource ErpSecondaryButton}" />

                <Button Command="{Binding CancelCommand}"

                        Content="Annuler"

                        Margin="0,0,8,0"

                        Style="{StaticResource ErpSecondaryButton}" />

                <Button Command="{Binding SaveCommand}"

                        Content="Enregistrer"

                        Style="{StaticResource ErpPrimaryButton}" />

            </StackPanel>

        </Border>



        <Border Grid.Row="2"

                Margin="0,8,0,0"

                Visibility="{Binding StatusMessage, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">

            <Border.Style>

                <Style TargetType="Border" BasedOn="{StaticResource SchoolFeeNotificationInfo}">

                    <Style.Triggers>

                        <DataTrigger Binding="{Binding StatusMessageKind}" Value="{x:Static vm:FeeStatusMessageKind.Success}">

                            <Setter Property="Background" Value="#ECFDF5" />

                            <Setter Property="BorderBrush" Value="#A7F3D0" />

                        </DataTrigger>

                        <DataTrigger Binding="{Binding StatusMessageKind}" Value="{x:Static vm:FeeStatusMessageKind.Warning}">

                            <Setter Property="Background" Value="#FFFBEB" />

                            <Setter Property="BorderBrush" Value="#FCD34D" />

                        </DataTrigger>

                        <DataTrigger Binding="{Binding StatusMessageKind}" Value="{x:Static vm:FeeStatusMessageKind.Error}">

                            <Setter Property="Background" Value="#FEF2F2" />

                            <Setter Property="BorderBrush" Value="#FECACA" />

                        </DataTrigger>

                    </Style.Triggers>

                </Style>

            </Border.Style>

            <StackPanel Orientation="Horizontal">

                <materialDesign:PackIcon Margin="0,0,10,0"

                                       VerticalAlignment="Center"

                                       Foreground="{StaticResource ErpPrimaryBrush}"

                                       Kind="InformationOutline" />

                <TextBlock VerticalAlignment="Center"

                           Foreground="{StaticResource ErpTextPrimaryBrush}"

                           Text="{Binding StatusMessage}"

                           TextWrapping="Wrap" />

            </StackPanel>

        </Border>



        <Border Grid.RowSpan="3"

                Background="#80FFFFFF"

                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                <ProgressBar IsIndeterminate="True" Width="180" />

                <TextBlock Margin="0,8,0,0" Text="Chargement..." HorizontalAlignment="Center" />

            </StackPanel>

        </Border>

    </Grid>

</UserControl>


