<UserControl x:Class="SchoolManagement.Desktop.Controls.CourseConfigurationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:erp="clr-namespace:SchoolManagement.Desktop.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:ui="clr-namespace:SchoolManagement.Desktop.UI"
             xmlns:vm="clr-namespace:SchoolManagement.Desktop.ViewModels"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <UserControl.Resources>
        <ui:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </UserControl.Resources>

    <Grid Style="{StaticResource ErpFadeIn}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,0,8">

                <!-- 1. Contexte -->
                <Border Margin="0,0,0,10"
                        Padding="14,12"
                        Style="{StaticResource ErpV2FormCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ErpSectionTitle}"
                                   Margin="0,0,0,2"
                                   Text="Contexte de configuration" />
                        <TextBlock Margin="0,0,0,10"
                                   FontSize="11"
                                   Style="{StaticResource ErpBodySecondary}"
                                   Text="Année scolaire active via la barre du haut — choisissez la section, la classe et la salle." />

                        <UniformGrid Columns="3" Margin="0,0,0,10">
                            <erp:ErpComboField Margin="0,0,8,0"
                                               IsCompact="True"
                                               DisplayMemberPath="Name"
                                               FieldWidth="200"
                                               HorizontalAlignment="Stretch"
                                               IconKind="LayersOutline"
                                               ItemsSource="{Binding Sections}"
                                               Label="Section"
                                               SelectedItem="{Binding SelectedSection, Mode=TwoWay}" />
                            <erp:ErpComboField Margin="0,0,8,0"
                                               IsCompact="True"
                                               DisplayMemberPath="DisplayName"
                                               FieldWidth="200"
                                               HorizontalAlignment="Stretch"
                                               IconKind="GoogleClassroom"
                                               ItemsSource="{Binding PedagogicalClasses}"
                                               Label="Classe"
                                               SelectedItem="{Binding SelectedPedagogicalClass, Mode=TwoWay}" />
                            <erp:ErpComboField IsCompact="True"
                                               DisplayMemberPath="Name"
                                               FieldWidth="200"
                                               HorizontalAlignment="Stretch"
                                               IconKind="Door"
                                               ItemsSource="{Binding ClassRooms}"
                                               Label="Salle de classe"
                                               SelectedItem="{Binding SelectedClassRoom, Mode=TwoWay}" />
                        </UniformGrid>

                        <Border Padding="10,8"
                                Background="#EFF6FF"
                                BorderBrush="#BFDBFE"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CalendarRange"
                                                         Width="16"
                                                         Height="16"
                                                         Margin="0,0,8,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource ErpPrimaryBrush}" />
                                <TextBlock FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#1E3A8A"
                                           Text="{Binding WorkingAcademicYearLabel}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 2. Options enseignant (primaire) -->
                <Border Margin="0,0,0,10"
                        Padding="14,12"
                        Style="{StaticResource ErpV2FormCard}"
                        Visibility="{Binding IsPrimaryLevel, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ErpSectionTitle}"
                                   Margin="0,0,0,8"
                                   Text="Options enseignant" />
                        <CheckBox Content="Utiliser le même enseignant pour tous les cours"
                                  IsChecked="{Binding UseSameTeacherForAll}" />
                        <erp:ErpSearchComboField Margin="0,8,0,0"
                                                 Placeholder="Rechercher un enseignant…"
                                                 DisplayMemberPath="DisplayName"
                                                 ItemsSource="{Binding Teachers}"
                                                 SelectedItem="{Binding SharedTeacher, Mode=TwoWay}"
                                                 Visibility="{Binding UseSameTeacherForAll, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Border>

                <!-- 3. Affectation des cours -->
                <Border Padding="14,12"
                        Style="{StaticResource ErpCard}">
                    <Grid MinHeight="420">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="360" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Margin="0,0,0,10"
                                   Style="{StaticResource ErpSectionTitle}"
                                   Text="Affectation des cours" />

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="280" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MinWidth="320" />
                            </Grid.ColumnDefinitions>

                            <!-- Cours disponibles -->
                            <Border Grid.Column="0"
                                    Margin="0,0,8,0"
                                    Padding="10"
                                    Background="White"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" MinHeight="120" />
                                    </Grid.RowDefinitions>

                                    <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                                        <Button Padding="10,4"
                                                Command="{Binding ShowNewCoursePanelCommand}"
                                                Content="+ Nouveau"
                                                DockPanel.Dock="Right"
                                                FontSize="12"
                                                Style="{StaticResource ErpSecondaryButton}" />
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1F2937"
                                                   Text="Cours disponibles" />
                                    </DockPanel>

                                    <erp:ErpSearchField Grid.Row="1"
                                                        Margin="0,0,0,8"
                                                        Placeholder="Rechercher un cours ou une branche…"
                                                        Text="{Binding AvailableSearchText, UpdateSourceTrigger=PropertyChanged}" />

                                    <Border Grid.Row="2"
                                            Margin="0,0,0,8"
                                            Padding="10"
                                            Background="#F9FAFB"
                                            BorderBrush="#E5E7EB"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Visibility="{Binding IsNewCoursePanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Margin="0,0,0,8"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#374151"
                                                       Text="Nouveau cours" />
                                            <UniformGrid Columns="3" Margin="0,0,0,8">
                                                <erp:ErpTextField Margin="0,0,6,0"
                                                                  IsCompact="True"
                                                                  IconKind="BookOpenPageVariant"
                                                                  Label="Nom du cours"
                                                                  Text="{Binding NewCourseName, UpdateSourceTrigger=PropertyChanged}" />
                                                <erp:ErpComboField Margin="0,0,6,0"
                                                                   IsCompact="True"
                                                                   DisplayMemberPath="Name"
                                                                   IconKind="TagOutline"
                                                                   ItemsSource="{Binding BranchOptions}"
                                                                   Label="Branche"
                                                                   SelectedItem="{Binding SelectedNewCourseBranch, Mode=TwoWay}" />
                                                <erp:ErpTextField IsCompact="True"
                                                                  IconKind="Numeric"
                                                                  Label="Max/P"
                                                                  Text="{Binding NewCourseMaxScore, UpdateSourceTrigger=PropertyChanged}" />
                                            </UniformGrid>
                                            <StackPanel HorizontalAlignment="Right"
                                                        Orientation="Horizontal">
                                                <Button Margin="0,0,6,0"
                                                        Padding="10,4"
                                                        Command="{Binding CancelNewCoursePanelCommand}"
                                                        Content="Fermer"
                                                        FontSize="12"
                                                        Style="{StaticResource ErpSecondaryButton}" />
                                                <Button Padding="10,4"
                                                        Command="{Binding ConfirmCreateCourseCommand}"
                                                        Content="Créer"
                                                        FontSize="12"
                                                        Style="{StaticResource ErpPrimaryButton}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="3"
                                            Background="#F9FAFB"
                                            BorderBrush="#E5E7EB"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="4">
                                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                                      VerticalScrollBarVisibility="Auto">
                                            <StackPanel>
                                                <Border Margin="0,0,0,6"
                                                        Background="White"
                                                        BorderBrush="#E5E7EB"
                                                        BorderThickness="1"
                                                        CornerRadius="6">
                                                    <Grid Height="30">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="36" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="52" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="1"
                                                                   Margin="6,0"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#374151"
                                                                   Text="Cours" />
                                                        <TextBlock Grid.Column="2"
                                                                   Margin="6,0"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#374151"
                                                                   Text="Max/P" />
                                                    </Grid>
                                                </Border>

                                                <ItemsControl ItemsSource="{Binding AvailableBranchGroups}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,0,0,6"
                                                                    Background="White"
                                                                    BorderBrush="#E5E7EB"
                                                                    BorderThickness="1"
                                                                    CornerRadius="8"
                                                                    ClipToBounds="True"
                                                                    Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <StackPanel>
                                                                    <Border Padding="8,5"
                                                                            Background="#EEF2FF"
                                                                            BorderBrush="#E5E7EB"
                                                                            BorderThickness="0,0,0,1"
                                                                            Cursor="Hand">
                                                                        <Border.InputBindings>
                                                                            <MouseBinding Command="{Binding ToggleExpandCommand}"
                                                                                          MouseAction="LeftClick" />
                                                                        </Border.InputBindings>
                                                                        <DockPanel LastChildFill="True">
                                                                            <TextBlock DockPanel.Dock="Right"
                                                                                       Margin="8,0,0,0"
                                                                                       VerticalAlignment="Center"
                                                                                       FontSize="11"
                                                                                       FontWeight="SemiBold"
                                                                                       Foreground="#1E3A8A"
                                                                                       Text="{Binding CourseCount, StringFormat={}{0} cours}" />
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <materialDesign:PackIcon Margin="0,0,6,0"
                                                                                                         VerticalAlignment="Center"
                                                                                                         Foreground="{StaticResource ErpPrimaryBrush}"
                                                                                                         Kind="{Binding ExpandIconKind}" />
                                                                                <materialDesign:PackIcon Margin="0,0,6,0"
                                                                                                         VerticalAlignment="Center"
                                                                                                         Foreground="{StaticResource ErpPrimaryBrush}"
                                                                                                         Kind="TagOutline" />
                                                                                <TextBlock VerticalAlignment="Center"
                                                                                           FontSize="12"
                                                                                           FontWeight="SemiBold"
                                                                                           Foreground="#1F2937"
                                                                                           Text="{Binding BranchName, StringFormat=Branche : {0}}" />
                                                                            </StackPanel>
                                                                        </DockPanel>
                                                                    </Border>
                                                                    <ItemsControl ItemsSource="{Binding Courses}"
                                                                                  Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Border Padding="6,2"
                                                                                        BorderBrush="#F3F4F6"
                                                                                        BorderThickness="0,0,0,1"
                                                                                        Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                    <Grid MinHeight="30">
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="36" />
                                                                                            <ColumnDefinition Width="*" />
                                                                                            <ColumnDefinition Width="52" />
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <CheckBox Grid.Column="0"
                                                                                                  VerticalAlignment="Center"
                                                                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                                                  IsEnabled="{Binding CanSelect}" />
                                                                                        <TextBlock Grid.Column="1"
                                                                                                   Margin="6,0"
                                                                                                   VerticalAlignment="Center"
                                                                                                   FontSize="12"
                                                                                                   Text="{Binding DisplayName}"
                                                                                                   TextTrimming="CharacterEllipsis">
                                                                                            <TextBlock.Style>
                                                                                                <Style TargetType="TextBlock">
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Binding="{Binding IsAlreadyAssigned}" Value="True">
                                                                                                            <Setter Property="Opacity" Value="0.55" />
                                                                                                        </DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </TextBlock.Style>
                                                                                        </TextBlock>
                                                                                        <TextBlock Grid.Column="2"
                                                                                                   Margin="6,0"
                                                                                                   VerticalAlignment="Center"
                                                                                                   HorizontalAlignment="Center"
                                                                                                   FontSize="12"
                                                                                                   FontWeight="SemiBold"
                                                                                                   Foreground="#374151"
                                                                                                   Text="{Binding MaxPerPeriod}" />
                                                                                    </Grid>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Transfert -->
                            <StackPanel Grid.Column="1"
                                        Margin="4,0"
                                        VerticalAlignment="Center">
                                <Button Width="40"
                                        Height="32"
                                        Margin="0,0,0,6"
                                        Padding="0"
                                        Command="{Binding AddSelectedCoursesCommand}"
                                        Content="&gt;&gt;"
                                        FontSize="12"
                                        Style="{StaticResource ErpPrimaryButton}" />
                                <Button Width="40"
                                        Height="32"
                                        Padding="0"
                                        Command="{Binding RemoveSelectedCoursesCommand}"
                                        Content="&lt;&lt;"
                                        FontSize="12"
                                        Style="{StaticResource ErpSecondaryButton}" />
                            </StackPanel>

                            <!-- Cours assignés -->
                            <Border Grid.Column="2"
                                    Margin="8,0,0,0"
                                    Padding="10"
                                    Background="White"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" MinHeight="320" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Margin="0,0,0,8"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#1F2937"
                                               Text="Cours de la classe" />

                                    <Border Grid.Row="1"
                                            Background="#F9FAFB"
                                            BorderBrush="#E5E7EB"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="4">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel>
                                                <Border Margin="0,0,0,6"
                                                        Background="White"
                                                        BorderBrush="#E5E7EB"
                                                        BorderThickness="1"
                                                        CornerRadius="6">
                                                    <Grid Height="30">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="36" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="160" />
                                                            <ColumnDefinition Width="52" />
                                                            <ColumnDefinition Width="52" />
                                                            <ColumnDefinition Width="48" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="1"
                                                                   Margin="6,0"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#374151"
                                                                   Text="Cours" />
                                                        <TextBlock Grid.Column="2"
                                                                   Margin="6,0"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#374151"
                                                                   Text="Enseignant" />
                                                        <TextBlock Grid.Column="3"
                                                                   Margin="6,0"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#374151"
                                                                   Text="Heures" />
                                                        <TextBlock Grid.Column="4"
                                                                   Margin="6,0"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#374151"
                                                                   Text="Max/P" />
                                                        <TextBlock Grid.Column="5"
                                                                   Margin="6,0"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#374151"
                                                                   Text="Actif" />
                                                    </Grid>
                                                </Border>

                                                <ItemsControl ItemsSource="{Binding AssignedBranchGroups}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,0,0,6"
                                                                    Background="White"
                                                                    BorderBrush="#E5E7EB"
                                                                    BorderThickness="1"
                                                                    CornerRadius="8"
                                                                    ClipToBounds="True">
                                                                <StackPanel>
                                                                    <Border Padding="8,5"
                                                                            Background="#EEF2FF"
                                                                            BorderBrush="#E5E7EB"
                                                                            BorderThickness="0,0,0,1"
                                                                            Cursor="Hand">
                                                                        <Border.InputBindings>
                                                                            <MouseBinding Command="{Binding ToggleExpandCommand}"
                                                                                          MouseAction="LeftClick" />
                                                                        </Border.InputBindings>
                                                                        <DockPanel LastChildFill="True">
                                                                            <TextBlock DockPanel.Dock="Right"
                                                                                       Margin="8,0,0,0"
                                                                                       VerticalAlignment="Center"
                                                                                       FontSize="11"
                                                                                       FontWeight="SemiBold"
                                                                                       Foreground="#1E3A8A"
                                                                                       Text="{Binding CourseCount, StringFormat={}{0} cours}" />
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <materialDesign:PackIcon Margin="0,0,6,0"
                                                                                                         VerticalAlignment="Center"
                                                                                                         Foreground="{StaticResource ErpPrimaryBrush}"
                                                                                                         Kind="{Binding ExpandIconKind}" />
                                                                                <materialDesign:PackIcon Margin="0,0,6,0"
                                                                                                         VerticalAlignment="Center"
                                                                                                         Foreground="{StaticResource ErpPrimaryBrush}"
                                                                                                         Kind="TagOutline" />
                                                                                <TextBlock VerticalAlignment="Center"
                                                                                           FontSize="12"
                                                                                           FontWeight="SemiBold"
                                                                                           Foreground="#1F2937"
                                                                                           Text="{Binding BranchName, StringFormat=Branche : {0}}" />
                                                                            </StackPanel>
                                                                        </DockPanel>
                                                                    </Border>
                                                                    <ItemsControl ItemsSource="{Binding Courses}"
                                                                                  Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Border Padding="6,2"
                                                                                        BorderBrush="#F3F4F6"
                                                                                        BorderThickness="0,0,0,1">
                                                                                    <Grid MinHeight="34">
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="36" />
                                                                                            <ColumnDefinition Width="*" />
                                                                                            <ColumnDefinition Width="160" />
                                                                                            <ColumnDefinition Width="52" />
                                                                                            <ColumnDefinition Width="52" />
                                                                                            <ColumnDefinition Width="48" />
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <CheckBox Grid.Column="0"
                                                                                                  VerticalAlignment="Center"
                                                                                                  IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" />
                                                                                        <TextBlock Grid.Column="1"
                                                                                                   Margin="6,0"
                                                                                                   VerticalAlignment="Center"
                                                                                                   FontSize="12"
                                                                                                   Text="{Binding CourseName}"
                                                                                                   TextTrimming="CharacterEllipsis" />
                                                                                        <erp:ErpSearchComboField Grid.Column="2"
                                                                                                                 Margin="2,0"
                                                                                                                 Placeholder="Enseignant…"
                                                                                                                 DisplayMemberPath="DisplayName"
                                                                                                                 ItemsSource="{Binding Teachers}"
                                                                                                                 SelectedItem="{Binding Teacher, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                                                 IsEnabled="{Binding DataContext.UseSameTeacherForAll, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBooleanConverter}}" />
                                                                                        <TextBox Grid.Column="3"
                                                                                                 Margin="2,0"
                                                                                                 VerticalContentAlignment="Center"
                                                                                                 HorizontalContentAlignment="Center"
                                                                                                 FontSize="12"
                                                                                                 Text="{Binding WeeklyHours, UpdateSourceTrigger=PropertyChanged}" />
                                                                                        <TextBox Grid.Column="4"
                                                                                                 Margin="2,0"
                                                                                                 VerticalContentAlignment="Center"
                                                                                                 HorizontalContentAlignment="Center"
                                                                                                 FontSize="12"
                                                                                                 Text="{Binding Maximum, UpdateSourceTrigger=PropertyChanged}" />
                                                                                        <CheckBox Grid.Column="5"
                                                                                                  Margin="6,0"
                                                                                                  VerticalAlignment="Center"
                                                                                                  HorizontalAlignment="Center"
                                                                                                  IsChecked="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}" />
                                                                                    </Grid>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Barre d'actions -->
        <Border Grid.Row="1"
                Margin="0,8,0,0"
                Padding="12,10"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="10"
                Effect="{StaticResource ErpCardShadow}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal">
                    <Button Margin="0,0,6,0"
                            Padding="10,5"
                            Command="{Binding RefreshConfigurationCommand}"
                            Content="Actualiser"
                            FontSize="12"
                            Style="{StaticResource ErpSecondaryButton}" />
                    <Button Margin="0,0,6,0"
                            Padding="10,5"
                            Command="{Binding CancelCommand}"
                            Content="Annuler"
                            FontSize="12"
                            Style="{StaticResource ErpSecondaryButton}" />
                    <Button Padding="10,5"
                            Command="{Binding SaveCommand}"
                            Content="Enregistrer"
                            FontSize="12"
                            Style="{StaticResource ErpPrimaryButton}" />
                </StackPanel>
                <TextBlock VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="#64748B"
                           Text="Les affectations sont enregistrées par salle et par année scolaire."
                           TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <!-- Notification -->
        <Border Grid.Row="2"
                Margin="0,8,0,0"
                Visibility="{Binding StatusMessage, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource SchoolFeeNotificationInfo}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusMessageKind}" Value="{x:Static vm:FeeStatusMessageKind.Success}">
                            <Setter Property="Background" Value="#ECFDF5" />
                            <Setter Property="BorderBrush" Value="#A7F3D0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StatusMessageKind}" Value="{x:Static vm:FeeStatusMessageKind.Warning}">
                            <Setter Property="Background" Value="#FFFBEB" />
                            <Setter Property="BorderBrush" Value="#FCD34D" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StatusMessageKind}" Value="{x:Static vm:FeeStatusMessageKind.Error}">
                            <Setter Property="Background" Value="#FEF2F2" />
                            <Setter Property="BorderBrush" Value="#FECACA" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource ErpPrimaryBrush}"
                                       Kind="InformationOutline" />
                <TextBlock VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource ErpTextPrimaryBrush}"
                           Text="{Binding StatusMessage}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Chargement -->
        <Border Grid.RowSpan="3"
                Background="#80FFFFFF"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <ProgressBar Width="160"
                             Height="4"
                             Foreground="{StaticResource ErpPrimaryBrush}"
                             IsIndeterminate="True" />
                <TextBlock Margin="0,8,0,0"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Style="{StaticResource ErpBodySecondary}"
                           Text="Chargement…" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
