<UserControl x:Class="SchoolManagement.Desktop.Controls.CurrencyManagementControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:erp="clr-namespace:SchoolManagement.Desktop.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <Grid VerticalAlignment="Stretch" Style="{StaticResource ErpFadeIn}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
            <Button Command="{Binding LoadCommand}"
                    DockPanel.Dock="Right"
                    Style="{StaticResource ErpSecondaryButton}"
                    Content="Actualiser" />
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Margin="0,0,8,0"
                                         VerticalAlignment="Center"
                                         Foreground="{StaticResource ErpPrimaryBrush}"
                                         Kind="CurrencyUsd" />
                <TextBlock FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                           Text="Gestion des devises et taux de change" />
            </StackPanel>
        </DockPanel>

        <!-- Monnaies -->
        <Grid Grid.Row="1" Visibility="{Binding IsMonnaiesMode, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource SchoolFeeStudentsLikePanel}" Margin="0,0,12,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="True">
                        <CheckBox Content="Actives seulement"
                                  IsChecked="{Binding ActiveOnly}"
                                  DockPanel.Dock="Right"
                                  VerticalAlignment="Center"
                                  Margin="8,0,0,0" />
                        <erp:ErpTextField Label="Recherche"
                                          Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding Currencies}"
                              SelectedItem="{Binding SelectedCurrency}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Style="{StaticResource ErpDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="80" />
                            <DataGridTextColumn Header="Libellé" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Symbole" Binding="{Binding Symbol}" Width="70" />
                            <DataGridTextColumn Header="Décimales" Binding="{Binding DecimalPlaces}" Width="80" />
                            <DataGridCheckBoxColumn Header="Locale" Binding="{Binding IsSystemLocal}" Width="70" />
                            <DataGridCheckBoxColumn Header="Actif" Binding="{Binding IsActive}" Width="60" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource SchoolFeeSectionCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SchoolFeeSectionTitle}" Text="Fiche devise" Margin="0,0,0,12" />
                    <erp:ErpTextField Label="Code" Text="{Binding CurrencyCode}" Margin="0,0,0,8" />
                    <erp:ErpTextField Label="Libellé" Text="{Binding CurrencyName}" Margin="0,0,0,8" />
                    <erp:ErpTextField Label="Symbole" Text="{Binding CurrencySymbol}" Margin="0,0,0,8" />
                    <erp:ErpTextField Label="Décimales" Text="{Binding CurrencyDecimals}" Margin="0,0,0,8" />
                    <CheckBox Content="Devise système locale" IsChecked="{Binding CurrencyIsSystemLocal}" Margin="0,0,0,6" />
                    <CheckBox Content="Actif" IsChecked="{Binding CurrencyIsActive}" Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Nouveau" Command="{Binding NewCurrencyCommand}" Style="{StaticResource ErpSecondaryButton}" Margin="0,0,8,0" />
                        <Button Content="Enregistrer" Command="{Binding SaveCurrencyCommand}" Style="{StaticResource ErpPrimaryButton}" Margin="0,0,8,0" />
                        <Button Content="Activer/Désactiver" Command="{Binding ToggleCurrencyActiveCommand}" Style="{StaticResource ErpSecondaryButton}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Taux -->
        <Grid Grid.Row="1" Visibility="{Binding IsTauxMode, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource SchoolFeeStudentsLikePanel}" Margin="0,0,12,0">
                <DataGrid ItemsSource="{Binding ExchangeRates}"
                          SelectedItem="{Binding SelectedRate}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Style="{StaticResource ErpDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Source" Binding="{Binding SourceCurrencyCode}" Width="70" />
                        <DataGridTextColumn Header="Cible" Binding="{Binding TargetCurrencyCode}" Width="70" />
                        <DataGridTextColumn Header="Type" Binding="{Binding RateTypeName}" Width="120" />
                        <DataGridTextColumn Header="Date" Binding="{Binding EffectiveDate}" Width="100" />
                        <DataGridTextColumn Header="Taux" Binding="{Binding Rate}" Width="100" />
                        <DataGridCheckBoxColumn Header="Actif" Binding="{Binding IsActive}" Width="60" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource SchoolFeeSectionCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SchoolFeeSectionTitle}" Text="Fiche taux" Margin="0,0,0,12" />
                    <erp:ErpComboField Label="Devise source"
                                       ItemsSource="{Binding Currencies}"
                                       SelectedItem="{Binding RateSource}"
                                       DisplayMemberPath="Code"
                                       Margin="0,0,0,8" />
                    <erp:ErpComboField Label="Devise cible"
                                       ItemsSource="{Binding Currencies}"
                                       SelectedItem="{Binding RateTarget}"
                                       DisplayMemberPath="Code"
                                       Margin="0,0,0,8" />
                    <erp:ErpComboField Label="Type de taux"
                                       ItemsSource="{Binding RateTypes}"
                                       SelectedItem="{Binding RateType}"
                                       DisplayMemberPath="Name"
                                       Margin="0,0,0,8" />
                    <DatePicker SelectedDate="{Binding RateEffectiveDate}" Margin="0,0,0,8" />
                    <erp:ErpTextField Label="Taux (1 source = X cible)" Text="{Binding RateValue}" Margin="0,0,0,4" />
                    <TextBlock Margin="0,0,0,8"
                               Foreground="{StaticResource ErpTextSecondaryBrush}"
                               Text="{Binding InverseRateHint}"
                               TextWrapping="Wrap" />
                    <erp:ErpTextField Label="Observation" Text="{Binding RateNotes}" Margin="0,0,0,8" />
                    <CheckBox Content="Actif" IsChecked="{Binding RateIsActive}" Margin="0,0,0,12" />
                    <WrapPanel>
                        <Button Content="Nouveau" Command="{Binding NewExchangeRateCommand}" Style="{StaticResource ErpSecondaryButton}" Margin="0,0,8,8" />
                        <Button Content="Enregistrer" Command="{Binding SaveExchangeRateCommand}" Style="{StaticResource ErpPrimaryButton}" Margin="0,0,8,8" />
                        <Button Content="Activer" Command="{Binding ActivateSelectedRateCommand}" Style="{StaticResource ErpSecondaryButton}" Margin="0,0,8,8" />
                        <Button Content="Désactiver" Command="{Binding DeactivateSelectedRateCommand}" Style="{StaticResource ErpSecondaryButton}" Margin="0,0,8,8" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Devises établissement -->
        <Grid Grid.Row="1" Visibility="{Binding IsSchoolCurrenciesMode, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource SchoolFeeStudentsLikePanel}" Margin="0,0,12,0">
                <DataGrid ItemsSource="{Binding SchoolCurrencies}"
                          SelectedItem="{Binding SelectedSchoolCurrency}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Style="{StaticResource ErpDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Code" Binding="{Binding CurrencyCode}" Width="80" />
                        <DataGridTextColumn Header="Libellé" Binding="{Binding CurrencyName}" Width="*" />
                        <DataGridCheckBoxColumn Header="Principale" Binding="{Binding IsPrimary}" Width="90" />
                        <DataGridCheckBoxColumn Header="Paiement" Binding="{Binding AllowPayment}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource SchoolFeeSectionCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SchoolFeeSectionTitle}" Text="Autoriser une devise" Margin="0,0,0,12" />
                    <erp:ErpComboField Label="Devise"
                                       ItemsSource="{Binding Currencies}"
                                       SelectedItem="{Binding SchoolCurrencyPick}"
                                       DisplayMemberPath="Code"
                                       Margin="0,0,0,8" />
                    <CheckBox Content="Devise principale" IsChecked="{Binding SchoolCurrencyIsPrimary}" Margin="0,0,0,6" />
                    <CheckBox Content="Autoriser paiement" IsChecked="{Binding SchoolCurrencyAllowPayment}" Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Enregistrer" Command="{Binding SaveSchoolCurrencyCommand}" Style="{StaticResource ErpPrimaryButton}" Margin="0,0,8,0" />
                        <Button Content="Retirer" Command="{Binding RemoveSchoolCurrencyCommand}" Style="{StaticResource ErpSecondaryButton}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Historique -->
        <Border Grid.Row="1"
                Style="{StaticResource SchoolFeeStudentsLikePanel}"
                Visibility="{Binding IsHistoryMode, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DataGrid ItemsSource="{Binding HistoryRows}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Style="{StaticResource ErpDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding OccurredAt}" Width="140" />
                    <DataGridTextColumn Header="Couple" Binding="{Binding SourceCurrencyCode}" Width="70" />
                    <DataGridTextColumn Header="→" Binding="{Binding TargetCurrencyCode}" Width="70" />
                    <DataGridTextColumn Header="Type" Binding="{Binding RateTypeCode}" Width="90" />
                    <DataGridTextColumn Header="Ancien" Binding="{Binding OldRate}" Width="90" />
                    <DataGridTextColumn Header="Nouveau" Binding="{Binding NewRate}" Width="90" />
                    <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="100" />
                    <DataGridTextColumn Header="Machine" Binding="{Binding MachineName}" Width="*" />
                    <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="110" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="2"
                   Margin="0,10,0,0"
                   Text="{Binding StatusMessage}"
                   Foreground="{StaticResource ErpPrimaryBrush}" />
    </Grid>
</UserControl>
