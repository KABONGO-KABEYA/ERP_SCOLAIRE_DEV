<UserControl x:Class="SchoolManagement.Desktop.Controls.ErpComboField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SchoolManagement.Desktop.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             x:Name="Root"
             HorizontalAlignment="Stretch"
             ToolTip="{Binding Label, ElementName=Root}">
    <Grid HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    x:Name="LabelPanel"
                    Margin="{StaticResource ErpFieldLabelSpacing}"
                    Orientation="Horizontal">
            <materialDesign:PackIcon Kind="{Binding IconKind, ElementName=Root}"
                                     Style="{StaticResource ErpFieldIcon}"
                                     Visibility="{Binding IconKind, ElementName=Root, Converter={StaticResource ErpIconVisibilityConverter}}" />
            <TextBlock x:Name="LabelText"
                       Style="{StaticResource ErpFieldLabel}"
                       Text="{Binding Label, ElementName=Root}" />
            <TextBlock Style="{StaticResource ErpFieldRequiredMark}"
                       Visibility="{Binding IsRequired, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>

        <Border x:Name="InputBorder"
                Grid.Row="1"
                HorizontalAlignment="Stretch"
                Style="{StaticResource ErpInputBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="InputComboBox"
                          Grid.Column="0"
                          HorizontalAlignment="Stretch"
                          Style="{StaticResource ErpInputComboBoxCore}"
                          DisplayMemberPath="{Binding DisplayMemberPath, ElementName=Root}"
                          SelectedValuePath="{Binding SelectedValuePath, ElementName=Root}"
                          ItemsSource="{Binding ItemsSource, ElementName=Root}"
                          SelectedItem="{Binding SelectedItem, ElementName=Root, Mode=TwoWay}"
                          SelectedValue="{Binding SelectedValue, ElementName=Root, Mode=TwoWay}"
                          IsTextSearchEnabled="True"
                          DropDownOpened="InputComboBox_OnDropDownOpened"
                          PreviewMouseLeftButtonDown="InputComboBox_OnPreviewMouseLeftButtonDown"
                          SelectionChanged="InputComboBox_OnSelectionChanged" />
                <materialDesign:PackIcon x:Name="SuccessIcon"
                                         Grid.Column="1"
                                         Margin="0,0,4,0"
                                         Style="{StaticResource ErpValidationSuccessIcon}"
                                         Visibility="Collapsed" />
                <materialDesign:PackIcon x:Name="ErrorIcon"
                                         Grid.Column="2"
                                         Margin="0,0,10,0"
                                         Style="{StaticResource ErpValidationErrorIcon}"
                                         Visibility="Collapsed" />
            </Grid>
        </Border>

        <TextBlock x:Name="ErrorText"
                   Grid.Row="2"
                   Style="{StaticResource ErpFieldErrorText}"
                   Text="{Binding ErrorMessage, ElementName=Root}"
                   Visibility="Collapsed" />
    </Grid>
</UserControl>
