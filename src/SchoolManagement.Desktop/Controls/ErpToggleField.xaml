<UserControl x:Class="SchoolManagement.Desktop.Controls.ErpToggleField"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:controls="clr-namespace:SchoolManagement.Desktop.Controls"
                         xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                         x:Name="Root">
    <StackPanel Orientation="Horizontal">
        <TextBlock Margin="0,0,12,0"
                   VerticalAlignment="Center"
                   FontFamily="{StaticResource ErpFontFamily}"
                   FontSize="14"
                   Text="{Binding Label, ElementName=Root}" />
        <ToggleButton IsChecked="{Binding IsChecked, ElementName=Root, Mode=TwoWay}"
                      Style="{StaticResource MaterialDesignSwitchToggleButton}"
                      ToolTip="{Binding Label, ElementName=Root}" />
    </StackPanel>
</UserControl>
