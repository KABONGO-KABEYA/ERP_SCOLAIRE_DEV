<UserControl x:Class="SchoolManagement.Desktop.Controls.ErpTextAreaField"
                           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:controls="clr-namespace:SchoolManagement.Desktop.Controls"
                           xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                           x:Name="Root"
                           HorizontalAlignment="Stretch"
                           ToolTip="{Binding Label, ElementName=Root}">
    <Grid HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0"
                    Margin="{StaticResource ErpFieldLabelSpacing}"
                    Orientation="Horizontal">
            <materialDesign:PackIcon Kind="{Binding IconKind, ElementName=Root}"
                                     Style="{StaticResource ErpFieldIcon}"
                                     Visibility="{Binding IconKind, ElementName=Root, Converter={StaticResource ErpIconVisibilityConverter}}" />
            <TextBlock Style="{StaticResource ErpFieldLabel}" Text="{Binding Label, ElementName=Root}" />
            <TextBlock Style="{StaticResource ErpFieldRequiredMark}"
                       Visibility="{Binding IsRequired, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>
        <Border x:Name="InputBorder"
                Grid.Row="1"
                HorizontalAlignment="Stretch"
                MinHeight="96"
                Background="White"
                BorderBrush="{StaticResource ErpInputBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource ErpInputRadius}">
            <TextBox x:Name="InputTextBox"
                     AcceptsReturn="True"
                     HorizontalAlignment="Stretch"
                     MinLines="{Binding MinLines, ElementName=Root}"
                     Style="{StaticResource ErpInputTextBoxCore}"
                     Text="{Binding Text, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     LostFocus="InputTextBox_OnLostFocus" />
        </Border>
        <TextBlock x:Name="ErrorText"
                   Grid.Row="2"
                   Style="{StaticResource ErpFieldErrorText}"
                   Text="{Binding ErrorMessage, ElementName=Root}"
                   Visibility="Collapsed" />
    </Grid>
</UserControl>
