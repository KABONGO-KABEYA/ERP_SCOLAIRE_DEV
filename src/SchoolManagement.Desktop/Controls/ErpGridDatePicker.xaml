<UserControl x:Class="SchoolManagement.Desktop.Controls.ErpGridDatePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             x:Name="Root"
             FocusVisualStyle="{x:Null}">
    <Border x:Name="HostBorder"
            Style="{StaticResource ErpGridDateCellBorder}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="DateTextBox"
                     Grid.Column="0"
                     Margin="0,0,6,0"
                     VerticalAlignment="Center"
                     VerticalContentAlignment="Center"
                     Background="Transparent"
                     BorderThickness="0"
                     CaretBrush="{StaticResource ErpPrimaryBrush}"
                     FocusVisualStyle="{x:Null}"
                     FontFamily="{StaticResource ErpFontFamily}"
                     FontSize="13"
                     FontWeight="Medium"
                     Foreground="{StaticResource ErpTextPrimaryBrush}"
                     Padding="0"
                     SelectionBrush="{StaticResource ErpPrimaryLightBrush}"
                     LostFocus="DateTextBox_OnLostFocus"
                     PreviewKeyDown="DateTextBox_OnPreviewKeyDown"
                     GotKeyboardFocus="DateTextBox_OnGotKeyboardFocus" />
            <Button x:Name="OpenCalendarButton"
                    Grid.Column="1"
                    Click="OpenCalendarButton_OnClick"
                    Style="{StaticResource ErpGridDatePickerButton}">
                <materialDesign:PackIcon Width="16"
                                         Height="16"
                                         Foreground="{StaticResource ErpPrimaryBrush}"
                                         Kind="CalendarMonthOutline" />
            </Button>
            <Popup x:Name="CalendarPopup"
                   AllowsTransparency="True"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=HostBorder}"
                   StaysOpen="False">
                <Border Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="10"
                        Effect="{StaticResource ErpCardShadow}"
                        Padding="6">
                    <Calendar x:Name="CalendarControl"
                              Background="White"
                              BorderThickness="0"
                              SelectedDatesChanged="CalendarControl_OnSelectedDatesChanged" />
                </Border>
            </Popup>
        </Grid>
    </Border>
</UserControl>
