<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Style x:Key="SchoolFeeSectionCard" TargetType="Border" BasedOn="{StaticResource ErpCard}">
        <Setter Property="Background" Value="White" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderBrush" Value="#E5E7EB" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Effect" Value="{x:Null}" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="SchoolFeeSectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ErpFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource ErpTextPrimaryBrush}" />
    </Style>

    <Style x:Key="SchoolFeeSectionSubtitle" TargetType="TextBlock" BasedOn="{StaticResource ErpBodySecondary}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <Style x:Key="SchoolFeeTabControl" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TabPanel Grid.Row="0"
                                  Margin="0,0,0,6"
                                  Background="Transparent"
                                  IsItemsHost="True" />
                        <ContentPresenter Grid.Row="1"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          Content="{TemplateBinding SelectedContent}"
                                          ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SchoolFeeTabItem" TargetType="TabItem">
        <Setter Property="FontFamily" Value="{StaticResource ErpFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource ErpTextSecondaryBrush}" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Root"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            CornerRadius="10,10,0,0"
                            BorderThickness="0,0,0,3"
                            BorderBrush="Transparent"
                            Cursor="Hand">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource ErpPrimaryLightBrush}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource ErpPrimaryBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource ErpPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#F3F4F6" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Root" Property="Background" Value="#E0EAFF" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SchoolFeeTabHeader" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
    </Style>

    <Style x:Key="SchoolFeeTabIcon" TargetType="materialDesign:PackIcon">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SchoolFeeScheduleDataGridRow" TargetType="DataGridRow" BasedOn="{StaticResource ErpDataGridRow}">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#F0F7FF" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#E8EFFF" />
                <Setter Property="BorderBrush" Value="{StaticResource ErpPrimaryBrush}" />
                <Setter Property="BorderThickness" Value="3,0,0,0" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="#DDE8FF" />
            </MultiTrigger>
            <Trigger Property="AlternationIndex" Value="1">
                <Setter Property="Background" Value="#FAFBFC" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="AlternationIndex" Value="1" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="#EDF4FF" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SchoolFeeScheduleDataGridCell" TargetType="DataGridCell" BasedOn="{StaticResource ErpDataGridCell}">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="#EEF2F7" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource ErpTextPrimaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SchoolFeeScheduleColumnHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ErpFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource ErpTextSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SchoolFeeScheduleDataGrid" TargetType="DataGrid" BasedOn="{StaticResource ErpDataGrid}">
        <Setter Property="Background" Value="White" />
        <Setter Property="RowBackground" Value="White" />
        <Setter Property="AlternatingRowBackground" Value="#FAFBFC" />
        <Setter Property="RowHeight" Value="48" />
        <Setter Property="ColumnHeaderHeight" Value="46" />
        <Setter Property="RowStyle" Value="{StaticResource SchoolFeeScheduleDataGridRow}" />
        <Setter Property="CellStyle" Value="{StaticResource SchoolFeeScheduleDataGridCell}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="CanUserResizeColumns" Value="True" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="#EEF2F7" />
        <Setter Property="BorderBrush" Value="#E5E7EB" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HeadersVisibility" Value="Column" />
    </Style>

    <Style x:Key="SchoolFeeGridOrderBadge" TargetType="Border">
        <Setter Property="Background" Value="#EEF2FF" />
        <Setter Property="BorderBrush" Value="#C7D2FE" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SchoolFeeGridOrderText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#1E5EFF" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style x:Key="SchoolFeeGridInputBorder" TargetType="Border" BasedOn="{StaticResource ErpInputBorder}">
        <Setter Property="Height" Value="38" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="White" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="#CBD5E1" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ErpPrimaryBrush}" />
                <Setter Property="Background" Value="#FAFCFF" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SchoolFeeGridNumericTextBox" TargetType="TextBox" BasedOn="{StaticResource ErpInputTextBoxCore}">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="12,0,12,0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#111827" />
    </Style>

    <Style x:Key="SchoolFeeGridDatePickerTextBox" TargetType="DatePickerTextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,0,4,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{StaticResource ErpFontFamily}" />
        <Setter Property="Foreground" Value="{StaticResource ErpTextPrimaryBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePickerTextBox">
                    <Grid x:Name="WatermarkWrapper">
                        <TextBox x:Name="PART_TextBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 CaretBrush="{StaticResource ErpPrimaryBrush}"
                                 FocusVisualStyle="{x:Null}"
                                 FontFamily="{TemplateBinding FontFamily}"
                                 FontSize="{TemplateBinding FontSize}"
                                 Foreground="{TemplateBinding Foreground}"
                                 HorizontalContentAlignment="Stretch"
                                 Padding="{TemplateBinding Padding}"
                                 SelectionBrush="{StaticResource ErpPrimaryLightBrush}"
                                 VerticalContentAlignment="Center" />
                        <ContentControl x:Name="PART_Watermark"
                                        HorizontalAlignment="Left"
                                        IsHitTestVisible="False"
                                        Margin="0,0,4,0"
                                        Opacity="0.45"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SchoolFeeGridDatePickerButton" TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#EEF2FF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SchoolFeeGridDatePicker" TargetType="DatePicker">
        <Setter Property="Foreground" Value="{StaticResource ErpTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource ErpFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Height" Value="36" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Grid x:Name="PART_Root">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <DatePickerTextBox x:Name="PART_TextBox"
                                           Grid.Column="0"
                                           Focusable="{TemplateBinding Focusable}"
                                           HorizontalContentAlignment="Stretch"
                                           Style="{StaticResource SchoolFeeGridDatePickerTextBox}"
                                           VerticalContentAlignment="Center" />
                        <Button x:Name="PART_Button"
                                Grid.Column="1"
                                Style="{StaticResource SchoolFeeGridDatePickerButton}">
                            <materialDesign:PackIcon Width="16"
                                                     Height="16"
                                                     Foreground="{StaticResource ErpPrimaryBrush}"
                                                     Kind="CalendarMonthOutline" />
                        </Button>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=PART_TextBox}">
                            <Border Background="White"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Effect="{StaticResource ErpCardShadow}"
                                    Padding="6">
                                <Calendar x:Name="PART_Calendar"
                                          Background="White"
                                          BorderThickness="0" />
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SchoolFeeGridDateCellBorder" TargetType="Border">
        <Setter Property="Height" Value="38" />
        <Setter Property="CornerRadius" Value="{StaticResource ErpInputRadius}" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource ErpInputBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Padding" Value="8,0,4,0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Effect" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ErpInputBorderHoverBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ErpInputFocusBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SchoolFeeAddInstallmentButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource ErpPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource ErpFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#EEF2FF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#9CA3AF" />
                            <Setter Property="Opacity" Value="0.75" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SchoolFeeInstallmentPickerPopup" TargetType="Border">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#E5E7EB" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="MinWidth" Value="260" />
        <Setter Property="MaxHeight" Value="280" />
        <Setter Property="Effect" Value="{StaticResource ErpCardShadow}" />
    </Style>

    <Style x:Key="SchoolFeeInstallmentPickerItem" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#F0F7FF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SchoolFeeGridRowActionButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="#9CA3AF" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#EF4444" />
                <Setter Property="Background" Value="#FEE2E2" />
            </Trigger>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                <Setter Property="Opacity" Value="1" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                <Setter Property="Opacity" Value="1" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SchoolFeeGridStatusBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SchoolFeeGridStatusText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SchoolFeeScheduleTotalBar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ErpPrimaryLightBrush}" />
        <Setter Property="BorderBrush" Value="#C7D2FE" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,12" />
    </Style>

    <Style x:Key="SchoolFeeAmountsToolbar" TargetType="DockPanel">
        <Setter Property="LastChildFill" Value="False" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="SchoolFeeCatalogSplitGrid" TargetType="Grid">
        <Setter Property="MinHeight" Value="320" />
    </Style>

    <Style x:Key="SchoolFeePremiumDataGrid" TargetType="DataGrid" BasedOn="{StaticResource ErpDataGrid}">
        <Setter Property="Background" Value="White" />
        <Setter Property="RowBackground" Value="White" />
        <Setter Property="AlternatingRowBackground" Value="#F8FAFC" />
        <Setter Property="RowHeight" Value="44" />
        <Setter Property="RowStyle" Value="{StaticResource ErpDataGridRow}" />
        <Setter Property="CellStyle" Value="{StaticResource ErpDataGridCell}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="CanUserResizeColumns" Value="True" />
    </Style>

    <Style x:Key="SchoolFeeDataGridText" TargetType="TextBlock">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
    </Style>

    <Style x:Key="SchoolFeeSummaryCard" TargetType="Border" BasedOn="{StaticResource SchoolFeeSectionCard}">
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="MinWidth" Value="200" />
    </Style>

    <Style x:Key="SchoolFeeSummaryLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource ErpTextSecondaryBrush}" />
    </Style>

    <Style x:Key="SchoolFeeSummaryValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource ErpTextPrimaryBrush}" />
        <Setter Property="Margin" Value="0,2,0,10" />
    </Style>

    <Style x:Key="SchoolFeeTotalLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource ErpTextSecondaryBrush}" />
        <Setter Property="Margin" Value="0,8,0,4" />
    </Style>

    <Style x:Key="SchoolFeeTotalAmount" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource ErpPrimaryBrush}" />
        <Setter Property="LineHeight" Value="32" />
    </Style>

    <Style x:Key="SchoolFeeClassCheckBox" TargetType="CheckBox">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource ErpTextPrimaryBrush}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="SchoolFeeClassListItemHost" TargetType="Border">
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#F0F7FF" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SchoolFeeActionBar" TargetType="Border">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#E5E7EB" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,12" />
    </Style>

    <Style x:Key="SchoolFeeNotificationInfo" TargetType="Border">
        <Setter Property="Background" Value="#EEF2FF" />
        <Setter Property="BorderBrush" Value="#C7D2FE" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <Style x:Key="SchoolFeeNotificationSuccess" TargetType="Border" BasedOn="{StaticResource SchoolFeeNotificationInfo}">
        <Setter Property="Background" Value="#ECFDF5" />
        <Setter Property="BorderBrush" Value="#A7F3D0" />
    </Style>

    <Style x:Key="SchoolFeeNotificationWarning" TargetType="Border" BasedOn="{StaticResource SchoolFeeNotificationInfo}">
        <Setter Property="Background" Value="#FFFBEB" />
        <Setter Property="BorderBrush" Value="#FCD34D" />
    </Style>

    <Style x:Key="SchoolFeeNotificationError" TargetType="Border" BasedOn="{StaticResource SchoolFeeNotificationInfo}">
        <Setter Property="Background" Value="#FEF2F2" />
        <Setter Property="BorderBrush" Value="#FECACA" />
    </Style>

    <Style x:Key="SchoolFeeStatusBadgeConfigured" TargetType="Border" BasedOn="{StaticResource ErpTableStatusBadgeActive}">
        <Setter Property="Padding" Value="10,4" />
    </Style>

    <Style x:Key="SchoolFeeStatusBadgePending" TargetType="Border" BasedOn="{StaticResource ErpTableStatusBadgeInactive}">
        <Setter Property="Padding" Value="10,4" />
    </Style>

    <Style x:Key="SchoolFeeStatusBadgeComplete" TargetType="Border" BasedOn="{StaticResource ErpTableStatusBadgeActive}">
        <Setter Property="Background" Value="{StaticResource ErpBadgeInfoBgBrush}" />
        <Setter Property="Padding" Value="10,4" />
    </Style>

    <Style x:Key="SchoolFeeStatusTextConfigured" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#15803D" />
    </Style>

    <Style x:Key="SchoolFeeStatusTextPending" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#6B7280" />
    </Style>

    <Style x:Key="SchoolFeeStatusTextComplete" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#1E5EFF" />
    </Style>

    <Style x:Key="SchoolFeeReadOnlyBanner" TargetType="Border">
        <Setter Property="Background" Value="#FFFBEB" />
        <Setter Property="BorderBrush" Value="#FCD34D" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="SchoolFeeMetricPill" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ErpPrimaryLightBrush}" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="SchoolFeeLoadingOverlay" TargetType="Border">
        <Setter Property="Background" Value="#99F5F7FB" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <Style x:Key="SchoolFeeCollapsibleExpander" TargetType="Expander">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="IsExpanded" Value="True" />
        <Setter Property="ExpandDirection" Value="Down" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border Background="#FAFBFC"
                            BorderBrush="{StaticResource ErpBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Effect="{StaticResource ErpCardShadow}">
                        <DockPanel>
                            <ToggleButton x:Name="HeaderSite"
                                          DockPanel.Dock="Top"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Cursor="Hand"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0" ContentSource="Header" />
                                    <materialDesign:PackIcon x:Name="Chevron"
                                                             Grid.Column="2"
                                                             Width="18"
                                                             Height="18"
                                                             VerticalAlignment="Center"
                                                             Foreground="{StaticResource ErpTextSecondaryBrush}"
                                                             Kind="ChevronDown" />
                                </Grid>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite"
                                              Margin="12,0,12,12"
                                              DockPanel.Dock="Bottom"
                                              Visibility="Collapsed" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Chevron" Property="RenderTransformOrigin" Value="0.5,0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SchoolFeeStudentsLikePanel" TargetType="Border">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#E5E7EB" />
        <Setter Property="BorderThickness" Value="1" />
