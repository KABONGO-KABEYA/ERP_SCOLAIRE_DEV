<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="ErpV2PageHost" TargetType="Grid">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style x:Key="ErpV2FormCard" TargetType="Border" BasedOn="{StaticResource ErpCard}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>

    <Style x:Key="ErpV2CardHeader" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="ErpV2CardDivider" TargetType="Border">
        <Setter Property="BorderBrush" Value="#E5E7EB" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <Style x:Key="ErpV2InfoCard" TargetType="Border" BasedOn="{StaticResource ErpCard}">
        <Setter Property="Background" Value="#EFF6FF" />
        <Setter Property="BorderBrush" Value="#BFDBFE" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,16,0,0" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <Style x:Key="ErpV2SummaryPanel" TargetType="Border" BasedOn="{StaticResource ErpCard}">
        <Setter Property="Padding" Value="16" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>

    <Style x:Key="ErpV2SummaryLine" TargetType="TextBlock" BasedOn="{StaticResource ErpBodySecondary}">
        <Setter Property="Margin" Value="0,0,0,5" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="ErpV2FooterBar" TargetType="Border">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#E5E7EB" />
        <Setter Property="BorderThickness" Value="1,1,1,0" />
        <Setter Property="Padding" Value="24,14" />
        <Setter Property="Effect" Value="{StaticResource ErpCardShadow}" />
    </Style>

    <Style x:Key="ErpV2PhotoButton" TargetType="Button" BasedOn="{StaticResource ErpSecondaryButton}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="ErpV2StepCircle" TargetType="Border">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Background" Value="{Binding State, Converter={StaticResource WizardStepStateToBrushConverter}}" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Active">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="1.08"
                                             Duration="0:0:0.22"
                                             AutoReverse="True" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="1.08"
                                             Duration="0:0:0.22"
                                             AutoReverse="True" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ErpV2StepTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{StaticResource ErpTextSecondaryBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Active">
                <Setter Property="Foreground" Value="{StaticResource ErpPrimaryBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Completed">
                <Setter Property="Foreground" Value="{StaticResource ErpSuccessBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ErpV2StepSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{StaticResource ErpTextSecondaryBrush}" />
        <Setter Property="Opacity" Value="0.85" />
    </Style>

    <Style x:Key="ErpV2ModernBadge" TargetType="Border">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ErpV2ModernBadgeSuccess" TargetType="Border" BasedOn="{StaticResource ErpV2ModernBadge}">
        <Setter Property="Background" Value="{StaticResource ErpBadgeSuccessBgBrush}" />
    </Style>

    <Style x:Key="ErpV2ModernBadgePurple" TargetType="Border" BasedOn="{StaticResource ErpV2ModernBadge}">
        <Setter Property="Background" Value="{StaticResource ErpBadgePurpleBgBrush}" />
    </Style>

    <Style x:Key="ErpV2ModernBadgeWarning" TargetType="Border" BasedOn="{StaticResource ErpV2ModernBadge}">
        <Setter Property="Background" Value="{StaticResource ErpBadgeWarningBgBrush}" />
    </Style>

    <Style x:Key="ErpV2ModuleChip" TargetType="Border">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#BFDBFE" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Margin" Value="0,0,8,8" />
    </Style>

</ResourceDictionary>
