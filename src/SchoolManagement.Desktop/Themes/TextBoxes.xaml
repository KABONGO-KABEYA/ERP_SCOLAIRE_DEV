<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- Styles legacy — basés sur le Design System ERP -->
    <Style x:Key="ErpTextBox" TargetType="TextBox" BasedOn="{StaticResource ErpInputTextBoxCore}">
        <Setter Property="Height" Value="{StaticResource ErpInputHeight}" />
        <Setter Property="BorderBrush" Value="{StaticResource ErpInputBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="White" />
        <Setter Property="materialDesign:TextFieldAssist.DecorationVisibility" Value="Collapsed" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ErpInputRadius}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource ErpInputBorderHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource ErpInputFocusBrush}" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter Property="Background" Value="{StaticResource ErpInputReadOnlyBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{StaticResource ErpInputDisabledBrush}" />
                            <Setter Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ERPTextBox" TargetType="TextBox" BasedOn="{StaticResource ErpTextBox}" />

    <Style x:Key="ErpPasswordBox" TargetType="PasswordBox" BasedOn="{StaticResource MaterialDesignOutlinedPasswordBox}">
        <Setter Property="Height" Value="{StaticResource ErpInputHeight}" />
        <Setter Property="FontFamily" Value="{StaticResource ErpFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="{StaticResource ErpInputPadding}" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource ErpInputBorderBrush}" />
        <Setter Property="materialDesign:TextFieldAssist.DecorationVisibility" Value="Collapsed" />
    </Style>

    <Style x:Key="ErpComboBox" TargetType="ComboBox" BasedOn="{StaticResource ErpInputComboBoxCore}">
        <Setter Property="Height" Value="{StaticResource ErpInputHeight}" />
        <Setter Property="BorderBrush" Value="{StaticResource ErpInputBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="White" />
        <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
    </Style>

    <Style x:Key="ERPComboBox" TargetType="ComboBox" BasedOn="{StaticResource ErpComboBox}" />

    <Style x:Key="ErpDatePicker" TargetType="DatePicker" BasedOn="{StaticResource ErpInputDatePickerCore}">
        <Setter Property="Height" Value="{StaticResource ErpInputHeight}" />
        <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
    </Style>

    <Style x:Key="ERPDatePicker" TargetType="DatePicker" BasedOn="{StaticResource ErpDatePicker}" />

    <Style x:Key="ErpWizardSearchBox" TargetType="TextBox" BasedOn="{StaticResource ErpTextBox}">
        <Setter Property="MinWidth" Value="360" />
        <Setter Property="Padding" Value="40,0,14,0" />
    </Style>

</ResourceDictionary>
