<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Style x:Key="ErpBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Background" Value="{StaticResource ErpBadgeInfoBgBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="ErpBadgeText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ErpFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource ErpPrimaryBrush}" />
    </Style>

    <Style x:Key="ErpBadgeSuccess" TargetType="Border" BasedOn="{StaticResource ErpBadge}">
        <Setter Property="Background" Value="{StaticResource ErpBadgeSuccessBgBrush}" />
    </Style>

    <Style x:Key="ErpBadgeSuccessText" TargetType="TextBlock" BasedOn="{StaticResource ErpBadgeText}">
        <Setter Property="Foreground" Value="#166534" />
    </Style>

    <Style x:Key="ErpBadgeInfo" TargetType="Border" BasedOn="{StaticResource ErpBadge}">
        <Setter Property="Background" Value="{StaticResource ErpBadgeInfoBgBrush}" />
    </Style>

    <Style x:Key="ErpBadgeInfoText" TargetType="TextBlock" BasedOn="{StaticResource ErpBadgeText}">
        <Setter Property="Foreground" Value="{StaticResource ErpPrimaryBrush}" />
    </Style>

    <Style x:Key="ErpBadgePurple" TargetType="Border" BasedOn="{StaticResource ErpBadge}">
        <Setter Property="Background" Value="{StaticResource ErpBadgePurpleBgBrush}" />
    </Style>

    <Style x:Key="ErpBadgePurpleText" TargetType="TextBlock" BasedOn="{StaticResource ErpBadgeText}">
        <Setter Property="Foreground" Value="#7C3AED" />
    </Style>

    <Style x:Key="ErpBadgeWarning" TargetType="Border" BasedOn="{StaticResource ErpBadge}">
        <Setter Property="Background" Value="{StaticResource ErpBadgeWarningBgBrush}" />
    </Style>

    <Style x:Key="ErpBadgeWarningText" TargetType="TextBlock" BasedOn="{StaticResource ErpBadgeText}">
        <Setter Property="Foreground" Value="#B45309" />
    </Style>

    <Style x:Key="ErpBadgeIcon" TargetType="materialDesign:PackIcon">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
