<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- Design unifié : même rendu que « Date limite » (configuration frais scolaires) -->

    <Style x:Key="ErpGridDatePickerTextBox" TargetType="DatePickerTextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,0,4,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{StaticResource ErpFontFamily}" />
        <Setter Property="Foreground" Value="{StaticResource ErpTextPrimaryBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <!-- Template par défaut conservé : la saisie clavier dd/MM/yyyy (culture fr-FR) reste possible. -->
    </Style>

    <Style x:Key="ErpGridDatePickerButton" TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#EEF2FF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ErpGridDatePicker" TargetType="DatePicker">
        <Setter Property="Language" Value="fr-FR" />
        <Setter Property="SelectedDateFormat" Value="Short" />
        <Setter Property="Foreground" Value="{StaticResource ErpTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource ErpFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Height" Value="36" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Grid x:Name="PART_Root"
                          Language="fr-FR">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <DatePickerTextBox x:Name="PART_TextBox"
                                           Grid.Column="0"
                                           Focusable="{TemplateBinding Focusable}"
                                           HorizontalContentAlignment="Stretch"
                                           Language="fr-FR"
                                           Style="{StaticResource ErpGridDatePickerTextBox}"
                                           VerticalContentAlignment="Center" />
                        <Button x:Name="PART_Button"
                                Grid.Column="1"
                                Style="{StaticResource ErpGridDatePickerButton}">
                            <materialDesign:PackIcon Width="16"
                                                     Height="16"
                                                     Foreground="{StaticResource ErpPrimaryBrush}"
                                                     Kind="CalendarMonthOutline" />
                        </Button>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=PART_TextBox}">
                            <Border Background="White"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Effect="{StaticResource ErpCardShadow}"
                                    Padding="6">
                                <Calendar x:Name="PART_Calendar"
                                          Background="White"
                                          BorderThickness="0"
                                          Language="fr-FR" />
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ErpGridDateCellBorder" TargetType="Border">
        <Setter Property="Height" Value="38" />
        <Setter Property="CornerRadius" Value="{StaticResource ErpInputRadius}" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource ErpInputBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Padding" Value="8,0,4,0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Effect" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ErpInputBorderHoverBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ErpInputFocusBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Alias rétrocompatibilité module frais scolaires -->
    <Style x:Key="SchoolFeeGridDatePickerTextBox" TargetType="DatePickerTextBox" BasedOn="{StaticResource ErpGridDatePickerTextBox}" />
    <Style x:Key="SchoolFeeGridDatePickerButton" TargetType="Button" BasedOn="{StaticResource ErpGridDatePickerButton}" />
    <Style x:Key="SchoolFeeGridDatePicker" TargetType="DatePicker" BasedOn="{StaticResource ErpGridDatePicker}" />
    <Style x:Key="SchoolFeeGridDateCellBorder" TargetType="Border" BasedOn="{StaticResource ErpGridDateCellBorder}" />

</ResourceDictionary>
