<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DropShadowEffect x:Key="ErpCardShadow"
                      BlurRadius="24"
                      ShadowDepth="2"
                      Direction="270"
                      Opacity="0.08"
                      Color="#000000" />

    <DropShadowEffect x:Key="ErpTopBarShadow"
                      BlurRadius="12"
                      ShadowDepth="1"
                      Direction="270"
                      Opacity="0.06"
                      Color="#000000" />

    <DropShadowEffect x:Key="ErpHoverShadow"
                      BlurRadius="20"
                      ShadowDepth="3"
                      Direction="270"
                      Opacity="0.12"
                      Color="#1E5EFF" />

    <DropShadowEffect x:Key="ErpInputFocusShadow"
                      BlurRadius="10"
                      ShadowDepth="0"
                      Direction="270"
                      Opacity="0.28"
                      Color="#1E5EFF" />

</ResourceDictionary>
