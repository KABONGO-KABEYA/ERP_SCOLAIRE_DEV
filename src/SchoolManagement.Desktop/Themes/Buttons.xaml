<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Style x:Key="ErpPrimaryButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
        <Setter Property="Height" Value="42" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="#1E5EFF" />
        <Setter Property="BorderBrush" Value="#1E5EFF" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="10" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#184FD9" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ErpSecondaryButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
        <Setter Property="Height" Value="42" />
        <Setter Property="MinWidth" Value="100" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="BorderBrush" Value="#E5E7EB" />
        <Setter Property="Foreground" Value="#1F2937" />
        <Setter Property="Background" Value="White" />
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="10" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#E8EFFF" />
                <Setter Property="BorderBrush" Value="#1E5EFF" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ErpSuccessButton" TargetType="Button" BasedOn="{StaticResource ErpPrimaryButton}">
        <Setter Property="Background" Value="#22C55E" />
        <Setter Property="BorderBrush" Value="#22C55E" />
    </Style>

    <Style x:Key="ErpDangerButton" TargetType="Button" BasedOn="{StaticResource ErpPrimaryButton}">
        <Setter Property="Background" Value="#EF4444" />
        <Setter Property="BorderBrush" Value="#EF4444" />
    </Style>

    <Style x:Key="ErpIconButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Foreground" Value="#6B7280" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#1E5EFF" />
                <Setter Property="Background" Value="#E8EFFF" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ErpTopBarIconButton" TargetType="Button" BasedOn="{StaticResource ErpIconButton}">
        <Setter Property="Foreground" Value="#6B7280" />
    </Style>

    <Style x:Key="ERPPrimaryButton" TargetType="Button" BasedOn="{StaticResource ErpPrimaryButton}" />
    <Style x:Key="ERPSecondaryButton" TargetType="Button" BasedOn="{StaticResource ErpSecondaryButton}" />

</ResourceDictionary>
