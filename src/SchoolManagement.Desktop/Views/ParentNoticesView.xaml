<UserControl x:Class="SchoolManagement.Desktop.Views.ParentNoticesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:ui="clr-namespace:SchoolManagement.Desktop.UI">
    <Grid Background="{StaticResource ErpPageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Margin="24,18,24,12" Background="Transparent">
            <TabItem Header="Rédaction">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="340" Margin="0,0,12,0" Style="{StaticResource ErpCard}" Padding="16"
                            Visibility="{Binding IsLeftPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock FontSize="15" FontWeight="SemiBold" Text="1. Ciblage et impression" />
                                <ComboBox Margin="0,14,0,0" ItemsSource="{Binding AcademicYears}" SelectedItem="{Binding SelectedAcademicYear}"
                                          DisplayMemberPath="Label" Style="{StaticResource ErpComboBox}"
                                          materialDesign:HintAssist.Hint="Année scolaire" />
                                <ComboBox Margin="0,12,0,0" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}"
                                          DisplayMemberPath="Name" Style="{StaticResource ErpComboBox}"
                                          materialDesign:HintAssist.Hint="Section (facultatif)" />
                                <ComboBox Margin="0,12,0,0" ItemsSource="{Binding Classes}" SelectedItem="{Binding SelectedClass}"
                                          DisplayMemberPath="FullDisplayName" Style="{StaticResource ErpComboBox}"
                                          materialDesign:HintAssist.Hint="Classe (facultatif)" />
                                <ComboBox Margin="0,12,0,0" ItemsSource="{Binding FeeTypes}" SelectedItem="{Binding SelectedFeeType}"
                                          DisplayMemberPath="Name" Style="{StaticResource ErpComboBox}"
                                          materialDesign:HintAssist.Hint="Type de frais" />
                                <Button Margin="0,10,0,0" Command="{Binding ClearFiltersCommand}"
                                        Content="Toutes les sections et classes" Style="{StaticResource ErpSecondaryButton}" />

                                <DockPanel Margin="0,16,0,6">
                                    <TextBlock FontWeight="SemiBold" Text="Tranches concernées" />
                                    <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource ErpPrimaryBrush}"
                                               Text="{Binding InstallmentSelectionSummary}" />
                                </DockPanel>
                                <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                                    <Button Margin="0,0,6,0" Padding="8,3" Command="{Binding SelectAllInstallmentsCommand}"
                                            Content="Toutes" Style="{StaticResource ErpSecondaryButton}" />
                                    <Button Padding="8,3" Command="{Binding ClearInstallmentsCommand}"
                                            Content="Aucune" Style="{StaticResource ErpSecondaryButton}" />
                                </StackPanel>
                                <ListBox Height="105" ItemsSource="{Binding Installments}" BorderBrush="#CBD5E1"
                                         BorderThickness="1" Background="White" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Margin="8,5" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Content="{Binding InstallmentName}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <ComboBox Margin="0,12,0,0" ItemsSource="{Binding Layouts}" SelectedItem="{Binding SelectedLayout}"
                                          DisplayMemberPath="Label" Style="{StaticResource ErpComboBox}"
                                          materialDesign:HintAssist.Hint="Mise en page" />
                                <ComboBox Margin="0,12,0,0" ItemsSource="{Binding Orientations}" SelectedItem="{Binding SelectedOrientation}"
                                          DisplayMemberPath="Label" IsEnabled="{Binding IsPageOrientationEnabled}"
                                          Style="{StaticResource ErpComboBox}" materialDesign:HintAssist.Hint="Orientation de la page" />
                                <TextBlock Margin="2,12,0,0" TextWrapping="Wrap" Text="En-tête : selon la sélection Avis aux parents dans Établissement → En-têtes." />

                                <Separator Margin="0,16" />
                                <DockPanel>
                                    <TextBlock FontWeight="SemiBold" Text="Élèves destinataires" />
                                    <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource ErpPrimaryBrush}"
                                               Text="{Binding SelectionSummary}" />
                                </DockPanel>
                                <StackPanel Margin="0,8,0,8" Orientation="Horizontal">
                                    <Button Margin="0,0,6,0" Padding="8,3" Command="{Binding SelectAllCommand}"
                                            Content="Tous" Style="{StaticResource ErpSecondaryButton}" />
                                    <Button Padding="8,3" Command="{Binding ClearSelectionCommand}"
                                            Content="Aucun" Style="{StaticResource ErpSecondaryButton}" />
                                </StackPanel>
                                <DataGrid Height="265" AutoGenerateColumns="False" CanUserAddRows="False"
                                          HeadersVisibility="Column" ItemsSource="{Binding Recipients}"
                                          Style="{StaticResource ErpDataGrid}">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Width="38" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <DataGridTextColumn Width="*" Header="Élève" Binding="{Binding FullName}" />
                                        <DataGridTextColumn Width="100" Header="Classe" Binding="{Binding ClassName}" />
                                        <DataGridTextColumn Width="105" Header="Reste" Binding="{Binding BalanceDisplay}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource ErpCard}" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid x:Name="EditorHeader" SizeChanged="EditorHeader_SizeChanged">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="LeftPanelToggle" Margin="0,0,10,0" Padding="10,4"
                                        Command="{Binding ToggleLeftPanelCommand}" Content="{Binding LeftPanelToggleLabel}"
                                        Style="{StaticResource ErpSecondaryButton}" ToolTip="Afficher ou masquer le panneau de ciblage" />
                                <TextBlock x:Name="EditorSectionTitle" Grid.Column="1" VerticalAlignment="Center"
                                           FontSize="15" FontWeight="SemiBold" Text="2. Rédaction de l'avis" />

                                <StackPanel x:Name="InlineActionButtons" Grid.Column="3" Margin="16,0,0,0"
                                            Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Margin="0,0,8,0" Padding="10,4" Command="{Binding NewNoticeCommand}"
                                            Content="Nouvel avis" Style="{StaticResource ErpSecondaryButton}" />
                                    <Button Margin="0,0,8,0" Padding="10,4" Command="{Binding SaveDraftCommand}"
                                            Content="Enregistrer le brouillon" Style="{StaticResource ErpSecondaryButton}" />
                                    <Button Margin="0,0,8,0" Padding="10,4" Command="{Binding PreviewCommand}"
                                            Content="Aperçu d'un élève" Style="{StaticResource ErpSecondaryButton}" />
                                    <Button Padding="10,4" Command="{Binding GenerateCommand}"
                                            Content="Générer les avis" Style="{StaticResource ErpPrimaryButton}" />
                                </StackPanel>

                                <materialDesign:PopupBox x:Name="CompactActionsMenu" Grid.Column="3" Margin="16,0,0,0"
                                                         PlacementMode="BottomAndAlignRightEdges" PopupMode="Click"
                                                         StaysOpen="False" ToolTip="Actions disponibles"
                                                         Visibility="Collapsed">
                                    <materialDesign:PopupBox.ToggleContent>
                                        <Border Padding="12,6" Background="White" BorderBrush="{StaticResource ErpBorderBrush}"
                                                BorderThickness="1" CornerRadius="8" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Actions" />
                                                <materialDesign:PackIcon Width="16" Height="16" Margin="6,0,0,0"
                                                                         VerticalAlignment="Center" Kind="ChevronDown" />
                                            </StackPanel>
                                        </Border>
                                    </materialDesign:PopupBox.ToggleContent>
                                    <Border MinWidth="225" Padding="6" Background="{StaticResource ErpCardBackgroundBrush}"
                                            BorderBrush="{StaticResource ErpBorderBrush}" BorderThickness="1"
                                            CornerRadius="10" Effect="{StaticResource ErpCardShadow}">
                                        <StackPanel>
                                            <Button Height="38" Padding="12,0" HorizontalContentAlignment="Left"
                                                    Command="{Binding NewNoticeCommand}" Content="Nouvel avis"
                                                    Style="{StaticResource MaterialDesignFlatButton}" />
                                            <Button Height="38" Padding="12,0" HorizontalContentAlignment="Left"
                                                    Command="{Binding SaveDraftCommand}" Content="Enregistrer le brouillon"
                                                    Style="{StaticResource MaterialDesignFlatButton}" />
                                            <Button Height="38" Padding="12,0" HorizontalContentAlignment="Left"
                                                    Command="{Binding PreviewCommand}" Content="Aperçu d'un élève"
                                                    Style="{StaticResource MaterialDesignFlatButton}" />
                                            <Separator Margin="8,4" Background="{StaticResource ErpBorderBrush}" />
                                            <Button Height="38" Padding="12,0" HorizontalContentAlignment="Left"
                                                    Command="{Binding GenerateCommand}" Content="Générer les avis"
                                                    Foreground="{StaticResource ErpPrimaryBrush}"
                                                    Style="{StaticResource MaterialDesignFlatButton}" />
                                        </StackPanel>
                                    </Border>
                                </materialDesign:PopupBox>

                                <Button x:Name="RightPanelToggle" Grid.Column="4" Margin="10,0,0,0" Padding="10,4"
                                        Command="{Binding ToggleRightPanelCommand}" Content="{Binding RightPanelToggleLabel}"
                                        Style="{StaticResource ErpSecondaryButton}" ToolTip="Afficher ou masquer les champs automatiques" />
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource ErpTextBox}" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Titre interne" />
                                <TextBox Grid.Column="2" Style="{StaticResource ErpTextBox}" Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Objet affiché dans l'avis" />
                            </Grid>
                            <WrapPanel Grid.Row="2" Margin="0,12,0,6" Background="#F8FAFC" VerticalAlignment="Center">
                                <Button Command="ApplicationCommands.Cut" CommandTarget="{Binding ElementName=Editor}" ToolTip="Couper">✂</Button>
                                <Button Command="ApplicationCommands.Copy" CommandTarget="{Binding ElementName=Editor}" ToolTip="Copier">⧉</Button>
                                <Button Command="ApplicationCommands.Paste" CommandTarget="{Binding ElementName=Editor}" ToolTip="Coller">▣</Button>
                                <Separator Width="8" />
                                <Button Command="EditingCommands.ToggleBold" CommandTarget="{Binding ElementName=Editor}" FontWeight="Bold" ToolTip="Gras">G</Button>
                                <Button Command="EditingCommands.ToggleItalic" CommandTarget="{Binding ElementName=Editor}" FontStyle="Italic" ToolTip="Italique">I</Button>
                                <Button Command="EditingCommands.ToggleUnderline" CommandTarget="{Binding ElementName=Editor}" ToolTip="Souligné">S̲</Button>
                                <Separator Width="8" />
                                <Button Click="AlignLeft_Click" ToolTip="Aligner à gauche">☰</Button>
                                <Button Click="AlignCenter_Click" ToolTip="Centrer">≡</Button>
                                <Button Click="AlignRight_Click" ToolTip="Aligner à droite">☷</Button>
                                <Separator Width="8" />
                                <ComboBox Width="155" Margin="4,2" SelectedIndex="0" SelectionChanged="FontFamily_SelectionChanged"
                                          Style="{StaticResource ErpComboBox}" materialDesign:HintAssist.Hint="Police">
                                    <ComboBoxItem Content="Times New Roman" />
                                    <ComboBoxItem Content="Arial" />
                                    <ComboBoxItem Content="Calibri" />
                                    <ComboBoxItem Content="Segoe UI" />
                                    <ComboBoxItem Content="Georgia" />
                                    <ComboBoxItem Content="Verdana" />
                                    <ComboBoxItem Content="Courier New" />
                                </ComboBox>
                                <ComboBox Width="82" Margin="4,2" SelectionChanged="FontSize_SelectionChanged" SelectedIndex="2"
                                          Style="{StaticResource ErpComboBox}" materialDesign:HintAssist.Hint="Taille">
                                    <ComboBoxItem Content="10" /><ComboBoxItem Content="11" /><ComboBoxItem Content="12" />
                                    <ComboBoxItem Content="14" /><ComboBoxItem Content="16" /><ComboBoxItem Content="18" /><ComboBoxItem Content="24" />
                                </ComboBox>
                                <ComboBox Width="118" Margin="4,2" SelectedIndex="0" SelectionChanged="FontColor_SelectionChanged"
                                          Style="{StaticResource ErpComboBox}" materialDesign:HintAssist.Hint="Couleur">
                                    <ComboBoxItem Content="Noir" Tag="#111827" />
                                    <ComboBoxItem Content="Bleu" Tag="#0F3163" />
                                    <ComboBoxItem Content="Rouge" Tag="#B91C1C" />
                                    <ComboBoxItem Content="Vert" Tag="#047857" />
                                    <ComboBoxItem Content="Gris" Tag="#475569" />
                                    <ComboBoxItem Content="Orange" Tag="#C2410C" />
                                </ComboBox>
                                <TextBlock Margin="12,0,6,0" VerticalAlignment="Center" FontWeight="SemiBold"
                                           Foreground="{StaticResource ErpPrimaryBrush}" Text="{Binding EditorPageLabel}" />
                            </WrapPanel>
                            <Border Grid.Row="3" BorderBrush="#CBD5E1" BorderThickness="1" Background="#E2E8F0"
                                    Padding="14" CornerRadius="4" ClipToBounds="True">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <Border Width="{Binding EditorPageWidth}" Height="{Binding EditorPageHeight}"
                                            HorizontalAlignment="Center" VerticalAlignment="Top"
                                            Background="White" BorderBrush="#94A3B8" BorderThickness="1">
                                        <RichTextBox x:Name="Editor" AcceptsTab="True" BorderThickness="0"
                                                     VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden"
                                                     Padding="{Binding EditorPagePadding}" SpellCheck.IsEnabled="True"
                                                     FontFamily="Times New Roman" FontSize="12"
                                                     ui:RichTextBoxRtf.Content="{Binding ContentRtfBase64, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Border>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Width="245" Margin="12,0,0,0" Style="{StaticResource ErpCard}" Padding="16"
                            Visibility="{Binding IsRightPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="3. Champs automatiques" />
                            <TextBlock Grid.Row="1" Margin="0,6,0,10" TextWrapping="Wrap" Style="{StaticResource ErpBodySecondary}"
                                       Text="Placez le curseur dans le texte puis cliquez sur un champ." />
                            <ListBox Grid.Row="2" ItemsSource="{Binding Fields}" BorderThickness="0" Background="Transparent"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate><TextBlock Margin="0,10,0,4" FontWeight="Bold" Text="{Binding Name}" /></DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="205" Margin="0,2" Padding="8,5" HorizontalContentAlignment="Left"
                                                Click="InsertField_Click" Content="{Binding Label}" ToolTip="{Binding Token}"
                                                Style="{StaticResource ErpSecondaryButton}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Historique et modèles">
                <Border Margin="0,12,0,0" Style="{StaticResource ErpCard}" Padding="16">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12" Orientation="Horizontal">
                            <Button Margin="0,0,8,0" Command="{Binding PreviewArchivedCommand}" Content="Aperçu archivé"
                                    Style="{StaticResource ErpSecondaryButton}" />
                            <Button Margin="0,0,8,0" Command="{Binding OpenSelectedCommand}" Content="Ouvrir / Dupliquer"
                                    Style="{StaticResource ErpSecondaryButton}" />
                            <Button Command="{Binding DeleteSelectedCommand}" Content="Supprimer"
                                    Style="{StaticResource ErpDangerButton}" />
                        </StackPanel>
                        <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" ItemsSource="{Binding Notices}"
                                  SelectedItem="{Binding SelectedNotice}" Style="{StaticResource ErpDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Titre" Binding="{Binding Title}" Width="*" />
                                <DataGridTextColumn Header="Année" Binding="{Binding AcademicYearLabel}" Width="130" />
                                <DataGridTextColumn Header="Type de frais" Binding="{Binding FeeTypeName}" Width="180" />
                                <DataGridTextColumn Header="Cible" Binding="{Binding TargetDescription}" Width="220" />
                                <DataGridTextColumn Header="Élèves" Binding="{Binding RecipientCount}" Width="80" />
                                <DataGridTextColumn Header="Format" Binding="{Binding PageLayout}" Width="110" />
                                <DataGridTextColumn Header="État" Binding="{Binding Status}" Width="100" />
                                <DataGridTextColumn Header="Créé le" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="150" />
                                <DataGridTextColumn Header="Généré le" Binding="{Binding GeneratedAtUtc, StringFormat=dd/MM/yyyy HH:mm}" Width="150" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1" Margin="24,0,24,18" Padding="12,8" Background="#EFF6FF" CornerRadius="8">
            <DockPanel>
                <ProgressBar Width="120" Height="5" Margin="0,0,12,0" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock VerticalAlignment="Center" Foreground="#1E40AF" Text="{Binding StatusMessage}" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
