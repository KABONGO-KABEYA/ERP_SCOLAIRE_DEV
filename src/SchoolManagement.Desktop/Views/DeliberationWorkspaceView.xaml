<UserControl x:Class="SchoolManagement.Desktop.Views.DeliberationWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <Style x:Key="DelibColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#0B1F47" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="BorderBrush" Value="#1E3A5F" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DelibCenteredText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="Padding" Value="6,0" />
        </Style>
        <Style x:Key="DelibLeftText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="None" />
        </Style>
        <Style x:Key="DelibAverageCell" TargetType="DataGridCell">
            <Setter Property="Background" Value="#ECFDF5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="#ECFDF5" Padding="4,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,16,20,16" Style="{StaticResource ErpFadeIn}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar filtres (style Résultats par classe) -->
        <Border Grid.Row="0"
                Margin="0,0,0,10"
                Padding="12,10"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="12">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Margin="0,0,6,0" Height="30" Padding="10,0"
                            Command="{Binding OpenHistoryCommand}"
                            Style="{StaticResource ErpSecondaryButton}"
                            Content="Historique" />
                    <Button Height="30" Padding="10,0"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource ErpSecondaryButton}"
                            Content="Actualiser" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox Width="220" Height="30" Margin="0,0,8,0"
                              ItemsSource="{Binding ClassRooms}"
                              SelectedItem="{Binding SelectedClassRoom}"
                              DisplayMemberPath="Name"
                              materialDesign:HintAssist.Hint="Classe" />
                    <ComboBox Width="200" Height="30" Margin="0,0,12,0"
                              ItemsSource="{Binding PeriodOptions}"
                              SelectedItem="{Binding SelectedPeriod}"
                              DisplayMemberPath="Name"
                              materialDesign:HintAssist.Hint="Sous-période" />

                    <Border Background="#0B1F47" CornerRadius="8" Padding="10,4" Margin="0,0,8,0"
                            VerticalAlignment="Center">
                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="White"
                                   VerticalAlignment="Center">
                            <Run Text="{Binding ClassDisplayName, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run Text="{Binding PeriodLabel, Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                    <Border Background="#ECFDF5" CornerRadius="8" Padding="10,4" Margin="0,0,8,0"
                            VerticalAlignment="Center" BorderBrush="#A7F3D0" BorderThickness="1">
                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#065F46"
                                   Text="{Binding ValidationStatusLabel}" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock FontSize="11" Foreground="#64748B" VerticalAlignment="Center"
                               Text="{Binding ModeBannerText}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Grille style Résultats par classe -->
        <Border Grid.Row="1"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="12"
                Background="White"
                ClipToBounds="True">
            <Grid>
                <DataGrid x:Name="ResultsGrid"
                          ItemsSource="{Binding Session.Rows}"
                          SelectedItem="{Binding Session.SelectedRow}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          CanUserResizeColumns="True"
                          HeadersVisibility="Column"
                          SelectionUnit="FullRow"
                          RowHeight="34"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F1F5F9"
                          VerticalGridLinesBrush="#F1F5F9"
                          AlternatingRowBackground="#F8FAFC"
                          Background="Transparent"
                          ColumnHeaderStyle="{StaticResource DelibColumnHeader}"
                          ColumnHeaderHeight="44"
                          EnableRowVirtualization="False"
                          EnableColumnVirtualization="False"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          Loaded="ResultsGrid_OnLoaded"
                          MouseDoubleClick="ResultsGrid_OnMouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Rang"
                                            Binding="{Binding RankDisplay}"
                                            Width="SizeToCells"
                                            MinWidth="48"
                                            IsReadOnly="True"
                                            ElementStyle="{StaticResource DelibCenteredText}" />
                        <DataGridTextColumn Header="Matricule"
                                            Binding="{Binding RegistrationNumber}"
                                            Width="SizeToCells"
                                            MinWidth="88"
                                            IsReadOnly="True"
                                            ElementStyle="{StaticResource DelibCenteredText}" />
                        <DataGridTextColumn Header="Nom de l'élève"
                                            Binding="{Binding FullName}"
                                            Width="SizeToCells"
                                            MinWidth="140"
                                            IsReadOnly="True"
                                            ElementStyle="{StaticResource DelibLeftText}">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DelibColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Moyenne"
                                            Binding="{Binding AverageDisplay}"
                                            Width="SizeToHeader"
                                            MinWidth="72"
                                            IsReadOnly="True"
                                            CellStyle="{StaticResource DelibAverageCell}"
                                            ElementStyle="{StaticResource DelibCenteredText}">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DelibColumnHeader}">
                                    <Setter Property="Background" Value="#164E63" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="%"
                                            Binding="{Binding PercentageDisplay}"
                                            Width="SizeToCells"
                                            MinWidth="56"
                                            IsReadOnly="True"
                                            ElementStyle="{StaticResource DelibCenteredText}" />
                        <DataGridTextColumn Header="Mention"
                                            Binding="{Binding Mention}"
                                            Width="SizeToCells"
                                            MinWidth="100"
                                            IsReadOnly="True"
                                            ElementStyle="{StaticResource DelibCenteredText}" />

                        <DataGridTemplateColumn x:Name="ConductColumn" Header="Conduite" Width="SizeToHeader" MinWidth="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.Session.ConductOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              SelectedItem="{Binding SelectedConduct, UpdateSourceTrigger=PropertyChanged}"
                                              DisplayMemberPath="Label"
                                              IsEnabled="{Binding DataContext.Session.CanSetConduct, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              MinWidth="120"
                                              Height="28" Margin="2" FontSize="12"
                                              HorizontalContentAlignment="Left" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn x:Name="DecisionColumn" Header="Décision" Width="SizeToHeader" MinWidth="130"
                                                Visibility="{Binding DataContext.ShowDecisionColumn, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.Session.AvailableDecisions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              SelectedItem="{Binding SelectedDecision, UpdateSourceTrigger=PropertyChanged}"
                                              DisplayMemberPath="Label"
                                              IsEnabled="{Binding DataContext.Session.CanSetFinalDecision, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              MinWidth="120"
                                              Height="28" Margin="2" FontSize="12"
                                              HorizontalContentAlignment="Left" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Observation"
                                            Binding="{Binding Observation, UpdateSourceTrigger=LostFocus}"
                                            Width="*"
                                            MinWidth="140"
                                            ElementStyle="{StaticResource DelibLeftText}">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DelibColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Background="White"
                        Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Opacity="0.85">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ProgressBar Width="160" Height="4" IsIndeterminate="True" />
                        <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="#64748B"
                                   Text="Chargement de la délibération…" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- KPI + actions élève -->
        <Border Grid.Row="2"
                Margin="0,8,0,0"
                Padding="10,8"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="12">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Ajouter des points" Height="30" Margin="0,0,0,0" Padding="12,0"
                            Command="{Binding OpenBonusForSelectedCommand}"
                            Visibility="{Binding Session.CanAddBonusPoints, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Style="{StaticResource ErpSecondaryButton}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#EEF2FF" CornerRadius="8" Padding="10,5" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Moyenne classe" FontSize="11" Foreground="#6366F1" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock FontSize="12" FontWeight="Bold" Foreground="#312E81"
                                       Text="{Binding Session.SummaryClassAverage}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Background="#ECFDF5" CornerRadius="8" Padding="10,5" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Réussite" FontSize="11" Foreground="#059669" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock FontSize="12" FontWeight="Bold" Foreground="#065F46"
                                       Text="{Binding Session.SummarySuccessRate}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Background="#F8FAFC" CornerRadius="8" Padding="10,5" Margin="0,0,8,0"
                            BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Élèves" FontSize="11" Foreground="#64748B" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock FontSize="12" FontWeight="Bold" Foreground="#0F172A"
                                       Text="{Binding Session.SummaryStudentCount}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Background="#FFF7ED" CornerRadius="8" Padding="10,5" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Admis" FontSize="11" Foreground="#EA580C" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock FontSize="12" FontWeight="Bold" Foreground="#9A3412"
                                       Text="{Binding Session.SummaryAdmitted}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Background="#FEF2F2" CornerRadius="8" Padding="10,5" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Ajournés" FontSize="11" Foreground="#DC2626" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock FontSize="12" FontWeight="Bold" Foreground="#991B1B"
                                       Text="{Binding Session.SummaryDeferred}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Pied : observations + validation -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                CornerRadius="12" Padding="14,12" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="Observations générales du conseil" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Session.PvGeneralObservations, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" MaxHeight="88"
                             VerticalScrollBarVisibility="Auto" />
                    <TextBlock Margin="0,8,0,0" Foreground="#64748B" FontSize="12"
                               Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Désactiver la validation" Height="36" MinWidth="170" Margin="0,0,8,0"
                            Command="{Binding CancelClassValidationCommand}"
                            IsEnabled="{Binding CanCancelValidation}"
                            Style="{StaticResource MaterialDesignOutlinedButton}" />
                    <Button Content="Valider la classe" Height="36" MinWidth="150"
                            Command="{Binding ValidateClassCommand}"
                            IsEnabled="{Binding CanValidateClass}"
                            Style="{StaticResource ErpPrimaryButton}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
