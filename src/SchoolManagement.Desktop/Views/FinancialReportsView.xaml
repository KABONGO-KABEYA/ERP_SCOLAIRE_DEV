<UserControl x:Class="SchoolManagement.Desktop.Views.FinancialReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:erp="clr-namespace:SchoolManagement.Desktop.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:ui="clr-namespace:SchoolManagement.Desktop.UI">
    <UserControl.Resources>
        <ui:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <Style x:Key="AllocationAmountCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="AllocationAmountHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="Padding" Value="0,0,12,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="0" Style="{StaticResource ErpFadeIn}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="280" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Filtres (même pattern qu'Encaissements) -->
        <Border Grid.Row="0"
                Margin="0,0,0,8"
                Padding="12,10"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="10">
            <StackPanel>
                <DockPanel LastChildFill="True">
                    <Button Width="32"
                            Height="32"
                            Padding="0"
                            HorizontalAlignment="Right"
                            Command="{Binding ToggleFiltersCommand}"
                            DockPanel.Dock="Right"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="{Binding FiltersToggleLabel}"
                            ToolTipService.InitialShowDelay="200">
                        <Grid Width="18" Height="18">
                            <materialDesign:PackIcon Kind="ChevronDown"
                                                     Width="18"
                                                     Height="18"
                                                     Visibility="{Binding IsFiltersExpanded, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                            <materialDesign:PackIcon Kind="ChevronUp"
                                                     Width="18"
                                                     Height="18"
                                                     Visibility="{Binding IsFiltersExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </Button>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"
                               Text="{Binding FiltersHeaderText}" />
                </DockPanel>

                <StackPanel Margin="0,10,0,0"
                            Visibility="{Binding IsFiltersExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <WrapPanel Margin="0,0,0,4">
                        <erp:ErpComboField Margin="0,0,10,10"
                                           DisplayMemberPath="Label"
                                           FieldWidth="160"
                                           HorizontalAlignment="Left"
                                           IconKind="CalendarClock"
                                           ItemsSource="{Binding PeriodOptions}"
                                           Label="Période"
                                           MaxDropDownHeight="140"
                                           SelectedItem="{Binding SelectedPeriod, Mode=TwoWay}" />
                        <erp:ErpComboField Margin="0,0,10,10"
                                           DisplayMemberPath="Label"
                                           FieldWidth="140"
                                           HorizontalAlignment="Left"
                                           IconKind="CalendarMonth"
                                           ItemsSource="{Binding MonthOptions}"
                                           Label="Mois"
                                           MaxDropDownHeight="180"
                                           SelectedItem="{Binding SelectedMonth, Mode=TwoWay}"
                                           Visibility="{Binding IsMonthPeriod, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <erp:ErpComboField Margin="0,0,10,10"
                                           DisplayMemberPath="Label"
                                           FieldWidth="100"
                                           HorizontalAlignment="Left"
                                           IconKind="Numeric"
                                           ItemsSource="{Binding CalendarYears}"
                                           Label="Année"
                                           MaxDropDownHeight="140"
                                           SelectedItem="{Binding SelectedCalendarYear, Mode=TwoWay}"
                                           Visibility="{Binding IsMonthPeriod, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <erp:ErpComboField Margin="0,0,10,10"
                                           DisplayMemberPath="Name"
                                           FieldWidth="160"
                                           HorizontalAlignment="Left"
                                           IconKind="School"
                                           ItemsSource="{Binding Sections}"
                                           Label="Section"
                                           MaxDropDownHeight="140"
                                           SelectedItem="{Binding FilterSection, Mode=TwoWay}" />
                        <erp:ErpComboField Margin="0,0,10,10"
                                           DisplayMemberPath="DisplayName"
                                           FieldWidth="200"
                                           HorizontalAlignment="Left"
                                           IconKind="GoogleClassroom"
                                           ItemsSource="{Binding ClassRooms}"
                                           Label="Classe"
                                           MaxDropDownHeight="180"
                                           SelectedItem="{Binding FilterClassRoom, Mode=TwoWay}" />
                        <erp:ErpComboField Margin="0,0,10,10"
                                           DisplayMemberPath="Name"
                                           FieldWidth="170"
                                           HorizontalAlignment="Left"
                                           IconKind="CashMultiple"
                                           IsRequired="True"
                                           ItemsSource="{Binding FeeTypes}"
                                           Label="Type de frais"
                                           MaxDropDownHeight="140"
                                           SelectedItem="{Binding FilterFeeType, Mode=TwoWay}" />
                        <erp:ErpDateField Margin="0,0,10,10"
                                          DateValidationMode="None"
                                          FieldWidth="150"
                                          HorizontalAlignment="Left"
                                          IsEnabled="{Binding IsCustomPeriod}"
                                          Label="Du"
                                          SelectedDate="{Binding FilterFromDate, Mode=TwoWay}"
                                          ShowBadges="False"
                                          ShowValidation="False" />
                        <erp:ErpDateField Margin="0,0,10,10"
                                          DateValidationMode="None"
                                          FieldWidth="150"
                                          HorizontalAlignment="Left"
                                          IsEnabled="{Binding IsCustomPeriod}"
                                          Label="Au"
                                          SelectedDate="{Binding FilterToDate, Mode=TwoWay}"
                                          ShowBadges="False"
                                          ShowValidation="False" />
                    </WrapPanel>

                    <TextBlock Margin="0,0,0,4"
                               FontSize="12"
                               Foreground="{StaticResource ErpDangerBrush}"
                               Text="{Binding FromDateError}"
                               TextWrapping="Wrap"
                               Visibility="{Binding FromDateError, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" />
                    <TextBlock Margin="0,0,0,8"
                               FontSize="12"
                               Foreground="{StaticResource ErpDangerBrush}"
                               Text="{Binding ToDateError}"
                               TextWrapping="Wrap"
                               Visibility="{Binding ToDateError, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" />

                    <StackPanel Orientation="Horizontal">
                        <Button Padding="14,6"
                                Command="{Binding SearchCommand}"
                                Content="Afficher"
                                Style="{StaticResource ErpPrimaryButton}" />
                        <Button Margin="8,0,0,0"
                                Padding="14,6"
                                Command="{Binding ClearFiltersCommand}"
                                Content="Réinitialiser"
                                Style="{StaticResource ErpSecondaryButton}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Barre d'actions -->
        <Border Grid.Row="1"
                Margin="0,0,0,8"
                Padding="10,8"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Padding="14,6"
                            Command="{Binding ExportExcelCommand}"
                            Content="Excel"
                            Style="{StaticResource ErpSecondaryButton}" />
                    <Button Margin="8,0,0,0"
                            Padding="14,6"
                            Command="{Binding ExportPdfCommand}"
                            Content="PDF"
                            Style="{StaticResource ErpSecondaryButton}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"
                               Text="{Binding PeriodLabel}" />
                    <TextBlock Margin="16,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               MaxWidth="520"
                               Style="{StaticResource ErpBodySecondary}"
                               Text="{Binding StatusMessage}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Cartes synthèse -->
        <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,8">
            <Border Margin="0,0,8,0"
                    Padding="14,12"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel Orientation="Horizontal">
                    <Border Width="40"
                            Height="40"
                            Margin="0,0,12,0"
                            Background="#ECFDF5"
                            CornerRadius="10">
                        <materialDesign:PackIcon Width="22"
                                                 Height="22"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Foreground="{StaticResource ErpSuccessBrush}"
                                                 Kind="CashCheck" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="12" Foreground="#6B7280" Text="Total période" />
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding GrandTotal, StringFormat=N2}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Margin="0,0,8,0"
                    Padding="14,12"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel Orientation="Horizontal">
                    <Border Width="40"
                            Height="40"
                            Margin="0,0,12,0"
                            Background="#E8EFFF"
                            CornerRadius="10">
                        <materialDesign:PackIcon Width="22"
                                                 Height="22"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Foreground="{StaticResource ErpPrimaryBrush}"
                                                 Kind="ReceiptText" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="12" Foreground="#6B7280" Text="Nombre de paiements" />
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding PaymentCount}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Padding="14,12"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock FontSize="12" Foreground="#6B7280" Text="Par devise" />
                    <ItemsControl ItemsSource="{Binding ByCurrency}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,2,0,0" FontSize="13" FontWeight="SemiBold">
                                    <Run Text="{Binding Currency, Mode=OneWay}" />
                                    <Run Text=" : " />
                                    <Run Text="{Binding TotalAmount, StringFormat=N2, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Onglets d'affichage -->
        <Border Grid.Row="3"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="12"
                Padding="8,4,8,8">
            <TabControl Style="{StaticResource ErpTabControl}">
                <TabItem Header="Détail" Style="{StaticResource ErpTabItem}">
                    <DataGrid Margin="0,8,0,0"
                              AutoGenerateColumns="True"
                              BorderThickness="0"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              ItemsSource="{Binding PivotView}"
                              Style="{StaticResource ErpDataGrid}" />
                </TabItem>

                <TabItem Header="Journalier" Style="{StaticResource ErpTabItem}">
                    <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                        <Border Background="White"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="10"
                                ClipToBounds="True">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding DailyPivotGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <!-- Rupture date -->
                                                <Border Padding="12,8"
                                                        Background="#EEF2FF"
                                                        BorderBrush="#E5E7EB"
                                                        BorderThickness="0,0,0,1">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Margin="0,0,8,0"
                                                                                 VerticalAlignment="Center"
                                                                                 Foreground="{StaticResource ErpPrimaryBrush}"
                                                                                 Kind="Calendar" />
                                                        <TextBlock VerticalAlignment="Center"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#1F2937"
                                                                   Text="{Binding DateLabel}" />
                                                    </StackPanel>
                                                </Border>

                                                <DataGrid AutoGenerateColumns="True"
                                                          BorderThickness="0"
                                                          CanUserAddRows="False"
                                                          CanUserDeleteRows="False"
                                                          CanUserResizeColumns="False"
                                                          ColumnWidth="*"
                                                          GridLinesVisibility="Horizontal"
                                                          HeadersVisibility="Column"
                                                          IsReadOnly="True"
                                                          ItemsSource="{Binding Rows}"
                                                          RowHeaderWidth="0"
                                                          Style="{StaticResource ErpDataGrid}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Background="#EEF2FF"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="0,1,0,0"
                                        Padding="12,10">
                                    <DockPanel LastChildFill="False">
                                        <TextBlock VerticalAlignment="Center"
                                                   FontWeight="Bold"
                                                   Foreground="#1E3A8A"
                                                   Text="Total général" />
                                        <TextBlock Margin="16,0,0,0"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   DockPanel.Dock="Right"
                                                   FontWeight="Bold"
                                                   Foreground="#1E3A8A"
                                                   Text="{Binding GrandTotal, StringFormat=N2}" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Par classe" Style="{StaticResource ErpTabItem}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Margin="0,0,0,8"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2937"
                                       Text="Total période par classe" />

                            <Border Margin="0,0,0,20"
                                    Background="White"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    ClipToBounds="True">
                                <StackPanel>
                                    <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                                        <Grid Height="40">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" MinWidth="180" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="80" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Margin="12,0,8,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#374151" Text="Code" />
                                            <TextBlock Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#374151" Text="Classe" />
                                            <TextBlock Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#374151" Text="Section" />
                                            <TextBlock Grid.Column="3" Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#374151" Text="Montant" />
                                            <TextBlock Grid.Column="4" Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#374151" Text="Nb" />
                                        </Grid>
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding ByClass}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1">
                                                    <Grid Height="36" Background="White">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="*" MinWidth="180" />
                                                            <ColumnDefinition Width="140" />
                                                            <ColumnDefinition Width="140" />
                                                            <ColumnDefinition Width="80" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Margin="12,0,8,0" VerticalAlignment="Center" Text="{Binding ClassCode}" />
                                                        <TextBlock Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center" Text="{Binding ClassName}" />
                                                        <TextBlock Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Center" Text="{Binding SectionName}" />
                                                        <TextBlock Grid.Column="3" Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding TotalAmount, StringFormat=N2}" />
                                                        <TextBlock Grid.Column="4" Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding PaymentCount}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border Background="#EEF2FF" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
                                        <Grid Height="40">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" MinWidth="180" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="80" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Margin="12,0,8,0" VerticalAlignment="Center" FontWeight="Bold" Foreground="#1E3A8A" Text="Total" />
                                            <TextBlock Grid.Column="3" Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" Foreground="#1E3A8A" Text="{Binding ByClassTotal, StringFormat=N2}" />
                                            <TextBlock Grid.Column="4" Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" Foreground="#1E3A8A" Text="{Binding ByClassPaymentCount}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <TextBlock Margin="0,0,0,8"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2937"
                                       Text="Recette journalière par classe" />

                            <Border Background="White"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    ClipToBounds="True">
                                <StackPanel>
                                    <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                                        <Grid Height="40">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="240" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="80" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Margin="12,0,8,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#374151" Text="Classe" />
                                            <TextBlock Grid.Column="1" Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#374151" Text="Montant" />
                                            <TextBlock Grid.Column="2" Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#374151" Text="Nb" />
                                        </Grid>
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding DailyByClassGroups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <Border Padding="12,8" Background="#EEF2FF" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                                                        <DockPanel LastChildFill="True">
                                                            <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#1E3A8A" Text="{Binding DayTotal, StringFormat=N2}" />
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource ErpPrimaryBrush}" Kind="Calendar" />
                                                                <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#1F2937" Text="{Binding DateLabel}" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                    <ItemsControl ItemsSource="{Binding Rows}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1">
                                                                    <Grid Height="36" Background="White">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" MinWidth="240" />
                                                                            <ColumnDefinition Width="140" />
                                                                            <ColumnDefinition Width="80" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Margin="12,0,8,0" VerticalAlignment="Center" Text="{Binding ClassName}" />
                                                                        <TextBlock Grid.Column="1" Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding TotalAmount, StringFormat=N2}" />
                                                                        <TextBlock Grid.Column="2" Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding PaymentCount}" />
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Par section" Style="{StaticResource ErpTabItem}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Margin="0,0,0,8"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2937"
                                       Text="Total période par section" />

                            <Border Margin="0,0,0,20"
                                    Background="White"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    ClipToBounds="True">
                                <StackPanel>
                                    <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                                        <Grid Height="40">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" MinWidth="240" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="80" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Margin="12,0,8,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#374151" Text="Code" />
                                            <TextBlock Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#374151" Text="Section" />
                                            <TextBlock Grid.Column="2" Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#374151" Text="Montant" />
                                            <TextBlock Grid.Column="3" Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#374151" Text="Nb" />
                                        </Grid>
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding BySection}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1">
                                                    <Grid Height="36" Background="White">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="*" MinWidth="240" />
                                                            <ColumnDefinition Width="140" />
                                                            <ColumnDefinition Width="80" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Margin="12,0,8,0" VerticalAlignment="Center" Text="{Binding SectionCode}" />
                                                        <TextBlock Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center" Text="{Binding SectionName}" />
                                                        <TextBlock Grid.Column="2" Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding TotalAmount, StringFormat=N2}" />
                                                        <TextBlock Grid.Column="3" Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding PaymentCount}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border Background="#EEF2FF" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
                                        <Grid Height="40">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" MinWidth="240" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="80" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Margin="12,0,8,0" VerticalAlignment="Center" FontWeight="Bold" Foreground="#1E3A8A" Text="Total" />
                                            <TextBlock Grid.Column="2" Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" Foreground="#1E3A8A" Text="{Binding BySectionTotal, StringFormat=N2}" />
                                            <TextBlock Grid.Column="3" Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" Foreground="#1E3A8A" Text="{Binding BySectionPaymentCount}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <TextBlock Margin="0,0,0,8"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2937"
                                       Text="Recette journalière par section" />

                            <Border Background="White"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    ClipToBounds="True">
                                <StackPanel>
