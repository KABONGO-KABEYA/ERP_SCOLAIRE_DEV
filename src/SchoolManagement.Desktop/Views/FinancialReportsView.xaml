<UserControl x:Class="SchoolManagement.Desktop.Views.FinancialReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:erp="clr-namespace:SchoolManagement.Desktop.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:ui="clr-namespace:SchoolManagement.Desktop.UI">
    <UserControl.Resources>
        <ui:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="0" Style="{StaticResource ErpFadeIn}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="280" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Filtres (même pattern qu'Encaissements) -->
        <Border Grid.Row="0"
                Margin="0,0,0,8"
                Padding="12,10"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="10">
            <StackPanel>
                <DockPanel LastChildFill="True">
                    <Button Width="32"
                            Height="32"
                            Padding="0"
                            HorizontalAlignment="Right"
                            Command="{Binding ToggleFiltersCommand}"
                            DockPanel.Dock="Right"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="{Binding FiltersToggleLabel}"
                            ToolTipService.InitialShowDelay="200">
                        <Grid Width="18" Height="18">
                            <materialDesign:PackIcon Kind="ChevronDown"
                                                     Width="18"
                                                     Height="18"
                                                     Visibility="{Binding IsFiltersExpanded, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                            <materialDesign:PackIcon Kind="ChevronUp"
                                                     Width="18"
                                                     Height="18"
                                                     Visibility="{Binding IsFiltersExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </Button>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"
                               Text="{Binding FiltersHeaderText}" />
                </DockPanel>

                <StackPanel Margin="0,10,0,0"
                            Visibility="{Binding IsFiltersExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <WrapPanel Margin="0,0,0,4">
                        <erp:ErpComboField Margin="0,0,10,10"
                                           DisplayMemberPath="Label"
                                           FieldWidth="160"
                                           HorizontalAlignment="Left"
                                           IconKind="CalendarClock"
                                           ItemsSource="{Binding PeriodOptions}"
                                           Label="Période"
                                           MaxDropDownHeight="140"
                                           SelectedItem="{Binding SelectedPeriod, Mode=TwoWay}" />
                        <erp:ErpComboField Margin="0,0,10,10"
                                           DisplayMemberPath="Label"
                                           FieldWidth="140"
                                           HorizontalAlignment="Left"
                                           IconKind="CalendarMonth"
                                           ItemsSource="{Binding MonthOptions}"
                                           Label="Mois"
                                           MaxDropDownHeight="180"
                                           SelectedItem="{Binding SelectedMonth, Mode=TwoWay}"
                                           Visibility="{Binding IsMonthPeriod, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <erp:ErpComboField Margin="0,0,10,10"
                                           DisplayMemberPath="Label"
                                           FieldWidth="100"
                                           HorizontalAlignment="Left"
                                           IconKind="Numeric"
                                           ItemsSource="{Binding CalendarYears}"
                                           Label="Année"
                                           MaxDropDownHeight="140"
                                           SelectedItem="{Binding SelectedCalendarYear, Mode=TwoWay}"
                                           Visibility="{Binding IsMonthPeriod, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <erp:ErpComboField Margin="0,0,10,10"
                                           DisplayMemberPath="Label"
                                           FieldWidth="160"
                                           HorizontalAlignment="Left"
                                           IconKind="CalendarRange"
                                           ItemsSource="{Binding AcademicYears}"
                                           Label="Année scolaire"
                                           MaxDropDownHeight="140"
                                           SelectedItem="{Binding FilterYear, Mode=TwoWay}" />
                        <erp:ErpComboField Margin="0,0,10,10"
                                           DisplayMemberPath="Name"
                                           FieldWidth="160"
                                           HorizontalAlignment="Left"
                                           IconKind="School"
                                           ItemsSource="{Binding Sections}"
                                           Label="Section"
                                           MaxDropDownHeight="140"
                                           SelectedItem="{Binding FilterSection, Mode=TwoWay}" />
                        <erp:ErpComboField Margin="0,0,10,10"
                                           DisplayMemberPath="DisplayName"
                                           FieldWidth="200"
                                           HorizontalAlignment="Left"
                                           IconKind="GoogleClassroom"
                                           ItemsSource="{Binding ClassRooms}"
                                           Label="Classe"
                                           MaxDropDownHeight="180"
                                           SelectedItem="{Binding FilterClassRoom, Mode=TwoWay}" />
                        <erp:ErpComboField Margin="0,0,10,10"
                                           DisplayMemberPath="Name"
                                           FieldWidth="170"
                                           HorizontalAlignment="Left"
                                           IconKind="CashMultiple"
                                           IsRequired="True"
                                           ItemsSource="{Binding FeeTypes}"
                                           Label="Type de frais"
                                           MaxDropDownHeight="140"
                                           SelectedItem="{Binding FilterFeeType, Mode=TwoWay}" />
                        <erp:ErpDateField Margin="0,0,10,10"
                                          DateValidationMode="None"
                                          FieldWidth="150"
                                          HorizontalAlignment="Left"
                                          IsEnabled="{Binding IsCustomPeriod}"
                                          Label="Du"
                                          SelectedDate="{Binding FilterFromDate, Mode=TwoWay}"
                                          ShowBadges="False"
                                          ShowValidation="False" />
                        <erp:ErpDateField Margin="0,0,10,10"
                                          DateValidationMode="None"
                                          FieldWidth="150"
                                          HorizontalAlignment="Left"
                                          IsEnabled="{Binding IsCustomPeriod}"
                                          Label="Au"
                                          SelectedDate="{Binding FilterToDate, Mode=TwoWay}"
                                          ShowBadges="False"
                                          ShowValidation="False" />
                    </WrapPanel>

                    <TextBlock Margin="0,0,0,4"
                               FontSize="12"
                               Foreground="{StaticResource ErpDangerBrush}"
                               Text="{Binding FromDateError}"
                               TextWrapping="Wrap"
                               Visibility="{Binding FromDateError, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" />
                    <TextBlock Margin="0,0,0,8"
                               FontSize="12"
                               Foreground="{StaticResource ErpDangerBrush}"
                               Text="{Binding ToDateError}"
                               TextWrapping="Wrap"
                               Visibility="{Binding ToDateError, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" />

                    <StackPanel Orientation="Horizontal">
                        <Button Padding="14,6"
                                Command="{Binding SearchCommand}"
                                Content="Afficher"
                                Style="{StaticResource ErpPrimaryButton}" />
                        <Button Margin="8,0,0,0"
                                Padding="14,6"
                                Command="{Binding ClearFiltersCommand}"
                                Content="Réinitialiser"
                                Style="{StaticResource ErpSecondaryButton}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Barre d'actions -->
        <Border Grid.Row="1"
                Margin="0,0,0,8"
                Padding="10,8"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Padding="14,6"
                            Command="{Binding ExportExcelCommand}"
                            Content="Excel"
                            Style="{StaticResource ErpSecondaryButton}" />
                    <Button Margin="8,0,0,0"
                            Padding="14,6"
                            Command="{Binding ExportPdfCommand}"
                            Content="PDF"
                            Style="{StaticResource ErpSecondaryButton}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"
                               Text="{Binding PeriodLabel}" />
                    <TextBlock Margin="16,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               MaxWidth="520"
                               Style="{StaticResource ErpBodySecondary}"
                               Text="{Binding StatusMessage}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Cartes synthèse -->
        <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,8">
            <Border Margin="0,0,8,0"
                    Padding="14,12"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel Orientation="Horizontal">
                    <Border Width="40"
                            Height="40"
                            Margin="0,0,12,0"
                            Background="#ECFDF5"
                            CornerRadius="10">
                        <materialDesign:PackIcon Width="22"
                                                 Height="22"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Foreground="{StaticResource ErpSuccessBrush}"
                                                 Kind="CashCheck" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="12" Foreground="#6B7280" Text="Total période" />
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding GrandTotal, StringFormat=N2}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Margin="0,0,8,0"
                    Padding="14,12"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel Orientation="Horizontal">
                    <Border Width="40"
                            Height="40"
                            Margin="0,0,12,0"
                            Background="#E8EFFF"
                            CornerRadius="10">
                        <materialDesign:PackIcon Width="22"
                                                 Height="22"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Foreground="{StaticResource ErpPrimaryBrush}"
                                                 Kind="ReceiptText" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="12" Foreground="#6B7280" Text="Nombre de paiements" />
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding PaymentCount}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Padding="14,12"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock FontSize="12" Foreground="#6B7280" Text="Par devise" />
                    <ItemsControl ItemsSource="{Binding ByCurrency}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,2,0,0" FontSize="13" FontWeight="SemiBold">
                                    <Run Text="{Binding Currency, Mode=OneWay}" />
                                    <Run Text=" : " />
                                    <Run Text="{Binding TotalAmount, StringFormat=N2, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Onglets d'affichage -->
        <Border Grid.Row="3"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="12"
                Padding="8,4,8,8">
            <TabControl Style="{StaticResource ErpTabControl}">
                <TabItem Header="Détail" Style="{StaticResource ErpTabItem}">
                    <DataGrid Margin="0,8,0,0"
                              AutoGenerateColumns="True"
                              BorderThickness="0"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              ItemsSource="{Binding PivotView}"
                              Style="{StaticResource ErpDataGrid}" />
                </TabItem>

                <TabItem Header="Journalier" Style="{StaticResource ErpTabItem}">
                    <DataGrid Margin="0,8,0,0"
                              AutoGenerateColumns="True"
                              BorderThickness="0"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              ItemsSource="{Binding DailyPivotView}"
                              Style="{StaticResource ErpDataGrid}">
                    </DataGrid>
                </TabItem>

                <TabItem Header="Par classe" Style="{StaticResource ErpTabItem}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Margin="0,0,0,6"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2937"
                                       Text="Total période par classe" />
                            <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="0" Margin="0,0,0,12">
                                <DataGrid BorderThickness="0"
                                          ItemsSource="{Binding ByClass}"
                                          MaxHeight="220"
                                          Style="{StaticResource ErpDataGrid}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Binding="{Binding ClassCode}" Header="Code" Width="80" />
                                        <DataGridTextColumn Binding="{Binding ClassName}" Header="Classe" Width="*" />
                                        <DataGridTextColumn Binding="{Binding SectionName}" Header="Section" Width="120" />
                                        <DataGridTextColumn Binding="{Binding TotalAmount, StringFormat=N2}" Header="Montant" Width="110" />
                                        <DataGridTextColumn Binding="{Binding PaymentCount}" Header="Nb" Width="70" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <TextBlock Margin="0,0,0,6"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2937"
                                       Text="Recette journalière par classe" />
                            <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="0">
                                <DataGrid BorderThickness="0"
                                          ItemsSource="{Binding DailyByClass}"
                                          MaxHeight="220"
                                          Style="{StaticResource ErpDataGrid}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Header="Jour" Width="110" />
                                        <DataGridTextColumn Binding="{Binding ClassName}" Header="Classe" Width="*" />
                                        <DataGridTextColumn Binding="{Binding TotalAmount, StringFormat=N2}" Header="Montant" Width="110" />
                                        <DataGridTextColumn Binding="{Binding PaymentCount}" Header="Nb" Width="70" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Par section" Style="{StaticResource ErpTabItem}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Margin="0,0,0,6"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2937"
                                       Text="Total période par section" />
                            <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="0" Margin="0,0,0,12">
                                <DataGrid BorderThickness="0"
                                          ItemsSource="{Binding BySection}"
                                          MaxHeight="220"
                                          Style="{StaticResource ErpDataGrid}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Binding="{Binding SectionCode}" Header="Code" Width="80" />
                                        <DataGridTextColumn Binding="{Binding SectionName}" Header="Section" Width="*" />
                                        <DataGridTextColumn Binding="{Binding TotalAmount, StringFormat=N2}" Header="Montant" Width="110" />
                                        <DataGridTextColumn Binding="{Binding PaymentCount}" Header="Nb" Width="70" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <TextBlock Margin="0,0,0,6"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2937"
                                       Text="Recette journalière par section" />
                            <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="0">
                                <DataGrid BorderThickness="0"
                                          ItemsSource="{Binding DailyBySection}"
                                          MaxHeight="220"
                                          Style="{StaticResource ErpDataGrid}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Header="Jour" Width="110" />
                                        <DataGridTextColumn Binding="{Binding SectionName}" Header="Section" Width="*" />
                                        <DataGridTextColumn Binding="{Binding TotalAmount, StringFormat=N2}" Header="Montant" Width="110" />
                                        <DataGridTextColumn Binding="{Binding PaymentCount}" Header="Nb" Width="70" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Par type de frais" Style="{StaticResource ErpTabItem}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Margin="0,0,0,6"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2937"
                                       Text="Total période par type de frais" />
                            <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="0" Margin="0,0,0,12">
                                <DataGrid BorderThickness="0"
                                          ItemsSource="{Binding ByFeeType}"
                                          MaxHeight="220"
                                          Style="{StaticResource ErpDataGrid}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Binding="{Binding FeeTypeName}" Header="Type de frais" Width="*" />
                                        <DataGridTextColumn Binding="{Binding Currency}" Header="Devise" Width="80" />
                                        <DataGridTextColumn Binding="{Binding TotalAmount, StringFormat=N2}" Header="Montant" Width="110" />
                                        <DataGridTextColumn Binding="{Binding PaymentCount}" Header="Nb" Width="70" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <TextBlock Margin="0,0,0,6"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2937"
                                       Text="Recette journalière par type de frais" />
                            <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="0">
                                <DataGrid BorderThickness="0"
                                          ItemsSource="{Binding DailyByFeeType}"
                                          MaxHeight="220"
                                          Style="{StaticResource ErpDataGrid}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Header="Jour" Width="110" />
                                        <DataGridTextColumn Binding="{Binding FeeTypeName}" Header="Type de frais" Width="*" />
                                        <DataGridTextColumn Binding="{Binding Currency}" Header="Devise" Width="80" />
                                        <DataGridTextColumn Binding="{Binding TotalAmount, StringFormat=N2}" Header="Montant" Width="110" />
                                        <DataGridTextColumn Binding="{Binding PaymentCount}" Header="Nb" Width="70" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Répartitions" Style="{StaticResource ErpTabItem}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Margin="0,0,0,8"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2937"
                                       Text="Répartition globale par compte bénéficiaire" />

                            <Border Margin="0,0,0,16"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <DataGrid CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          IsReadOnly="True"
                                          ItemsSource="{Binding AllocationGlobalRows}"
                                          Style="{StaticResource ErpDataGrid}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Binding="{Binding DestinationCode}" Header="Code" Width="90" />
                                        <DataGridTextColumn Binding="{Binding DestinationName}" Header="Compte bénéficiaire" Width="*" MinWidth="180" />
                                        <DataGridTextColumn Binding="{Binding PeriodJ1, StringFormat=N2}" Header="Période J-1" Width="120" />
                                        <DataGridTextColumn Binding="{Binding Encaissement, StringFormat=N2}" Header="Encaissement" Width="120" />
                                        <DataGridTextColumn Binding="{Binding DepenseP, StringFormat=N2}" Header="Dépense P" Width="120" />
                                        <DataGridTextColumn Binding="{Binding PeriodeP, StringFormat=N2}" Header="Période P" Width="120" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <Border Margin="0,0,0,16"
                                    Padding="12,10"
                                    Background="#F3F4F6"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               FontWeight="SemiBold"
                                               Text="{Binding AllocationTotals.DestinationName, FallbackValue=Total général}" />
                                    <TextBlock Grid.Column="1"
                                               HorizontalAlignment="Right"
                                               FontWeight="SemiBold"
                                               Text="{Binding AllocationTotals.PeriodJ1, StringFormat=N2}" />
                                    <TextBlock Grid.Column="2"
                                               HorizontalAlignment="Right"
                                               FontWeight="SemiBold"
                                               Text="{Binding AllocationTotals.Encaissement, StringFormat=N2}" />
                                    <TextBlock Grid.Column="3"
                                               HorizontalAlignment="Right"
                                               FontWeight="SemiBold"
                                               Text="{Binding AllocationTotals.DepenseP, StringFormat=N2}" />
                                    <TextBlock Grid.Column="4"
                                               HorizontalAlignment="Right"
                                               FontWeight="SemiBold"
                                               Text="{Binding AllocationTotals.PeriodeP, StringFormat=N2}" />
                                </Grid>
                            </Border>

                            <TextBlock Margin="0,0,0,8"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2937"
                                       Text="Répartition par date" />

                            <Border BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <DataGrid CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          IsReadOnly="True"
                                          ItemsSource="{Binding AllocationDailyRows}"
                                          Style="{StaticResource ErpDataGrid}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Header="Date" Width="110" />
                                        <DataGridTextColumn Binding="{Binding DestinationCode}" Header="Code" Width="90" />
                                        <DataGridTextColumn Binding="{Binding DestinationName}" Header="Compte bénéficiaire" Width="*" MinWidth="160" />
                                        <DataGridTextColumn Binding="{Binding PeriodJ1, StringFormat=N2}" Header="Période J-1" Width="110" />
                                        <DataGridTextColumn Binding="{Binding Encaissement, StringFormat=N2}" Header="Encaissement" Width="110" />
                                        <DataGridTextColumn Binding="{Binding DepenseP, StringFormat=N2}" Header="Dépense P" Width="110" />
                                        <DataGridTextColumn Binding="{Binding PeriodeP, StringFormat=N2}" Header="Période P" Width="110" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>
