                                                                       FontWeight="SemiBold"
                                                                       Foreground="#1E3A8A"
                                                                       Text="{Binding TypeTotal, StringFormat=N2}" />
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Margin="0,0,8,0"
                                                                                         VerticalAlignment="Center"
                                                                                         Foreground="{StaticResource ErpPrimaryBrush}"
                                                                                         Kind="PercentOutline" />
                                                                <TextBlock VerticalAlignment="Center"
                                                                           FontSize="13"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#1F2937"
                                                                           Text="{Binding TypeLabel}" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>

                                                    <ItemsControl ItemsSource="{Binding Students}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1">
                                                                    <Grid Height="36" Background="White">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" MinWidth="240" />
                                                                            <ColumnDefinition Width="140" />
                                                                            <ColumnDefinition Width="140" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0"
                                                                                   Margin="12,0,8,0"
                                                                                   VerticalAlignment="Center"
                                                                                   Text="{Binding StudentName}" />
                                                                        <TextBlock Grid.Column="1"
                                                                                   Margin="0,0,12,0"
                                                                                   HorizontalAlignment="Right"
                                                                                   VerticalAlignment="Center"
                                                                                   Text="{Binding PaymentDate, StringFormat=dd/MM/yyyy}" />
                                                                        <TextBlock Grid.Column="2"
                                                                                   Margin="0,0,12,0"
                                                                                   HorizontalAlignment="Right"
                                                                                   VerticalAlignment="Center"
                                                                                   Text="{Binding Amount, StringFormat=N2}" />
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border Background="#EEF2FF" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
                                        <Grid Height="40">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="240" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="140" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Margin="12,0,8,0"
                                                       VerticalAlignment="Center"
                                                       FontWeight="Bold"
                                                       Foreground="#1E3A8A"
                                                       Text="Total" />
                                            <TextBlock Grid.Column="2"
                                                       Margin="0,0,12,0"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       FontWeight="Bold"
                                                       Foreground="#1E3A8A"
                                                       Text="{Binding WithholdingGrandTotal, StringFormat=N2}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>
