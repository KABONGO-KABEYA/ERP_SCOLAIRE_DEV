<Window x:Class="SchoolManagement.Desktop.Views.DeliberationDecisionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Décision du Conseil"
        Width="640"
        Height="720"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FB"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <DockPanel Margin="20">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Content="Enregistrer" Height="36" Padding="18,0" Margin="8,0,0,0"
                    Click="Save_Click" Style="{StaticResource ErpPrimaryButton}" />
            <Button DockPanel.Dock="Right" Content="Annuler" Height="36" Padding="18,0"
                    Click="Cancel_Click" Style="{StaticResource MaterialDesignOutlinedButton}" IsCancel="True" />
            <TextBlock Text="{Binding ValidationMessage}" Foreground="#DC2626"
                       VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding FullName, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
                <TextBlock Margin="0,2,0,12" Foreground="#64748B" FontSize="13"
                           Text="{Binding SubtitleDisplay, Mode=OneWay}" />

                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Moyenne" FontSize="11" Foreground="#64748B" />
                            <TextBlock Text="{Binding AverageDisplay, Mode=OneWay}" FontWeight="SemiBold" FontSize="16" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="%" FontSize="11" Foreground="#64748B" />
                            <TextBlock Text="{Binding PercentageDisplay, Mode=OneWay}" FontWeight="SemiBold" FontSize="16" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Mention" FontSize="11" Foreground="#64748B" />
                            <TextBlock Text="{Binding Mention, Mode=OneWay}" FontWeight="SemiBold" FontSize="16" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="Décision" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox Text="{Binding ProposedDecisionLabel, Mode=OneWay}" IsReadOnly="True" Height="36" Margin="0,0,0,12" />

                <TextBlock Text="Décision après délibération" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding FinalDecisionOptions}"
                          SelectedItem="{Binding SelectedFinalDecision}"
                          DisplayMemberPath="Label"
                          Height="36" Margin="0,0,0,12" />

                <TextBlock Text="Observation" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox Text="{Binding Observation, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"
                         VerticalScrollBarVisibility="Auto" Margin="0,0,0,12" />

                <Border Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1" CornerRadius="8" Padding="12"
                        Margin="0,0,0,12"
                        Visibility="{Binding ShowRemedialCourses, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Cours à repêcher" FontWeight="SemiBold" Foreground="#9A3412" Margin="0,0,0,8" />
                        <TextBlock Text="Cochez uniquement les cours concernés (2ᵉ session)."
                                   FontSize="11" Foreground="#9A3412" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Courses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding CourseName}" IsChecked="{Binding IsSelected}"
                                              Margin="0,0,0,6" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="8" Padding="12"
                        Margin="0,0,0,12"
                        Visibility="{Binding ShowExemptionFields, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Dispense — cours concernés" FontWeight="SemiBold" Foreground="#1E40AF" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Courses}" Margin="0,0,0,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding CourseName}" IsChecked="{Binding IsSelected}"
                                              Margin="0,0,0,6" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Motif" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Text="{Binding ExemptionMotive, UpdateSourceTrigger=PropertyChanged}"
                                 Height="36" Margin="0,0,0,8" />
                        <TextBlock Text="Observation dispense" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Text="{Binding ExemptionObservation, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />
                    </StackPanel>
                </Border>

                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10">
                    <TextBlock FontSize="11" Foreground="#64748B"
                               Text="{Binding AuditDisplay, Mode=OneWay}" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
