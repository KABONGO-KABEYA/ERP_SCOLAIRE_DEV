<Window x:Class="SchoolManagement.Desktop.Views.StudentWithdrawalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Retrait de l'élève"
        Height="480"
        Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource ErpPageBackgroundBrush}"
        FontFamily="{StaticResource ErpFontFamily}">
    <Border Margin="24" Style="{StaticResource ErpCard}">
        <StackPanel>
            <TextBlock FontSize="20"
                       FontWeight="SemiBold"
                       Text="Exclusion ou abandon" />
            <TextBlock x:Name="StudentNameText"
                       Margin="0,6,0,16"
                       Style="{StaticResource ErpBodySecondary}"
                       TextWrapping="Wrap" />

            <TextBlock Margin="0,0,0,8"
                       FontWeight="SemiBold"
                       Text="Type de retrait" />
            <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                <RadioButton x:Name="ExclusionRadio"
                             Margin="0,0,24,0"
                             Content="Exclusion"
                             IsChecked="True"
                             Checked="WithdrawalType_OnChanged" />
                <RadioButton x:Name="AbandonRadio"
                             Content="Abandon"
                             Checked="WithdrawalType_OnChanged" />
            </StackPanel>

            <TextBlock Margin="0,0,0,8"
                       FontWeight="SemiBold"
                       Text="Raison" />
            <ComboBox x:Name="ReasonCombo"
                      Margin="0,0,0,12"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Code"
                      SelectionChanged="ReasonCombo_OnSelectionChanged"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}" />

            <TextBox x:Name="CustomReasonBox"
                     Margin="0,0,0,8"
                     materialDesign:HintAssist.Hint="Précisez la raison"
                     AcceptsReturn="True"
                     MaxHeight="80"
                     TextWrapping="Wrap"
                     Visibility="Collapsed"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" />

            <TextBlock x:Name="ErrorText"
                       Foreground="{StaticResource ErpDangerBrush}"
                       TextWrapping="Wrap" />

            <StackPanel Margin="0,20,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Padding="16,8"
                        Click="CancelButton_OnClick"
                        Content="Annuler"
                        Style="{StaticResource ErpSecondaryButton}" />
                <Button Margin="10,0,0,0"
                        Padding="16,8"
                        Click="ConfirmButton_OnClick"
                        Content="Confirmer"
                        Style="{StaticResource ErpDangerButton}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
