<UserControl x:Class="SchoolManagement.Desktop.Views.IndividualResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:ui="clr-namespace:SchoolManagement.Desktop.UI">
    <UserControl.Resources>
        <ui:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Margin="20,16,20,16" Style="{StaticResource ErpFadeIn}">
        <!-- Empty -->
        <Border Visibility="{Binding HasData, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                Padding="48"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="560"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="16">
            <StackPanel>
                <materialDesign:PackIcon Width="56" Height="56" HorizontalAlignment="Center"
                                         Foreground="#1D4ED8" Kind="AccountSchoolOutline" />
                <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold"
                           Foreground="#0F1F4A" Text="Résultat individuel" />
                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="#64748B" Text="{Binding EmptyHint}" />
                <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" Foreground="#DC2626"
                           Text="{Binding StatusMessage}" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Content -->
        <Grid Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="False">
                <Button DockPanel.Dock="Left"
                        Command="{Binding BackCommand}"
                        Style="{StaticResource ErpSecondaryButton}"
                        Content="Retour" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Margin="0,0,8,0"
                            Command="{Binding ExportPdfCommand}"
                            Style="{StaticResource ErpSecondaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FilePdfBox" Width="16" Height="16" Margin="0,0,6,0" />
                            <TextBlock Text="Exporter PDF" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding PrintCommand}"
                            Style="{StaticResource ErpPrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Printer" Width="16" Height="16" Margin="0,0,6,0" />
                            <TextBlock Text="Imprimer" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>

            <!-- Identity -->
            <Border Grid.Row="1"
                    Margin="0,14,0,0"
                    Padding="16"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="12"
                    Effect="{StaticResource ErpCardShadow}">
                <DockPanel>
                    <Border Width="96"
                            Height="120"
                            CornerRadius="8"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            DockPanel.Dock="Left"
                            Background="#F1F5F9"
                            ClipToBounds="True">
                        <Grid>
                            <materialDesign:PackIcon Kind="Account"
                                                     Width="40" Height="40"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     Foreground="#94A3B8"
                                                     Visibility="{Binding HasPhoto, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                            <Image Source="{Binding PhotoSource}"
                                   Stretch="UniformToFill"
                                   Visibility="{Binding HasPhoto, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </Border>

                    <Grid Margin="20,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,12">
                            <TextBlock FontSize="12" Foreground="#6B7280" Text="Nom" />
                            <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#0F1F4A" Text="{Binding StudentName}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,12">
                            <TextBlock FontSize="12" Foreground="#6B7280" Text="Matricule" />
                            <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#0F1F4A" Text="{Binding RegistrationNumber}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock FontSize="12" Foreground="#6B7280" Text="Année scolaire" />
                            <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#0F1F4A" Text="{Binding AcademicYearLabel}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock FontSize="12" Foreground="#6B7280" Text="Classe" />
                            <TextBlock FontSize="15" Foreground="#1F2937" Text="{Binding ClassDisplayName}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock FontSize="12" Foreground="#6B7280" Text="Période" />
                            <TextBlock FontSize="15" Foreground="#1F2937" Text="{Binding PeriodLabel}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock FontSize="12" Foreground="#6B7280" Text="Décision" />
                            <TextBlock FontSize="15" FontWeight="SemiBold"
                                       Foreground="{Binding DecisionBrush}"
                                       Text="{Binding DecisionLabel}" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Courses table -->
            <Border Grid.Row="2"
                    Margin="0,14,0,0"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="12"
                    Effect="{StaticResource ErpCardShadow}">
                <DataGrid ItemsSource="{Binding Courses}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="#F8FAFC"
                          BorderThickness="0"
                          RowHeight="40">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Cours" Binding="{Binding CourseName}" Width="*" MinWidth="160" />
                        <DataGridTextColumn Header="Maximum" Binding="{Binding MaximumDisplay}" Width="90" />
                        <DataGridTextColumn Header="Total obtenu" Binding="{Binding TotalObtainedDisplay}" Width="110" />
                        <DataGridTextColumn Header="Résultat" Binding="{Binding ResultDisplay}" Width="90" />
                        <DataGridTextColumn Header="Mention" Binding="{Binding Mention}" Width="120" />
                        <DataGridTextColumn Header="Observation" Binding="{Binding Observation}" Width="1.2*" MinWidth="140" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Summary -->
            <UniformGrid Grid.Row="3" Columns="5" Margin="0,14,0,0">
                <Border Margin="0,0,8,0" Padding="14,12" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10">
                    <StackPanel>
                        <TextBlock FontSize="12" Foreground="#6B7280" Text="Moyenne générale" />
                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="#0F1F4A" Text="{Binding AverageDisplay}" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,8,0" Padding="14,12" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10">
                    <StackPanel>
                        <TextBlock FontSize="12" Foreground="#6B7280" Text="Pourcentage" />
                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="#0F1F4A" Text="{Binding PercentageDisplay}" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,8,0" Padding="14,12" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10">
                    <StackPanel>
                        <TextBlock FontSize="12" Foreground="#6B7280" Text="Mention générale" />
                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#0F1F4A" Text="{Binding Mention}" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,8,0" Padding="14,12" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10">
                    <StackPanel>
                        <TextBlock FontSize="12" Foreground="#6B7280" Text="Décision" />
                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{Binding DecisionBrush}" Text="{Binding DecisionLabel}" />
                    </StackPanel>
                </Border>
                <Border Padding="14,12" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10">
                    <StackPanel>
                        <TextBlock FontSize="12" Foreground="#6B7280" Text="Rang" />
                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="#0F1F4A" Text="{Binding RankDisplay}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <DockPanel Grid.Row="4" Margin="0,10,0,0">
                <ProgressBar Width="120" Height="4" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#6B7280" Text="{Binding StatusMessage}" />
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
