<UserControl x:Class="SchoolManagement.Desktop.Views.EncaissementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:erp="clr-namespace:SchoolManagement.Desktop.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:models="clr-namespace:SchoolManagement.Application.Finance.DTOs;assembly=SchoolManagement.Application"
             xmlns:ui="clr-namespace:SchoolManagement.Desktop.UI">
    <UserControl.Resources>
        <ui:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="0" Style="{StaticResource ErpFadeIn}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="280" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,8"
                Padding="12,10"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="10">
            <StackPanel>
                <DockPanel LastChildFill="True">
                    <Button Width="32"
                            Height="32"
                            Padding="0"
                            HorizontalAlignment="Right"
                            Command="{Binding ToggleFiltersCommand}"
                            DockPanel.Dock="Right"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="{Binding FiltersToggleLabel}"
                            ToolTipService.InitialShowDelay="200">
                        <Grid Width="18" Height="18">
                            <materialDesign:PackIcon Kind="ChevronDown"
                                                     Width="18"
                                                     Height="18"
                                                     Visibility="{Binding IsFiltersExpanded, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                            <materialDesign:PackIcon Kind="ChevronUp"
                                                     Width="18"
                                                     Height="18"
                                                     Visibility="{Binding IsFiltersExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </Button>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"
                               Text="{Binding FiltersHeaderText}" />
                </DockPanel>

                <StackPanel Margin="0,10,0,0"
                            Visibility="{Binding IsFiltersExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <UniformGrid Columns="4" Margin="0,0,0,10">
                        <erp:ErpComboField Margin="0,0,12,12"
                                           DisplayMemberPath="Name"
                                           FieldWidth="200"
                                           HorizontalAlignment="Stretch"
                                           IconKind="School"
                                           ItemsSource="{Binding Sections}"
                                           Label="Section"
                                           SelectedItem="{Binding SelectedSection, Mode=TwoWay}" />
                        <erp:ErpComboField Margin="0,0,12,12"
                                           DisplayMemberPath="DisplayName"
                                           FieldWidth="200"
                                           HorizontalAlignment="Stretch"
                                           IconKind="GoogleClassroom"
                                           ItemsSource="{Binding PedagogicalClasses}"
                                           Label="Classe"
                                           SelectedItem="{Binding SelectedPedagogicalClass, Mode=TwoWay}" />
                        <erp:ErpComboField Margin="0,0,12,12"
                                           DisplayMemberPath="Name"
                                           FieldWidth="200"
                                           HorizontalAlignment="Stretch"
                                           IconKind="CashMultiple"
                                           ItemsSource="{Binding FeeTypes}"
                                           Label="Type de frais"
                                           SelectedItem="{Binding SelectedFeeType, Mode=TwoWay}" />
                        <erp:ErpComboField Margin="0,0,0,12"
                                           DisplayMemberPath="Label"
                                           FieldWidth="200"
                                           HorizontalAlignment="Stretch"
                                           IconKind="TagOutline"
                                           ItemsSource="{Binding PaymentStatuses}"
                                           Label="Statut de paiement"
                                           SelectedItem="{Binding SelectedPaymentStatusFilter, Mode=TwoWay}" />
                    </UniformGrid>

                    <StackPanel Orientation="Horizontal">
                        <Button Padding="14,6"
                                Command="{Binding ApplyFiltersCommand}"
                                Content="Afficher"
                                Style="{StaticResource ErpPrimaryButton}" />
                        <Button Margin="8,0,0,0"
                                Padding="14,6"
                                Command="{Binding ClearFiltersCommand}"
                                Content="Réinitialiser"
                                Style="{StaticResource ErpSecondaryButton}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="0,0,0,8"
                Padding="10,8"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Padding="14,6"
                            Command="{Binding PreviewReceiptCommand}"
                            Content="Aperçu du reçu"
                            Style="{StaticResource ErpSecondaryButton}" />
                    <Button Margin="8,0,0,0"
                            Padding="14,6"
                            Command="{Binding NewPaymentCommand}"
                            Content="Nouveau paiement"
                            Style="{StaticResource ErpSuccessButton}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <erp:ErpSearchField Width="320"
                                        HorizontalAlignment="Left"
                                        Placeholder="Matricule, nom ou prénom…"
                                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="16,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               MaxWidth="420"
                               Style="{StaticResource ErpBodySecondary}"
                               Text="{Binding StatusMessage}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="12">
            <DataGrid x:Name="StudentsGrid"
                      BorderThickness="0"
                      ItemsSource="{Binding Students}"
                      LoadingRow="StudentsGrid_OnLoadingRow"
                      SelectedItem="{Binding SelectedStudent}"
                      Style="{StaticResource ErpStudentsDataGrid}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="#" Width="56">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Center"
                                           FontSize="13"
                                           Foreground="#6B7280"
                                           Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Tag}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="MATRICULE" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ErpTableCodeBadge}">
                                    <TextBlock Style="{StaticResource ErpTableCodeBadgeText}"
                                               Text="{Binding RegistrationNumber}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Binding="{Binding FullName}"
                                        Header="NOM COMPLET"
                                        MinWidth="160"
                                        Width="*"
                                        ElementStyle="{StaticResource ErpStudentsGridCellText}" />
                    <DataGridTextColumn Binding="{Binding GenderLabel}"
                                        Header="SEXE"
                                        Width="80"
                                        ElementStyle="{StaticResource ErpStudentsGridCellText}" />
                    <DataGridTextColumn Binding="{Binding ClassName}"
                                        Header="CLASSE"
                                        Width="140"
                                        ElementStyle="{StaticResource ErpStudentsGridCellText}" />
                    <DataGridTemplateColumn Header="PAYÉ / ATTENDU" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#374151"
                                           Text="{Binding AmountPaidExpectedDisplay}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="SOLDE" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="BalanceText"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#374151"
                                           Text="{Binding BalanceDisplay}" />
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding HasOutstandingBalance}" Value="True">
                                        <Setter TargetName="BalanceText" Property="Foreground" Value="#B91C1C" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCredit}" Value="True">
                                        <Setter TargetName="BalanceText" Property="Foreground" Value="#1D4ED8" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="STATUT" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="StatusBadge" Style="{StaticResource ErpTableStatusBadgeActive}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon x:Name="StatusIcon"
                                                                 Width="14"
                                                                 Height="14"
                                                                 Margin="0,0,6,0"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="#16A34A"
                                                                 Kind="CheckCircle" />
                                        <TextBlock x:Name="StatusText"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe UI"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#166534"
                                                   Text="{Binding PaymentStatusLabel}" />
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding PaymentStatus}" Value="{x:Static models:PaymentSituationStatus.EnRetard}">
                                        <Setter TargetName="StatusBadge" Property="Style" Value="{StaticResource ErpTableStatusBadgeWarning}" />
                                        <Setter TargetName="StatusIcon" Property="Kind" Value="ClockAlertOutline" />
                                        <Setter TargetName="StatusIcon" Property="Foreground" Value="#D97706" />
                                        <Setter TargetName="StatusText" Property="Foreground" Value="#B45309" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding PaymentStatus}" Value="{x:Static models:PaymentSituationStatus.Impaye}">
                                        <Setter TargetName="StatusBadge" Property="Style" Value="{StaticResource ErpTableStatusBadgeArchived}" />
                                        <Setter TargetName="StatusIcon" Property="Kind" Value="CloseCircleOutline" />
                                        <Setter TargetName="StatusIcon" Property="Foreground" Value="#DC2626" />
                                        <Setter TargetName="StatusText" Property="Foreground" Value="#B91C1C" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding PaymentStatus}" Value="{x:Static models:PaymentSituationStatus.Credit}">
                                        <Setter TargetName="StatusBadge" Property="Style" Value="{StaticResource ErpTableStatusBadgeCredit}" />
                                        <Setter TargetName="StatusIcon" Property="Kind" Value="ArrowUpBoldCircleOutline" />
                                        <Setter TargetName="StatusIcon" Property="Foreground" Value="#2563EB" />
                                        <Setter TargetName="StatusText" Property="Foreground" Value="#1D4ED8" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="ACTION" Width="96">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Click="StudentActionsButton_OnClick"
                                        Content="..."
                                        Style="{StaticResource ErpStudentsGridActionButton}"
                                        Tag="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3"
                Margin="0,8,0,0"
                Padding="10,8"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Padding="12,5"
                            Command="{Binding PreviousPageCommand}"
                            Content="Précédent"
                            IsEnabled="{Binding CanGoPreviousPage}"
                            Style="{StaticResource ErpSecondaryButton}" />
                    <Button Margin="8,0,0,0"
                            Padding="12,5"
                            Command="{Binding NextPageCommand}"
                            Content="Suivant"
                            IsEnabled="{Binding CanGoNextPage}"
                            Style="{StaticResource ErpSecondaryButton}" />
                </StackPanel>
                <TextBlock VerticalAlignment="Center"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#374151"
                           Text="{Binding PaginationLabel}" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
