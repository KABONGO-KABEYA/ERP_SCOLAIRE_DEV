<UserControl x:Class="SchoolManagement.Desktop.Views.SecurityExceptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:erp="clr-namespace:SchoolManagement.Desktop.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid Margin="20" Style="{StaticResource ErpFadeIn}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="240" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="True">
            <Button DockPanel.Dock="Right"
                    Padding="14,6"
                    VerticalAlignment="Top"
                    Command="{Binding LoadCommand}"
                    Style="{StaticResource ErpSecondaryButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Refresh"
                                             Margin="0,0,6,0"
                                             VerticalAlignment="Center" />
                    <TextBlock VerticalAlignment="Center" Text="Actualiser" />
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock Style="{StaticResource ErpPageTitle}" Text="Exceptions de permissions" />
                <TextBlock Margin="0,4,0,0"
                           Style="{StaticResource ErpBodySecondary}"
                           Text="Octrois et refus exceptionnels par utilisateur" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1"
                Margin="0,0,0,12"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="14">
            <DockPanel>
                <Border DockPanel.Dock="Top"
                        Padding="14,10"
                        BorderBrush="#E5E7EB"
                        BorderThickness="0,0,0,1">
                    <TextBlock FontWeight="SemiBold"
                               Foreground="#0F1F4A"
                               Text="Exceptions enregistrées" />
                </Border>
                <DataGrid AutoGenerateColumns="False"
                          BorderThickness="0"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          ItemsSource="{Binding Exceptions}"
                          SelectedItem="{Binding SelectedException}"
                          Style="{StaticResource ErpDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding UserName}"
                                            Header="UTILISATEUR"
                                            Width="120" />
                        <DataGridTextColumn Binding="{Binding PermissionDisplayName}"
                                            Header="PERMISSION"
                                            Width="*" />
                        <DataGridTextColumn Binding="{Binding Effect}"
                                            Header="EFFET"
                                            Width="90" />
                        <DataGridTextColumn Binding="{Binding ValidFrom, StringFormat=d}"
                                            Header="DÉBUT"
                                            Width="100" />
                        <DataGridTextColumn Binding="{Binding ValidTo, StringFormat=d}"
                                            Header="FIN"
                                            Width="100" />
                        <DataGridCheckBoxColumn Binding="{Binding IsCurrentlyActive}"
                                                Header="ACTIVE"
                                                Width="70" />
                        <DataGridTextColumn Binding="{Binding Reason}"
                                            Header="MOTIF"
                                            Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Row="2"
                Margin="0,0,0,8"
                Padding="14,12"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="12">
            <StackPanel>
                <TextBlock FontWeight="SemiBold"
                           Foreground="#0F1F4A"
                           Text="Nouvelle exception" />
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <erp:ErpComboField Grid.Column="0"
                                       Margin="0,0,8,0"
                                       DisplayMemberPath="FullName"
                                       HorizontalAlignment="Stretch"
                                       IconKind="Account"
                                       IsCompact="True"
                                       ItemsSource="{Binding Users}"
                                       Label="Utilisateur"
                                       SelectedValue="{Binding NewUserId}"
                                       SelectedValuePath="Id" />
                    <erp:ErpComboField Grid.Column="1"
                                       Margin="0,0,8,0"
                                       DisplayMemberPath="DisplayName"
                                       HorizontalAlignment="Stretch"
                                       IconKind="ShieldKeyOutline"
                                       IsCompact="True"
                                       ItemsSource="{Binding Permissions}"
                                       Label="Permission"
                                       SelectedValue="{Binding NewPermissionId}"
                                       SelectedValuePath="Id" />
                    <erp:ErpComboField Grid.Column="2"
                                       Margin="0,0,8,0"
                                       HorizontalAlignment="Stretch"
                                       IconKind="SwapHorizontal"
                                       IsCompact="True"
                                       ItemsSource="{Binding EffectChoices}"
                                       Label="Effet"
                                       SelectedItem="{Binding NewEffect}" />
                    <erp:ErpDateField Grid.Column="3"
                                      Margin="0,0,8,0"
                                      HorizontalAlignment="Stretch"
                                      IsCompact="True"
                                      Label="Début"
                                      SelectedDate="{Binding NewValidFrom}"
                                      ShowBadges="False" />
                    <erp:ErpDateField Grid.Column="4"
                                      Margin="0,0,8,0"
                                      HorizontalAlignment="Stretch"
                                      IsCompact="True"
                                      Label="Fin (opt.)"
                                      SelectedDate="{Binding NewValidTo}"
                                      ShowBadges="False" />
                    <erp:ErpTextField Grid.Column="5"
                                      HorizontalAlignment="Stretch"
                                      IconKind="TextBoxOutline"
                                      IsCompact="True"
                                      Label="Motif"
                                      Text="{Binding NewReason, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <WrapPanel Margin="0,12,0,0">
                    <Button Margin="0,0,8,0"
                            Padding="14,6"
                            Command="{Binding CreateCommand}"
                            Style="{StaticResource ErpPrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus"
                                                     Margin="0,0,6,0"
                                                     VerticalAlignment="Center" />
                            <TextBlock VerticalAlignment="Center" Text="Créer" />
                        </StackPanel>
                    </Button>
                    <Button Padding="14,6"
                            Command="{Binding CloseCommand}"
                            Style="{StaticResource ErpSecondaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CloseCircleOutline"
                                                     Margin="0,0,6,0"
                                                     VerticalAlignment="Center" />
                            <TextBlock VerticalAlignment="Center" Text="Clôturer la sélection" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3"
                   Style="{StaticResource ErpBodySecondary}"
                   Text="{Binding StatusMessage}"
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>
