<UserControl x:Class="SchoolManagement.Desktop.Views.PricingCategoryAssignmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:erp="clr-namespace:SchoolManagement.Desktop.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:ui="clr-namespace:SchoolManagement.Desktop.UI">
    <UserControl.Resources>
        <ui:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="0" Style="{StaticResource ErpFadeIn}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="280" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,8"
                Padding="12,10"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="10">
            <StackPanel>
                <DockPanel LastChildFill="True">
                    <Button Width="32"
                            Height="32"
                            Padding="0"
                            HorizontalAlignment="Right"
                            Command="{Binding ToggleFiltersCommand}"
                            DockPanel.Dock="Right"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="{Binding FiltersToggleLabel}"
                            ToolTipService.InitialShowDelay="200">
                        <Grid Width="18" Height="18">
                            <materialDesign:PackIcon Kind="ChevronDown"
                                                     Width="18"
                                                     Height="18"
                                                     Visibility="{Binding IsFiltersExpanded, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                            <materialDesign:PackIcon Kind="ChevronUp"
                                                     Width="18"
                                                     Height="18"
                                                     Visibility="{Binding IsFiltersExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </Button>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"
                               Text="{Binding FiltersHeaderText}" />
                </DockPanel>

                <StackPanel Margin="0,10,0,0"
                            Visibility="{Binding IsFiltersExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <UniformGrid Columns="3" Margin="0,0,0,10">
                        <erp:ErpComboField Margin="0,0,12,12"
                                           DisplayMemberPath="Label"
                                           FieldWidth="240"
                                           HorizontalAlignment="Stretch"
                                           IconKind="CalendarRange"
                                           ItemsSource="{Binding AcademicYears}"
                                           Label="Année scolaire"
                                           SelectedItem="{Binding SelectedAcademicYear, Mode=TwoWay}" />
                        <erp:ErpComboField Margin="0,0,12,12"
                                           DisplayMemberPath="Name"
                                           FieldWidth="240"
                                           HorizontalAlignment="Stretch"
                                           IconKind="School"
                                           ItemsSource="{Binding Sections}"
                                           Label="Section"
                                           SelectedItem="{Binding SelectedSection, Mode=TwoWay}" />
                        <erp:ErpComboField Margin="0,0,0,12"
                                           DisplayMemberPath="Name"
                                           FieldWidth="240"
                                           HorizontalAlignment="Stretch"
                                           IconKind="TagOutline"
                                           ItemsSource="{Binding PricingCategories}"
                                           Label="Catégorie tarifaire (filtre / nouvelle valeur)"
                                           SelectedItem="{Binding SelectedPricingCategoryFilter, Mode=TwoWay}" />
                    </UniformGrid>

                    <StackPanel Orientation="Horizontal">
                        <Button Padding="14,6"
                                Command="{Binding ApplyFiltersCommand}"
                                Content="Afficher"
                                Style="{StaticResource ErpPrimaryButton}" />
                        <Button Margin="8,0,0,0"
                                Padding="14,6"
                                Command="{Binding ClearFiltersCommand}"
                                Content="Réinitialiser"
                                Style="{StaticResource ErpSecondaryButton}" />
                    </StackPanel>

                    <TextBlock Margin="0,8,0,0"
                               FontSize="12"
                               Style="{StaticResource ErpBodySecondary}"
                               Text="{Binding StatusMessage}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="0,0,0,8"
                Padding="10,8"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="10">
            <erp:ErpSearchField Width="320"
                                HorizontalAlignment="Left"
                                Placeholder="Matricule, nom ou catégorie…"
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
        </Border>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="12">
            <DataGrid x:Name="StudentsGrid"
                      BorderThickness="0"
                      ItemsSource="{Binding Students}"
                      LoadingRow="StudentsGrid_OnLoadingRow"
                      SelectedItem="{Binding SelectedStudent}"
                      Style="{StaticResource ErpStudentsDataGrid}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="#" Width="56">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Center"
                                           FontSize="13"
                                           Foreground="#6B7280"
                                           Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Tag}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="MATRICULE" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ErpTableCodeBadge}">
                                    <TextBlock Style="{StaticResource ErpTableCodeBadgeText}"
                                               Text="{Binding RegistrationNumber}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Binding="{Binding FullName}"
                                        Header="NOM COMPLET"
                                        MinWidth="160"
                                        Width="*"
                                        ElementStyle="{StaticResource ErpStudentsGridCellText}" />
                    <DataGridTextColumn Binding="{Binding ClassName}"
                                        Header="CLASSE"
                                        Width="150"
                                        ElementStyle="{StaticResource ErpStudentsGridCellText}" />
                    <DataGridTemplateColumn Header="CATÉGORIE TARIFAIRE" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ErpTableCodeBadge}">
                                    <TextBlock Style="{StaticResource ErpTableCodeBadgeText}"
                                               Text="{Binding PricingCategoryName}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Binding="{Binding AssignedAtDisplay}"
                                        Header="DATE D'ATTRIBUTION"
                                        Width="150"
                                        ElementStyle="{StaticResource ErpStudentsGridCellText}" />
                    <DataGridTemplateColumn Header="ACTION" Width="96">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Click="StudentActionsButton_OnClick"
                                        Content="..."
                                        Style="{StaticResource ErpStudentsGridActionButton}"
                                        Tag="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3"
                Margin="0,8,0,0"
                Padding="10,8"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Padding="12,5"
                            Command="{Binding PreviousPageCommand}"
                            Content="Précédent"
                            IsEnabled="{Binding CanGoPreviousPage}"
                            Style="{StaticResource ErpSecondaryButton}" />
                    <Button Margin="8,0,0,0"
                            Padding="12,5"
                            Command="{Binding NextPageCommand}"
                            Content="Suivant"
                            IsEnabled="{Binding CanGoNextPage}"
                            Style="{StaticResource ErpSecondaryButton}" />
                </StackPanel>
                <TextBlock VerticalAlignment="Center"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#374151"
                           Text="{Binding PaginationLabel}" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
