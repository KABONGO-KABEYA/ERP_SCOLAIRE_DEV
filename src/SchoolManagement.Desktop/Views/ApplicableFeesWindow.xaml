<Window x:Class="SchoolManagement.Desktop.Views.ApplicableFeesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Frais applicables"
        Height="520"
        Width="760"
        MinHeight="400"
        MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource ErpPageBackgroundBrush}"
        FontFamily="{StaticResource ErpFontFamily}">
    <Border Margin="20" Style="{StaticResource ErpCard}">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Frais applicables" />
                <TextBlock x:Name="StudentInfoText"
                           Margin="0,4,0,0"
                           Style="{StaticResource ErpBodySecondary}"
                           TextWrapping="Wrap" />
            </StackPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <TextBlock x:Name="TotalText"
                           VerticalAlignment="Center"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#0B1F47" />
                <Button HorizontalAlignment="Right"
                        Padding="16,8"
                        Click="CloseButton_OnClick"
                        Content="Fermer"
                        Style="{StaticResource ErpSecondaryButton}" />
            </DockPanel>
            <DataGrid x:Name="FeesGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      IsReadOnly="True"
                      Style="{StaticResource ErpStudentsDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding FeeTypeName}"
                                        Header="Type de frais"
                                        Width="*" />
                    <DataGridTextColumn Binding="{Binding InstallmentName}"
                                        Header="Tranche"
                                        Width="160" />
                    <DataGridTextColumn Binding="{Binding Amount, StringFormat=N0}"
                                        Header="Montant"
                                        Width="110" />
                    <DataGridTextColumn Binding="{Binding Currency}"
                                        Header="Devise"
                                        Width="80" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
</Window>
