<UserControl x:Class="SchoolManagement.Desktop.Views.DashboardCollectedDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:erp="clr-namespace:SchoolManagement.Desktop.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <ScrollViewer Style="{StaticResource ErpPageHost}" Background="{StaticResource ErpPageBackgroundBrush}">
        <StackPanel Margin="20" Style="{StaticResource ErpFadeIn}">
            <Button Margin="0,0,0,12"
                    HorizontalAlignment="Left"
                    Command="{Binding GoBackCommand}"
                    Style="{StaticResource ErpSecondaryButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="Retour" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="#0F1F4A" Text="Total encaissé — détail" />
            <TextBlock Margin="0,4,0,16" Style="{StaticResource ErpBodySecondary}"
                       Text="Consultez les encaissements selon la même logique que la carte du tableau de bord." />

            <Border Padding="16" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12">
                <StackPanel>
                    <ComboBox Width="280" HorizontalAlignment="Left"
                              DisplayMemberPath="Label"
                              ItemsSource="{Binding ScopeOptions}"
                              SelectedItem="{Binding SelectedScope, Mode=TwoWay}" />
                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal"
                                Visibility="{Binding IsCustomScope, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <erp:ErpDateField Margin="0,0,12,0" Label="Du" SelectedDate="{Binding CustomFromDate, Mode=TwoWay}" IsCompact="True" ShowBadges="False" />
                        <erp:ErpDateField Label="Au" SelectedDate="{Binding CustomToDate, Mode=TwoWay}" IsCompact="True" ShowBadges="False" />
                        <Button Margin="12,18,0,0" Padding="14,6" Command="{Binding LoadCommand}" Content="Actualiser"
                                Style="{StaticResource ErpPrimaryButton}" />
                    </StackPanel>
                    <TextBlock Margin="0,16,0,8" FontSize="18" FontWeight="SemiBold" Text="{Binding TotalLabel}" />
                    <TextBlock Foreground="#DC2626" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <DataGrid Margin="0,16,0,0" AutoGenerateColumns="False" CanUserAddRows="False"
                      IsReadOnly="True" ItemsSource="{Binding PaymentRows}"
                      Visibility="{Binding ShowPaymentLines, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding DateLabel}" Width="160" />
                    <DataGridTextColumn Header="Élève" Binding="{Binding StudentName}" Width="*" MinWidth="180" />
                    <DataGridTextColumn Header="Référence" Binding="{Binding Reference}" Width="120" />
                    <DataGridTextColumn Header="Montant" Binding="{Binding AmountLabel}" Width="140" />
                    <DataGridTextColumn Header="Mode" Binding="{Binding Method}" Width="120" />
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid Margin="0,16,0,0" AutoGenerateColumns="False" CanUserAddRows="False"
                      IsReadOnly="True" ItemsSource="{Binding RevenuePointRows}">
                <DataGrid.Style>
                    <Style TargetType="DataGrid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowPaymentLines}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Style>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Période" Binding="{Binding Label}" Width="*" MinWidth="180" />
                    <DataGridTextColumn Header="Montant encaissé" Binding="{Binding AmountLabel}" Width="180" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
