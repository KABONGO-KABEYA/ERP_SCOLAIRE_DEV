<UserControl x:Class="SchoolManagement.Desktop.Views.ResultsHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SchoolManagement.Desktop.Views"
             xmlns:vm="clr-namespace:SchoolManagement.Desktop.ViewModels">
    <Grid Background="{StaticResource ErpPageBackgroundBrush}">
        <ContentControl Content="{Binding ClassResults}"
                        Visibility="{Binding IsParClasseSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ContentControl.ContentTemplate>
                <DataTemplate DataType="{x:Type vm:ClassResultsViewModel}">
                    <views:ClassResultsView />
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

        <ContentControl Content="{Binding Individual}"
                        Visibility="{Binding IsIndividuelSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ContentControl.ContentTemplate>
                <DataTemplate DataType="{x:Type vm:IndividualResultViewModel}">
                    <views:IndividualResultView />
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

        <ContentControl Content="{Binding Deliberation}"
                        Visibility="{Binding IsDeliberationSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ContentControl.ContentTemplate>
                <DataTemplate DataType="{x:Type vm:DeliberationWorkspaceViewModel}">
                    <views:DeliberationWorkspaceView />
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

        <ContentControl Content="{Binding Placeholder}"
                        Visibility="{Binding IsPlaceholderSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ContentControl.ContentTemplate>
                <DataTemplate DataType="{x:Type vm:ResultsPlaceholderViewModel}">
                    <views:ResultsPlaceholderView />
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>
    </Grid>
</UserControl>
