<UserControl x:Class="SchoolManagement.Desktop.Views.AcademicView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Style="{StaticResource ErpFadeIn}">
            <TextBlock Style="{StaticResource ErpPageTitle}" Text="Gestion académique" />
            <TextBlock Margin="0,4,0,0" Style="{StaticResource ErpBodySecondary}" Text="Classes, cours et inscriptions des élèves" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,16,0,12" Style="{StaticResource ErpCard}">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding LoadClassRoomsCommand}"
                        Content="Actualiser"
                        Style="{StaticResource ErpSecondaryButton}" />
                <TextBlock Margin="20,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource ErpBodySecondary}"
                           Text="{Binding StatusMessage}" />
            </StackPanel>
        </Border>

        <TabControl Grid.Row="2" Style="{StaticResource ErpTabControl}">
            <TabItem Header="Classes" Style="{StaticResource ErpTabItem}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource ErpCard}" Padding="0">
                        <DataGrid Style="{StaticResource ErpDataGrid}"
                                  BorderThickness="0"
                                  ItemsSource="{Binding ClassRooms}"
                                  SelectedItem="{Binding SelectedClass}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Code}" Header="Code" Width="100" />
                                <DataGridTextColumn Binding="{Binding Name}" Header="Classe" Width="*" />
                                <DataGridTextColumn Binding="{Binding SectionName}" Header="Section" Width="*" />
                                <DataGridTextColumn Binding="{Binding Level}" Header="Niveau" Width="70" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Border Grid.Row="1" Margin="0,12,0,0" Style="{StaticResource ErpCard}">
                        <WrapPanel>
                            <ComboBox Width="180" Margin="0,0,12,0"
                                      DisplayMemberPath="Name"
                                      ItemsSource="{Binding Sections}"
                                      SelectedItem="{Binding SelectedSection}"
                                      Style="{StaticResource ErpComboBox}"
                                      materialDesign:HintAssist.Hint="Section" />
                            <TextBox Width="120" Margin="0,0,12,0"
                                     materialDesign:HintAssist.Hint="Code"
                                     Style="{StaticResource ErpTextBox}"
                                     Text="{Binding NewClassCode}" />
                            <TextBox Width="160" Margin="0,0,12,0"
                                     materialDesign:HintAssist.Hint="Nom"
                                     Style="{StaticResource ErpTextBox}"
                                     Text="{Binding NewClassName}" />
                            <TextBox Width="80" Margin="0,0,12,0"
                                     materialDesign:HintAssist.Hint="Niveau"
                                     Style="{StaticResource ErpTextBox}"
                                     Text="{Binding NewClassLevel}" />
                            <Button Command="{Binding CreateClassRoomCommand}" Content="Créer classe" Style="{StaticResource ErpPrimaryButton}" />
                        </WrapPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Cours" Style="{StaticResource ErpTabItem}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource ErpCard}" Padding="0">
                        <DataGrid Style="{StaticResource ErpDataGrid}"
                                  BorderThickness="0"
                                  ItemsSource="{Binding Courses}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Code}" Header="Code" Width="100" />
                                <DataGridTextColumn Binding="{Binding Name}" Header="Cours" Width="*" />
                                <DataGridTextColumn Binding="{Binding Coefficient}" Header="Coef." Width="60" />
                                <DataGridTextColumn Binding="{Binding MaxScore}" Header="/" Width="40" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Border Grid.Row="1" Margin="0,12,0,0" Style="{StaticResource ErpCard}">
                        <WrapPanel>
                            <TextBox Width="120" Margin="0,0,12,0"
                                     materialDesign:HintAssist.Hint="Code cours"
                                     Style="{StaticResource ErpTextBox}"
                                     Text="{Binding NewCourseCode}" />
                            <TextBox Width="220" Margin="0,0,12,0"
                                     materialDesign:HintAssist.Hint="Nom cours"
                                     Style="{StaticResource ErpTextBox}"
                                     Text="{Binding NewCourseName}" />
                            <Button Command="{Binding CreateCourseCommand}" Content="Créer cours" Style="{StaticResource ErpPrimaryButton}" />
                        </WrapPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Inscriptions" Style="{StaticResource ErpTabItem}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource ErpCard}" Padding="0">
                        <DataGrid Style="{StaticResource ErpDataGrid}"
                                  BorderThickness="0"
                                  ItemsSource="{Binding Enrollments}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding RegistrationNumber}" Header="Matricule" Width="120" />
                                <DataGridTextColumn Binding="{Binding StudentName}" Header="Élève" Width="*" />
                                <DataGridTextColumn Binding="{Binding ClassName}" Header="Classe" Width="*" />
                                <DataGridTextColumn Binding="{Binding Status}" Header="Statut" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Border Grid.Row="1" Margin="0,12,0,0" Style="{StaticResource ErpCard}">
                        <WrapPanel>
                            <ComboBox Width="260" Margin="0,0,12,0"
                                      DisplayMemberPath="FullName"
                                      ItemsSource="{Binding Students}"
                                      SelectedItem="{Binding SelectedStudent}"
                                      Style="{StaticResource ErpComboBox}"
                                      materialDesign:HintAssist.Hint="Élève à inscrire" />
                            <Button Command="{Binding CreateEnrollmentCommand}" Content="Inscrire en classe" Style="{StaticResource ErpPrimaryButton}" />
                        </WrapPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
