<UserControl x:Class="SchoolManagement.Desktop.Views.PersonnelHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SchoolManagement.Desktop.Views"
             xmlns:vm="clr-namespace:SchoolManagement.Desktop.ViewModels">
    <Grid Background="{StaticResource ErpPageBackgroundBrush}">
        <ContentControl Content="{Binding List}"
                        Visibility="{Binding IsListeSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ContentControl.ContentTemplate>
                <DataTemplate DataType="{x:Type vm:PersonnelListViewModel}">
                    <views:PersonnelListView />
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

        <ContentControl Content="{Binding Edit}"
                        Visibility="{Binding IsNouveauSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ContentControl.ContentTemplate>
                <DataTemplate DataType="{x:Type vm:PersonnelEditViewModel}">
                    <views:PersonnelEditView />
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

        <ContentControl Content="{Binding Departments}"
                        Visibility="{Binding IsDepartementsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ContentControl.ContentTemplate>
                <DataTemplate DataType="{x:Type vm:PersonnelDepartmentsViewModel}">
                    <views:PersonnelDepartmentsView />
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

        <ContentControl Content="{Binding Functions}"
                        Visibility="{Binding IsFonctionsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ContentControl.ContentTemplate>
                <DataTemplate DataType="{x:Type vm:PersonnelFunctionsViewModel}">
                    <views:PersonnelFunctionsView />
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

        <ContentControl Content="{Binding Placeholder}"
                        Visibility="{Binding IsPlaceholderSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ContentControl.ContentTemplate>
                <DataTemplate DataType="{x:Type vm:PersonnelPlaceholderViewModel}">
                    <views:PersonnelPlaceholderView />
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>
    </Grid>
</UserControl>
