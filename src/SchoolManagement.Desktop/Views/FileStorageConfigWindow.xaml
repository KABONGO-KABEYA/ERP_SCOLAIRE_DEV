<Window x:Class="SchoolManagement.Desktop.Views.FileStorageConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Configuration du serveur de fichiers"
        MinHeight="620"
        Height="680"
        Width="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource ErpPageBackgroundBrush}"
        FontFamily="{StaticResource ErpFontFamily}">
    <Grid Margin="24">
        <Border Style="{StaticResource ErpCard}">
            <DockPanel Margin="28" LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Style="{StaticResource ErpFadeIn}">
                    <Border Width="56"
                            Height="56"
                            Background="{StaticResource ErpPrimaryLightBrush}"
                            CornerRadius="14"
                            HorizontalAlignment="Left">
                        <materialDesign:PackIcon Kind="FolderNetwork"
                                                 Width="28"
                                                 Height="28"
                                                 Foreground="{StaticResource ErpPrimaryBrush}"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Margin="0,18,0,6"
                               Style="{StaticResource ErpSectionTitle}"
                               FontSize="24"
                               Text="Configuration du serveur de fichiers" />
                    <TextBlock Style="{StaticResource ErpBodySecondary}"
                               Text="Indiquez le chemin du dossier partagé réseau Dossier_Elève où sont stockés les photos et documents scannés des élèves."
                               TextWrapping="Wrap" />
                </StackPanel>

                <Grid DockPanel.Dock="Bottom" Margin="0,20,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ProgressBar Grid.Row="0"
                                 Height="3"
                                 Margin="0,0,0,12"
                                 Foreground="{StaticResource ErpPrimaryBrush}"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                HorizontalAlignment="Left"
                                Command="{Binding ResetCommand}"
                                Content="Réinitialiser"
                                Style="{StaticResource ErpSecondaryButton}" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Margin="0,0,10,0"
                                    Command="{Binding CancelCommand}"
                                    Content="Annuler"
                                    Style="{StaticResource ErpSecondaryButton}" />
                            <Button Margin="0,0,10,0"
                                    Click="TestAccessButton_OnClick"
                                    Content="Tester l'accès"
                                    Style="{StaticResource ErpSecondaryButton}" />
                            <Button Click="SaveButton_OnClick"
                                    Content="Enregistrer"
                                    Style="{StaticResource ErpPrimaryButton}" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <ScrollViewer Margin="0,24,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Style="{StaticResource ErpFadeIn}">
                        <TextBlock Margin="0,0,0,12"
                                   Style="{StaticResource ErpSectionTitle}"
                                   FontSize="16"
                                   Text="Dossier partagé" />

                        <StackPanel Margin="{StaticResource ErpFieldLabelSpacing}" Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Folder"
                                                     Style="{StaticResource ErpFieldIcon}" />
                            <TextBlock Style="{StaticResource ErpFieldLabel}" Text="Chemin du dossier Dossier_Elève" />
                            <TextBlock Style="{StaticResource ErpFieldRequiredMark}" Text="*" />
                        </StackPanel>

                        <TextBox x:Name="RacineTextBox"
                                 Margin="0,6,0,0"
                                 materialDesign:HintAssist.Hint="\\SERVEUR\Partage\Dossier_Elève"
                                 HorizontalAlignment="Stretch"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Text="{Binding Racine, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock MinHeight="20"
                                   Margin="0,6,0,0"
                                   Foreground="{StaticResource ErpDangerBrush}"
                                   Text="{Binding RacineError}"
                                   TextWrapping="Wrap" />

                        <Border MinHeight="52"
                                Margin="0,14,0,0"
                                Padding="14,12"
                                Background="#F8FAFC"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="10">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon x:Name="StatusIcon"
                                                         Width="20"
                                                         Height="20"
                                                         Margin="0,0,10,0"
                                                         VerticalAlignment="Top" />
                                <TextBlock Text="{Binding ConnectionStatusMessage}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0"
                                Padding="14,12"
                                Background="#F8FAFC"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="10">
                            <TextBlock Foreground="#64748B"
                                       Text="Exemples : \\SERVEUR\Partage\Dossier_Elève  ou  D:\Donnees\Dossier_Elève"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
