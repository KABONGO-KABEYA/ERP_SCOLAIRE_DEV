<UserControl x:Class="SchoolManagement.Desktop.Views.SecurityAuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:erp="clr-namespace:SchoolManagement.Desktop.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid Margin="20" Style="{StaticResource ErpFadeIn}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="240" />
            <RowDefinition Height="200" MinHeight="160" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource ErpPageTitle}" Text="Journal de sécurité" />
            <TextBlock Margin="0,4,0,0"
                       Style="{StaticResource ErpBodySecondary}"
                       Text="Journal des événements de sécurité et de gouvernance" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,0,0,12"
                Padding="14,12"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <erp:ErpDateField Grid.Column="0"
                                  Margin="0,0,8,0"
                                  HorizontalAlignment="Stretch"
                                  IsCompact="True"
                                  Label="Du (UTC)"
                                  SelectedDate="{Binding FilterFromUtc}"
                                  ShowBadges="False" />
                <erp:ErpDateField Grid.Column="1"
                                  Margin="0,0,8,0"
                                  HorizontalAlignment="Stretch"
                                  IsCompact="True"
                                  Label="Au (UTC)"
                                  SelectedDate="{Binding FilterToUtc}"
                                  ShowBadges="False" />
                <erp:ErpTextField Grid.Column="2"
                                  Margin="0,0,8,0"
                                  HorizontalAlignment="Stretch"
                                  IconKind="FlashOutline"
                                  IsCompact="True"
                                  Label="Type d'action"
                                  Text="{Binding FilterActionType, UpdateSourceTrigger=PropertyChanged}" />
                <erp:ErpTextField Grid.Column="3"
                                  Margin="0,0,8,0"
                                  HorizontalAlignment="Stretch"
                                  IconKind="AccountSearchOutline"
                                  IsCompact="True"
                                  Label="Utilisateur cible"
                                  Text="{Binding FilterTargetUserName, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="4"
                        Padding="14,6"
                        VerticalAlignment="Bottom"
                        Command="{Binding SearchCommand}"
                        Style="{StaticResource ErpPrimaryButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Magnify"
                                                 Margin="0,0,6,0"
                                                 VerticalAlignment="Center" />
                        <TextBlock VerticalAlignment="Center" Text="Rechercher" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Margin="0,0,0,12"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="14">
            <DockPanel>
                <Border DockPanel.Dock="Top"
                        Padding="14,10"
                        BorderBrush="#E5E7EB"
                        BorderThickness="0,0,0,1">
                    <TextBlock FontWeight="SemiBold"
                               Foreground="#0F1F4A"
                               Text="Événements" />
                </Border>
                <DataGrid AutoGenerateColumns="False"
                          BorderThickness="0"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          ItemsSource="{Binding Entries}"
                          SelectedItem="{Binding SelectedEntry}"
                          Style="{StaticResource ErpDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding OccurredAtUtc, StringFormat=g}"
                                            Header="DATE (UTC)"
                                            Width="150" />
                        <DataGridTextColumn Binding="{Binding ActorUserName}"
                                            Header="ACTEUR"
                                            Width="120" />
                        <DataGridTextColumn Binding="{Binding ActionType}"
                                            Header="ACTION"
                                            Width="160" />
                        <DataGridTextColumn Binding="{Binding TargetUserName}"
                                            Header="CIBLE"
                                            Width="120" />
                        <DataGridTextColumn Binding="{Binding Summary}"
                                            Header="RÉSUMÉ"
                                            Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Row="3"
                Margin="0,0,0,8"
                Padding="14,12"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock FontWeight="SemiBold"
                               Foreground="#0F1F4A"
                               Text="Détail de l'événement" />
                    <TextBlock Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="#6B7280"
                               Text="{Binding DetailSummary}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <TextBox MinHeight="90"
                         IsReadOnly="True"
                         Text="{Binding DetailJson}"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" />
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="4"
                   Style="{StaticResource ErpBodySecondary}"
                   Text="{Binding StatusMessage}"
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>
