<UserControl x:Class="SchoolManagement.Desktop.Views.DashboardStudentConsultationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <ScrollViewer Style="{StaticResource ErpPageHost}" Background="{StaticResource ErpPageBackgroundBrush}">
        <StackPanel Margin="20" Style="{StaticResource ErpFadeIn}">
            <Button Margin="0,0,0,12"
                    HorizontalAlignment="Left"
                    Command="{Binding GoBackCommand}"
                    Style="{StaticResource ErpSecondaryButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="Retour" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="#0F1F4A" Text="Fiche élève — consultation" />
            <TextBlock Margin="0,4,0,16" Style="{StaticResource ErpBodySecondary}"
                       Text="Consultation analytique DAF (identité, scolarité, responsables, situation financière)." />

            <Border Padding="16" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Width="120" Margin="16,0,0,0">
                        <Border Width="96" Height="96" CornerRadius="48" Background="#EEF2FF" HorizontalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="28" FontWeight="Bold" Foreground="#1D4ED8" Text="👤" />
                        </Border>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding IdentityTitle}" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource ErpBodySecondary}" Text="{Binding RegistrationNumber}" />
                        <TextBlock Margin="0,12,0,0" Foreground="#DC2626" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                        <Button Margin="0,12,0,0" HorizontalAlignment="Left" Padding="14,6" Command="{Binding LoadCommand}" Content="Actualiser"
                                Style="{StaticResource ErpSecondaryButton}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding IdentificationItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="#64748B" Text="{Binding Label}" />
                            <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Value}" TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Margin="0,20,0,8" FontSize="16" FontWeight="SemiBold" Text="Adresse" />
            <ItemsControl ItemsSource="{Binding AddressItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="#64748B" Text="{Binding Label}" />
                            <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Margin="0,20,0,8" FontSize="16" FontWeight="SemiBold" Text="Scolarité" />
            <ItemsControl ItemsSource="{Binding SchoolItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="#64748B" Text="{Binding Label}" />
                            <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Margin="0,20,0,8" FontSize="16" FontWeight="SemiBold" Text="Responsables" />
            <DataGrid AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      IsReadOnly="True"
                      ItemsSource="{Binding Guardians}"
                      Margin="0,0,0,8"
                      Style="{StaticResource ErpStudentsDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Role}" Header="Rôle" Width="120" />
                    <DataGridTextColumn Binding="{Binding FullName}" Header="Nom" Width="*" />
                    <DataGridTextColumn Binding="{Binding Phone}" Header="Téléphone" Width="120" />
                    <DataGridTextColumn Binding="{Binding Email}" Header="Email" Width="160" />
                    <DataGridTextColumn Binding="{Binding Profession}" Header="Profession" Width="140" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Margin="0,12,0,8" FontSize="16" FontWeight="SemiBold" Text="Informations médicales" />
            <ItemsControl ItemsSource="{Binding MedicalItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="#64748B" Text="{Binding Label}" />
                            <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Margin="0,20,0,8" FontSize="16" FontWeight="SemiBold" Text="Documents" />
            <ItemsControl ItemsSource="{Binding DocumentItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="#64748B" Text="{Binding Label}" />
                            <TextBlock Grid.Column="1" Text="{Binding Value}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Margin="0,24,0,8" FontSize="18" FontWeight="SemiBold" Text="Situation financière" />
            <TextBlock Margin="0,0,0,12" FontWeight="SemiBold" Text="{Binding FinancialTotalsLabel}" />

            <ItemsControl ItemsSource="{Binding FinancialGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,12" Padding="12" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="{Binding FeeTypeName}" />
                                <TextBlock Margin="0,2,0,8" Foreground="#64748B"
                                           Text="{Binding CategoryName, StringFormat=Catégorie tarifaire : {0}}" />
                                <DataGrid AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          HeadersVisibility="Column"
                                          IsReadOnly="True"
                                          ItemsSource="{Binding Lines}"
                                          Style="{StaticResource ErpStudentsDataGrid}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Binding="{Binding InstallmentName}" Header="Tranche" Width="*" />
                                        <DataGridTextColumn Binding="{Binding AmountExpected, StringFormat=N0}" Header="Prévu" Width="90" />
                                        <DataGridTextColumn Binding="{Binding AmountPaid, StringFormat=N0}" Header="Payé" Width="90" />
                                        <DataGridTextColumn Binding="{Binding Balance, StringFormat=N0}" Header="Solde" Width="90" />
                                        <DataGridTextColumn Binding="{Binding Currency}" Header="Dev." Width="50" />
                                        <DataGridTextColumn Binding="{Binding DueDateLabel}" Header="Échéance" Width="90" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="{Binding TotalsLabel}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
