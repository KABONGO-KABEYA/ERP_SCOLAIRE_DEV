<UserControl x:Class="SchoolManagement.Desktop.Views.ResultValidationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="20,16,20,16" Style="{StaticResource ErpFadeIn}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Filtres -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                CornerRadius="10" Padding="14,12" Margin="0,0,0,10"
                Visibility="{Binding ShowLocalFilters, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Classe" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding ClassRooms}"
                              SelectedItem="{Binding SelectedClassRoom}"
                              DisplayMemberPath="Name"
                              Height="36" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Sous-période" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding PeriodOptions}"
                              SelectedItem="{Binding SelectedPeriod}"
                              DisplayMemberPath="Name"
                              Height="36" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,16,0" VerticalAlignment="Bottom">
                    <TextBlock Text="Statut" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Non validé" Margin="0,0,12,0"
                                     IsChecked="{Binding IsStatusNonValide}" />
                        <RadioButton Content="Validé" Margin="0,0,12,0"
                                     IsChecked="{Binding IsStatusValide}" />
                        <RadioButton Content="Verrouillé"
                                     IsChecked="{Binding IsStatusVerrouille}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Actualiser" Height="36" Margin="0,0,6,0"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}" />
                    <Button Content="Excel" Height="36" Margin="0,0,6,0"
                            Command="{Binding ExportExcelCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}" />
                    <Button Content="PDF" Height="36" Margin="0,0,6,0"
                            Command="{Binding ExportPdfCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}" />
                    <Button Content="Imprimer" Height="36"
                            Command="{Binding PrintCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- En-tête KPI -->
        <Border Grid.Row="1" Background="#0B1F47" CornerRadius="10" Padding="16,14" Margin="0,0,0,10"
                Visibility="{Binding ShowHeaderKpi, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Classe / Période" Foreground="#94A3B8" FontSize="11" />
                    <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="White">
                        <Run Text="{Binding ClassDisplayName}" />
                        <Run Text=" · " />
                        <Run Text="{Binding PeriodLabel}" />
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="#A7F3D0"
                               Text="{Binding StatusLabel}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0">
                    <TextBlock Text="Élèves" Foreground="#94A3B8" FontSize="11" />
                    <TextBlock Text="{Binding SummaryStudentCount}" FontSize="18" FontWeight="Bold" Foreground="White" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="8,0">
                    <TextBlock Text="Admis" Foreground="#94A3B8" FontSize="11" />
                    <TextBlock Text="{Binding SummaryAdmitted}" FontSize="18" FontWeight="Bold" Foreground="#86EFAC" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="8,0">
                    <TextBlock Text="Ajournés" Foreground="#94A3B8" FontSize="11" />
                    <TextBlock Text="{Binding SummaryDeferred}" FontSize="18" FontWeight="Bold" Foreground="#FCD34D" />
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="8,0">
                    <TextBlock Text="Exclus" Foreground="#94A3B8" FontSize="11" />
                    <TextBlock Text="{Binding SummaryExcluded}" FontSize="18" FontWeight="Bold" Foreground="#FCA5A5" />
                </StackPanel>
                <StackPanel Grid.Column="5" Margin="8,0">
                    <TextBlock Text="Moyenne" Foreground="#94A3B8" FontSize="11" />
                    <TextBlock Text="{Binding SummaryClassAverage}" FontSize="18" FontWeight="Bold" Foreground="White" />
                </StackPanel>
                <StackPanel Grid.Column="6" Margin="8,0">
                    <TextBlock Text="Taux réussite" Foreground="#94A3B8" FontSize="11" />
                    <TextBlock Text="{Binding SummarySuccessRate}" FontSize="18" FontWeight="Bold" Foreground="White" />
                </StackPanel>
                <StackPanel Grid.Column="7" Margin="8,0">
                    <TextBlock Text="Calcul / MAJ" Foreground="#94A3B8" FontSize="11" />
                    <TextBlock Text="{Binding SummaryCalculatedAt}" FontSize="12" Foreground="White" />
                    <TextBlock Text="{Binding SummaryLastUpdated}" FontSize="11" Foreground="#94A3B8" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Grille + journal -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                    CornerRadius="10" Margin="0,0,10,0">
                <DataGrid ItemsSource="{Binding Rows}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          RowHeight="36"
                          AlternatingRowBackground="#F8FAFC">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Rang" Binding="{Binding RankDisplay}" Width="60" />
                        <DataGridTextColumn Header="Matricule" Binding="{Binding RegistrationNumber}" Width="110" />
                        <DataGridTextColumn Header="Nom complet" Binding="{Binding FullName}" Width="*" MinWidth="160" />
                        <DataGridTextColumn Header="Moyenne" Binding="{Binding AverageDisplay}" Width="80" />
                        <DataGridTextColumn Header="%" Binding="{Binding PercentageDisplay}" Width="70" />
                        <DataGridTextColumn Header="Mention" Binding="{Binding Mention}" Width="110" />
                        <DataGridTextColumn Header="Décision" Binding="{Binding DecisionLabel}" Width="100" />
                        <DataGridTextColumn Header="Statut" Binding="{Binding ValidationStatusLabel}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                    CornerRadius="10" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Journal des événements"
                               FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />
                    <ListBox ItemsSource="{Binding Events}" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding OperationLabel}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding OccurredAtDisplay}" FontSize="11" Foreground="#64748B" />
                                        <TextBlock Text="{Binding UserName}" FontSize="12" />
                                        <TextBlock Text="{Binding Observations}" FontSize="11" Foreground="#475569"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Actions + rapport -->
        <Border Grid.Row="3" Margin="0,10,0,0" Background="White" BorderBrush="#E2E8F0"
                BorderThickness="1" CornerRadius="10" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBox materialDesign:HintAssist.Hint="Observations (optionnel)"
                             Text="{Binding Observations, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,8" MaxWidth="480" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#475569" TextWrapping="Wrap" />
                    <ScrollViewer MaxHeight="120" Margin="0,6,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasReadinessIssues, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding ReadinessIssues}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="11" Foreground="#B45309"
                                               TextWrapping="Wrap" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"
                            Visibility="{Binding ShowLifecycleActions, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button Content="Valider" Height="36" Margin="0,0,6,0"
                            Command="{Binding ValidateCommand}"
                            IsEnabled="{Binding CanValidate}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#059669" BorderBrush="#059669" />
                    <Button Content="Annuler validation" Height="36" Margin="0,0,6,0"
                            Command="{Binding CancelValidationCommand}"
                            IsEnabled="{Binding CanCancelValidation}"
                            Style="{StaticResource MaterialDesignOutlinedButton}" />
                    <Button Content="Verrouiller" Height="36" Margin="0,0,6,0"
                            Command="{Binding LockCommand}"
                            IsEnabled="{Binding CanLock}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#0B1F47" BorderBrush="#0B1F47" />
                    <Button Content="Déverrouiller" Height="36"
                            Command="{Binding UnlockCommand}"
                            IsEnabled="{Binding CanUnlock}"
                            Style="{StaticResource MaterialDesignOutlinedButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.RowSpan="4" Background="#80FFFFFF"
              Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ProgressBar IsIndeterminate="True" Width="180" Height="4" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
