<UserControl x:Class="SchoolManagement.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <ScrollViewer Style="{StaticResource ErpPageHost}">
        <StackPanel Style="{StaticResource ErpFadeIn}">
            <!-- Welcome -->
            <Border Style="{StaticResource ErpCard}"
                    Background="{StaticResource ErpPrimaryBrush}"
                    BorderBrush="{StaticResource ErpPrimaryBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontFamily="{StaticResource ErpFontFamily}"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Text="{Binding WelcomeMessage}" />
                        <TextBlock Margin="0,8,0,0"
                                   FontFamily="{StaticResource ErpFontFamily}"
                                   FontSize="14"
                                   Foreground="#C7D7FF"
                                   Text="Vue d'ensemble de votre établissement scolaire"
                                   TextWrapping="Wrap" />
                        <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                            <Border Background="#FFFFFF22"
                                    CornerRadius="8"
                                    Padding="10,6">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource ErpSuccessBrush}" VerticalAlignment="Center" />
                                    <TextBlock Margin="8,0,0,0"
                                               FontSize="13"
                                               Foreground="White"
                                               Text="{Binding ApiStatus, StringFormat=État API : {0}}" />
                                </StackPanel>
                            </Border>
                            <Button Margin="12,0,0,0"
                                    Command="{Binding RefreshApiStatusCommand}"
                                    Content="Actualiser"
                                    Style="{StaticResource ErpSecondaryButton}"
                                    Background="#FFFFFF22"
                                    BorderBrush="#FFFFFF44"
                                    Foreground="White" />
                        </StackPanel>
                    </StackPanel>
                    <materialDesign:PackIcon Grid.Column="1"
                                             Kind="ViewDashboard"
                                             Width="80"
                                             Height="80"
                                             Opacity="0.25"
                                             Foreground="White"
                                             VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- KPI Cards -->
            <UniformGrid Margin="0,16,0,0" Columns="5" Rows="1">
                <Border Style="{StaticResource ErpStatCard}" Margin="0,0,8,0">
                    <Grid>
                        <StackPanel>
                            <Border Width="44" Height="44" Background="#E8EFFF" CornerRadius="12">
                                <materialDesign:PackIcon Kind="AccountGroup" Width="24" Height="24" Foreground="{StaticResource ErpPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Margin="0,12,0,0" Style="{StaticResource ErpStatValue}" Text="—" />
                            <TextBlock Style="{StaticResource ErpStatLabel}" Text="Élèves inscrits" />
                            <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource ErpSuccessBrush}" Text="Module Statistiques" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource ErpStatCard}" Margin="4,0">
                    <StackPanel>
                        <Border Width="44" Height="44" Background="#ECFDF5" CornerRadius="12">
                            <materialDesign:PackIcon Kind="AccountTie" Width="24" Height="24" Foreground="{StaticResource ErpSuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Margin="0,12,0,0" Style="{StaticResource ErpStatValue}" Text="—" />
                        <TextBlock Style="{StaticResource ErpStatLabel}" Text="Enseignants" />
                        <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource ErpSuccessBrush}" Text="Module Statistiques" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ErpStatCard}" Margin="4,0">
                    <StackPanel>
                        <Border Width="44" Height="44" Background="#FFF7ED" CornerRadius="12">
                            <materialDesign:PackIcon Kind="GoogleClassroom" Width="24" Height="24" Foreground="{StaticResource ErpWarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Margin="0,12,0,0" Style="{StaticResource ErpStatValue}" Text="—" />
                        <TextBlock Style="{StaticResource ErpStatLabel}" Text="Classes actives" />
                        <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource ErpSuccessBrush}" Text="Module Statistiques" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ErpStatCard}" Margin="4,0">
                    <StackPanel>
                        <Border Width="44" Height="44" Background="#F0FDF4" CornerRadius="12">
                            <materialDesign:PackIcon Kind="CalendarCheck" Width="24" Height="24" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Margin="0,12,0,0" Style="{StaticResource ErpStatValue}" Text="—" />
                        <TextBlock Style="{StaticResource ErpStatLabel}" Text="Taux de présence" />
                        <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource ErpTextSecondaryBrush}" Text="Bientôt disponible" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ErpStatCard}" Margin="8,0,0,0">
                    <StackPanel>
                        <Border Width="44" Height="44" Background="#FEF2F2" CornerRadius="12">
                            <materialDesign:PackIcon Kind="CashMultiple" Width="24" Height="24" Foreground="{StaticResource ErpDangerBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Margin="0,12,0,0" Style="{StaticResource ErpStatValue}" Text="—" />
                        <TextBlock Style="{StaticResource ErpStatLabel}" Text="Impayés (CDF)" />
                        <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource ErpDangerBrush}" Text="Module Financier" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Charts row -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource ErpCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ErpSubtitle}" Text="Répartition des élèves" />
                        <TextBlock Margin="0,4,0,16" Style="{StaticResource ErpBodySecondary}" Text="Par cycle d'enseignement" />
                        <Grid Height="180">
                            <Ellipse Width="140" Height="140" HorizontalAlignment="Center" Stroke="{StaticResource ErpBorderBrush}" StrokeThickness="20" />
                            <Ellipse Width="140" Height="140" HorizontalAlignment="Center" Stroke="{StaticResource ErpPrimaryBrush}" StrokeThickness="20" StrokeDashArray="2.5 1.5" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><RotateTransform Angle="-90" /></Ellipse.RenderTransform>
                            </Ellipse>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center" Style="{StaticResource ErpStatValue}" FontSize="24" Text="RDC" />
                                <TextBlock HorizontalAlignment="Center" Style="{StaticResource ErpStatLabel}" Text="Structure officielle" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource ErpCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ErpSubtitle}" Text="Évolution des inscriptions" />
                        <TextBlock Margin="0,4,0,16" Style="{StaticResource ErpBodySecondary}" Text="Tendance annuelle" />
                        <Canvas Height="180">
                            <Polyline Stroke="{StaticResource ErpPrimaryBrush}" StrokeThickness="3" StrokeLineJoin="Round"
                                      Points="10,150 60,120 110,130 160,80 220,90 280,40 340,60" />
                            <Polyline Stroke="#E5E7EB" StrokeThickness="1" Points="10,150 340,150" />
                        </Canvas>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Bottom row -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource ErpCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ErpSubtitle}" Text="Alertes" />
                        <Border Margin="0,12,0,0" Background="#FEF2F2" CornerRadius="10" Padding="12">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AlertCircle" Foreground="{StaticResource ErpDangerBrush}" VerticalAlignment="Center" />
                                <TextBlock Margin="10,0,0,0" Style="{StaticResource ErpBody}" TextWrapping="Wrap" Text="Consultez le module Statistiques pour les alertes financières." />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,8,0,0" Background="#FFFBEB" CornerRadius="10" Padding="12">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Information" Foreground="{StaticResource ErpWarningBrush}" VerticalAlignment="Center" />
                                <TextBlock Margin="10,0,0,0" Style="{StaticResource ErpBody}" TextWrapping="Wrap" Text="Activez vos classes dans Paramètres → Structure pédagogique." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource ErpCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ErpSubtitle}" Text="Événements" />
                        <StackPanel Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Width="4" Background="{StaticResource ErpPrimaryBrush}" CornerRadius="2" Margin="0,0,12,0" />
                                <StackPanel>
                                    <TextBlock Style="{StaticResource ErpBody}" Text="Rentrée scolaire 2025-2026" />
                                    <TextBlock Style="{StaticResource ErpBodySecondary}" Text="Septembre 2025" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="4" Background="{StaticResource ErpSuccessBrush}" CornerRadius="2" Margin="0,0,12,0" />
                                <StackPanel>
                                    <TextBlock Style="{StaticResource ErpBody}" Text="Examens de fin de trimestre" />
                                    <TextBlock Style="{StaticResource ErpBodySecondary}" Text="À planifier" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource ErpCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ErpSubtitle}" Text="Communication récente" />
                        <TextBlock Margin="0,12,0,0" Style="{StaticResource ErpBodySecondary}" TextWrapping="Wrap" Text="Aucun message récent. Le module Communication sera disponible prochainement." />
                        <Button Margin="0,16,0,0"
                                HorizontalAlignment="Left"
                                Content="Nouveau message"
                                Style="{StaticResource ErpSecondaryButton}"
                                IsEnabled="False" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
