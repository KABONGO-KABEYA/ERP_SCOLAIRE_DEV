<Window x:Class="SchoolManagement.Desktop.Views.DatabaseServerConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SchoolManagement.Desktop.Controls"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Configuration du serveur SQL"
        Height="720"
        Width="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource ErpPageBackgroundBrush}"
        FontFamily="{StaticResource ErpFontFamily}">
    <Grid Margin="24">
        <Border Style="{StaticResource ErpCard}">
            <Grid Margin="28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Style="{StaticResource ErpFadeIn}">
                    <Border Width="56"
                            Height="56"
                            Background="{StaticResource ErpPrimaryLightBrush}"
                            CornerRadius="14"
                            HorizontalAlignment="Left">
                        <materialDesign:PackIcon Kind="DatabaseCog"
                                                 Width="28"
                                                 Height="28"
                                                 Foreground="{StaticResource ErpPrimaryBrush}"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Margin="0,18,0,6"
                               Style="{StaticResource ErpSectionTitle}"
                               FontSize="24"
                               Text="Configuration du serveur SQL" />
                    <TextBlock Style="{StaticResource ErpBodySecondary}"
                               Text="Paramétrez la connexion à SQL Server via le fichier ServeurDonnees.txt. Aucune recompilation n'est nécessaire pour changer de serveur."
                               TextWrapping="Wrap" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" Margin="0,24,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource ErpFadeIn}">
                        <TextBlock Margin="0,0,0,12"
                                   Style="{StaticResource ErpSectionTitle}"
                                   FontSize="16"
                                   Text="Informations serveur" />

                        <controls:ErpTextField Label="Nom ou adresse IP du serveur"
                                               IconKind="Server"
                                               IsRequired="True"
                                               Margin="0,0,0,4"
                                               Text="{Binding Serveur, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,0,0,12"
                                   Foreground="{StaticResource ErpDangerBrush}"
                                   Text="{Binding ServeurError}"
                                   TextWrapping="Wrap" />

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>
                            <controls:ErpTextField Grid.Column="0"
                                                   Label="Base de données"
                                                   IconKind="Database"
                                                   IsRequired="True"
                                                   Text="{Binding Base, UpdateSourceTrigger=PropertyChanged}" />
                            <controls:ErpTextField Grid.Column="2"
                                                   Label="Port"
                                                   IconKind="LanConnect"
                                                   IsRequired="True"
                                                   Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <TextBlock Margin="0,0,0,12"
                                   Foreground="{StaticResource ErpDangerBrush}"
                                   Text="{Binding BaseError}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,-8,0,12"
                                   Foreground="{StaticResource ErpDangerBrush}"
                                   Text="{Binding PortError}"
                                   TextWrapping="Wrap" />

                        <TextBlock Margin="0,8,0,12"
                                   Style="{StaticResource ErpSectionTitle}"
                                   FontSize="16"
                                   Text="Authentification" />

                        <Border Margin="0,0,0,16"
                                Padding="14,12"
                                Background="#F8FAFC"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="10">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ShieldKey"
                                                         Width="20"
                                                         Height="20"
                                                         Margin="0,0,10,0"
                                                         Foreground="{StaticResource ErpPrimaryBrush}"
                                                         VerticalAlignment="Center" />
                                <TextBlock VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Foreground="#1F2937"
                                           Text="{Binding AuthenticationLabel}" />
                            </StackPanel>
                        </Border>

                        <controls:ErpTextField Label="Utilisateur SQL"
                                               IconKind="Account"
                                               IsRequired="True"
                                               Margin="0,0,0,4"
                                               Text="{Binding Utilisateur, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,0,0,12"
                                   Foreground="{StaticResource ErpDangerBrush}"
                                   Text="{Binding UtilisateurError}"
                                   TextWrapping="Wrap" />

                        <TextBlock Margin="{StaticResource ErpFieldLabelSpacing}"
                                   Style="{StaticResource ErpFieldLabel}"
                                   Text="Mot de passe SQL" />
                        <TextBlock Style="{StaticResource ErpFieldRequiredMark}" Text="*" />
                        <PasswordBox x:Name="PasswordBox"
                                     Margin="0,6,0,4"
                                     PasswordChanged="PasswordBox_OnPasswordChanged"
                                     Style="{StaticResource ErpPasswordBox}" />
                        <TextBlock Foreground="{StaticResource ErpDangerBrush}"
                                   Text="{Binding MotDePasseError}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2"
                        Margin="0,20,0,0"
                        Padding="14,12"
                        Background="#F8FAFC"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon x:Name="StatusIcon"
                                                 Width="20"
                                                 Height="20"
                                                 Margin="0,0,10,0"
                                                 VerticalAlignment="Center" />
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding ConnectionStatusMessage}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="3" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            HorizontalAlignment="Left"
                            Command="{Binding ResetCommand}"
                            Content="Réinitialiser"
                            Style="{StaticResource ErpSecondaryButton}" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Margin="0,0,10,0"
                                Command="{Binding CancelCommand}"
                                Content="Annuler"
                                Style="{StaticResource ErpSecondaryButton}" />
                        <Button Margin="0,0,10,0"
                                Command="{Binding TestConnectionCommand}"
                                Content="Tester la connexion"
                                Style="{StaticResource ErpSecondaryButton}" />
                        <Button Command="{Binding SaveCommand}"
                                Content="Enregistrer"
                                Style="{StaticResource ErpPrimaryButton}" />
                    </StackPanel>
                </Grid>

                <ProgressBar Grid.Row="3"
                             Height="3"
                             Margin="0,68,0,-8"
                             Foreground="{StaticResource ErpPrimaryBrush}"
                             IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Border>
    </Grid>
</Window>
