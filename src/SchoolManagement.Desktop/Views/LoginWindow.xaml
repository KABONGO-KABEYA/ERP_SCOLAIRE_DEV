<Window x:Class="SchoolManagement.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SchoolManagement.Desktop.Controls"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        Title="Connexion — ERP Scolaire RDC"
        Icon="pack://siteoforigin:,,,/Assets/app.ico"
        Width="1140"
        Height="740"
        MinWidth="960"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource LoginFontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        MouseLeftButtonDown="Window_OnMouseLeftButtonDown">
    <Border Margin="12"
            Background="White"
            CornerRadius="20"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32"
                              Direction="270"
                              Opacity="0.28"
                              ShadowDepth="6"
                              Color="#0F172A" />
        </Border.Effect>

        <Grid x:Name="LoginRootGrid"
              ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <!-- Maquette complète Right_Login.png (sans rognage) -->
            <Grid x:Name="LeftPanelHost"
                  Grid.Column="0"
                  MinWidth="480"
                  ClipToBounds="True"
                  Panel.ZIndex="0"
                  Opacity="1">
                <Image Source="pack://application:,,,/Assets/Right_Login.png"
                       Stretch="UniformToFill"
                       VerticalAlignment="Stretch"
                       HorizontalAlignment="Left"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>

            <!-- Panneau connexion (découpé sur la courbe, sans dépasser le panneau gauche) -->
            <Grid x:Name="RightPanelHost"
                  Grid.Column="1"
                  Background="White"
                  Margin="-20,0,0,0"
                  Panel.ZIndex="1"
                  ClipToBounds="True"
                  Opacity="1">
                <Grid.RenderTransform>
                    <TranslateTransform X="36" />
                </Grid.RenderTransform>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Chrome + Version.png -->
                <StackPanel Grid.Row="0"
                            HorizontalAlignment="Right"
                            Margin="0,8,12,0"
                            Panel.ZIndex="10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Click="MinimizeButton_OnClick"
                                Style="{StaticResource LoginChromeButton}"
                                ToolTip="Réduire">
                            <fa:IconImage Icon="{x:Static fa:IconChar.Minus}" Height="14" Width="14" />
                        </Button>
                        <Button Click="MaximizeButton_OnClick"
                                Style="{StaticResource LoginChromeButton}"
                                ToolTip="Agrandir">
                            <fa:IconImage x:Name="MaximizeIcon"
                                          Icon="{x:Static fa:IconChar.Square}"
                                          Height="12"
                                          Width="12" />
                        </Button>
                        <Button Click="CloseButton_OnClick"
                                Style="{StaticResource LoginCloseChromeButton}"
                                ToolTip="Fermer">
                            <fa:IconImage Icon="{x:Static fa:IconChar.Xmark}" Height="14" Width="14" />
                        </Button>
                    </StackPanel>

                    <Image Source="pack://application:,,,/Assets/Version.png"
                           Height="88"
                           Width="88"
                           HorizontalAlignment="Right"
                           Margin="0,4,0,0"
                           Stretch="Uniform"
                           SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </StackPanel>

                <controls:LoginFormPanel x:Name="LoginForm"
                                         Grid.Row="1"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Stretch"
                                         DataContext="{Binding}" />
            </Grid>
        </Grid>
    </Border>
</Window>
