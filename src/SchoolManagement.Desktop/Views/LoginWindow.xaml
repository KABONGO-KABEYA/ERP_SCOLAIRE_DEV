<Window x:Class="SchoolManagement.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SchoolManagement.Desktop.Controls"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        Title="Connexion — ERP Scolaire RDC"
        Icon="pack://siteoforigin:,,,/Assets/app.ico"
        Width="1180"
        Height="760"
        MinWidth="1000"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource LoginFontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        MouseLeftButtonDown="Window_OnMouseLeftButtonDown">
    <Border Margin="12"
            Background="White"
            CornerRadius="20"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32"
                              Direction="270"
                              Opacity="0.28"
                              ShadowDepth="6"
                              Color="#0F172A" />
        </Border.Effect>

        <Grid x:Name="LoginRootGrid"
              ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <!-- Largeur calculée en code = hauteur × (895/1024) pour Right_Login.png sans rognage -->
                <ColumnDefinition x:Name="LeftColumn" Width="520" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- Maquette complète Right_Login.png — Stretch Uniform : jamais rognée -->
            <Border x:Name="LeftPanelHost"
                    Grid.Column="0"
                    Background="Transparent"
                    ClipToBounds="True"
                    Panel.ZIndex="0"
                    Opacity="1">
                <Image Source="pack://application:,,,/Assets/Right_Login.png"
                       Stretch="Uniform"
                       VerticalAlignment="Stretch"
                       HorizontalAlignment="Stretch"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>

            <!-- Formulaire : léger chevauchement uniquement sur la zone transparente de l'image -->
            <Grid x:Name="RightPanelHost"
                  Grid.Column="1"
                  Background="White"
                  Margin="-36,0,0,0"
                  Panel.ZIndex="1"
                  ClipToBounds="True"
                  Opacity="1">
                <Grid.RenderTransform>
                    <TranslateTransform X="36" />
                </Grid.RenderTransform>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Chrome + Version.png -->
                <StackPanel Grid.Row="0"
                            HorizontalAlignment="Right"
                            Margin="0,4,8,0"
                            Panel.ZIndex="10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Click="MinimizeButton_OnClick"
                                Style="{StaticResource LoginChromeButton}"
                                ToolTip="Réduire">
                            <fa:IconImage Icon="{x:Static fa:IconChar.Minus}" Height="12" Width="12" />
                        </Button>
                        <Button Click="MaximizeButton_OnClick"
                                Style="{StaticResource LoginChromeButton}"
                                ToolTip="Agrandir">
                            <fa:IconImage x:Name="MaximizeIcon"
                                          Icon="{x:Static fa:IconChar.Square}"
                                          Height="11"
                                          Width="11" />
                        </Button>
                        <Button Click="CloseButton_OnClick"
                                Style="{StaticResource LoginCloseChromeButton}"
                                ToolTip="Fermer">
                            <fa:IconImage Icon="{x:Static fa:IconChar.Xmark}" Height="12" Width="12" />
                        </Button>
                    </StackPanel>

                    <Image Source="pack://application:,,,/Assets/Version.png"
                           Height="56"
                           Width="56"
                           HorizontalAlignment="Right"
                           Margin="0,2,0,0"
                           Stretch="Uniform"
                           SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </StackPanel>

                <controls:LoginFormPanel x:Name="LoginForm"
                                         Grid.Row="1"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Stretch"
                                         DataContext="{Binding}" />
            </Grid>
        </Grid>
    </Border>
</Window>
