<Window x:Class="SchoolManagement.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Connexion — ERP Scolaire RDC"
        Height="560"
        Width="960"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F7FB"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0F1F3D">
            <Grid Margin="48">
                <StackPanel VerticalAlignment="Center">
                    <Border Width="72" Height="72" Background="#1E5EFF" CornerRadius="18">
                        <materialDesign:PackIcon Kind="School" Width="40" Height="40" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Margin="0,24,0,8"
                               FontSize="32"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Text="ERP Scolaire RDC" />
                    <TextBlock FontSize="16"
                               Foreground="#94A3B8"
                               Text="Administration scolaire moderne"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,24,0,0"
                               FontSize="14"
                               Foreground="#64748B"
                               Text="Gestion des élèves, notes, finances et rapports — conforme au système éducatif congolais."
                               TextWrapping="Wrap"
                               MaxWidth="360" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Background="White"
                Padding="48,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock FontSize="24"
                           FontWeight="Bold"
                           Foreground="#1F2937"
                           Text="Connexion" />
                <TextBlock Margin="0,8,0,32"
                           FontSize="13"
                           Foreground="#6B7280"
                           Text="Accédez à votre espace de gestion" />

                <TextBox materialDesign:HintAssist.Hint="Nom d'utilisateur"
                         materialDesign:HintAssist.Foreground="#6B7280"
                         Height="42"
                         Margin="0,0,0,16"
                         Padding="12,8"
                         FontSize="14"
                         Foreground="#1F2937"
                         Background="White"
                         BorderBrush="#E5E7EB"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />

                <PasswordBox x:Name="PasswordBox"
                             materialDesign:HintAssist.Hint="Mot de passe"
                             materialDesign:HintAssist.Foreground="#6B7280"
                             Height="42"
                             Margin="0,0,0,8"
                             Padding="12,8"
                             FontSize="14"
                             Foreground="#1F2937"
                             Background="White"
                             BorderBrush="#E5E7EB"
                             PasswordChanged="PasswordBox_OnPasswordChanged"
                             Style="{StaticResource MaterialDesignOutlinedPasswordBox}" />

                <TextBlock Foreground="#EF4444"
                           Text="{Binding ErrorMessage}"
                           TextWrapping="Wrap" />

                <Button Margin="0,24,0,0"
                        Command="{Binding LoginCommand}"
                        Content="Se connecter"
                        Height="42"
                        HorizontalAlignment="Stretch"
                        Background="#1E5EFF"
                        BorderBrush="#1E5EFF"
                        Foreground="White"
                        FontSize="14"
                        FontWeight="SemiBold"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        Style="{StaticResource MaterialDesignRaisedButton}" />

                <ProgressBar Margin="0,16,0,0"
                             Height="3"
                             Foreground="#1E5EFF"
                             IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
