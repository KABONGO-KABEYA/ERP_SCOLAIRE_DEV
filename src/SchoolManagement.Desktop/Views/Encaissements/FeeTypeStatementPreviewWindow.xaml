<Window x:Class="SchoolManagement.Desktop.Views.Encaissements.FeeTypeStatementPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Aperçu du relevé"
        Width="720"
        Height="900"
        MinWidth="560"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource ErpPageBackgroundBrush}">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Margin="0,0,8,0"
                        Click="PrintButton_OnClick"
                        Style="{StaticResource ErpPrimaryButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Margin="0,0,6,0" Kind="Printer" VerticalAlignment="Center" />
                        <TextBlock Text="Imprimer" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Margin="0,0,8,0"
                        Click="ExportPdfButton_OnClick"
                        Style="{StaticResource ErpSecondaryButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Margin="0,0,6,0" Kind="FilePdfBox" VerticalAlignment="Center" />
                        <TextBlock Text="PDF" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="CloseButton_OnClick" Style="{StaticResource ErpSecondaryButton}" Content="Fermer" />
            </StackPanel>
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Aperçu du relevé" />
                <TextBlock x:Name="SubtitleText"
                           Margin="0,4,0,0"
                           Foreground="{StaticResource ErpTextSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <Border Background="White"
                BorderBrush="{StaticResource ErpInputBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8">
            <FlowDocumentScrollViewer x:Name="DocumentViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      IsToolBarVisible="False" />
        </Border>
    </DockPanel>
</Window>
