<Window x:Class="SchoolManagement.Desktop.Views.Encaissements.CollectPaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:encaissements="clr-namespace:SchoolManagement.Desktop.Controls.Encaissements"
        Title="Encaisser un paiement"
        Height="720"
        Width="1000"
        MinHeight="560"
        MinWidth="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource ErpPageBackgroundBrush}"
        FontFamily="{StaticResource ErpFontFamily}"
        Loaded="Window_OnLoaded">
    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                Padding="16,8"
                Background="#FFFFFF"
                BorderBrush="#E5E7EB"
                BorderThickness="0,1,0,0"
                VerticalAlignment="Bottom">
            <encaissements:PaymentFooter />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24,20">
            <StackPanel Style="{StaticResource ErpFadeIn}" MaxWidth="960" HorizontalAlignment="Stretch">
                <encaissements:StudentSummaryCard Margin="0,0,0,14" />
                <encaissements:PaymentAmountCard Margin="0,0,0,14" />
                <encaissements:InstallmentTable Margin="0,0,0,8" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
