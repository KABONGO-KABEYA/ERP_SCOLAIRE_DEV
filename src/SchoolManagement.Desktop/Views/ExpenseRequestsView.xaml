<UserControl x:Class="SchoolManagement.Desktop.Views.ExpenseRequestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:erp="clr-namespace:SchoolManagement.Desktop.Controls">
    <Grid Margin="0" Style="{StaticResource ErpFadeIn}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="240" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,8"
                Padding="12,10"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="10">
            <StackPanel>
                <TextBlock FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#1F2937"
                           Text="Nouvelle demande de paiement" />
                <UniformGrid Columns="3" Margin="0,10,0,0">
                    <erp:ErpComboField Margin="0,0,12,12"
                                       DisplayMemberPath="Name"
                                       ItemsSource="{Binding Destinations}"
                                       Label="Compte bénéficiaire"
                                       SelectedItem="{Binding SelectedDestination, Mode=TwoWay}" />
                    <erp:ErpTextField Margin="0,0,12,12"
                                      Label="Objet"
                                      Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" />
                    <erp:ErpTextField Margin="0,0,0,12"
                                      Label="Montant"
                                      Text="{Binding NewAmount, UpdateSourceTrigger=PropertyChanged}"
                                      ValidationMode="Decimal" />
                </UniformGrid>
                <StackPanel Orientation="Horizontal">
                    <Button Margin="0,0,8,0"
                            Command="{Binding CreateCommand}"
                            Content="Créer en brouillon"
                            Style="{StaticResource ErpPrimaryButton}" />
                    <Button Command="{Binding SearchCommand}"
                            Content="Actualiser"
                            Style="{StaticResource ErpSecondaryButton}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="10">
            <DataGrid CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      ItemsSource="{Binding Requests}"
                      SelectedItem="{Binding SelectedRequest, Mode=TwoWay}"
                      Style="{StaticResource ErpDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Reference}" Header="Réf." Width="120" />
                    <DataGridTextColumn Binding="{Binding Title}" Header="Objet" Width="*" MinWidth="160" />
                    <DataGridTextColumn Binding="{Binding DestinationName}" Header="Compte" Width="140" />
                    <DataGridTextColumn Binding="{Binding RequestedAmount, StringFormat=N2}" Header="Montant" Width="100" />
                    <DataGridTextColumn Binding="{Binding RequestDate, StringFormat=dd/MM/yyyy}" Header="Date" Width="100" />
                    <DataGridTextColumn Binding="{Binding StatusLabel}" Header="Statut" Width="100" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Margin="0,0,8,0"
                        Command="{Binding SubmitCommand}"
                        Content="Soumettre"
                        IsEnabled="{Binding CanSubmit}"
                        Style="{StaticResource ErpSecondaryButton}" />
                <Button Command="{Binding ApproveCommand}"
                        Content="Approuver"
                        IsEnabled="{Binding CanApprove}"
                        Style="{StaticResource ErpPrimaryButton}" />
            </StackPanel>
            <TextBlock VerticalAlignment="Center"
                       Foreground="#6B7280"
                       Text="{Binding StatusMessage}" />
        </DockPanel>
    </Grid>
</UserControl>
