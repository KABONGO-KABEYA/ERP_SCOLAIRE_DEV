<UserControl x:Class="SchoolManagement.Desktop.Views.DashboardEnrolledStudentsDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:erp="clr-namespace:SchoolManagement.Desktop.Controls"
             xmlns:ui="clr-namespace:SchoolManagement.Desktop.UI">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <ui:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <ui:HexToBrushConverter x:Key="HexToBrush" />
        <ui:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <ui:StringNullOrEmptyToVisibilityConverter x:Key="StringNullOrEmptyToVisibilityConverter" />

        <Style x:Key="AnalyticsKpiCard" TargetType="Border" BasedOn="{StaticResource ErpCard}">
            <Setter Property="MinHeight" Value="118" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <Style x:Key="AnalyticsKpiLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="AnalyticsKpiValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="32" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#0F1F4A" />
        </Style>

        <Style x:Key="AnalyticsTableHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="AnalyticsTableCell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#0F1F4A" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="AnalyticsTableCellWrap" TargetType="TextBlock" BasedOn="{StaticResource AnalyticsTableCell}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,2,12,2" />
        </Style>

        <Style x:Key="AnalyticsRegimeExpander" TargetType="Expander">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="AnalyticsClassExpander" TargetType="Expander">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource ErpPageHost}" Background="{StaticResource ErpPageBackgroundBrush}">
        <StackPanel Style="{StaticResource ErpFadeIn}" Margin="0,0,0,24">

            <!-- EN-TÊTE -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Button Margin="0,0,0,12"
                            HorizontalAlignment="Left"
                            Command="{Binding GoBackCommand}"
                            Style="{StaticResource ErpSecondaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ArrowLeft" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Retour" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock FontSize="28" FontWeight="SemiBold" Foreground="#0F1F4A"
                               Text="Élèves inscrits — analyse" />
                    <TextBlock Margin="0,6,0,0" FontSize="14" Foreground="#64748B" TextWrapping="Wrap"
                               Text="Regroupement par régime scolaire puis par classe. Consultez le détail jusqu'à la fiche de l'élève et sa situation financière." />
                </StackPanel>

                <Button Grid.Column="1" Padding="16,10" VerticalAlignment="Top"
                        Command="{Binding LoadCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                        Style="{StaticResource ErpPrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18"
                                                     VerticalAlignment="Center" />
                            <TextBlock Margin="8,0,0,0" FontWeight="SemiBold" Text="Actualiser"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
            </Grid>

            <TextBlock Margin="0,0,0,16" Foreground="#DC2626" Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       Visibility="{Binding StatusMessage, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" />

            <!-- KPI -->
            <UniformGrid Columns="5" Margin="0,0,0,20">
                <Border Background="#1E3A8A" CornerRadius="16" Padding="16,14" Margin="0,0,12,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountGroup" Width="20" Height="20"
                                                     Foreground="#BFDBFE" VerticalAlignment="Center" />
                            <TextBlock Margin="8,0,0,0" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#DBEAFE" Text="TOTAL ÉLÈVES" />
                        </StackPanel>
                        <TextBlock Margin="0,10,0,0" FontSize="34" FontWeight="Bold"
                                   Foreground="White" Text="{Binding TotalStudents}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AnalyticsKpiCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="28" Height="28" CornerRadius="8" Background="#DBEAFE">
                                <materialDesign:PackIcon Kind="GenderMale" Width="16" Height="16"
                                                         Foreground="#1E3A8A"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Margin="8,0,0,0" Style="{StaticResource AnalyticsKpiLabel}"
                                       VerticalAlignment="Center" Text="GARÇONS" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource AnalyticsKpiValue}" Text="{Binding TotalBoys}" />
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#1E3A8A"
                                   Text="{Binding BoysPercentLabel}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AnalyticsKpiCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="28" Height="28" CornerRadius="8" Background="#FCE7F3">
                                <materialDesign:PackIcon Kind="GenderFemale" Width="16" Height="16"
                                                         Foreground="#DB2777"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Margin="8,0,0,0" Style="{StaticResource AnalyticsKpiLabel}"
                                       VerticalAlignment="Center" Text="FILLES" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource AnalyticsKpiValue}" Text="{Binding TotalGirls}" />
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#DB2777"
                                   Text="{Binding GirlsPercentLabel}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AnalyticsKpiCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="28" Height="28" CornerRadius="8" Background="#DCFCE7">
                                <materialDesign:PackIcon Kind="ChartLine" Width="16" Height="16"
                                                         Foreground="#16A34A"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Margin="8,0,0,0" Style="{StaticResource AnalyticsKpiLabel}"
                                       VerticalAlignment="Center" Text="MOYENNE PAR CLASSE" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource AnalyticsKpiValue}" Text="{Binding AveragePerClassLabel}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AnalyticsKpiCard}" Margin="0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="28" Height="28" CornerRadius="8" Background="#EDE9FE">
                                <materialDesign:PackIcon Kind="GoogleClassroom" Width="16" Height="16"
                                                         Foreground="#7C3AED"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Margin="8,0,0,0" Style="{StaticResource AnalyticsKpiLabel}"
                                       VerticalAlignment="Center" Text="CLASSES ACTIVES" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource AnalyticsKpiValue}" Text="{Binding ActiveClassesCount}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- RECHERCHE ÉLÈVE -->
            <Border Margin="0,0,0,16"
                    Padding="10,8"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="10">
                <erp:ErpSearchField HorizontalAlignment="Stretch"
                                    Placeholder="Rechercher un élève (matricule, nom ou prénom)…"
                                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            </Border>

            <!-- RÉSULTATS RECHERCHE -->
            <StackPanel Margin="0,0,0,16"
                        Visibility="{Binding IsSearchMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid Margin="0,0,0,10">
                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#0F1F4A"
                               Text="{Binding SearchResultsLabel}" />
                    <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="#64748B"
                               Text="Chargement..."
                               Visibility="{Binding IsSearching, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>

                <TextBlock Margin="0,0,0,10" Foreground="#DC2626"
                           Text="{Binding SearchStatusMessage}"
                           TextWrapping="Wrap"
                           Visibility="{Binding SearchStatusMessage, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" />

                <Border Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        ClipToBounds="True"
                        CornerRadius="12">
                    <DataGrid AutoGenerateColumns="False"
                              AlternatingRowBackground="#F8FAFC"
                              Background="Transparent"
                              BorderThickness="0"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserResizeColumns="True"
                              CellStyle="{StaticResource ErpUsersListCell}"
                              ColumnHeaderStyle="{StaticResource ErpUsersListColumnHeader}"
                              EnableColumnVirtualization="True"
                              EnableRowVirtualization="True"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              HorizontalGridLinesBrush="#F1F5F9"
                              IsReadOnly="True"
                              ItemsSource="{Binding SearchResults}"
                              RowBackground="Transparent"
                              RowHeight="34"
                              RowStyle="{StaticResource ErpUsersListRow}"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              VerticalGridLinesBrush="#F1F5F9">
                        <DataGrid.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#EEF2FF" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0F172A" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#F1F5F9" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#0F172A" />
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding RowNumber}"
                                                Header="N°"
                                                Width="44" />
                            <DataGridTextColumn Binding="{Binding RegistrationNumber}"
                                                Header="MATRICULE"
                                                Width="110" />
                            <DataGridTextColumn Binding="{Binding FullName}"
                                                Header="NOM ET PRÉNOMS"
                                                Width="*" />
                            <DataGridTextColumn Binding="{Binding ClassName}"
                                                Header="CLASSE"
                                                Width="160" />
                            <DataGridTextColumn Binding="{Binding GenderLabel}"
                                                Header="SEXE"
                                                Width="60" />
                            <DataGridTextColumn Binding="{Binding DateOfBirthLabel}"
                                                Header="DATE NAISSANCE"
                                                Width="120" />
                            <DataGridTemplateColumn Header="ACTION" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding OpenCommand}"
                                                Cursor="Hand"
                                                Height="28"
                                                Padding="0"
                                                ToolTip="Consulter la fiche"
                                                Width="28">
                                            <materialDesign:PackIcon Kind="Eye"
                                                                     Width="16"
                                                                     Height="16"
                                                                     Foreground="#1E5EFF" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </StackPanel>

            <!-- RÉGIMES -->
            <ItemsControl ItemsSource="{Binding RegimeGroups}"
                          Visibility="{Binding IsSearchMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,14"
                                Background="{Binding AccentBackgroundHex, Converter={StaticResource HexToBrush}}"
                                BorderBrush="{Binding AccentBorderHex, Converter={StaticResource HexToBrush}}"
                                BorderThickness="1" CornerRadius="16">
                            <Expander Style="{StaticResource AnalyticsRegimeExpander}" IsExpanded="False">
                                <Expander.Header>
                                    <Grid Margin="4,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="18" FontWeight="Bold"
                                                   Foreground="{Binding AccentTitleHex, Converter={StaticResource HexToBrush}}"
                                                   Text="{Binding RegimeTitle}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                                                    CornerRadius="999" Padding="10,4" Margin="0,0,6,0">
                                                <TextBlock FontSize="12" Foreground="#475569"
                                                           Text="{Binding StudentsBadge}" />
                                            </Border>
                                            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                                                    CornerRadius="999" Padding="10,4" Margin="0,0,6,0">
                                                <TextBlock FontSize="12" Foreground="#475569"
                                                           Text="{Binding BoysBadge}" />
                                            </Border>
                                            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                                                    CornerRadius="999" Padding="10,4" Margin="0,0,6,0">
                                                <TextBlock FontSize="12" Foreground="#475569"
                                                           Text="{Binding GirlsBadge}" />
                                            </Border>
                                            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                                                    CornerRadius="999" Padding="10,4" Margin="0,0,6,0">
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#475569"
                                                           Text="{Binding ClassesBadge}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Expander.Header>

                                <StackPanel Margin="0,0,0,8">
                                    <Border Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="0,1,0,1"
                                            Padding="14,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="280" />
                                                <ColumnDefinition Width="*" MinWidth="220" />
                                                <ColumnDefinition Width="72" />
                                                <ColumnDefinition Width="72" />
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="56" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource AnalyticsTableHeader}" Text="Classe" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource AnalyticsTableHeader}" Text="Section" />
                                            <TextBlock Grid.Column="2" HorizontalAlignment="Right"
                                                       Style="{StaticResource AnalyticsTableHeader}" Text="Garçons" />
                                            <TextBlock Grid.Column="3" HorizontalAlignment="Right"
                                                       Style="{StaticResource AnalyticsTableHeader}" Text="Filles" />
                                            <TextBlock Grid.Column="4" HorizontalAlignment="Right"
                                                       Style="{StaticResource AnalyticsTableHeader}" Text="Total" />
                                            <TextBlock Grid.Column="5" HorizontalAlignment="Center"
                                                       Style="{StaticResource AnalyticsTableHeader}" Text="Action" />
                                        </Grid>
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding ClassesSorted}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Expander Style="{StaticResource AnalyticsClassExpander}"
                                                          Expanded="ClassExpander_OnExpanded">
                                                    <Expander.Header>
                                                        <Grid Margin="14,10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" MinWidth="280" />
                                                                <ColumnDefinition Width="*" MinWidth="220" />
                                                                <ColumnDefinition Width="72" />
                                                                <ColumnDefinition Width="72" />
                                                                <ColumnDefinition Width="64" />
                                                                <ColumnDefinition Width="56" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Style="{StaticResource AnalyticsTableCellWrap}"
                                                                       FontWeight="SemiBold" Text="{Binding ClassName}" />
                                                            <TextBlock Grid.Column="1" Style="{StaticResource AnalyticsTableCellWrap}"
                                                                       Text="{Binding SectionName}" />
                                                            <TextBlock Grid.Column="2" HorizontalAlignment="Right"
                                                                       Style="{StaticResource AnalyticsTableCell}"
                                                                       Text="{Binding TotalBoys}" />
                                                            <TextBlock Grid.Column="3" HorizontalAlignment="Right"
                                                                       Style="{StaticResource AnalyticsTableCell}"
                                                                       Text="{Binding TotalGirls}" />
                                                            <TextBlock Grid.Column="4" HorizontalAlignment="Right"
                                                                       FontWeight="SemiBold"
                                                                       Style="{StaticResource AnalyticsTableCell}"
                                                                       Text="{Binding TotalStudents}" />
                                                            <materialDesign:PackIcon Grid.Column="5"
                                                                                     Kind="ChevronRight"
                                                                                     Width="20" Height="20"
                                                                                     Foreground="#64748B"
                                                                                     HorizontalAlignment="Center"
                                                                                     VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Expander.Header>

                                                    <StackPanel Margin="14,0,14,8">
                                                        <TextBlock Foreground="#DC2626" Text="{Binding LoadError}"
                                                                   TextWrapping="Wrap" />

                                                        <TextBlock Margin="0,8,0,0" FontSize="12"
                                                                   Foreground="#64748B" Text="Chargement..."
                                                                   Visibility="{Binding IsLoadingStudents, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                                        <!-- Même conteneur + DataGrid que SecurityUsersView (liste utilisateurs) -->
                                                        <Border Background="White"
                                                                BorderBrush="#E5E7EB"
                                                                BorderThickness="1"
                                                                ClipToBounds="True"
                                                                CornerRadius="12">
                                                            <DataGrid AutoGenerateColumns="False"
                                                                      AlternatingRowBackground="#F8FAFC"
                                                                      Background="Transparent"
                                                                      BorderThickness="0"
                                                                      CanUserAddRows="False"
                                                                      CanUserDeleteRows="False"
                                                                      CanUserReorderColumns="False"
                                                                      CanUserResizeColumns="True"
                                                                      CellStyle="{StaticResource ErpUsersListCell}"
                                                                      ColumnHeaderStyle="{StaticResource ErpUsersListColumnHeader}"
                                                                      EnableColumnVirtualization="True"
                                                                      EnableRowVirtualization="True"
                                                                      GridLinesVisibility="Horizontal"
                                                                      HeadersVisibility="Column"
                                                                      HorizontalGridLinesBrush="#F1F5F9"
                                                                      IsReadOnly="True"
                                                                      ItemsSource="{Binding Students}"
                                                                      RowBackground="Transparent"
                                                                      RowHeight="34"
                                                                      RowStyle="{StaticResource ErpUsersListRow}"
                                                                      SelectionMode="Single"
                                                                      SelectionUnit="FullRow"
                                                                      VerticalGridLinesBrush="#F1F5F9">
                                                                <DataGrid.Resources>
                                                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#EEF2FF" />
                                                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0F172A" />
                                                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#F1F5F9" />
                                                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#0F172A" />
                                                                </DataGrid.Resources>
                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn Binding="{Binding RowNumber}"
                                                                                        Header="N°"
                                                                                        Width="44" />
                                                                    <DataGridTextColumn Binding="{Binding RegistrationNumber}"
                                                                                        Header="MATRICULE"
                                                                                        Width="110" />
                                                                    <DataGridTextColumn Binding="{Binding FullName}"
                                                                                        Header="NOM ET PRÉNOMS"
                                                                                        Width="*" />
                                                                    <DataGridTextColumn Binding="{Binding GenderLabel}"
                                                                                        Header="SEXE"
                                                                                        Width="60" />
                                                                    <DataGridTextColumn Binding="{Binding DateOfBirthLabel}"
                                                                                        Header="DATE NAISSANCE"
                                                                                        Width="120" />
                                                                    <DataGridTemplateColumn Header="ACTION" Width="90">
                                                                        <DataGridTemplateColumn.CellTemplate>
                                                                            <DataTemplate>
                                                                                <Button Background="Transparent"
                                                                                        BorderThickness="0"
                                                                                        Command="{Binding OpenCommand}"
                                                                                        Cursor="Hand"
                                                                                        Height="28"
                                                                                        Padding="0"
                                                                                        ToolTip="Consulter la fiche"
                                                                                        Width="28">
                                                                                    <materialDesign:PackIcon Kind="Eye"
                                                                                                             Width="16"
                                                                                                             Height="16"
                                                                                                             Foreground="#1E5EFF" />
                                                                                </Button>
                                                                            </DataTemplate>
                                                                        </DataGridTemplateColumn.CellTemplate>
                                                                    </DataGridTemplateColumn>
                                                                </DataGrid.Columns>
                                                            </DataGrid>
                                                        </Border>
                                                    </StackPanel>
                                                </Expander>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="#94A3B8"
                       HorizontalAlignment="Right" Text="{Binding LastUpdatedLabel}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
