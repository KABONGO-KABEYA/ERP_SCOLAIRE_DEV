<UserControl x:Class="SchoolManagement.Desktop.Views.GradesView"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"

             xmlns:ui="clr-namespace:SchoolManagement.Desktop.UI"

             xmlns:erp="clr-namespace:SchoolManagement.Desktop.Controls"

             Background="{StaticResource ErpPageBackgroundBrush}">

    <UserControl.Resources>

        <ui:InverseBooleanConverter x:Key="InverseBooleanConverter" />

        <ui:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />

        <Style x:Key="EvalManagerBadge" TargetType="Border">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="EvalManagerBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="EvalManagerKpiCard" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="MaxHeight" Value="80" />
            <Setter Property="Effect" Value="{StaticResource ErpCardShadow}" />
        </Style>
        <Style x:Key="EvalManagerTabButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#64748B" />
        </Style>
        <Style x:Key="EvalManagerEvalCard" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Effect" Value="{StaticResource ErpCardShadow}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#93C5FD" />
                    <Setter Property="Background" Value="#F8FAFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EvalWizardTypeCard" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#3B82F6" />
                    <Setter Property="Background" Value="#EFF6FF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GradesParamLabel" TargetType="TextBlock">

            <Setter Property="FontFamily" Value="Segoe UI" />

            <Setter Property="FontSize" Value="12" />

            <Setter Property="FontWeight" Value="SemiBold" />

            <Setter Property="Foreground" Value="#374151" />

            <Setter Property="Margin" Value="0,0,0,6" />

        </Style>

        <Style x:Key="GradesSectionTitle" TargetType="TextBlock">

            <Setter Property="FontFamily" Value="Segoe UI" />

            <Setter Property="FontSize" Value="11" />

            <Setter Property="FontWeight" Value="Bold" />

            <Setter Property="Foreground" Value="#1E5EFF" />

            <Setter Property="Margin" Value="0,0,0,10" />

        </Style>

        <Style x:Key="GradesStatCard" TargetType="Border">

            <Setter Property="Background" Value="White" />

            <Setter Property="BorderBrush" Value="#E5E7EB" />

            <Setter Property="BorderThickness" Value="1" />

            <Setter Property="CornerRadius" Value="12" />

            <Setter Property="Padding" Value="14,12" />

            <Setter Property="MinWidth" Value="110" />

            <Setter Property="Margin" Value="0,0,10,0" />

        </Style>

        <Style x:Key="GradesSummaryItem" TargetType="TextBlock">

            <Setter Property="FontFamily" Value="Segoe UI" />

            <Setter Property="FontSize" Value="12" />

            <Setter Property="VerticalAlignment" Value="Center" />

            <Setter Property="TextTrimming" Value="CharacterEllipsis" />

        </Style>

        <Style x:Key="GradesSummaryValue" TargetType="TextBlock" BasedOn="{StaticResource GradesSummaryItem}">

            <Setter Property="FontWeight" Value="SemiBold" />

            <Setter Property="Foreground" Value="#1F2937" />

        </Style>

        <Style x:Key="GradesSummaryLabel" TargetType="TextBlock" BasedOn="{StaticResource GradesSummaryItem}">

            <Setter Property="Foreground" Value="#6B7280" />

            <Setter Property="Margin" Value="0,0,6,0" />

        </Style>

        <Style x:Key="GradesCollectColumnHeader" TargetType="DataGridColumnHeader">

            <Setter Property="Background" Value="Transparent" />

            <Setter Property="BorderThickness" Value="0,0,0,1" />

            <Setter Property="BorderBrush" Value="#E2E8F0" />

            <Setter Property="Padding" Value="12,10" />

            <Setter Property="FontWeight" Value="SemiBold" />

            <Setter Property="Foreground" Value="#64748B" />

            <Setter Property="FontSize" Value="12" />

            <Setter Property="HorizontalContentAlignment" Value="Left" />

            <Setter Property="VerticalContentAlignment" Value="Center" />

        </Style>

        <Style x:Key="GradesCollectCell" TargetType="DataGridCell">

            <Setter Property="BorderThickness" Value="0" />

            <Setter Property="Padding" Value="8,0" />

            <Setter Property="Foreground" Value="#0F172A" />

            <Setter Property="FocusVisualStyle" Value="{x:Null}" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="DataGridCell">

                        <Border x:Name="CellBorder"

                                Padding="{TemplateBinding Padding}"

                                Background="Transparent">

                            <ContentPresenter VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsSelected" Value="True">

                                <Setter TargetName="CellBorder" Property="Background" Value="#EEF2FF" />

                                <Setter Property="Foreground" Value="#0F172A" />

                            </Trigger>

                            <Trigger Property="IsKeyboardFocusWithin" Value="True">

                                <Setter Property="Foreground" Value="#0F172A" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsSelected" Value="True">

                    <Setter Property="Background" Value="#EEF2FF" />

                    <Setter Property="Foreground" Value="#0F172A" />

                </Trigger>

            </Style.Triggers>

        </Style>

        <Style x:Key="GradesCollectEditTextBox" TargetType="TextBox">

            <Setter Property="Padding" Value="8,6" />

            <Setter Property="Background" Value="#F8FAFC" />

            <Setter Property="BorderBrush" Value="#E2E8F0" />

            <Setter Property="BorderThickness" Value="1" />

            <Setter Property="Foreground" Value="#0F172A" />

            <Setter Property="CaretBrush" Value="#0F172A" />

            <Setter Property="SelectionBrush" Value="#BFDBFE" />

            <Setter Property="VerticalContentAlignment" Value="Center" />

            <Setter Property="FontFamily" Value="Segoe UI" />

            <Setter Property="FontSize" Value="13" />

            <Style.Triggers>

                <Trigger Property="IsEnabled" Value="False">

                    <Setter Property="Foreground" Value="#94A3B8" />

                    <Setter Property="Background" Value="#F1F5F9" />

                </Trigger>

                <Trigger Property="IsKeyboardFocusWithin" Value="True">

                    <Setter Property="Foreground" Value="#0F172A" />

                    <Setter Property="Background" Value="#FFFFFF" />

                </Trigger>

            </Style.Triggers>

        </Style>

        <Style x:Key="GradesCollectScoreTextBox" TargetType="TextBox" BasedOn="{StaticResource GradesCollectEditTextBox}">

            <Setter Property="HorizontalContentAlignment" Value="Center" />

            <Setter Property="FontWeight" Value="SemiBold" />

        </Style>

        <Style x:Key="GradesCollectReadOnlyText" TargetType="TextBlock">

            <Setter Property="FontFamily" Value="Segoe UI" />

            <Setter Property="FontSize" Value="13" />

            <Setter Property="Foreground" Value="#0F172A" />

            <Setter Property="VerticalAlignment" Value="Center" />

            <Setter Property="TextTrimming" Value="CharacterEllipsis" />

        </Style>

    </UserControl.Resources>



    <Grid Margin="20,16,20,16" Style="{StaticResource ErpFadeIn}">

        <!-- Identification enseignant (Direction / Admin uniquement) -->
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="440"
                Padding="28,24"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="16"
                Visibility="{Binding ShowIdentificationPanel, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock FontSize="20"
                           FontWeight="Bold"
                           Foreground="#0B1F47"
                           Text="Cotation des élèves"
                           HorizontalAlignment="Center" />
                <TextBlock Margin="0,8,0,8"
                           FontSize="12"
                           Foreground="#6B7280"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Text="Identifiez l'enseignant dont vous coterez les affectations. L'année est celle de la barre de titre." />
                <TextBlock Margin="0,0,0,16"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#1D4ED8"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Text="{Binding ConnectedUserLabel}" />

                <erp:ErpTextField Margin="0,0,0,12"
                                  Label="Enseignant (matricule / identifiant)"
                                  IconKind="AccountTie"
                                  IsEnabledField="{Binding IsTeacherIdentityLocked, Converter={StaticResource InverseBooleanConverter}}"
                                  Text="{Binding TeacherEmployeeNumber, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Visibility="{Binding RequiresTeacherPassword, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Style="{StaticResource GradesParamLabel}" Text="Mot de passe (si requis)" />
                    <PasswordBox x:Name="TeacherPasswordBox"
                                 Margin="0,0,0,12"
                                 Style="{StaticResource ErpPasswordBox}"
                                 PasswordChanged="TeacherPasswordBox_OnPasswordChanged" />
                </StackPanel>

                <TextBlock Margin="0,0,0,12"
                           FontSize="12"
                           Foreground="#DC2626"
                           TextWrapping="Wrap"
                           Text="{Binding SessionError}" />

                <Button Height="42"
                        Command="{Binding OpenCotationSessionCommand}"
                        Style="{StaticResource ErpPrimaryButton}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="Login" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Voir les affectations" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Accueil : mes affectations -->
        <Grid Visibility="{Binding ShowAssignmentsHome, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                <Button Width="40"
                        Height="40"
                        Padding="0"
                        Margin="0,0,0,0"
                        Command="{Binding LeaveCotationSessionCommand}"
                        DockPanel.Dock="Right"
                        ToolTip="Changer d'enseignant"
                        Style="{StaticResource MaterialDesignIconButton}"
                        Visibility="{Binding ShowSwitchTeacherButton, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <materialDesign:PackIcon Kind="AccountSwitch" Width="22" Height="22" Foreground="#1F2937" />
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="20" FontWeight="Bold" Foreground="#0B1F47" Text="Mes affectations" />
                    <TextBlock FontSize="12" Foreground="#6B7280" Text="{Binding SessionAccessLabel}" />
                    <TextBlock FontSize="12" Foreground="#1D4ED8" Text="{Binding BannerTeacher}" />
                </StackPanel>
            </DockPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding AssignmentClassGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,14"
                                    Background="White"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Effect="{StaticResource ErpCardShadow}">
                                <StackPanel>
                                    <!-- En-tête classe (accordéon) -->
                                    <Border Background="Transparent" Cursor="Hand" Padding="16,14">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.ToggleAssignmentClassGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}" />
                                        </Border.InputBindings>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="40" Height="40" Margin="0,0,12,0"
                                                    Background="#EEF2FF" CornerRadius="10"
                                                    VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="School" Width="22" Height="22"
                                                                         Foreground="#1D4ED8"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#0B1F47"
                                                           Text="{Binding ClassName}" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="#64748B"
                                                           Text="{Binding SummaryText}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button MinWidth="140"
                                                        Height="34"
                                                        Margin="0,0,10,0"
                                                        Padding="12,0"
                                                        Content="COTATION GLOBALE"
                                                        Command="{Binding DataContext.OpenGlobalCotationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource ErpSecondaryButton}"
                                                        ToolTip="Coter tous les cours de cette classe dans une seule grille" />
                                                <materialDesign:PackIcon Width="22" Height="22"
                                                                         Foreground="#64748B">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Setter Property="Kind" Value="ChevronDown" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                    <Setter Property="Kind" Value="ChevronUp" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Tableau des cours -->
                                    <Border Padding="12,0,12,14"
                                            Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>

                                                <!-- En-tête colonnes -->
                                                <Border Grid.Row="0" Background="#F1F5F9" Padding="12,10"
                                                        CornerRadius="10,10,0,0" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*" MinWidth="140" />
                                                            <ColumnDefinition Width="Auto" MinWidth="100" />
                                                            <ColumnDefinition Width="2*" MinWidth="160" />
                                                            <ColumnDefinition Width="Auto" MinWidth="130" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="Cours" />
                                                        <TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="Évaluations" />
                                                        <TextBlock Grid.Column="2" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Text="Dernière activité" />
                                                        <TextBlock Grid.Column="3" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"
                                                                   HorizontalAlignment="Right" Text="Action" />
                                                    </Grid>
                                                </Border>

                                                <ItemsControl Grid.Row="1" ItemsSource="{Binding Courses}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Padding="12,10" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1"
                                                                    Background="Transparent">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Style.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Background" Value="#EEF2FF" />
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2*" MinWidth="140" />
                                                                        <ColumnDefinition Width="Auto" MinWidth="100" />
                                                                        <ColumnDefinition Width="2*" MinWidth="160" />
                                                                        <ColumnDefinition Width="Auto" MinWidth="130" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"
                                                                               VerticalAlignment="Center" Text="{Binding CourseName}"
                                                                               TextWrapping="Wrap" />
                                                                    <TextBlock Grid.Column="1" FontSize="14" FontWeight="SemiBold" Foreground="#1D4ED8"
                                                                               VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                               MinWidth="40" Text="{Binding EvaluationsText}" />
                                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"
                                                                                   Text="{Binding LastActivityTitle}" TextWrapping="Wrap" />
                                                                        <TextBlock FontSize="11" Foreground="#64748B"
                                                                                   Text="{Binding LastActivityDateText}"
                                                                                   Visibility="{Binding HasLastActivityDate, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                    </StackPanel>
                                                                    <Button Grid.Column="3"
                                                                            MinWidth="120"
                                                                            Height="34"
                                                                            Margin="8,0,0,0"
                                                                            HorizontalAlignment="Right"
                                                                            VerticalAlignment="Center"
                                                                            Content="{Binding ActionLabel}"
                                                                            Command="{Binding DataContext.CoterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            Style="{StaticResource ErpPrimaryButton}" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Border>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Grid.Row="2"
                       Margin="0,8,0,0"
                       Foreground="#DC2626"
                       Text="{Binding StatusMessage}"
                       TextWrapping="Wrap" />
        </Grid>

        <!-- Cotation globale de la classe -->
        <Grid Visibility="{Binding ShowGlobalCotation, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- En-tête -->
            <Border Grid.Row="0" Margin="0,0,0,8" Padding="12,10"
                    Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12">
                <DockPanel LastChildFill="True">
                    <Button Margin="0,0,12,0" Height="34" Padding="12,0"
                            Command="{Binding CloseGlobalCotationCommand}"
                            DockPanel.Dock="Left"
                            Style="{StaticResource ErpSecondaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ArrowLeft" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Retour" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Border DockPanel.Dock="Right" Background="#EEF2FF" CornerRadius="8" Padding="10,5"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CalendarRange" Width="14" Height="14"
                                                     Foreground="#4338CA" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#4338CA"
                                       Text="{Binding GlobalPeriodLabel}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="16" FontWeight="Bold" Foreground="#0B1F47"
                                   Text="Cotation globale" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <materialDesign:PackIcon Kind="School" Width="14" Height="14"
                                                     Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#334155"
                                       Text="{Binding GlobalClassName}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Onglets segmentés -->
            <Border Grid.Row="1" Margin="0,0,0,8" Padding="4" HorizontalAlignment="Left"
                    Background="#F1F5F9" CornerRadius="10">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Saisie globale" Height="32" MinWidth="128" Padding="14,0"
                            Command="{Binding SelectGlobalCotationTabCommand}"
                            CommandParameter="0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Foreground" Value="#64748B" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#E2E8F0" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GlobalCotationTabIndex}" Value="0">
                                        <Setter Property="Foreground" Value="#0B1F47" />
                                        <Setter Property="Background" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Vue globale" Height="32" MinWidth="128" Padding="14,0"
                            Command="{Binding SelectGlobalCotationTabCommand}"
                            CommandParameter="1">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Foreground" Value="#64748B" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#E2E8F0" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GlobalCotationTabIndex}" Value="1">
                                        <Setter Property="Foreground" Value="#0B1F47" />
                                        <Setter Property="Background" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2">
                <!-- Saisie globale -->
                <Grid Visibility="{Binding ShowGlobalSaisieTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Toolbar Saisie globale (même langage visuel que Vue globale) -->
                    <Border Grid.Row="0" Margin="0,0,0,8" Padding="10,8"
                            Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Margin="0,0,10,0" CornerRadius="8" Padding="8,4" VerticalAlignment="Center"
                                        BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#ECFDF5" />
                                            <Setter Property="BorderBrush" Value="#A7F3D0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedGlobalSession.IsNew}" Value="False">
                                                    <Setter Property="Background" Value="#EFF6FF" />
                                                    <Setter Property="BorderBrush" Value="#BFDBFE" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon">
                                                    <Setter Property="Kind" Value="PlusCircleOutline" />
                                                    <Setter Property="Foreground" Value="#059669" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedGlobalSession.IsNew}" Value="False">
                                                            <Setter Property="Kind" Value="PencilOutline" />
                                                            <Setter Property="Foreground" Value="#2563EB" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                        <TextBlock FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Nouvelle saisie" />
                                                    <Setter Property="Foreground" Value="#047857" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedGlobalSession.IsNew}" Value="False">
                                                            <Setter Property="Text" Value="Modification" />
                                                            <Setter Property="Foreground" Value="#1D4ED8" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Button Height="30" Padding="10,0"
                                        Command="{Binding StartNewGlobalSessionCommand}"
                                        Style="{StaticResource ErpSecondaryButton}"
                                        ToolTip="Repartir sur une grille vide">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Width="14" Height="14"
                                                                 Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Nouvelle saisie" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ComboBox Width="240" Height="30" Margin="0,0,10,0"
                                          ItemsSource="{Binding GlobalSessionOptions}"
                                          DisplayMemberPath="DisplayLabel"
                                          SelectedItem="{Binding SelectedGlobalSession, Mode=TwoWay}"
                                          IsEnabled="{Binding IsGlobalBusy, Converter={StaticResource InverseBooleanConverter}}" />

                                <ComboBox Width="150" Height="30" Margin="0,0,10,0"
                                          ItemsSource="{Binding GlobalEvaluationTypes}"
                                          DisplayMemberPath="Name"
                                          SelectedItem="{Binding GlobalEvaluationType, Mode=TwoWay}"
                                          IsEnabled="{Binding IsGlobalSessionEditable}"
                                          ToolTip="Type d'évaluation" />

                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                        CornerRadius="8" Padding="8,0" Height="30" MinWidth="160" Margin="0,0,10,0">
                                    <DockPanel>
                                        <TextBlock Text="Libellé" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"
                                                   VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,8,0" />
                                        <TextBox BorderThickness="0" Background="Transparent"
                                                 VerticalContentAlignment="Center" FontSize="12"
                                                 IsEnabled="{Binding IsGlobalSessionEditable}"
                                                 Text="{Binding GlobalEvaluationTitle, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                </Border>

                                <DatePicker Width="140" Height="30"
                                            SelectedDate="{Binding GlobalEvaluationDate, Mode=TwoWay}"
                                            IsEnabled="{Binding IsGlobalSessionEditable}"
                                            ToolTip="Date de l'évaluation" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12"
                            Padding="0" Background="White" ClipToBounds="True">
                        <DataGrid x:Name="GlobalCotationGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserResizeColumns="True"
                                  HeadersVisibility="Column"
                                  SelectionUnit="Cell"
                                  SelectionMode="Single"
                                  FrozenColumnCount="3"
                                  ItemsSource="{Binding GlobalRows}"
                                  IsReadOnly="{Binding IsGlobalSessionEditable, Converter={StaticResource InverseBooleanConverter}}"
                                  PreviewKeyDown="GlobalCotationGrid_OnPreviewKeyDown"
                                  RowHeight="36"
                                  BorderThickness="0"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F1F5F9"
                                  VerticalGridLinesBrush="#F1F5F9"
                                  AlternatingRowBackground="#F8FAFC"
                                  Background="Transparent"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="Background" Value="#F8FAFC" />
                                    <Setter Property="Foreground" Value="#0B1F47" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="FontSize" Value="11" />
                                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                                    <Setter Property="Padding" Value="8,8" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Padding" Value="0" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#DBEAFE" />
                                            <Setter Property="Foreground" Value="#0B1F47" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                        </DataGrid>
                    </Border>

                    <Border Grid.Row="2" Margin="0,8,0,0" Padding="12,8"
                            Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Margin="0,0,8,0" Height="34" Padding="14,0"
                                        Background="#22C55E" BorderBrush="#16A34A" Foreground="White"
                                        Command="{Binding SaveGlobalCotationCommand}"
                                        Style="{StaticResource ErpPrimaryButton}"
                                        IsEnabled="{Binding CanSaveGlobalCotation}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ContentSave" Width="14" Height="14"
                                                                 Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Enregistrer" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Margin="0,0,8,0" Height="34" Padding="14,0"
                                        Command="{Binding SaveAndCloseGlobalCotationCommand}"
                                        Style="{StaticResource ErpPrimaryButton}"
                                        IsEnabled="{Binding CanSaveGlobalCotation}">
                                    <TextBlock Text="Enregistrer et fermer" FontSize="12" />
                                </Button>
                                <Button Height="34" Padding="14,0"
                                        Command="{Binding CancelGlobalCotationCommand}"
                                        Style="{StaticResource ErpSecondaryButton}">
                                    <TextBlock Text="Annuler" Foreground="#EF4444" FontSize="12" />
                                </Button>
                            </StackPanel>
                            <TextBlock VerticalAlignment="Center" Foreground="#DC2626" FontSize="12"
                                       Text="{Binding GlobalStatusMessage}" TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- Vue globale (feuille pédagogique lecture seule) -->
                <Grid Visibility="{Binding ShowGlobalVueTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Toolbar Vue globale -->
                    <Border Grid.Row="0" Margin="0,0,0,8" Padding="10,8"
                            Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1"
                                        CornerRadius="8" Padding="8,4" Margin="0,0,10,0" VerticalAlignment="Center"
                                        ToolTip="Consultation seule. Les notes se saisissent dans l'onglet Saisie globale.">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="EyeOutline" Width="14" Height="14"
                                                                 Foreground="#0284C7" VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <TextBlock Text="Lecture seule" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#0369A1" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Button Margin="0,0,6,0" Height="30" Padding="10,0"
                                        Command="{Binding ExportPedagogicalSheetExcelCommand}"
                                        Style="{StaticResource ErpSecondaryButton}"
                                        ToolTip="Exporter Excel">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="MicrosoftExcel" Width="14" Height="14"
                                                                 Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Excel" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Height="30" Padding="10,0"
                                        Command="{Binding PrintPedagogicalSheetCommand}"
                                        Style="{StaticResource ErpSecondaryButton}"
                                        ToolTip="Imprimer">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="PrinterOutline" Width="14" Height="14"
                                                                 Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Imprimer" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#F1F5F9" CornerRadius="8" Padding="3" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Height="26" Padding="10,0" Margin="0,0,2,0"
                                                Command="{Binding SelectPedagogicalSheetSubPeriodModeCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                                    <Setter Property="FontSize" Value="11" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Setter Property="Foreground" Value="#64748B" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPedagogicalSheetSubPeriodMode}" Value="True">
                                                            <Setter Property="Foreground" Value="#0B1F47" />
                                                            <Setter Property="Background" Value="White" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="Sous-période" />
                                        </Button>
                                        <Button Height="26" Padding="10,0"
                                                Command="{Binding SelectPedagogicalSheetMainPeriodModeCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                                    <Setter Property="FontSize" Value="11" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Setter Property="Foreground" Value="#64748B" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPedagogicalSheetSubPeriodMode}" Value="False">
                                                            <Setter Property="Foreground" Value="#0B1F47" />
                                                            <Setter Property="Background" Value="White" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="Période principale" />
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <ComboBox Width="200" Height="30" Margin="0,0,10,0"
                                          ItemsSource="{Binding PedagogicalSheetPeriodOptions}"
                                          DisplayMemberPath="Name"
                                          SelectedItem="{Binding SelectedPedagogicalSheetPeriod, Mode=TwoWay}" />

                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                        CornerRadius="8" Padding="8,0" Height="30" MinWidth="210">
                                    <DockPanel>
                                        <materialDesign:PackIcon Kind="Magnify" Width="16" Height="16"
                                                                 Foreground="#94A3B8" VerticalAlignment="Center"
                                                                 DockPanel.Dock="Left" Margin="0,0,6,0" />
                                        <TextBox BorderThickness="0" Background="Transparent"
                                                 VerticalContentAlignment="Center" FontSize="12"
                                                 materialDesign:HintAssist.Hint="Rechercher un élève…"
                                                 Text="{Binding PedagogicalSheetSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Padding="14" CornerRadius="12"
                                Visibility="{Binding IsPedagogicalSheetLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Chargement de la feuille pédagogique…" FontSize="12"
                                           Foreground="#64748B" Margin="0,0,0,10" />
                                <Border Height="36" Margin="0,0,0,6" Background="#F1F5F9" CornerRadius="8" />
                                <Border Height="36" Margin="0,0,0,6" Background="#F1F5F9" CornerRadius="8" />
                                <Border Height="36" Background="#F8FAFC" CornerRadius="8" />
                            </StackPanel>
                        </Border>

                        <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" Padding="20" CornerRadius="12"
                                Visibility="{Binding ShowPedagogicalSheetError, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
                                <materialDesign:PackIcon Kind="AlertCircleOutline" Width="28" Height="28"
                                                         Foreground="#DC2626" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#991B1B"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           Text="{Binding PedagogicalSheetError}" />
                                <Button Margin="0,12,0,0" HorizontalAlignment="Center" Height="30" Padding="14,0"
                                        Content="Réessayer"
                                        Command="{Binding RetryPedagogicalSheetCommand}"
                                        Style="{StaticResource ErpSecondaryButton}" />
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="0"
                                Background="White" ClipToBounds="True"
                                Visibility="{Binding ShowPedagogicalSheetContent, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#0B1F47" Padding="0">
                                    <Grid x:Name="PedagogicalSheetHeaderRoot">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid x:Name="PedagogicalSheetFrozenHeader" />
                                        <ScrollViewer x:Name="PedagogicalSheetHeaderScroll"
                                                      Grid.Column="1"
                                                      HorizontalScrollBarVisibility="Hidden"
                                                      VerticalScrollBarVisibility="Disabled"
                                                      Focusable="False">
                                            <Grid x:Name="PedagogicalSheetScrollableHeader" />
                                        </ScrollViewer>
                                    </Grid>
                                </Border>

                                <DataGrid x:Name="PedagogicalSheetGrid"
                                          Grid.Row="1"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserReorderColumns="False"
                                          CanUserResizeColumns="True"
                                          IsReadOnly="True"
                                          HeadersVisibility="None"
                                          SelectionUnit="FullRow"
                                          FrozenColumnCount="3"
                                          ItemsSource="{Binding FilteredPedagogicalSheetRows}"
                                          RowHeight="34"
                                          BorderThickness="0"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#F1F5F9"
                                          VerticalGridLinesBrush="#F1F5F9"
                                          AlternatingRowBackground="#F8FAFC"
                                          Background="Transparent"
                                          EnableRowVirtualization="True"
                                          EnableColumnVirtualization="True"
                                          Loaded="PedagogicalSheetGrid_OnLoaded" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Synthèse KPI -->
                    <Border Grid.Row="2" Margin="0,8,0,0" Padding="10,8"
                            Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12"
                            Visibility="{Binding ShowPedagogicalSheetContent, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#EEF2FF" CornerRadius="8" Padding="10,5" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Moyenne" FontSize="11" Foreground="#6366F1" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock FontSize="12" FontWeight="Bold" Foreground="#312E81"
                                               Text="{Binding PedagogicalSheetSummary.ClassAverageDisplay}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border Background="#ECFDF5" CornerRadius="8" Padding="10,5" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Max" FontSize="11" Foreground="#059669" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock FontSize="12" FontWeight="Bold" Foreground="#065F46"
                                               Text="{Binding PedagogicalSheetSummary.MaxObtainedDisplay}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border Background="#FFF7ED" CornerRadius="8" Padding="10,5" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Min" FontSize="11" Foreground="#EA580C" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock FontSize="12" FontWeight="Bold" Foreground="#9A3412"
                                               Text="{Binding PedagogicalSheetSummary.MinObtainedDisplay}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border Background="#F8FAFC" CornerRadius="8" Padding="10,5" Margin="0,0,8,0"
                                    BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Élèves cotés" FontSize="11" Foreground="#64748B" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock FontSize="12" FontWeight="Bold" Foreground="#0F172A"
                                               Text="{Binding PedagogicalSheetSummary.GradedCountDisplay}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border Background="#FEF2F2" CornerRadius="8" Padding="10,5"
                                    BorderBrush="#FECACA" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="ABS" FontSize="11" Foreground="#DC2626" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock FontSize="12" FontWeight="Bold" Foreground="#991B1B"
                                               Text="{Binding PedagogicalSheetSummary.AbsentCountDisplay}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Gestion des évaluations (après COTER) -->
        <Grid Visibility="{Binding ShowEvaluationManager, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Titre + retour -->
            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <Button Width="40" Height="40" Padding="0" Margin="0,0,10,0"
                        Command="{Binding BackToAssignmentsCommand}"
                        DockPanel.Dock="Left"
                        ToolTip="Retour aux affectations"
                        Style="{StaticResource MaterialDesignIconButton}">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="22" Height="22" Foreground="#1F2937" />
                </Button>
                <TextBlock FontSize="18" FontWeight="Bold" Foreground="#0B1F47"
                           VerticalAlignment="Center"
                           Text="Espace de cotation" />
            </DockPanel>

            <!-- Bandeau compact (≤ 90px) -->
            <Border Grid.Row="1" Margin="0,0,0,10" Padding="12,10" MaxHeight="90"
                    Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12"
                    Effect="{StaticResource ErpCardShadow}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource EvalManagerBadge}" Background="#EEF2FF">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="School" Width="14" Height="14" Margin="0,0,6,0"
                                                         Foreground="#1D4ED8" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource EvalManagerBadgeText}" Text="{Binding BannerClass}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource EvalManagerBadge}" Background="#ECFDF5">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="BookOpenPageVariant" Width="14" Height="14" Margin="0,0,6,0"
                                                         Foreground="#047857" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource EvalManagerBadgeText}" Text="{Binding BannerCourse}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource EvalManagerBadge}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Account" Width="14" Height="14" Margin="0,0,6,0"
                                                         Foreground="#475569" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource EvalManagerBadgeText}" Text="{Binding BannerTeacher}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource EvalManagerBadge}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountGroup" Width="14" Height="14" Margin="0,0,6,0"
                                                         Foreground="#475569" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource EvalManagerBadgeText}" Text="{Binding ManagerStudentBadge}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource EvalManagerBadge}" Background="#FFF7ED">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CalendarMonth" Width="14" Height="14" Margin="0,0,6,0"
                                                         Foreground="#C2410C" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource EvalManagerBadgeText}" Text="{Binding BannerPeriod}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource EvalManagerBadge}" Background="#F5F3FF">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ClipboardText" Width="14" Height="14" Margin="0,0,6,0"
                                                         Foreground="#6D28D9" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource EvalManagerBadgeText}" Text="{Binding BannerPeriodKind}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource EvalManagerBadge}" Margin="0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CalendarRange" Width="14" Height="14" Margin="0,0,6,0"
                                                         Foreground="#475569" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource EvalManagerBadgeText}" Text="{Binding BannerPeriodRange}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- KPI -->
            <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,10">
                <Border Style="{StaticResource EvalManagerKpiCard}" Margin="0,0,8,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="11" Foreground="#64748B" Text="Évaluations" />
                        <TextBlock FontSize="22" FontWeight="Bold" Foreground="#0B1F47"
                                   Text="{Binding ManagerKpiEvaluations}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource EvalManagerKpiCard}" Margin="0,0,8,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="11" Foreground="#64748B" Text="Élèves" />
                        <TextBlock FontSize="22" FontWeight="Bold" Foreground="#0B1F47"
                                   Text="{Binding ManagerKpiStudents}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource EvalManagerKpiCard}" Margin="0,0,8,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="11" Foreground="#64748B" Text="Notes saisies" />
                        <TextBlock FontSize="22" FontWeight="Bold" Foreground="#0B1F47"
                                   Text="{Binding ManagerKpiGradesEntered}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource EvalManagerKpiCard}" Margin="0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="11" Foreground="#64748B" Text="Moyenne générale" />
                        <TextBlock FontSize="22" FontWeight="Bold" Foreground="#0B1F47"
                                   Text="{Binding ManagerKpiAverage}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Onglets + bouton créer -->
            <DockPanel Grid.Row="3" Margin="0,0,0,10" LastChildFill="True">
                <Button DockPanel.Dock="Right" Height="36" Padding="14,0" Margin="12,0,0,0"
                        Content="Créer une évaluation"
                        Command="{Binding BeginCreateEvaluationCommand}"
                        IsEnabled="{Binding CanManageEvaluations}"
                        Style="{StaticResource ErpPrimaryButton}"
                        Visibility="{Binding ShowCreateEvaluationInManager, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Évaluations"
                            Command="{Binding SelectEvaluationManagerTabCommand}"
                            CommandParameter="0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource EvalManagerTabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EvaluationManagerTabIndex}" Value="0">
                                        <Setter Property="Foreground" Value="#1D4ED8" />
                                        <Setter Property="BorderBrush" Value="#1D4ED8" />
                                        <Setter Property="BorderThickness" Value="0,0,0,2" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Vue des notes"
                            Command="{Binding SelectEvaluationManagerTabCommand}"
                            CommandParameter="1">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource EvalManagerTabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EvaluationManagerTabIndex}" Value="1">
                                        <Setter Property="Foreground" Value="#1D4ED8" />
                                        <Setter Property="BorderBrush" Value="#1D4ED8" />
                                        <Setter Property="BorderThickness" Value="0,0,0,2" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Statistiques"
                            Command="{Binding SelectEvaluationManagerTabCommand}"
                            CommandParameter="2">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource EvalManagerTabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EvaluationManagerTabIndex}" Value="2">
                                        <Setter Property="Foreground" Value="#1D4ED8" />
                                        <Setter Property="BorderBrush" Value="#1D4ED8" />
                                        <Setter Property="BorderThickness" Value="0,0,0,2" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Historique"
                            Command="{Binding SelectEvaluationManagerTabCommand}"
                            CommandParameter="3">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource EvalManagerTabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EvaluationManagerTabIndex}" Value="3">
                                        <Setter Property="Foreground" Value="#1D4ED8" />
                                        <Setter Property="BorderBrush" Value="#1D4ED8" />
                                        <Setter Property="BorderThickness" Value="0,0,0,2" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </DockPanel>

            <!-- Contenu onglets -->
            <Grid Grid.Row="4">
                <!-- Chargement -->
                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Padding="16" CornerRadius="12"
                        Visibility="{Binding ShowManagedEvaluationsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <Border Height="72" Margin="0,0,0,10" Background="#F3F4F6" CornerRadius="10" />
                        <Border Height="72" Margin="0,0,0,10" Background="#F3F4F6" CornerRadius="10" />
                        <Border Height="72" Background="#F3F4F6" CornerRadius="10" />
                    </StackPanel>
                </Border>

                <!-- Erreur -->
                <Border Background="White" BorderBrush="#FECACA" BorderThickness="1" Padding="24" CornerRadius="12"
                        Visibility="{Binding ShowManagedEvaluationsError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                        <materialDesign:PackIcon Kind="AlertCircleOutline" Width="40" Height="40"
                                                 Foreground="#DC2626" HorizontalAlignment="Center" />
                        <TextBlock Margin="0,12,0,8" FontSize="14" FontWeight="SemiBold" Foreground="#991B1B"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   Text="{Binding ManagedEvaluationsError}" />
                        <Button HorizontalAlignment="Center" Content="Réessayer"
                                Command="{Binding RetryManagedEvaluationsCommand}"
                                Style="{StaticResource ErpSecondaryButton}" />
                    </StackPanel>
                </Border>

                <!-- Empty state + wizard CTA -->
                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Padding="32" CornerRadius="12"
                        Visibility="{Binding ShowManagedEvaluationsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">
                        <Border Width="96" Height="96" CornerRadius="48" Background="#EEF2FF"
                                HorizontalAlignment="Center" Margin="0,0,0,18">
                            <materialDesign:PackIcon Kind="ClipboardPlusOutline" Width="48" Height="48"
                                                     Foreground="#1D4ED8"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock FontSize="18" FontWeight="Bold" Foreground="#0F172A"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   Text="Aucune évaluation n'a encore été créée." />
                        <TextBlock Margin="0,10,0,22" FontSize="13" Foreground="#64748B"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   Text="Créez votre première évaluation afin de commencer la saisie des notes de cette classe." />
                        <Button HorizontalAlignment="Center" MinWidth="220" Height="40"
                                Content="Créer une évaluation"
                                Command="{Binding BeginCreateEvalWizardCommand}"
                                IsEnabled="{Binding CanManageEvaluations}"
                                Style="{StaticResource ErpPrimaryButton}" />
                    </StackPanel>
                </Border>

                <!-- Liste cartes évaluations -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding ShowManagedEvaluationsGrid, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding ManagedEvaluations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource EvalManagerEvalCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="44" Height="44" CornerRadius="10" Background="#EEF2FF"
                                                VerticalAlignment="Top" Margin="0,0,12,0">
                                            <materialDesign:PackIcon Kind="FileDocumentOutline" Width="22" Height="22"
                                                                     Foreground="#1D4ED8"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#0F172A"
                                                       Text="{Binding Title}" TextWrapping="Wrap" />
                                            <WrapPanel Margin="0,6,0,0">
                                                <Border Background="#F1F5F9" CornerRadius="6" Padding="8,3" Margin="0,0,6,4">
                                                    <TextBlock FontSize="11" Foreground="#475569" Text="{Binding TypeName}" />
                                                </Border>
                                                <Border Background="#EFF6FF" CornerRadius="6" Padding="8,3" Margin="0,0,6,4">
                                                    <TextBlock FontSize="11" Foreground="#1D4ED8"
                                                               Text="{Binding MaxScoreLabel, StringFormat=Max {0}}" />
                                                </Border>
                                                <Border Background="#F8FAFC" CornerRadius="6" Padding="8,3" Margin="0,0,6,4">
                                                    <TextBlock FontSize="11" Foreground="#475569"
                                                               Text="{Binding ProgressText, StringFormat=Notes {0}}" />
                                                </Border>
                                                <Border Background="#F8FAFC" CornerRadius="6" Padding="8,3" Margin="0,0,6,4">
                                                    <TextBlock FontSize="11" Foreground="#64748B"
                                                               Text="{Binding CreatedDateText, StringFormat=Créée {0}}" />
                                                </Border>
                                                <Border Background="#F8FAFC" CornerRadius="6" Padding="8,3" Margin="0,0,6,4">
                                                    <TextBlock FontSize="11" Foreground="#64748B"
                                                               Text="{Binding ModifiedDateText, StringFormat=Modifiée {0}}" />
                                                </Border>
                                                <Border CornerRadius="6" Padding="8,3" Margin="0,0,0,4">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#FEF3C7" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StatusTone}" Value="Done">
                                                                    <Setter Property="Background" Value="#D1FAE5" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusTone}" Value="Progress">
                                                                    <Setter Property="Background" Value="#DBEAFE" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding StatusLabel}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#92400E" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding StatusTone}" Value="Done">
                                                                        <Setter Property="Foreground" Value="#065F46" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusTone}" Value="Progress">
                                                                        <Setter Property="Foreground" Value="#1E40AF" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </WrapPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button MinWidth="130" Height="36" Margin="0,0,8,0"
                                                    Content="Saisir les notes"
                                                    Command="{Binding DataContext.OpenManagedEvaluationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource ErpPrimaryButton}" />
                                            <materialDesign:PopupBox PlacementMode="BottomAndAlignRightEdges"
                                                                     StaysOpen="False"
                                                                     ToolTip="Actions">
                                                <StackPanel MinWidth="150">
                                                    <Button Content="Modifier" Margin="0,0,0,4"
                                                            HorizontalContentAlignment="Left"
                                                            IsEnabled="{Binding CanEdit}"
                                                            Command="{Binding DataContext.BeginEditEvaluationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource MaterialDesignFlatButton}" />
                                                    <Button Content="Dupliquer" Margin="0,0,0,4"
                                                            HorizontalContentAlignment="Left"
                                                            IsEnabled="{Binding CanDuplicate}"
                                                            Command="{Binding DataContext.BeginDuplicateEvaluationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource MaterialDesignFlatButton}" />
                                                    <Button Content="Supprimer"
                                                            HorizontalContentAlignment="Left"
                                                            Foreground="#DC2626"
                                                            IsEnabled="{Binding CanDelete}"
                                                            Command="{Binding DataContext.DeleteManagedEvaluationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource MaterialDesignFlatButton}" />
                                                </StackPanel>
                                            </materialDesign:PopupBox>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Placeholders onglets futurs -->
                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Padding="28" CornerRadius="12"
                        Visibility="{Binding ShowManagerTabPlaceholder, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                        <materialDesign:PackIcon Kind="HammerWrench" Width="40" Height="40"
                                                 Foreground="#94A3B8" HorizontalAlignment="Center" />
                        <TextBlock Margin="0,12,0,6" FontSize="15" FontWeight="SemiBold" Foreground="#334155"
                                   TextAlignment="Center" Text="Bientôt disponible" />
                        <TextBlock FontSize="13" Foreground="#64748B" TextAlignment="Center" TextWrapping="Wrap"
                                   Text="Cet espace accueillera prochainement les statistiques et l'historique d'audit." />
                    </StackPanel>
                </Border>

                <!-- Onglet Notes (vue consolidée lecture seule) -->
                <Grid Visibility="{Binding ShowManagerTabNotes, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Margin="0,0,0,10" Padding="14" Background="#F8FAFC"
                            BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12"
                            Visibility="{Binding ShowCourseNotesContent, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <UniformGrid Columns="5">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock FontSize="11" Foreground="#64748B" Text="Cours" />
                                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"
                                           Text="{Binding CourseNotesCourseName}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock FontSize="11" Foreground="#64748B" Text="Classe" />
                                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"
                                           Text="{Binding CourseNotesClassName}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock FontSize="11" Foreground="#64748B" Text="Sous-période" />
                                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"
                                           Text="{Binding CourseNotesPeriodName}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock FontSize="11" Foreground="#64748B" Text="Nombre d'évaluations" />
                                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"
                                           Text="{Binding CourseNotesEvaluationCount}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock FontSize="11" Foreground="#64748B" Text="Nombre d'élèves" />
                                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"
                                           Text="{Binding CourseNotesStudentCount}" />
                            </StackPanel>
                        </UniformGrid>
                    </Border>

                    <DockPanel Grid.Row="1" Margin="0,0,0,10"
                               Visibility="{Binding ShowCourseNotesContent, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Margin="0,0,8,0" Height="34" Padding="12,0"
                                    Content="Exporter Excel"
                                    Command="{Binding ExportCourseNotesExcelCommand}"
                                    Style="{StaticResource ErpSecondaryButton}" />
                            <Button Height="34" Padding="12,0"
                                    Content="Imprimer"
                                    Command="{Binding PrintCourseNotesCommand}"
                                    Style="{StaticResource ErpSecondaryButton}" />
                        </StackPanel>
                        <TextBox Width="280" Height="34" VerticalContentAlignment="Center"
                                 materialDesign:HintAssist.Hint="Rechercher (nom ou matricule)"
                                 Text="{Binding CourseNotesSearchText, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>

                    <Border Grid.Row="2" Margin="0,0,0,8" Padding="10,8" Background="#EEF2FF" BorderBrush="#C7D2FE"
                            BorderThickness="1" CornerRadius="8"
                            Visibility="{Binding ShowCourseNotesContent, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock FontSize="12" Foreground="#3730A3" TextWrapping="Wrap"
                                   Text="Cette page permet uniquement de consulter les notes enregistrées. Toute saisie ou modification doit être effectuée depuis l'écran « Cotation des notes »." />
                    </Border>

                    <Grid Grid.Row="3">
                        <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Padding="16" CornerRadius="12"
                                Visibility="{Binding IsCourseNotesLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <Border Height="56" Margin="0,0,0,8" Background="#F3F4F6" CornerRadius="8" />
                                <Border Height="56" Margin="0,0,0,8" Background="#F3F4F6" CornerRadius="8" />
                                <Border Height="56" Background="#F3F4F6" CornerRadius="8" />
                            </StackPanel>
                        </Border>

                        <Border Background="White" BorderBrush="#FECACA" BorderThickness="1" Padding="24" CornerRadius="12"
                                Visibility="{Binding ShowCourseNotesError, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                                <materialDesign:PackIcon Kind="AlertCircleOutline" Width="36" Height="36"
                                                         Foreground="#DC2626" HorizontalAlignment="Center" />
                                <TextBlock Margin="0,10,0,8" FontSize="13" Foreground="#991B1B"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           Text="{Binding CourseNotesError}" />
                                <Button HorizontalAlignment="Center" Content="Réessayer"
                                        Command="{Binding RetryCourseNotesCommand}"
                                        Style="{StaticResource ErpSecondaryButton}" />
                            </StackPanel>
                        </Border>

                        <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Padding="4" CornerRadius="12"
                                Visibility="{Binding ShowCourseNotesContent, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <DataGrid x:Name="CourseNotesGrid"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserReorderColumns="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      SelectionUnit="FullRow"
                                      FrozenColumnCount="3"
                                      ItemsSource="{Binding FilteredCourseNotesRows}"
                                      RowHeight="36"
                                      BorderThickness="0"
                                      GridLinesVisibility="All"
                                      HorizontalGridLinesBrush="#E5E7EB"
                                      VerticalGridLinesBrush="#E5E7EB"
                                      Background="Transparent"
                                      EnableRowVirtualization="True"
                                      EnableColumnVirtualization="True" />
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <TextBlock Grid.Row="5" Margin="0,8,0,0" Foreground="#DC2626"
                       Text="{Binding StatusMessage}" TextWrapping="Wrap" />

            <!-- Dialogue création (liste non vide) -->
            <Grid Grid.RowSpan="6" Background="#88000000"
                  Visibility="{Binding IsCreateEvalDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Width="440" Padding="22" Background="White" CornerRadius="12"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Effect="{StaticResource ErpCardShadow}">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="Bold" Text="Créer une évaluation" />
                        <TextBlock Margin="0,8,0,4" Style="{StaticResource GradesParamLabel}" Text="Type d'évaluation" />
                        <ComboBox ItemsSource="{Binding EvaluationTypes}"
                                  DisplayMemberPath="Name"
                                  SelectedItem="{Binding NewEvalType, Mode=TwoWay}" />
                        <TextBlock Margin="0,12,0,4" Style="{StaticResource GradesParamLabel}" Text="Libellé" />
                        <TextBox Text="{Binding NewEvalTitle, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,12,0,4" Style="{StaticResource GradesParamLabel}" Text="Date" />
                        <DatePicker SelectedDate="{Binding NewEvalDate, Mode=TwoWay}" />
                        <TextBlock Margin="0,12,0,4" Style="{StaticResource GradesParamLabel}" Text="Maximum de cette évaluation" />
                        <TextBox Text="{Binding NewEvalMaxScore, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="#64748B" TextWrapping="Wrap"
                                   Text="L'enseignant peut choisir un barème propre (ex. /10). En fin de période, les notes seront ramenées au maximum prévu pour le cours." />
                        <TextBlock Margin="0,8,0,12" Foreground="#DC2626" Text="{Binding EvalDialogError}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Margin="0,0,8,0" Content="Annuler" Command="{Binding CancelCreateEvaluationCommand}"
                                    Style="{StaticResource ErpSecondaryButton}" />
                            <Button Content="Créer" Command="{Binding ConfirmCreateEvaluationCommand}"
                                    Style="{StaticResource ErpPrimaryButton}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Wizard 3 étapes (liste vide) -->
            <Grid Grid.RowSpan="6" Background="#88000000"
                  Visibility="{Binding IsCreateEvalWizardOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Width="560" MaxWidth="560" Padding="24" Background="White" CornerRadius="14"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Effect="{StaticResource ErpCardShadow}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Padding="0" Width="32" Height="32"
                                    Command="{Binding CancelCreateEvaluationCommand}"
                                    Style="{StaticResource MaterialDesignIconButton}"
                                    ToolTip="Fermer">
                                <materialDesign:PackIcon Kind="Close" Width="18" Height="18" />
                            </Button>
                            <TextBlock FontSize="17" FontWeight="Bold" Foreground="#0B1F47"
                                       VerticalAlignment="Center" Text="Assistant — nouvelle évaluation" />
                        </DockPanel>
                        <TextBlock Margin="0,0,0,16" FontSize="12" Foreground="#64748B"
                                   Text="{Binding CreateEvalWizardStepLabel}" />

                        <!-- Étape 1 -->
                        <StackPanel Visibility="{Binding ShowCreateEvalWizardStep1, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Margin="0,0,0,10" FontSize="13" FontWeight="SemiBold" Foreground="#334155"
                                       Text="Choisissez le type d'évaluation" />
                            <ItemsControl ItemsSource="{Binding EvaluationTypes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource EvalWizardTypeCard}" MinWidth="150">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.SelectWizardEvalTypeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}" />
                                            </Border.InputBindings>
                                            <StackPanel>
                                                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"
                                                           Text="{Binding Name}" />
                                                <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding Code}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="#475569"
                                       Text="{Binding NewEvalType.Name, StringFormat=Sélection : {0}}" />
                        </StackPanel>

                        <!-- Étape 2 -->
                        <StackPanel Visibility="{Binding ShowCreateEvalWizardStep2, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Margin="0,0,0,4" Style="{StaticResource GradesParamLabel}" Text="Libellé" />
                            <TextBox Text="{Binding NewEvalTitle, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,12,0,4" Style="{StaticResource GradesParamLabel}" Text="Date" />
                            <DatePicker SelectedDate="{Binding NewEvalDate, Mode=TwoWay}" />
                            <TextBlock Margin="0,12,0,4" Style="{StaticResource GradesParamLabel}" Text="Maximum de cette évaluation" />
                            <TextBox Text="{Binding NewEvalMaxScore, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="#64748B" TextWrapping="Wrap"
                                       Text="Ex. devoir /10 ou /15. Le barème mensuel du cours s'applique seulement au calcul final de la période." />
                        </StackPanel>

                        <!-- Étape 3 -->
                        <StackPanel Visibility="{Binding ShowCreateEvalWizardStep3, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <materialDesign:PackIcon Kind="Loading" Width="36" Height="36"
                                                     Foreground="#1D4ED8" HorizontalAlignment="Center" />
                            <TextBlock Margin="0,12,0,0" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"
                                       TextAlignment="Center" Text="Création et ouverture de la saisie…" />
                            <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="#64748B"
                                       TextAlignment="Center" Text="Vous allez accéder directement à la grille de notes." />
                        </StackPanel>

                        <TextBlock Margin="0,12,0,0" Foreground="#DC2626" Text="{Binding EvalDialogError}" TextWrapping="Wrap" />

                        <DockPanel Margin="0,18,0,0">
                            <Button DockPanel.Dock="Left" Content="Retour"
                                    Command="{Binding CreateEvalWizardBackCommand}"
                                    Style="{StaticResource ErpSecondaryButton}"
                                    Visibility="{Binding ShowCreateEvalWizardStep1, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Margin="0,0,8,0" Content="Annuler"
                                        Command="{Binding CancelCreateEvaluationCommand}"
                                        Style="{StaticResource ErpSecondaryButton}" />
                                <Button Content="Suivant"
                                        Command="{Binding CreateEvalWizardNextCommand}"
                                        Style="{StaticResource ErpPrimaryButton}"
                                        Visibility="{Binding ShowCreateEvalWizardStep1, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Button Content="Créer et saisir les notes"
                                        Command="{Binding CreateEvalWizardNextCommand}"
                                        Style="{StaticResource ErpPrimaryButton}"
                                        Visibility="{Binding ShowCreateEvalWizardStep2, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Dialogue modification -->
            <Grid Grid.RowSpan="6" Background="#88000000"
                  Visibility="{Binding IsEditEvalDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Width="420" Padding="20" Background="White" CornerRadius="12"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Effect="{StaticResource ErpCardShadow}">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="Bold" Text="Modifier l'évaluation" />
                        <TextBlock Margin="0,8,0,4" Foreground="#64748B"
                                   Text="{Binding EditingEvaluation.TypeName}" />
                        <TextBlock Margin="0,8,0,4" Style="{StaticResource GradesParamLabel}" Text="Libellé" />
                        <TextBox Text="{Binding NewEvalTitle, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,12,0,4" Style="{StaticResource GradesParamLabel}" Text="Date" />
                        <DatePicker SelectedDate="{Binding NewEvalDate, Mode=TwoWay}" />
                        <TextBlock Margin="0,12,0,4" Style="{StaticResource GradesParamLabel}" Text="Maximum de cette évaluation" />
                        <TextBox Text="{Binding NewEvalMaxScore, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,8,0,12" Foreground="#DC2626" Text="{Binding EvalDialogError}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Margin="0,0,8,0" Content="Annuler" Command="{Binding CancelEditEvaluationCommand}"
                                    Style="{StaticResource ErpSecondaryButton}" />
                            <Button Content="Enregistrer" Command="{Binding ConfirmEditEvaluationCommand}"
                                    Style="{StaticResource ErpPrimaryButton}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Zone principale -->

        <Grid Visibility="{Binding ShowCotationWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- En-tête saisie : retour + infos évaluation uniquement -->
            <Border Grid.Row="0"
                    Margin="0,0,0,12"
                    Background="#EEF4FF"
                    BorderBrush="#D6E4FF"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12,10">
                <DockPanel LastChildFill="True">
                    <Button Margin="0,0,12,0"
                            Padding="12,8"
                            VerticalAlignment="Center"
                            Command="{Binding BackToEvaluationManagerCommand}"
                            DockPanel.Dock="Left"
                            Style="{StaticResource ErpSecondaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ArrowLeft"
                                                     Width="16"
                                                     Height="16"
                                                     Margin="0,0,6,0"
                                                     VerticalAlignment="Center"
                                                     Foreground="#1F2937" />
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="#1F2937"
                                       Text="Retour aux évaluations" />
                        </StackPanel>
                    </Button>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#1F2937"
                                   Text="Cotation des notes" />
                        <WrapPanel Margin="0,6,0,0">
                            <StackPanel Margin="0,0,20,4" Orientation="Horizontal">
                                <TextBlock Style="{StaticResource GradesSummaryLabel}" Text="Évaluation" />
                                <TextBlock Margin="8,0,0,0"
                                           Style="{StaticResource GradesSummaryValue}"
                                           Text="{Binding EvaluationTitle}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,20,4" Orientation="Horizontal">
                                <TextBlock Style="{StaticResource GradesSummaryLabel}" Text="Type" />
                                <TextBlock Margin="8,0,0,0"
                                           Style="{StaticResource GradesSummaryValue}"
                                           Text="{Binding SummaryWorkTypeName}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,20,4" Orientation="Horizontal">
                                <TextBlock Style="{StaticResource GradesSummaryLabel}" Text="Maximum" />
                                <TextBlock Margin="8,0,0,0"
                                           Style="{StaticResource GradesSummaryValue}"
                                           Text="{Binding SummaryMaxScoreLabel}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                                <TextBlock Style="{StaticResource GradesSummaryLabel}" Text="Date" />
                                <TextBlock Margin="8,0,0,0"
                                           Style="{StaticResource GradesSummaryValue}"
                                           Text="{Binding SummaryDate}" />
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Grille de saisie (élément principal) -->
            <Border Grid.Row="1" Style="{StaticResource ErpCard}" Padding="8,8,8,8">
                <DataGrid x:Name="GradingGrid"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          IsReadOnly="True"
                          ItemsSource="{Binding GradeEntries}"
                          PreviewKeyDown="GradingGrid_OnPreviewKeyDown"
                          SelectionMode="Single"
                          SelectionUnit="Cell"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F1F5F9"
                          BorderThickness="0"
                          Background="Transparent"
                          RowBackground="Transparent"
                          AlternatingRowBackground="#FAFBFC"
                          RowHeight="46"
                          ColumnHeaderStyle="{StaticResource GradesCollectColumnHeader}"
                          CellStyle="{StaticResource GradesCollectCell}">
                    <DataGrid.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#EEF2FF" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0F172A" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#F1F5F9" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#0F172A" />
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="N°" Width="50" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource GradesCollectReadOnlyText}"
                                               Foreground="#64748B"
                                               Text="{Binding RowNumber}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Matricule" Width="110" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource GradesCollectReadOnlyText}"
                                               Foreground="#64748B"
                                               Text="{Binding RegistrationNumber}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Nom de l'élève" Width="*" MinWidth="160" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource GradesCollectReadOnlyText}"
                                               FontWeight="SemiBold"
                                               Text="{Binding StudentName}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Abs" Width="70" IsReadOnly="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding IsAbsent, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding DataContext.CanEditGrades, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Note" Width="140" IsReadOnly="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Score, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource GradesCollectScoreTextBox}">
                                                <Setter Property="IsEnabled" Value="True" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAbsent}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DataContext.CanEditGrades, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="False">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Observation" Width="*" MinWidth="180" IsReadOnly="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Style="{StaticResource GradesCollectEditTextBox}"
                                             IsEnabled="{Binding DataContext.CanEditGrades, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                             Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Actions saisie uniquement -->
            <Border Grid.Row="2"
                    Margin="0,12,0,0"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="16,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Margin="0,0,8,0"
                            Command="{Binding SaveGradesCommand}"
                            Height="42"
                            Padding="18,0"
                            Background="#22C55E"
                            BorderBrush="#22C55E"
                            Foreground="White"
                            Style="{StaticResource ErpPrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Enregistrer" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Margin="0,0,8,0"
                            Command="{Binding SaveAndCloseGradesCommand}"
                            Height="42"
                            Padding="18,0"
                            Style="{StaticResource ErpPrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSaveCheck" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Enregistrer et fermer" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CancelGradesCommand}"
                            Height="42"
                            Padding="18,0"
                            Style="{StaticResource ErpSecondaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Undo" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#EF4444" />
                            <TextBlock Text="Annuler" Foreground="#EF4444" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="3"
                       Margin="0,10,0,0"
                       Style="{StaticResource ErpBodySecondary}"
                       Text="{Binding StatusMessage}"
                       TextWrapping="Wrap" />
        </Grid>


        <!-- Menu hamburger : panneau paramètres -->

        <Grid Panel.ZIndex="30"

              Visibility="{Binding IsParametersExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">

            <Button Command="{Binding ToggleParametersCommand}"

                    Background="#66000000"

                    BorderThickness="0"

                    Cursor="Hand"

                    HorizontalAlignment="Stretch"

                    VerticalAlignment="Stretch" />

            <Border Width="400"

                    HorizontalAlignment="Left"

                    VerticalAlignment="Stretch"

                    Style="{StaticResource SchoolFeeStudentsLikePanel}">

                <DockPanel LastChildFill="True">

                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">

                        <Button Width="36"

                                Height="36"

                                Padding="0"

                                HorizontalAlignment="Right"

                                Command="{Binding ToggleParametersCommand}"

                                DockPanel.Dock="Right"

                                ToolTip="Fermer"

                                Style="{StaticResource MaterialDesignIconButton}">

                            <materialDesign:PackIcon Kind="Close" Width="20" Height="20" />

                        </Button>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                            <materialDesign:PackIcon Kind="ClipboardEditOutline"

                                                     Width="20"

                                                     Height="20"

                                                     Margin="0,0,8,0"

                                                     VerticalAlignment="Center"

                                                     Foreground="{StaticResource ErpPrimaryBrush}" />

                            <TextBlock Text="{Binding ParametersHeaderText}"

                                       FontSize="14"

                                       FontWeight="SemiBold"

                                       Foreground="#1F2937" />

                        </StackPanel>

                    </DockPanel>



                    <ScrollViewer DockPanel.Dock="Bottom"

                                  VerticalScrollBarVisibility="Auto"

                                  HorizontalScrollBarVisibility="Disabled">

                        <StackPanel>

                            <Border Style="{StaticResource SchoolFeeSectionCard}" Margin="0,0,0,12">

                                <StackPanel>

                                    <TextBlock Style="{StaticResource GradesSectionTitle}" Text="ÉVALUATIONS ENREGISTRÉES" />

                                    <erp:ErpComboField Margin="0,0,0,8"

                                                       Label="Choisir une évaluation"

                                                       IconKind="ClipboardListOutline"

                                                       DisplayMemberPath="DisplayLabel"

                                                       ItemsSource="{Binding SavedEvaluations}"

                                                       SelectedItem="{Binding SelectedSavedEvaluation, Mode=TwoWay}" />

                                    <TextBlock Margin="0,0,0,8"

                                               FontSize="11"

                                               Foreground="#9CA3AF"

                                               Text="Aucune évaluation enregistrée pour cette salle et cette période."

                                               TextWrapping="Wrap"

                                               Visibility="{Binding ShowNoSavedEvaluationsMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                    <Button Height="34"

                                            Command="{Binding RefreshSavedEvaluationsCommand}"

                                            Style="{StaticResource ErpSecondaryButton}">

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                            <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />

                                            <TextBlock Text="Actualiser la liste" VerticalAlignment="Center" />

                                        </StackPanel>

                                    </Button>

                                </StackPanel>

                            </Border>



                            <Border Style="{StaticResource SchoolFeeSectionCard}" Margin="0,0,0,12">

                                <StackPanel>

                                    <Border Margin="0,0,0,12"
                                            Padding="12"
                                            Background="#EEF2FF"
                                            BorderBrush="#C7D2FE"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#4338CA"
                                                       Text="Période ouverte" />
                                            <TextBlock FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="#0B1F47"
                                                       Text="{Binding ActivePeriodBanner}" />
                                            <TextBlock FontSize="12"
                                                       Foreground="#4B5563"
                                                       Text="{Binding ActivePeriodDetails}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,6,0,0"
                                                       FontSize="12"
                                                       Foreground="#DC2626"
                                                       Text="{Binding NoOpenPeriodMessage}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <erp:ErpComboField Margin="0,0,0,12"
                                                       Label="Type d'évaluation"
                                                       IconKind="ClipboardTextOutline"
                                                       DisplayMemberPath="Name"
                                                       ItemsSource="{Binding EvaluationTypes}"
                                                       SelectedItem="{Binding SelectedEvaluationType, Mode=TwoWay}" />

                                    <TextBlock Style="{StaticResource GradesParamLabel}" Text="Cours (affectation)" />
                                    <TextBlock Margin="0,0,0,12"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#0B1F47"
                                               Text="{Binding BannerCourse}" />

                                </StackPanel>

                            </Border>



                            <Border Style="{StaticResource SchoolFeeSectionCard}" Margin="0,0,0,12">

                                <StackPanel>

                                    <erp:ErpDateField Margin="0,0,0,12"

                                                      Label="Date de l'évaluation"

                                                      SelectedDate="{Binding EvaluationDate, Mode=TwoWay}" />

                                    <erp:ErpTextField Margin="0,0,0,12"

                                                      Label="Barème"

                                                      IconKind="Numeric"

                                                      Text="{Binding EvaluationMaxScore, UpdateSourceTrigger=PropertyChanged}" />

                                    <erp:ErpTextField Margin="0,0,0,12"

                                                      Label="Coefficient"

                                                      IconKind="Numeric"

                                                      Text="{Binding EvaluationCoefficient, UpdateSourceTrigger=PropertyChanged}" />

                                    <erp:ErpTextField Label="Intitulé de l'évaluation"

                                                      IconKind="FormatTitle"

                                                      Text="{Binding EvaluationTitle, UpdateSourceTrigger=PropertyChanged}" />

                                </StackPanel>

                            </Border>



                            <Button Height="38"

                                    Command="{Binding LoadStudentsCommand}"

                                    Style="{StaticResource ErpPrimaryButton}">

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                    <materialDesign:PackIcon Kind="AccountSearch" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />

                                    <TextBlock Text="Recharger les élèves" FontWeight="SemiBold" VerticalAlignment="Center" />

                                </StackPanel>

                            </Button>



                            <Border Margin="0,10,0,0"

                                    Background="#F8FAFC"

                                    BorderBrush="#E5E7EB"

                                    BorderThickness="1"

                                    CornerRadius="10"

                                    Padding="10,8">

                                <StackPanel>

                                    <TextBlock FontWeight="SemiBold"

                                               Foreground="#1E5EFF"

                                               FontSize="12"

                                               Text="Raccourcis clavier" />

                                    <TextBlock Margin="0,4,0,0" FontSize="10" Foreground="#6B7280" Text="Saisie directe dans Points / Observation" />

                                    <TextBlock Margin="0,1,0,0" FontSize="10" Foreground="#6B7280" Text="Entrée : élève suivant" />

                                    <TextBlock Margin="0,1,0,0" FontSize="10" Foreground="#6B7280" Text="Tab : colonne suivante" />

                                    <TextBlock Margin="0,1,0,0" FontSize="10" Foreground="#6B7280" Text="Ctrl+S : enregistrer" />

                                </StackPanel>

                            </Border>

                        </StackPanel>

                    </ScrollViewer>

                </DockPanel>

            </Border>

        </Grid>



        <Border Style="{StaticResource SchoolFeeLoadingOverlay}"

                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                <ProgressBar Width="180" Height="4" IsIndeterminate="True" Foreground="{StaticResource ErpPrimaryBrush}" />

                <TextBlock Margin="0,10,0,0"

                           HorizontalAlignment="Center"

                           Style="{StaticResource ErpBodySecondary}"

                           Text="Chargement en cours…" />

            </StackPanel>

        </Border>

    </Grid>

</UserControl>


