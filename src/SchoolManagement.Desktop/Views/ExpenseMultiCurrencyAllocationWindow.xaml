<Window x:Class="SchoolManagement.Desktop.Views.ExpenseMultiCurrencyAllocationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Répartition multi-devises"
        Height="560"
        Width="920"
        MinHeight="420"
        MinWidth="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource ErpPageBackgroundBrush}"
        FontFamily="{StaticResource ErpFontFamily}"
        Loaded="Window_OnLoaded">
    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                Padding="16,10"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" MaxWidth="480">
                    <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Margin="0,0,8,0"
                            Padding="14,8"
                            Command="{Binding AutoAllocateCommand}"
                            Content="Recalculer auto"
                            Style="{StaticResource ErpSecondaryButton}" />
                    <Button Margin="0,0,8,0"
                            Padding="14,8"
                            Command="{Binding CancelCommand}"
                            Content="Annuler"
                            Style="{StaticResource ErpSecondaryButton}" />
                    <Button Padding="14,8"
                            Command="{Binding ConfirmCommand}"
                            Content="Valider la répartition"
                            Style="{StaticResource ErpSuccessButton}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
            <StackPanel>
                <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" Text="Répartition multi-devises" />
                <TextBlock Margin="0,4,0,12"
                           FontSize="13"
                           Foreground="#64748B"
                           Text="{Binding AccountTitle, StringFormat=Compte : {0}}" />

                <UniformGrid Columns="3" Margin="0,0,0,14">
                    <Border Margin="0,0,8,0" Padding="12,10" Background="#EFF6FF" CornerRadius="8">
                        <StackPanel>
                            <TextBlock FontSize="11" Foreground="#64748B" Text="Dépense à couvrir" />
                            <TextBlock FontSize="16" FontWeight="Bold" Text="{Binding ExpenseAmountDisplay}" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,0,8,0" Padding="12,10" Background="#ECFDF5" CornerRadius="8">
                        <StackPanel>
                            <TextBlock FontSize="11" Foreground="#64748B" Text="Couvert" />
                            <TextBlock FontSize="16" FontWeight="Bold" Foreground="#16A34A" Text="{Binding CoveredDisplay}" />
                        </StackPanel>
                    </Border>
                    <Border Padding="12,10" Background="#FEF2F2" CornerRadius="8">
                        <StackPanel>
                            <TextBlock FontSize="11" Foreground="#64748B" Text="Reste à couvrir" />
                            <TextBlock FontSize="16" FontWeight="Bold" Foreground="#DC2626" Text="{Binding RemainingToCoverDisplay}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <DataGrid ItemsSource="{Binding Lines}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          IsReadOnly="False"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          BorderBrush="#E5E7EB"
                          BorderThickness="1"
                          RowHeight="40"
                          AlternatingRowBackground="#F8FAFC"
                          materialDesign:DataGridAssist.CellPadding="8,4"
                          CellEditEnding="DataGrid_OnCellEditEnding">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Devise"
                                            Binding="{Binding CurrencyCode}"
                                            IsReadOnly="True"
                                            Width="80" />
                        <DataGridTextColumn Header="Disponible"
                                            Binding="{Binding AvailableDisplay}"
                                            IsReadOnly="True"
                                            Width="120" />
                        <DataGridTextColumn Header="Taux"
                                            Binding="{Binding Rate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N8}"
                                            Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Sens / taux"
                                            Binding="{Binding RateDirectionLabel}"
                                            IsReadOnly="True"
                                            Width="*" />
                        <DataGridTextColumn Header="Utilisé"
                                            Binding="{Binding UsedAmountText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                            Width="110" />
                        <DataGridTextColumn Header="Équiv. principale"
                                            Binding="{Binding EquivalentDisplay}"
                                            IsReadOnly="True"
                                            Width="120" />
                        <DataGridTextColumn Header="Reste"
                                            Binding="{Binding RemainingDisplay}"
                                            IsReadOnly="True"
                                            Width="120" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Margin="0,10,0,0"
                           FontSize="12"
                           Foreground="#64748B"
                           TextWrapping="Wrap"
                           Text="La devise principale est utilisée en priorité. Les autres devises complètent automatiquement le montant manquant via le taux en vigueur. Une devise ne peut être utilisée qu'une seule fois." />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
