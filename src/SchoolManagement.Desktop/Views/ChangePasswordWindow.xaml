<Window x:Class="SchoolManagement.Desktop.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Changement de mot de passe"
        Width="480"
        MinHeight="420"
        SizeToContent="Height"
        MaxHeight="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource ErpPageBackgroundBrush}"
        FontFamily="{StaticResource ErpFontFamily}">
    <Border Margin="24"
            Padding="20"
            Style="{StaticResource ErpCard}">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                <Button Command="{Binding SaveCommand}"
                        Content="Enregistrer"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource ErpPrimaryButton}" />
                <ProgressBar Margin="0,12,0,0"
                             Height="3"
                             Foreground="{StaticResource ErpPrimaryBrush}"
                             IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Style="{StaticResource ErpFadeIn}">
                    <Border Width="56"
                            Height="56"
                            Background="{StaticResource ErpPrimaryLightBrush}"
                            CornerRadius="14"
                            HorizontalAlignment="Left">
                        <materialDesign:PackIcon Kind="LockReset"
                                                 Width="28"
                                                 Height="28"
                                                 Foreground="{StaticResource ErpPrimaryBrush}"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Margin="0,16,0,8"
                               Style="{StaticResource ErpSectionTitle}"
                               FontSize="20"
                               Text="{Binding Title}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,0,0,20"
                               Style="{StaticResource ErpBodySecondary}"
                               Text="{Binding Description}"
                               TextWrapping="Wrap" />

                    <PasswordBox x:Name="CurrentPasswordBox"
                                 materialDesign:HintAssist.Hint="Mot de passe actuel"
                                 Margin="0,0,0,16"
                                 PasswordChanged="CurrentPasswordBox_OnPasswordChanged"
                                 Style="{StaticResource ErpPasswordBox}" />

                    <PasswordBox x:Name="NewPasswordBox"
                                 materialDesign:HintAssist.Hint="Nouveau mot de passe"
                                 Margin="0,0,0,16"
                                 PasswordChanged="NewPasswordBox_OnPasswordChanged"
                                 Style="{StaticResource ErpPasswordBox}" />

                    <PasswordBox x:Name="ConfirmPasswordBox"
                                 materialDesign:HintAssist.Hint="Confirmer le mot de passe"
                                 Margin="0,0,0,8"
                                 PasswordChanged="ConfirmPasswordBox_OnPasswordChanged"
                                 Style="{StaticResource ErpPasswordBox}" />

                    <TextBlock Foreground="{StaticResource ErpDangerBrush}"
                               Text="{Binding ErrorMessage}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
