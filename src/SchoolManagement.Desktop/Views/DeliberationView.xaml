<UserControl x:Class="SchoolManagement.Desktop.Views.DeliberationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="20,16,20,16" Style="{StaticResource ErpFadeIn}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                CornerRadius="10" Padding="14,12" Margin="0,0,0,10"
                Visibility="{Binding ShowLocalFilters, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Classe" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding ClassRooms}"
                              SelectedItem="{Binding SelectedClassRoom}"
                              DisplayMemberPath="Name"
                              Height="36" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Sous-période" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding PeriodOptions}"
                              SelectedItem="{Binding SelectedPeriod}"
                              DisplayMemberPath="Name"
                              Height="36" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Actualiser" Height="36" Margin="0,0,6,0"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}" />
                    <Button Content="Excel" Height="36" Margin="0,0,6,0"
                            Command="{Binding ExportExcelCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}" />
                    <Button Content="PDF" Height="36" Margin="0,0,6,0"
                            Command="{Binding ExportPdfCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}" />
                    <Button Content="Imprimer" Height="36"
                            Command="{Binding PrintCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#0B1F47" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Classe / Période" Foreground="#94A3B8" FontSize="11" />
                    <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="White">
                        <Run Text="{Binding ClassDisplayName}" />
                        <Run Text=" · " />
                        <Run Text="{Binding PeriodLabel}" />
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="#A7F3D0"
                               Text="{Binding ValidationStatusLabel}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0">
                    <TextBlock Text="Élèves" Foreground="#94A3B8" FontSize="11" />
                    <TextBlock Text="{Binding SummaryStudentCount}" FontSize="18" FontWeight="Bold" Foreground="White" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="8,0">
                    <TextBlock Text="Admis" Foreground="#94A3B8" FontSize="11" />
                    <TextBlock Text="{Binding SummaryAdmitted}" FontSize="18" FontWeight="Bold" Foreground="#86EFAC" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="8,0">
                    <TextBlock Text="Ajournés" Foreground="#94A3B8" FontSize="11" />
                    <TextBlock Text="{Binding SummaryDeferred}" FontSize="18" FontWeight="Bold" Foreground="#FCD34D" />
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="8,0">
                    <TextBlock Text="Exclus" Foreground="#94A3B8" FontSize="11" />
                    <TextBlock Text="{Binding SummaryExcluded}" FontSize="18" FontWeight="Bold" Foreground="#FCA5A5" />
                </StackPanel>
                <StackPanel Grid.Column="5" Margin="8,0">
                    <TextBlock Text="Moyenne" Foreground="#94A3B8" FontSize="11" />
                    <TextBlock Text="{Binding SummaryClassAverage}" FontSize="18" FontWeight="Bold" Foreground="White" />
                </StackPanel>
                <StackPanel Grid.Column="6" Margin="8,0">
                    <TextBlock Text="Taux réussite" Foreground="#94A3B8" FontSize="11" />
                    <TextBlock Text="{Binding SummarySuccessRate}" FontSize="18" FontWeight="Bold" Foreground="White" />
                </StackPanel>
                <StackPanel Grid.Column="7" Margin="8,0">
                    <TextBlock Text="Validation" Foreground="#94A3B8" FontSize="11" />
                    <TextBlock Text="{Binding ValidatedAtDisplay}" FontSize="12" Foreground="White" />
                    <TextBlock Text="{Binding ValidatedByDisplay}" FontSize="11" Foreground="#94A3B8" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="2"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    Style="{StaticResource MaterialDesignTabControl}">
            <TabItem Header="Résultats">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                            CornerRadius="10" Margin="0,0,10,0">
                        <Grid>
                            <DataGrid ItemsSource="{Binding Rows}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      BorderThickness="0"
                                      RowHeight="36"
                                      AlternatingRowBackground="#F8FAFC"
                                      MouseDoubleClick="Rows_MouseDoubleClick"
                                      Visibility="{Binding AccessBlocked, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Rang" Binding="{Binding RankDisplay}" Width="60" />
                                    <DataGridTextColumn Header="Matricule" Binding="{Binding RegistrationNumber}" Width="100" />
                                    <DataGridTextColumn Header="Nom" Binding="{Binding FullName}" Width="*" MinWidth="120" />
                                    <DataGridTextColumn Header="Moyenne" Binding="{Binding AverageDisplay}" Width="70" />
                                    <DataGridTextColumn Header="%" Binding="{Binding PercentageDisplay}" Width="60" />
                                    <DataGridTextColumn Header="Mention" Binding="{Binding Mention}" Width="90" />
                                    <DataGridTextColumn Header="Décision" Binding="{Binding ProposedDecisionLabel}" Width="150" />
                                    <DataGridTextColumn Header="Décision après délibération" Binding="{Binding FinalDecisionLabel}" Width="170" />
                                    <DataGridTextColumn Header="Statut" Binding="{Binding ValidationStatusLabel}" Width="80" />
                                    <DataGridTemplateColumn Header="" Width="170">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Décision" Height="28" Padding="8,0" Margin="0,0,4,0"
                                                            Command="{Binding DataContext.OpenDecisionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource ErpPrimaryButton}" />
                                                    <Button Content="Consulter" Height="28" Padding="8,0"
                                                            Command="{Binding DataContext.ConsultCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource MaterialDesignFlatButton}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Background="#FFFBEB" Padding="24"
                                    Visibility="{Binding AccessBlocked, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                                    <materialDesign:PackIcon Kind="Gavel" Width="40" Height="40"
                                                             Foreground="#B45309" HorizontalAlignment="Center" />
                                    <TextBlock Text="Accès à la délibération refusé"
                                               FontSize="18" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Margin="0,12,0,8" />
                                    <TextBlock Text="{Binding StatusMessage}"
                                               TextWrapping="Wrap" TextAlignment="Center"
                                               Foreground="#92400E" FontSize="14" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                            CornerRadius="10"
                            Visibility="{Binding AccessBlocked, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="#0F172A" CornerRadius="10,10,0,0" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="Cas particuliers" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                                    <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="#94A3B8"
                                               Text="Aide au Conseil de classe — PeriodResult uniquement" />
                                    <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="#FCD34D">
                                        <Run Text="{Binding SpecialCaseTotalCount, Mode=OneWay}" />
                                        <Run Text=" cas signalé(s)" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,8,10,10">
                                <StackPanel>
                                    <TextBlock Text="Aucun cas particulier pour cette classe."
                                               Foreground="#64748B" FontSize="12" TextWrapping="Wrap"
                                               Margin="4,12"
                                               Visibility="{Binding HasSpecialCases, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

                                    <ItemsControl ItemsSource="{Binding SpecialCaseSections}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1"
                                                        CornerRadius="8" Padding="0,0,0,4">
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Top" Padding="10,8"
                                                                BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                                                            <DockPanel>
                                                                <Border DockPanel.Dock="Left" Width="4" CornerRadius="2"
                                                                        Margin="0,0,8,0" Background="{Binding AccentHex}" />
                                                                <TextBlock DockPanel.Dock="Right"
                                                                           Text="{Binding CountDisplay}"
                                                                           FontWeight="Bold" Foreground="#0F172A"
                                                                           VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Title}" FontSize="12"
                                                                           FontWeight="SemiBold" Foreground="#0F172A"
                                                                           TextWrapping="Wrap" VerticalAlignment="Center" />
                                                            </DockPanel>
                                                        </Border>
                                                        <ItemsControl ItemsSource="{Binding Items}" Margin="6,4,6,0">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Margin="0,0,0,6" Padding="8,6" Background="#F8FAFC"
                                                                            CornerRadius="6">
                                                                        <DockPanel>
                                                                            <StackPanel DockPanel.Dock="Bottom"
                                                                                        Orientation="Horizontal" Margin="0,6,0,0">
                                                                                <Button Content="Fiche" Height="26" Padding="8,0" Margin="0,0,4,0"
                                                                                        Command="{Binding DataContext.OpenSpecialCaseProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                        CommandParameter="{Binding}"
                                                                                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                                                                                <Button Content="Résultats" Height="26" Padding="8,0"
                                                                                        Command="{Binding DataContext.ViewSpecialCaseResultsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                        CommandParameter="{Binding}"
                                                                                        Style="{StaticResource MaterialDesignFlatButton}" />
                                                                            </StackPanel>
                                                                            <StackPanel>
                                                                                <TextBlock Text="{Binding FullName}" FontSize="12"
                                                                                           FontWeight="SemiBold" Foreground="#0F172A"
                                                                                           TextWrapping="Wrap" />
                                                                                <TextBlock Text="{Binding Detail}" FontSize="11"
                                                                                           Foreground="#64748B" TextWrapping="Wrap"
                                                                                           Margin="0,2,0,0" />
                                                                            </StackPanel>
                                                                        </DockPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Procès-verbal">
                <Border Margin="0,8,0,0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                        CornerRadius="10" Padding="16">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding AccessBlocked, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Procès-verbal de délibération"
                                                   FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" />
                                        <TextBlock Text="Saisie Direction — sans modification des résultats scolaires."
                                                   FontSize="12" Foreground="#64748B" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button DockPanel.Dock="Right"
                                            Content="Enregistrer le PV"
                                            Height="36" Padding="16,0"
                                            Command="{Binding SaveMinutesCommand}"
                                            Style="{StaticResource ErpPrimaryButton}" />
                                </DockPanel>

                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                        CornerRadius="8" Padding="12" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Enregistré par" FontSize="11" Foreground="#64748B" />
                                            <TextBlock Text="{Binding PvRecordedByDisplay}" FontWeight="SemiBold" Foreground="#0F172A" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Date / heure" FontSize="11" Foreground="#64748B" />
                                            <TextBlock Text="{Binding PvRecordedAtDisplay}" FontWeight="SemiBold" Foreground="#0F172A" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Statut" FontSize="11" Foreground="#64748B" />
                                            <TextBlock FontWeight="SemiBold" Foreground="#0F172A"
                                                       Text="{Binding PvStatusDisplay}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <TextBlock Text="Observations générales" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#0F172A" Margin="0,0,0,6" />
                                <TextBox Text="{Binding PvGeneralObservations, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90"
                                         VerticalScrollBarVisibility="Auto"
                                         materialDesign:HintAssist.Hint="Ex. Climat de classe, discipline, participation…"
                                         Margin="0,0,0,14" />

                                <TextBlock Text="Décisions du Conseil" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#0F172A" Margin="0,0,0,6" />
                                <TextBox Text="{Binding PvCouncilDecisions, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90"
                                         VerticalScrollBarVisibility="Auto"
                                         materialDesign:HintAssist.Hint="Ex. Félicitations au Tableau d'honneur…"
                                         Margin="0,0,0,14" />

                                <TextBlock Text="Recommandations pédagogiques" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#0F172A" Margin="0,0,0,6" />
                                <TextBox Text="{Binding PvPedagogicalRecommendations, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90"
                                         VerticalScrollBarVisibility="Auto"
                                         materialDesign:HintAssist.Hint="Ex. Cours de rattrapage, convocations parents…"
                                         Margin="0,0,0,10" />

                                <TextBlock Text="Exemples (cliquer pour insérer)" FontSize="11" Foreground="#64748B" Margin="0,0,0,6" />
                                <WrapPanel>
                                    <Button Content="Félicitations au Tableau d'honneur"
                                            Margin="0,0,6,6" Height="28" Padding="10,0"
                                            Command="{Binding InsertPvExampleCommand}"
                                            CommandParameter="Félicitations au Tableau d'honneur."
                                            Style="{StaticResource MaterialDesignOutlinedButton}" />
                                    <Button Content="Cours de rattrapage"
                                            Margin="0,0,6,6" Height="28" Padding="10,0"
                                            Command="{Binding InsertPvExampleCommand}"
                                            CommandParameter="Organisation de cours de rattrapage."
                                            Style="{StaticResource MaterialDesignOutlinedButton}" />
                                    <Button Content="Convocation parents ajournés"
                                            Margin="0,0,6,6" Height="28" Padding="10,0"
                                            Command="{Binding InsertPvExampleCommand}"
                                            CommandParameter="Convocation des parents des élèves ajournés."
                                            Style="{StaticResource MaterialDesignOutlinedButton}" />
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <Border Background="#FFFBEB" Padding="24"
                                Visibility="{Binding AccessBlocked, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                                <TextBlock Text="Procès-verbal indisponible"
                                           FontSize="18" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,0,0,8" />
                                <TextBlock Text="Les résultats doivent être validés avant de rédiger le procès-verbal."
                                           TextWrapping="Wrap" TextAlignment="Center"
                                           Foreground="#92400E" FontSize="14" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Margin="0,10,0,0" Padding="4,8">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#475569"
                       Visibility="{Binding AccessBlocked, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
        </Border>

        <Grid Grid.RowSpan="4" Background="#80FFFFFF"
              Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ProgressBar IsIndeterminate="True" Width="180" Height="4" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
