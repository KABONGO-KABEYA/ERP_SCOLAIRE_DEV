<UserControl x:Class="SchoolManagement.Desktop.Views.ExpensePaymentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:erp="clr-namespace:SchoolManagement.Desktop.Controls">
    <Grid Margin="0" Style="{StaticResource ErpFadeIn}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="240" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,8"
                Padding="12,10"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="10">
            <StackPanel>
                <TextBlock FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#1F2937"
                           Text="Nouvelle dépense" />
                <UniformGrid Columns="4" Margin="0,10,0,0">
                    <erp:ErpComboField Margin="0,0,12,12"
                                       DisplayMemberPath="Label"
                                       ItemsSource="{Binding AcademicYears}"
                                       Label="Année scolaire"
                                       SelectedItem="{Binding SelectedAcademicYear, Mode=TwoWay}" />
                    <erp:ErpComboField Margin="0,0,12,12"
                                       DisplayMemberPath="Name"
                                       ItemsSource="{Binding Destinations}"
                                       Label="Compte bénéficiaire"
                                       SelectedItem="{Binding SelectedDestination, Mode=TwoWay}" />
                    <erp:ErpTextField Margin="0,0,12,12"
                                      Label="Libellé"
                                      Text="{Binding NewLabel, UpdateSourceTrigger=PropertyChanged}" />
                    <erp:ErpTextField Margin="0,0,0,12"
                                      Label="Montant"
                                      Text="{Binding NewAmount, UpdateSourceTrigger=PropertyChanged}" />
                </UniformGrid>
                <StackPanel Orientation="Horizontal">
                    <Button Margin="0,0,8,0"
                            Command="{Binding CreateCommand}"
                            Content="Enregistrer la dépense"
                            Style="{StaticResource ErpPrimaryButton}" />
                    <Button Command="{Binding SearchCommand}"
                            Content="Actualiser"
                            Style="{StaticResource ErpSecondaryButton}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="10">
            <DataGrid CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      ItemsSource="{Binding Payments}"
                      Style="{StaticResource ErpDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Reference}" Header="Réf." Width="120" />
                    <DataGridTextColumn Binding="{Binding Label}" Header="Libellé" Width="*" MinWidth="160" />
                    <DataGridTextColumn Binding="{Binding DestinationName}" Header="Compte" Width="140" />
                    <DataGridTextColumn Binding="{Binding Amount, StringFormat=N2}" Header="Montant" Width="100" />
                    <DataGridTextColumn Binding="{Binding ExpenseDate, StringFormat=dd/MM/yyyy}" Header="Date" Width="100" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="2"
                   Margin="0,8,0,0"
                   Foreground="#6B7280"
                   Text="{Binding StatusMessage}" />
    </Grid>
</UserControl>
