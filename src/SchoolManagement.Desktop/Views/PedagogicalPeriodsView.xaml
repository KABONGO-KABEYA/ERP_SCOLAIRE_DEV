<UserControl x:Class="SchoolManagement.Desktop.Views.PedagogicalPeriodsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SchoolManagement.Desktop.ViewModels"
             xmlns:ui="clr-namespace:SchoolManagement.Desktop.UI"
             Background="{StaticResource ErpPageBackgroundBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <ui:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,16"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Margin="0,0,8,0"
                    Command="{Binding LoadStructureCommand}"
                    Style="{StaticResource ErpSecondaryButton}"
                    Content="Actualiser" />
            <Button Command="{Binding CreateStructureCommand}"
                    Style="{StaticResource ErpPrimaryButton}"
                    Content="Générer le calendrier"
                    Visibility="{Binding HasStructure, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding CycleGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CycleGroupItem}">
                        <Border Margin="0,0,0,20"
                                Padding="16"
                                Background="White"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="12">
                            <StackPanel>
                                <TextBlock FontSize="16" FontWeight="Bold" Foreground="#0B1F47"
                                           Text="{Binding Label}" />
                                <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding MainPeriods}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:MainPeriodItem}">
                                            <StackPanel Margin="0,0,0,16">
                                                <TextBlock FontWeight="SemiBold" FontSize="14"
                                                           Foreground="#1E3A8A"
                                                           Text="{Binding Name}" />
                                                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding SubPeriods}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:SubPeriodItem}">
                                                            <Border Margin="0,0,0,8"
                                                                    Padding="12,10"
                                                                    BorderBrush="#E5E7EB"
                                                                    BorderThickness="1"
                                                                    CornerRadius="8">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="#F8FAFC" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                <Setter Property="Background" Value="#ECFDF5" />
                                                                                <Setter Property="BorderBrush" Value="#86EFAC" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Width="24"
                                                                               FontSize="16"
                                                                               VerticalAlignment="Center"
                                                                               Foreground="{Binding StatusBrush}"
                                                                               Text="{Binding StatusGlyph}" />
                                                                    <StackPanel Grid.Column="1" Margin="8,0">
                                                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                                        <TextBlock FontSize="13"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="#0F172A"
                                                                                   Text="{Binding DateRangeText}" />
                                                                        <TextBlock FontSize="12" Foreground="#6B7280"
                                                                                   Text="{Binding StatusLabel}" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2"
                                                                                Orientation="Horizontal"
                                                                                VerticalAlignment="Center">
                                                                        <Button Margin="4,0" Padding="10,4"
                                                                                Command="{Binding DataContext.BeginOpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding}"
                                                                                Content="Ouvrir"
                                                                                IsEnabled="{Binding CanOpen}"
                                                                                Style="{StaticResource ErpSecondaryButton}" />
                                                                        <Button Margin="4,0" Padding="10,4"
                                                                                Command="{Binding DataContext.CloseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding}"
                                                                                Content="Clôturer"
                                                                                IsEnabled="{Binding CanClose}"
                                                                                Style="{StaticResource ErpSecondaryButton}" />
                                                                        <Button Margin="4,0" Padding="10,4"
                                                                                Command="{Binding DataContext.LockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding}"
                                                                                Content="Verrouiller"
                                                                                IsEnabled="{Binding CanLock}"
                                                                                Style="{StaticResource ErpSecondaryButton}" />
                                                                        <Button Margin="4,0" Padding="10,4"
                                                                                Command="{Binding DataContext.UnlockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding}"
                                                                                Content="Déverrouiller"
                                                                                IsEnabled="{Binding CanUnlock}"
                                                                                Style="{StaticResource ErpSecondaryButton}" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="2"
                   Margin="0,8,0,0"
                   Foreground="#DC2626"
                   Text="{Binding StatusMessage}"
                   TextWrapping="Wrap" />

        <Grid Grid.RowSpan="3"
              Background="#88000000"
              Visibility="{Binding IsOpenDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="420"
                    Padding="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="White"
                    CornerRadius="12">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="Bold" Foreground="#0B1F47"
                               Text="Ouvrir la période" />
                    <TextBlock Margin="0,4,0,12" Foreground="#64748B"
                               Text="{Binding OpeningItem.Name}" />
                    <TextBlock Style="{StaticResource ErpBodySecondary}" Text="Date de début" />
                    <DatePicker Margin="0,4,0,12"
                                SelectedDate="{Binding OpenStartDate, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource ErpBodySecondary}" Text="Date de fin" />
                    <DatePicker Margin="0,4,0,12"
                                SelectedDate="{Binding OpenEndDate, Mode=TwoWay}" />
                    <TextBlock Margin="0,0,0,12"
                               Foreground="#DC2626"
                               Text="{Binding OpenError}"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Margin="0,0,8,0"
                                Command="{Binding CancelOpenCommand}"
                                Content="Annuler"
                                Style="{StaticResource ErpSecondaryButton}" />
                        <Button Command="{Binding ConfirmOpenCommand}"
                                Content="Ouvrir"
                                Style="{StaticResource ErpPrimaryButton}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
