<Window x:Class="SchoolManagement.Desktop.Views.CardTemplateDesignerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:SchoolManagement.Desktop.ViewModels"
        Title="Concepteur de modèles de cartes"
        Width="1280"
        Height="820"
        MinWidth="1000"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="#F3F4F6">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>

        <!-- Toolbox -->
        <Border Grid.Column="0"
                Margin="0,0,10,0"
                Padding="10"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="10">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock FontWeight="SemiBold" Text="Éléments" />
                    <TextBlock Margin="0,4,0,0"
                               FontSize="11"
                               Foreground="#6B7280"
                               Text="Cliquez pour ajouter sur le canevas"
                               TextWrapping="Wrap" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding ToolboxItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DesignerToolboxItem}">
                            <Button Margin="0,0,0,6"
                                    Padding="10,8"
                                    HorizontalContentAlignment="Left"
                                    Command="{Binding DataContext.AddElementCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource ErpSecondaryButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="18"
                                                             Height="18"
                                                             Margin="0,0,8,0"
                                                             Kind="{Binding IconKind}"
                                                             VerticalAlignment="Center" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Label}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Canvas -->
        <Border Grid.Column="1"
                Padding="12"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="10">
            <DockPanel LastChildFill="True">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ToggleButton Margin="0,0,8,0"
                                      Content="{Binding SideLabel}"
                                      IsChecked="{Binding IsFrontSide}"
                                      Style="{StaticResource MaterialDesignFlatToggleButton}"
                                      ToolTip="Basculer Recto / Verso" />
                        <Button Margin="0,0,8,0"
                                Command="{Binding SaveCommand}"
                                Content="Enregistrer"
                                Style="{StaticResource ErpPrimaryButton}" />
                        <Button Content="Fermer"
                                Click="Close_Click"
                                Style="{StaticResource ErpSecondaryButton}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{Binding TemplateName, StringFormat=Modèle : {0}}" />
                        <TextBlock FontSize="12"
                                   Foreground="#6B7280"
                                   Text="{Binding SideLabel, StringFormat=Face : {0} — grille magnétique 1 mm}" />
                    </StackPanel>
                </DockPanel>

                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border x:Name="CardHost"
                                Background="#CBD5E1"
                                BorderBrush="#94A3B8"
                                BorderThickness="1"
                                Padding="16"
                                CornerRadius="4">
                            <Canvas x:Name="DesignCanvas"
                                    Width="{Binding CanvasWidthDip}"
                                    Height="{Binding CanvasHeightDip}"
                                    Background="White"
                                    ClipToBounds="True"
                                    MouseLeftButtonDown="DesignCanvas_MouseLeftButtonDown"
                                    MouseMove="DesignCanvas_MouseMove"
                                    MouseLeftButtonUp="DesignCanvas_MouseLeftButtonUp" />
                        </Border>
                    </Grid>
                </ScrollViewer>

                <TextBlock DockPanel.Dock="Bottom"
                           Margin="0,8,0,0"
                           FontSize="12"
                           Foreground="#6B7280"
                           Text="{Binding StatusMessage}" />
            </DockPanel>
        </Border>

        <!-- Properties -->
        <Border Grid.Column="2"
                Margin="10,0,0,0"
                Padding="12"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Propriétés modèle" />
                    <TextBox Margin="0,8,0,6"
                             materialDesign:HintAssist.Hint="Nom"
                             Style="{StaticResource ErpTextBox}"
                             Text="{Binding TemplateName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Margin="0,0,0,6"
                             materialDesign:HintAssist.Hint="Description"
                             Style="{StaticResource ErpTextBox}"
                             Text="{Binding TemplateDescription, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Margin="0,0,0,6"
                             materialDesign:HintAssist.Hint="Fond (#hex)"
                             Style="{StaticResource ErpTextBox}"
                             Text="{Binding BackgroundColor, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Margin="0,0,0,12"
                              Content="Snap to grid"
                              IsChecked="{Binding SnapToGrid}" />

                    <TextBlock FontWeight="SemiBold" Text="Élément sélectionné" />
                    <TextBlock Margin="0,6,0,8"
                               FontSize="12"
                               Foreground="#6B7280"
                               Text="{Binding SelectedElement.Kind, TargetNullValue=Aucun}" />
                    <TextBlock Margin="0,0,0,8"
                               FontSize="11"
                               Foreground="#9CA3AF"
                               Text="Glisser pour déplacer · Flèches 1 mm · Maj+flèches 5 mm · Suppr" />

                    <TextBlock Margin="0,0,0,4"
                               FontSize="12"
                               Text="{Binding StatusMessage, TargetNullValue=''}" />

                    <ComboBox Margin="0,0,0,6"
                              DisplayMemberPath="Label"
                              ItemsSource="{Binding DataFields}"
                              SelectedItem="{Binding SelectedDataField}"
                              Style="{StaticResource ErpComboBox}"
                              materialDesign:HintAssist.Hint="Champ lié" />
                    <TextBox Margin="0,0,0,6"
                             materialDesign:HintAssist.Hint="Texte / libellé"
                             Style="{StaticResource ErpTextBox}"
                             Text="{Binding SelectedElement.Text, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Margin="0,0,0,6"
                             materialDesign:HintAssist.Hint="Couleur texte"
                             Style="{StaticResource ErpTextBox}"
                             Text="{Binding SelectedElement.Foreground, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Margin="0,0,0,6"
                             materialDesign:HintAssist.Hint="Taille police (pt)"
                             Style="{StaticResource ErpTextBox}"
                             Text="{Binding SelectedElement.FontSizePt, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Margin="0,0,0,8"
                              Content="Gras"
                              IsChecked="{Binding SelectedElement.Bold}" />

                    <WrapPanel>
                        <Button Margin="0,0,6,6"
                                Command="{Binding ApplyPropertyEditsCommand}"
                                Content="Appliquer"
                                Style="{StaticResource ErpPrimaryButton}" />
                        <Button Margin="0,0,6,6"
                                Command="{Binding BringForwardCommand}"
                                Content="Avant"
                                Style="{StaticResource ErpSecondaryButton}" />
                        <Button Margin="0,0,6,6"
                                Command="{Binding SendBackwardCommand}"
                                Content="Arrière"
                                Style="{StaticResource ErpSecondaryButton}" />
                        <Button Margin="0,0,6,6"
                                Command="{Binding DeleteSelectedCommand}"
                                Content="Supprimer"
                                Style="{StaticResource ErpSecondaryButton}" />
                    </WrapPanel>

                    <TextBlock Margin="0,16,0,6" FontWeight="SemiBold" Text="Liste des éléments" />
                    <ListBox MaxHeight="220"
                             DisplayMemberPath="Kind"
                             ItemsSource="{Binding Elements}"
                             SelectedItem="{Binding SelectedElement}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
