<UserControl x:Class="SchoolManagement.Desktop.Views.SecurityRolesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:erp="clr-namespace:SchoolManagement.Desktop.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:ui="clr-namespace:SchoolManagement.Desktop.UI">
    <UserControl.Resources>
        <ui:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </UserControl.Resources>

    <Grid Margin="20" Style="{StaticResource ErpFadeIn}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="220" MinHeight="180" />
            <RowDefinition Height="*" MinHeight="220" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="True">
            <Button DockPanel.Dock="Right"
                    Padding="14,6"
                    VerticalAlignment="Top"
                    Command="{Binding LoadCommand}"
                    Style="{StaticResource ErpSecondaryButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Refresh"
                                             Margin="0,0,6,0"
                                             VerticalAlignment="Center" />
                    <TextBlock VerticalAlignment="Center" Text="Actualiser" />
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock Style="{StaticResource ErpPageTitle}" Text="Rôles" />
                <TextBlock Margin="0,4,0,0"
                           Style="{StaticResource ErpBodySecondary}"
                           Text="Rôles applicatifs, matrice des permissions et dépendances" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="0,0,8,0"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="14">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Padding="14,10"
                            BorderBrush="#E5E7EB"
                            BorderThickness="0,0,0,1">
                        <TextBlock FontWeight="SemiBold"
                                   Foreground="#0F1F4A"
                                   Text="Liste des rôles" />
                    </Border>
                    <DataGrid AutoGenerateColumns="False"
                              BorderThickness="0"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              ItemsSource="{Binding Roles}"
                              SelectedItem="{Binding SelectedRole}"
                              Style="{StaticResource ErpDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Code}"
                                                Header="CODE"
                                                Width="100" />
                            <DataGridTextColumn Binding="{Binding Name}"
                                                Header="NOM"
                                                Width="*" />
                            <DataGridTemplateColumn Header="SYSTÈME" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="#6B7280"
                                                   Text="Système"
                                                   Visibility="{Binding IsSystem, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Binding="{Binding PermissionCount}"
                                                Header="PERMISSIONS"
                                                Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="1"
                    Margin="8,0,0,0"
                    Padding="14,12"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="14">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold"
                               Foreground="#0F1F4A"
                               Text="Modifier le rôle" />
                    <erp:ErpTextField Margin="0,12,0,0"
                                      HorizontalAlignment="Stretch"
                                      IconKind="RenameBox"
                                      IsCompact="True"
                                      Label="Nom"
                                      Text="{Binding EditRoleName, UpdateSourceTrigger=PropertyChanged}" />
                    <erp:ErpTextField Margin="0,8,0,0"
                                      HorizontalAlignment="Stretch"
                                      IconKind="TextBoxOutline"
                                      IsCompact="True"
                                      Label="Description"
                                      Text="{Binding EditRoleDescription, UpdateSourceTrigger=PropertyChanged}" />
                    <WrapPanel Margin="0,12,0,0">
                        <Button Margin="0,0,8,0"
                                Padding="14,6"
                                Command="{Binding SaveRoleCommand}"
                                Style="{StaticResource ErpPrimaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave"
                                                         Margin="0,0,6,0"
                                                         VerticalAlignment="Center" />
                                <TextBlock VerticalAlignment="Center" Text="Enregistrer" />
                            </StackPanel>
                        </Button>
                        <Button Padding="14,6"
                                Command="{Binding DeleteRoleCommand}"
                                IsEnabled="{Binding CanDeleteRole}"
                                Style="{StaticResource ErpDangerButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DeleteOutline"
                                                         Margin="0,0,6,0"
                                                         VerticalAlignment="Center" />
                                <TextBlock VerticalAlignment="Center" Text="Supprimer" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <TextBlock Margin="0,10,0,0"
                               FontSize="12"
                               Foreground="#D97706"
                               Text="Les permissions du rôle ADMIN sont en lecture seule."
                               TextWrapping="Wrap"
                               Visibility="{Binding PermissionsReadOnly, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="14">
            <DockPanel>
                <Border DockPanel.Dock="Top"
                        Padding="14,10"
                        BorderBrush="#E5E7EB"
                        BorderThickness="0,0,0,1">
                    <TextBlock FontWeight="SemiBold"
                               Foreground="#0F1F4A"
                               Text="Matrice des permissions" />
                </Border>
                <DataGrid AutoGenerateColumns="False"
                          BorderThickness="0"
                          CanUserAddRows="False"
                          ItemsSource="{Binding PermissionMatrix}"
                          Style="{StaticResource ErpDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Module}"
                                            Header="MODULE"
                                            IsReadOnly="True"
                                            Width="120" />
                        <DataGridTextColumn Binding="{Binding Code}"
                                            Header="CODE"
                                            IsReadOnly="True"
                                            Width="160" />
                        <DataGridTextColumn Binding="{Binding DisplayName}"
                                            Header="PERMISSION"
                                            IsReadOnly="True"
                                            Width="*" />
                        <DataGridTemplateColumn Header="ACCORDÉE" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center"
                                              IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBooleanConverter}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Row="3"
                Margin="0,12,0,8"
                Padding="14,12"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <erp:ErpTextField Grid.Column="0"
                                  Margin="0,0,8,0"
                                  HorizontalAlignment="Stretch"
                                  IconKind="Identifier"
                                  IsCompact="True"
                                  Label="Code (nouveau)"
                                  Text="{Binding NewRoleCode, UpdateSourceTrigger=PropertyChanged}" />
                <erp:ErpTextField Grid.Column="1"
                                  Margin="0,0,8,0"
                                  HorizontalAlignment="Stretch"
                                  IconKind="ShieldAccount"
                                  IsCompact="True"
                                  Label="Nom (nouveau)"
                                  Text="{Binding NewRoleName, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="2"
                        Margin="0,0,8,0"
                        Padding="14,6"
                        VerticalAlignment="Bottom"
                        Command="{Binding CreateRoleCommand}"
                        Style="{StaticResource ErpSecondaryButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus"
                                                 Margin="0,0,6,0"
                                                 VerticalAlignment="Center" />
                        <TextBlock VerticalAlignment="Center" Text="Créer un rôle" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3"
                        Padding="14,6"
                        VerticalAlignment="Bottom"
                        Command="{Binding SavePermissionsCommand}"
                        Style="{StaticResource ErpPrimaryButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ShieldCheck"
                                                 Margin="0,0,6,0"
                                                 VerticalAlignment="Center" />
                        <TextBlock VerticalAlignment="Center" Text="Enregistrer permissions" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <TextBlock Grid.Row="4"
                   Style="{StaticResource ErpBodySecondary}"
                   Text="{Binding StatusMessage}"
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>
