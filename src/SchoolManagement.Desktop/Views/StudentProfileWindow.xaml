<Window x:Class="SchoolManagement.Desktop.Views.StudentProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dossier élève"
        Width="760"
        Height="620"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FB">
    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock x:Name="TitleText"
                       FontFamily="Segoe UI"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#1F2937" />
            <TextBlock x:Name="SubtitleText"
                       Margin="0,4,0,16"
                       FontFamily="Segoe UI"
                       FontSize="13"
                       Foreground="#6B7280" />

            <Border Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16"
                    Margin="0,0,0,16">
                <StackPanel x:Name="IdentityPanel" />
            </Border>

            <TextBlock Margin="0,0,0,8"
                       FontFamily="Segoe UI"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#1F2937"
                       Text="Historique scolarité" />

            <DataGrid x:Name="EnrollmentsGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      Style="{StaticResource ErpStudentsDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding AcademicYearLabel}" Header="Année" Width="120" />
                    <DataGridTextColumn Binding="{Binding ClassDisplayName}" Header="Classe" Width="*" />
                    <DataGridTextColumn Binding="{Binding SectionName}" Header="Section" Width="120" />
                    <DataGridTextColumn Binding="{Binding StudyOption}" Header="Option" Width="120" />
                    <DataGridTextColumn Binding="{Binding EnrollmentDate}" Header="Inscription" Width="110" />
                    <DataGridTextColumn Binding="{Binding Status}" Header="Statut" Width="110" />
                </DataGrid.Columns>
            </DataGrid>

            <Button Margin="0,20,0,0"
                    HorizontalAlignment="Right"
                    Width="120"
                    Content="Fermer"
                    Click="CloseButton_OnClick"
                    Style="{StaticResource ErpPrimaryButton}" />
        </StackPanel>
    </ScrollViewer>
</Window>
