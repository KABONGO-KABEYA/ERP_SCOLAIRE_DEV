<UserControl x:Class="SchoolManagement.Desktop.Views.DashboardExpensesDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:erp="clr-namespace:SchoolManagement.Desktop.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <ScrollViewer Style="{StaticResource ErpPageHost}" Background="{StaticResource ErpPageBackgroundBrush}">
        <StackPanel Margin="20" Style="{StaticResource ErpFadeIn}">
            <Button Margin="0,0,0,12"
                    HorizontalAlignment="Left"
                    Command="{Binding GoBackCommand}"
                    Style="{StaticResource ErpSecondaryButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="Retour" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="#0F1F4A" Text="Dépenses — détail" />
            <TextBlock Margin="0,4,0,16" Style="{StaticResource ErpBodySecondary}"
                       Text="Type de compte → période → jour → libellé et montant." />

            <Border Padding="16" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12">
                <StackPanel>
                    <ComboBox Width="280" HorizontalAlignment="Left"
                              DisplayMemberPath="Label"
                              ItemsSource="{Binding ScopeOptions}"
                              SelectedItem="{Binding SelectedScope, Mode=TwoWay}" />
                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal"
                                Visibility="{Binding IsCustomScope, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <erp:ErpDateField Margin="0,0,12,0" Label="Du" SelectedDate="{Binding CustomFromDate, Mode=TwoWay}" IsCompact="True" ShowBadges="False" />
                        <erp:ErpDateField Label="Au" SelectedDate="{Binding CustomToDate, Mode=TwoWay}" IsCompact="True" ShowBadges="False" />
                        <Button Margin="12,18,0,0" Padding="14,6" Command="{Binding LoadCommand}" Content="Actualiser"
                                Style="{StaticResource ErpPrimaryButton}" />
                    </StackPanel>
                    <TextBlock Margin="0,16,0,0" FontSize="18" FontWeight="SemiBold" Text="{Binding TotalLabel}" />
                    <TextBlock Foreground="#DC2626" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding AccountGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander Margin="0,0,0,10" IsExpanded="False">
                            <Expander.Header>
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Right" FontWeight="Bold" Foreground="#DC2626" Text="{Binding TotalLabel}" />
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding AccountTypeName}" />
                                </DockPanel>
                            </Expander.Header>
                            <ItemsControl ItemsSource="{Binding Periods}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander Margin="8,4,0,4">
                                            <Expander.Header>
                                                <DockPanel LastChildFill="True">
                                                    <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold" Text="{Binding TotalLabel}" />
                                                    <TextBlock Text="{Binding Title}" />
                                                </DockPanel>
                                            </Expander.Header>
                                            <StackPanel>
                                                <ItemsControl ItemsSource="{Binding Lines}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="8,2,0,2" Padding="8" Background="#F9FAFB" CornerRadius="6">
                                                                <DockPanel LastChildFill="True">
                                                                    <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold" Text="{Binding AmountLabel}" />
                                                                    <StackPanel>
                                                                        <TextBlock FontWeight="SemiBold" Text="{Binding Label}" />
                                                                        <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding DateLabel}" />
                                                                    </StackPanel>
                                                                </DockPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <ItemsControl ItemsSource="{Binding Children}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Expander Margin="8,4,0,4">
                                                                <Expander.Header>
                                                                    <DockPanel LastChildFill="True">
                                                                        <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold" Text="{Binding TotalLabel}" />
                                                                        <TextBlock Text="{Binding Title}" />
                                                                    </DockPanel>
                                                                </Expander.Header>
                                                                <ItemsControl ItemsSource="{Binding Lines}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Margin="8,2,0,2" Padding="8" Background="#F9FAFB" CornerRadius="6">
                                                                                <DockPanel LastChildFill="True">
                                                                                    <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold" Text="{Binding AmountLabel}" />
                                                                                    <StackPanel>
                                                                                        <TextBlock FontWeight="SemiBold" Text="{Binding Label}" />
                                                                                        <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding DateLabel}" />
                                                                                    </StackPanel>
                                                                                </DockPanel>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Expander>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
