<UserControl x:Class="SchoolManagement.Desktop.Views.PersonnelPlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="20" Style="{StaticResource ErpFadeIn}">
        <Border Padding="48"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="560"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="16">
            <StackPanel HorizontalAlignment="Center">
                <materialDesign:PackIcon Width="56"
                                         Height="56"
                                         HorizontalAlignment="Center"
                                         Foreground="#1D4ED8"
                                         Kind="ClockOutline" />
                <TextBlock Margin="0,20,0,8"
                           HorizontalAlignment="Center"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#0F1F4A"
                           Text="{Binding Title}"
                           TextAlignment="Center" />
                <TextBlock HorizontalAlignment="Center"
                           Style="{StaticResource ErpBodySecondary}"
                           Text="{Binding Message}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
