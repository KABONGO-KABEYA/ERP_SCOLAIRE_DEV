<Window x:Class="SchoolManagement.Desktop.Views.ChangePricingCategoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Modifier la catégorie tarifaire"
        Height="360"
        Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource ErpPageBackgroundBrush}"
        FontFamily="{StaticResource ErpFontFamily}">
    <Border Margin="24" Style="{StaticResource ErpCard}">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Bottom" Margin="0,20,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Padding="16,8"
                        Click="CancelButton_OnClick"
                        Content="Annuler"
                        Style="{StaticResource ErpSecondaryButton}" />
                <Button Margin="10,0,0,0"
                        Padding="16,8"
                        Click="SaveButton_OnClick"
                        Content="Enregistrer"
                        Style="{StaticResource ErpPrimaryButton}" />
            </StackPanel>

            <StackPanel>
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Modifier la catégorie tarifaire" />
                <TextBlock x:Name="StudentInfoText"
                           Margin="0,6,0,16"
                           Style="{StaticResource ErpBodySecondary}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="Nouvelle catégorie" />
                <ComboBox x:Name="CategoryCombo"
                          DisplayMemberPath="Name"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                <TextBlock Margin="0,12,0,8" FontWeight="SemiBold" Text="Note (facultatif)" />
                <TextBox x:Name="NotesBox"
                         Height="64"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         materialDesign:HintAssist.Hint="Motif du changement"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                <TextBlock x:Name="ErrorText"
                           Margin="0,10,0,0"
                           Foreground="{StaticResource ErpDangerBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
