<UserControl x:Class="SchoolManagement.Desktop.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:views="clr-namespace:SchoolManagement.Desktop.Views"
             Background="{StaticResource ErpPageBackgroundBrush}">
    <UserControl.Resources>
        <views:ViewLocator x:Key="ViewLocator" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar — navigation inchangée (code-behind) -->
        <Border Grid.Column="0" Background="{StaticResource ErpSidebarBrush}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="22,28,22,18">
                    <Border Width="52" Height="52" CornerRadius="14" Background="#FFFFFF14">
                        <Image Source="/Assets/icone.png"
                               Width="40" Height="40"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock Margin="0,16,0,2"
                               Style="{StaticResource ErpSidebarTitle}"
                               Text="ERP Scolaire RDC" />
                    <TextBlock Style="{StaticResource ErpSidebarSubtitle}"
                               Foreground="#CBD5E1"
                               Text="{Binding SchoolName}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource ErpSidebarSubtitle}"
                               Text="Excellence • Discipline • Réussite"
                               TextWrapping="Wrap" />
                </StackPanel>

                <ScrollViewer DockPanel.Dock="Top"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="NavigationPanel" Margin="0,0,0,8" />
                </ScrollViewer>

                <Border DockPanel.Dock="Bottom"
                        Margin="14,8,14,22"
                        Padding="14"
                        Background="#0B1F42"
                        CornerRadius="16"
                        BorderBrush="#1E3A5F"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="42"
                                Background="{StaticResource ErpPrimaryBrush}"
                                CornerRadius="21">
                            <materialDesign:PackIcon Kind="Account"
                                                     Width="22" Height="22"
                                                     Foreground="White"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource ErpFontFamily}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="White"
                                       Text="{Binding DataContext.UserDisplayName, RelativeSource={RelativeSource AncestorType=Window}}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock FontFamily="{StaticResource ErpFontFamily}"
                                       FontSize="11" Foreground="#94A3B8"
                                       Text="{Binding Source={x:Static Application.Current}, Converter={StaticResource CurrentUserRoleConverter}}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Ellipse Width="8" Height="8"
                                         Fill="{StaticResource ErpSuccessBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock Margin="6,0,0,0"
                                           FontSize="11" Foreground="#86EFAC"
                                           Text="En ligne" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </DockPanel>
        </Border>

        <!-- Zone principale -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource ErpTopBarBrush}"
                    BorderBrush="{StaticResource ErpBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Effect="{StaticResource ErpTopBarShadow}"
                    Padding="20,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitleText"
                                   FontFamily="{StaticResource ErpFontFamily}"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource ErpTextPrimaryBrush}"
                                   Text="Tableau de bord" />
                        <TextBlock x:Name="PageSubtitleText"
                                   Margin="0,1,0,0"
                                   FontFamily="{StaticResource ErpFontFamily}"
                                   FontSize="12"
                                   Foreground="{StaticResource ErpTextSecondaryBrush}"
                                   Text="Gestion scolaire — République Démocratique du Congo" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Background="{StaticResource ErpPrimaryLightBrush}"
                                CornerRadius="12"
                                Padding="10,6"
                                Margin="0,0,10,0"
                                MinWidth="200">
                            <DockPanel LastChildFill="True">
                                <materialDesign:PackIcon Kind="CalendarRange"
                                                         Width="18" Height="18"
                                                         Margin="2,0,8,0"
                                                         Foreground="{StaticResource ErpPrimaryBrush}"
                                                         VerticalAlignment="Center"
                                                         DockPanel.Dock="Left" />
                                <ComboBox ItemsSource="{Binding WorkingAcademicYears}"
                                          SelectedItem="{Binding SelectedWorkingAcademicYear, Mode=TwoWay}"
                                          DisplayMemberPath="Label"
                                          BorderThickness="0"
                                          Background="Transparent"
                                          FontFamily="{StaticResource ErpFontFamily}"
                                          FontSize="13"
                                          FontWeight="Medium"
                                          Foreground="{StaticResource ErpPrimaryBrush}"
                                          VerticalContentAlignment="Center"
                                          ToolTip="Changer l'année scolaire de travail (globale)" />
                            </DockPanel>
                        </Border>

                        <Button Width="42" Height="42"
                                Foreground="{StaticResource ErpTextSecondaryBrush}"
                                ToolTip="Notifications"
                                Style="{StaticResource MaterialDesignIconButton}">
                            <materialDesign:PackIcon Kind="BellOutline" Width="22" Height="22" />
                        </Button>

                        <Button Margin="4,0,0,0"
                                Width="42" Height="42"
                                Foreground="{StaticResource ErpTextSecondaryBrush}"
                                ToolTip="Messages"
                                Style="{StaticResource MaterialDesignIconButton}">
                            <materialDesign:PackIcon Kind="EmailOutline" Width="22" Height="22" />
                        </Button>

                        <Button Margin="4,0,0,0"
                                Width="42" Height="42"
                                Foreground="{StaticResource ErpTextSecondaryBrush}"
                                Command="{Binding DataContext.ToggleThemeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                ToolTip="Basculer thème clair/sombre"
                                Style="{StaticResource MaterialDesignIconButton}">
                            <materialDesign:PackIcon Kind="ThemeLightDark" Width="22" Height="22" />
                        </Button>

                        <Border Margin="14,0,14,0"
                                Padding="12,8"
                                Background="#F1F5F9"
                                CornerRadius="12">
                            <StackPanel>
                                <TextBlock FontFamily="{StaticResource ErpFontFamily}"
                                           FontSize="12" FontWeight="Medium"
                                           Foreground="{StaticResource ErpTextPrimaryBrush}"
                                           Text="{Binding CurrentDateLabel}" />
                                <TextBlock FontFamily="{StaticResource ErpFontFamily}"
                                           FontSize="12"
                                           Foreground="{StaticResource ErpTextSecondaryBrush}"
                                           Text="{Binding CurrentTimeLabel}" />
                            </StackPanel>
                        </Border>

                        <materialDesign:PopupBox PlacementMode="BottomAndAlignRightEdges"
                                                 StaysOpen="False"
                                                 PopupMode="Click"
                                                 ToolTip="Compte utilisateur"
                                                 VerticalAlignment="Center">
                            <materialDesign:PopupBox.ToggleContent>
                                <Border Padding="6,4"
                                        Background="#F8FAFC"
                                        CornerRadius="14"
                                        BorderBrush="{StaticResource ErpBorderBrush}"
                                        BorderThickness="1"
                                        Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="36" Height="36"
                                                Background="{StaticResource ErpPrimaryBrush}"
                                                CornerRadius="18">
                                            <materialDesign:PackIcon Kind="Account"
                                                                     Width="20" Height="20"
                                                                     Foreground="White"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Margin="10,0,4,0" VerticalAlignment="Center">
                                            <TextBlock FontFamily="{StaticResource ErpFontFamily}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource ErpTextPrimaryBrush}"
                                                       Text="{Binding DataContext.UserDisplayName, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <TextBlock FontFamily="{StaticResource ErpFontFamily}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource ErpTextSecondaryBrush}"
                                                       Text="{Binding Source={x:Static Application.Current}, Converter={StaticResource CurrentUserRoleConverter}}" />
                                        </StackPanel>
                                        <materialDesign:PackIcon Kind="ChevronDown"
                                                                 Width="16" Height="16"
                                                                 Margin="2,0,2,0"
                                                                 Foreground="{StaticResource ErpTextSecondaryBrush}"
                                                                 VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </materialDesign:PopupBox.ToggleContent>

                            <Border MinWidth="220"
                                    Background="{StaticResource ErpCardBackgroundBrush}"
                                    BorderBrush="{StaticResource ErpBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="6"
                                    Effect="{StaticResource ErpCardShadow}">
                                <StackPanel>
                                    <Button HorizontalContentAlignment="Left"
                                            Height="40"
                                            Padding="12,0"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            ToolTip="Profil utilisateur">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="AccountCircleOutline"
                                                                     Width="18" Height="18"
                                                                     Margin="0,0,10,0"
                                                                     Foreground="{StaticResource ErpTextSecondaryBrush}"
                                                                     VerticalAlignment="Center" />
                                            <TextBlock Text="Profil"
                                                       FontFamily="{StaticResource ErpFontFamily}"
                                                       FontSize="13"
                                                       Foreground="{StaticResource ErpTextPrimaryBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Separator Margin="8,4" Background="{StaticResource ErpBorderBrush}" />

                                    <Button HorizontalContentAlignment="Left"
                                            Height="40"
                                            Padding="12,0"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Foreground="#DC2626"
                                            ToolTip="Se déconnecter"
                                            Command="{Binding DataContext.LogoutCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Logout"
                                                                     Width="18" Height="18"
                                                                     Margin="0,0,10,0"
                                                                     Foreground="#DC2626"
                                                                     VerticalAlignment="Center" />
                                            <TextBlock Text="Se déconnecter"
                                                       FontFamily="{StaticResource ErpFontFamily}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#DC2626"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </materialDesign:PopupBox>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentViewModel, Converter={StaticResource ViewLocator}}" />
        </Grid>
    </Grid>
</UserControl>
