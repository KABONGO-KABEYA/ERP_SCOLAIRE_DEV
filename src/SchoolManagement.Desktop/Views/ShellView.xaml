<UserControl x:Class="SchoolManagement.Desktop.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:views="clr-namespace:SchoolManagement.Desktop.Views"
             Background="#F5F7FB">
    <UserControl.Resources>
        <views:ViewLocator x:Key="ViewLocator" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition>
                <ColumnDefinition.Width>
                    <GridLength>270</GridLength>
                </ColumnDefinition.Width>
            </ColumnDefinition>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="#0F1F3D">
            <DockPanel LastChildFill="True">
                <!-- School branding -->
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,20">
                    <Image Source="/Assets/icone.png"
                           Width="52"
                           Height="52"
                           HorizontalAlignment="Left"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Margin="0,14,0,2"
                               FontFamily="Segoe UI"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Text="ERP Scolaire RDC"
                               TextWrapping="Wrap" />
                    <TextBlock FontFamily="Segoe UI"
                               FontSize="12"
                               Foreground="#94A3B8"
                               Text="Excellence • Discipline • Réussite"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Navigation -->
                <ScrollViewer DockPanel.Dock="Top"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="NavigationPanel" />
                </ScrollViewer>

                <!-- User profile -->
                <Border DockPanel.Dock="Bottom"
                        Margin="12,12,12,20"
                        Padding="14"
                        Background="#162847"
                        CornerRadius="14"
                        BorderBrush="#243B5C"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40"
                                Height="40"
                                Background="#1E5EFF"
                                CornerRadius="20">
                            <materialDesign:PackIcon Kind="Account"
                                                     Width="22"
                                                     Height="22"
                                                     Foreground="White"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe UI"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       Text="{Binding DataContext.UserDisplayName, RelativeSource={RelativeSource AncestorType=Window}}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock FontFamily="Segoe UI"
                                       FontSize="11"
                                       Foreground="#94A3B8"
                                       Text="{Binding Source={x:Static Application.Current}, Converter={StaticResource CurrentUserRoleConverter}}" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Command="{Binding DataContext.LogoutCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Width="40"
                                Height="40"
                                ToolTip="Déconnexion"
                                Foreground="#94A3B8"
                                Style="{StaticResource MaterialDesignIconButton}">
                            <materialDesign:PackIcon Kind="Logout" Width="18" Height="18" />
                        </Button>
                    </Grid>
                </Border>
            </DockPanel>
        </Border>

        <!-- Main area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition>
                    <RowDefinition.Height>
                        <GridLength>72</GridLength>
                    </RowDefinition.Height>
                </RowDefinition>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Grid.Row="0"
                    Background="#FFFFFF"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1"
                    Effect="{StaticResource ErpTopBarShadow}"
                    Padding="20,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitleText"
                                   FontFamily="Segoe UI"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#1F2937"
                                   Text="Tableau de bord" />
                        <TextBlock x:Name="PageSubtitleText"
                                   Margin="0,2,0,0"
                                   FontFamily="Segoe UI"
                                   FontSize="13"
                                   Foreground="#6B7280"
                                   Text="Gestion scolaire — République Démocratique du Congo" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Background="#E8EFFF"
                                CornerRadius="10"
                                Padding="8,4"
                                Margin="0,0,12,0"
                                MinWidth="200">
                            <DockPanel LastChildFill="True">
                                <materialDesign:PackIcon Kind="CalendarRange"
                                                         Width="18"
                                                         Height="18"
                                                         Margin="4,0,4,0"
                                                         Foreground="#1E5EFF"
                                                         VerticalAlignment="Center"
                                                         DockPanel.Dock="Left" />
                                <ComboBox ItemsSource="{Binding WorkingAcademicYears}"
                                          SelectedItem="{Binding SelectedWorkingAcademicYear, Mode=TwoWay}"
                                          DisplayMemberPath="Label"
                                          BorderThickness="0"
                                          Background="Transparent"
                                          FontFamily="Segoe UI"
                                          FontSize="13"
                                          FontWeight="Medium"
                                          Foreground="#1E5EFF"
                                          VerticalContentAlignment="Center"
                                          ToolTip="Changer l'année scolaire de travail (globale)" />
                            </DockPanel>
                        </Border>

                        <Button Width="40"
                                Height="40"
                                Foreground="#6B7280"
                                ToolTip="Notifications"
                                Style="{StaticResource MaterialDesignIconButton}">
                            <materialDesign:PackIcon Kind="BellOutline" Width="22" Height="22" />
                        </Button>

                        <Button Margin="4,0,0,0"
                                Width="40"
                                Height="40"
                                Foreground="#6B7280"
                                Command="{Binding DataContext.ToggleThemeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                ToolTip="Basculer thème clair/sombre"
                                Style="{StaticResource MaterialDesignIconButton}">
                            <materialDesign:PackIcon Kind="ThemeLightDark" Width="22" Height="22" />
                        </Button>

                        <Border Margin="12,0,0,0"
                                Padding="8,4"
                                Background="#F3F4F6"
                                CornerRadius="12">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="36"
                                        Height="36"
                                        Background="#1E5EFF"
                                        CornerRadius="18">
                                    <materialDesign:PackIcon Kind="Account"
                                                             Width="20"
                                                             Height="20"
                                                             Foreground="White"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="10,0,4,0" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe UI"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#1F2937"
                                               Text="{Binding DataContext.UserDisplayName, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <TextBlock FontFamily="Segoe UI"
                                               FontSize="11"
                                               Foreground="#6B7280"
                                               Text="{Binding Source={x:Static Application.Current}, Converter={StaticResource CurrentUserRoleConverter}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content -->
            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentViewModel, Converter={StaticResource ViewLocator}}" />
        </Grid>
    </Grid>
</UserControl>
