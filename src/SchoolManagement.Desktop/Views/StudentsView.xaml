<UserControl x:Class="SchoolManagement.Desktop.Views.StudentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:erp="clr-namespace:SchoolManagement.Desktop.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:ui="clr-namespace:SchoolManagement.Desktop.UI"
             xmlns:enums="clr-namespace:SchoolManagement.Domain.Enums;assembly=SchoolManagement.Domain">
    <UserControl.Resources>
        <ui:GenderDisplayConverter x:Key="GenderDisplayConverter" />
        <ui:StudentStatusLabelConverter x:Key="StudentStatusLabelConverter" />
        <ui:NullToDashConverter x:Key="NullToDashConverter" />
        <ui:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="20" Style="{StaticResource ErpFadeIn}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="280" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,8"
                Padding="12,10"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="10">
            <StackPanel>
                <DockPanel LastChildFill="True">
                    <Button Width="32"
                            Height="32"
                            Padding="0"
                            HorizontalAlignment="Right"
                            Command="{Binding ToggleFiltersCommand}"
                            DockPanel.Dock="Right"
                            ToolTip="{Binding FiltersToggleLabel}"
                            ToolTipService.InitialShowDelay="200"
                            Style="{StaticResource MaterialDesignIconButton}">
                        <Grid Width="18" Height="18">
                            <materialDesign:PackIcon Kind="ChevronDown"
                                                     Width="18"
                                                     Height="18"
                                                     Visibility="{Binding IsFiltersExpanded, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                            <materialDesign:PackIcon Kind="ChevronUp"
                                                     Width="18"
                                                     Height="18"
                                                     Visibility="{Binding IsFiltersExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </Button>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"
                               Text="{Binding FiltersHeaderText}" />
                </DockPanel>

                <StackPanel Margin="0,10,0,0"
                            Visibility="{Binding IsFiltersExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <UniformGrid Columns="3" Margin="0,0,0,10">
                        <erp:ErpComboField Margin="0,0,12,12"
                                           DisplayMemberPath="Name"
                                           FieldWidth="240"
                                           HorizontalAlignment="Stretch"
                                           IconKind="School"
                                           ItemsSource="{Binding Sections}"
                                           Label="Section"
                                           SelectedItem="{Binding SelectedSection, Mode=TwoWay}" />
                        <erp:ErpComboField Margin="0,0,12,12"
                                           DisplayMemberPath="DisplayName"
                                           FieldWidth="240"
                                           HorizontalAlignment="Stretch"
                                           IconKind="GoogleClassroom"
                                           ItemsSource="{Binding PedagogicalClasses}"
                                           Label="Classe"
                                           SelectedItem="{Binding SelectedPedagogicalClass, Mode=TwoWay}" />
                        <erp:ErpComboField Margin="0,0,0,12"
                                           FieldWidth="240"
                                           HorizontalAlignment="Stretch"
                                           IconKind="BookOpenVariant"
                                           ItemsSource="{Binding StudyOptions}"
                                           Label="Option"
                                           SelectedItem="{Binding SelectedStudyOption, Mode=TwoWay}" />
                        <erp:ErpComboField Margin="0,0,12,0"
                                           DisplayMemberPath="DisplayName"
                                           FieldWidth="240"
                                           HorizontalAlignment="Stretch"
                                           IconKind="Door"
                                           ItemsSource="{Binding ClassRooms}"
                                           Label="Locale"
                                           SelectedItem="{Binding SelectedClassRoom, Mode=TwoWay}" />
                    </UniformGrid>

                    <TextBlock Margin="0,0,0,6"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#374151"
                               Text="Afficher les élèves" />
                    <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                        <CheckBox Margin="0,0,20,0"
                                  Content="Inscrits"
                                  IsChecked="{Binding IncludeInscrits, Mode=TwoWay}" />
                        <CheckBox Margin="0,0,20,0"
                                  Content="Exclus"
                                  IsChecked="{Binding IncludeExcluded, Mode=TwoWay}" />
                        <CheckBox Content="Abandonnés"
                                  IsChecked="{Binding IncludeAbandoned, Mode=TwoWay}" />
                    </StackPanel>

                <StackPanel Orientation="Horizontal">
                        <Button Padding="14,6"
                                Command="{Binding ApplyFiltersCommand}"
                                Content="Afficher"
                            Style="{StaticResource ErpPrimaryButton}" />
                        <Button Margin="8,0,0,0"
                                Padding="14,6"
                                Command="{Binding ClearFiltersCommand}"
                                Content="Réinitialiser"
                                Style="{StaticResource ErpSecondaryButton}" />
                    </StackPanel>

                    <TextBlock Margin="0,8,0,0"
                               FontSize="12"
                               Style="{StaticResource ErpBodySecondary}"
                               Text="{Binding StatusMessage}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="0,0,0,8"
                Padding="10,8"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Padding="14,6"
                            Command="{Binding PrintListCommand}"
                            Content="Imprimer la liste"
                            Style="{StaticResource ErpSecondaryButton}" />
                    <Button Margin="8,0,0,0"
                            Padding="14,6"
                            Command="{Binding OpenEnrollmentWizardCommand}"
                            Content="Nouvelle inscription"
                            Style="{StaticResource ErpSuccessButton}" />
                    <Button Margin="8,0,0,0"
                            Padding="14,6"
                            Command="{Binding OpenReinscriptionWizardCommand}"
                            Content="Réinscription"
                            Style="{StaticResource ErpPrimaryButton}" />
                </StackPanel>
                <erp:ErpSearchField DockPanel.Dock="Left"
                                    Width="320"
                                    HorizontalAlignment="Left"
                                    Placeholder="Matricule, nom ou prénom…"
                                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
            </Border>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="12">
            <DataGrid x:Name="StudentsGrid"
                      Style="{StaticResource ErpStudentsDataGrid}"
                          BorderThickness="0"
                          ItemsSource="{Binding Students}"
                      LoadingRow="StudentsGrid_OnLoadingRow"
                          SelectedItem="{Binding SelectedStudent}">
                    <DataGrid.Columns>
                    <DataGridTemplateColumn Header="#" Width="56">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Center"
                                           FontSize="13"
                                           Foreground="#6B7280"
                                           Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Tag}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="MATRICULE" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ErpTableCodeBadge}">
                                    <TextBlock Style="{StaticResource ErpTableCodeBadgeText}"
                                               Text="{Binding RegistrationNumber}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Binding="{Binding LastName}"
                                        Header="NOM"
                                        Width="*"
                                        MinWidth="110"
                                        ElementStyle="{StaticResource ErpStudentsGridCellText}" />
                    <DataGridTextColumn Binding="{Binding MiddleName}"
                                        Header="POSTNOM"
                                        Width="*"
                                        MinWidth="110"
                                        ElementStyle="{StaticResource ErpStudentsGridCellText}" />
                    <DataGridTextColumn Binding="{Binding FirstName}"
                                        Header="PRÉNOM"
                                        Width="*"
                                        MinWidth="110"
                                        ElementStyle="{StaticResource ErpStudentsGridCellText}" />
                    <DataGridTemplateColumn Header="CLASSE" Width="190">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource ErpStudentsGridCellText}"
                                           Text="{Binding CurrentYearClassName, Converter={StaticResource NullToDashConverter}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="SEXE" Width="64">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource ErpStudentsGridCellText}"
                                           Text="{Binding Gender, Converter={StaticResource GenderDisplayConverter}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="ÉTAT" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="StatusBadge" Style="{StaticResource ErpTableStatusBadgeActive}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon x:Name="StatusIcon"
                                                                 Width="14"
                                                                 Height="14"
                                                                 Margin="0,0,6,0"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="#16A34A"
                                                                 Kind="CheckCircle" />
                                        <TextBlock x:Name="StatusText"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe UI"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#166534"
                                                   Text="{Binding Converter={StaticResource StudentStatusLabelConverter}}" />
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsArchived}" Value="True">
                                        <Setter TargetName="StatusBadge" Property="Style" Value="{StaticResource ErpTableStatusBadgeArchived}" />
                                        <Setter TargetName="StatusIcon" Property="Kind" Value="Archive" />
                                        <Setter TargetName="StatusIcon" Property="Foreground" Value="#DC2626" />
                                        <Setter TargetName="StatusText" Property="Foreground" Value="#B91C1C" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentYearStatus}" Value="{x:Static enums:EnrollmentStatus.Exclusion}">
                                        <Setter TargetName="StatusBadge" Property="Style" Value="{StaticResource ErpTableStatusBadgeArchived}" />
                                        <Setter TargetName="StatusIcon" Property="Kind" Value="CloseCircleOutline" />
                                        <Setter TargetName="StatusIcon" Property="Foreground" Value="#DC2626" />
                                        <Setter TargetName="StatusText" Property="Foreground" Value="#B91C1C" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentYearStatus}" Value="{x:Static enums:EnrollmentStatus.Abandon}">
                                        <Setter TargetName="StatusBadge" Property="Style" Value="{StaticResource ErpTableStatusBadgeInactive}" />
                                        <Setter TargetName="StatusIcon" Property="Kind" Value="ExitRun" />
                                        <Setter TargetName="StatusIcon" Property="Foreground" Value="#D97706" />
                                        <Setter TargetName="StatusText" Property="Foreground" Value="#B45309" />
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsArchived}" Value="False" />
                                            <Condition Binding="{Binding IsEnrolledCurrentYear}" Value="False" />
                                            <Condition Binding="{Binding CurrentYearStatus}" Value="{x:Null}" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="StatusBadge" Property="Style" Value="{StaticResource ErpTableStatusBadgeInactive}" />
                                        <Setter TargetName="StatusIcon" Property="Kind" Value="MinusCircleOutline" />
                                        <Setter TargetName="StatusIcon" Property="Foreground" Value="#6B7280" />
                                        <Setter TargetName="StatusText" Property="Foreground" Value="#4B5563" />
                                    </MultiDataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="ACTION" Width="96">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Click="StudentActionsButton_OnClick"
                                        Content="..."
                                        Style="{StaticResource ErpStudentsGridActionButton}"
                                        Tag="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
    </Grid>
</UserControl>
