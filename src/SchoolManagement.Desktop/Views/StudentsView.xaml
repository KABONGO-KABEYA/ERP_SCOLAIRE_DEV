<UserControl x:Class="SchoolManagement.Desktop.Views.StudentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:erp="clr-namespace:SchoolManagement.Desktop.Controls">
    <ScrollViewer Style="{StaticResource ErpPageHost}">
        <StackPanel Style="{StaticResource ErpFadeIn}">
            <TextBlock Style="{StaticResource ErpPageTitle}" Text="Gestion des élèves" />
            <TextBlock Margin="0,4,0,0" Style="{StaticResource ErpBodySecondary}" Text="Recherche, inscription et suivi des élèves de l'établissement" />

            <Border Margin="{StaticResource ErpSectionSpacing}" Style="{StaticResource ErpCard}">
                <StackPanel Orientation="Horizontal">
                    <erp:ErpSearchField Width="420"
                                        Margin="0,0,12,0"
                                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Margin="12,0,0,0"
                            Command="{Binding SearchCommand}"
                            Content="Rechercher"
                            Style="{StaticResource ErpPrimaryButton}" />
                    <Button Margin="8,0,0,0"
                            Command="{Binding OpenEnrollmentWizardCommand}"
                            Content="Nouvelle inscription"
                            Style="{StaticResource ErpSuccessButton}" />
                    <Button Margin="8,0,0,0"
                            Command="{Binding OpenReinscriptionWizardCommand}"
                            Content="Réinscription"
                            Style="{StaticResource ErpPrimaryButton}" />
                    <Button Margin="8,0,0,0"
                            Command="{Binding ArchiveSelectedCommand}"
                            Content="Archiver"
                            Style="{StaticResource ErpSecondaryButton}" />
                    <TextBlock Margin="20,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource ErpBodySecondary}"
                               Text="{Binding StatusMessage}" />
                </StackPanel>
            </Border>

            <Border Margin="{StaticResource ErpSectionSpacing}" Style="{StaticResource ErpCard}" Padding="0">
                <DataGrid Style="{StaticResource ErpDataGrid}"
                          BorderThickness="0"
                          ItemsSource="{Binding Students}"
                          SelectedItem="{Binding SelectedStudent}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding RegistrationNumber}" Header="Matricule" Width="120" />
                        <DataGridTextColumn Binding="{Binding LastName}" Header="Nom" Width="*" />
                        <DataGridTextColumn Binding="{Binding FirstName}" Header="Prénom" Width="*" />
                        <DataGridTextColumn Binding="{Binding Gender}" Header="Sexe" Width="80" />
                        <DataGridTextColumn Binding="{Binding DateOfBirth}" Header="Naissance" Width="110" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
