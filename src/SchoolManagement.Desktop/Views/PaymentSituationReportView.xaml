<UserControl x:Class="SchoolManagement.Desktop.Views.PaymentSituationReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:erp="clr-namespace:SchoolManagement.Desktop.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:ui="clr-namespace:SchoolManagement.Desktop.UI">
    <UserControl.Resources>
        <ui:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <DrawingBrush x:Key="PaymentSituationHatchBrush"
                      Stretch="None"
                      TileMode="Tile"
                      Viewport="0,0,8,8"
                      ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#D1D5DB">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,8,8" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#6B7280" Thickness="1" />
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <LineGeometry StartPoint="0,8" EndPoint="8,0" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>

    <Grid Margin="0" Style="{StaticResource ErpFadeIn}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="280" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,8"
                Padding="12,10"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="10">
            <StackPanel>
                <DockPanel LastChildFill="True">
                    <Button Width="32"
                            Height="32"
                            Padding="0"
                            HorizontalAlignment="Right"
                            Command="{Binding ToggleFiltersCommand}"
                            DockPanel.Dock="Right"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="{Binding FiltersToggleLabel}">
                        <materialDesign:PackIcon Width="18"
                                                 Height="18"
                                                 Kind="FilterVariant" />
                    </Button>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"
                               Text="Situation des paiements — critères" />
                </DockPanel>

                <StackPanel Margin="0,10,0,0"
                            Visibility="{Binding IsFiltersExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <WrapPanel>
                        <erp:ErpComboField Margin="0,0,10,10"
                                           DisplayMemberPath="Label"
                                           FieldWidth="170"
                                           IconKind="CalendarMonth"
                                           ItemsSource="{Binding AcademicYears}"
                                           Label="Année scolaire *"
                                           SelectedItem="{Binding SelectedAcademicYear, Mode=TwoWay}" />
                        <erp:ErpComboField Margin="0,0,10,10"
                                           DisplayMemberPath="Name"
                                           FieldWidth="180"
                                           IconKind="Cash"
                                           ItemsSource="{Binding FeeTypes}"
                                           Label="Type de frais *"
                                           SelectedItem="{Binding SelectedFeeType, Mode=TwoWay}" />
                        <erp:ErpComboField Margin="0,0,10,10"
                                           DisplayMemberPath="Label"
                                           FieldWidth="200"
                                           IconKind="LayersTriple"
                                           ItemsSource="{Binding ScopeKinds}"
                                           Label="Portée"
                                           SelectedItem="{Binding SelectedScopeKind, Mode=TwoWay}" />
                        <erp:ErpComboField Margin="0,0,10,10"
                                           DisplayMemberPath="Label"
                                           FieldWidth="180"
                                           IconKind="AccountCheck"
                                           ItemsSource="{Binding SituationFilters}"
                                           Label="Situation"
                                           SelectedItem="{Binding SelectedSituationFilter, Mode=TwoWay}" />
                        <erp:ErpComboField Margin="0,0,10,10"
                                           DisplayMemberPath="Label"
                                           FieldWidth="160"
                                           IconKind="Sort"
                                           ItemsSource="{Binding SortKinds}"
                                           Label="Tri"
                                           SelectedItem="{Binding SelectedSortKind, Mode=TwoWay}" />
                    </WrapPanel>

                    <WrapPanel>
                        <erp:ErpComboField Margin="0,0,10,10"
                                           DisplayMemberPath="Name"
                                           FieldWidth="170"
                                           IconKind="OfficeBuilding"
                                           ItemsSource="{Binding Sections}"
                                           Label="Section / Site"
                                           SelectedItem="{Binding SelectedSection, Mode=TwoWay}" />
                        <erp:ErpComboField Margin="0,0,10,10"
                                           DisplayMemberPath="FullDisplayName"
                                           FieldWidth="200"
                                           IconKind="GoogleClassroom"
                                           ItemsSource="{Binding ClassRooms}"
                                           Label="Classe / Promotion"
                                           SelectedItem="{Binding SelectedClassRoom, Mode=TwoWay}" />
                        <erp:ErpComboField Margin="0,0,10,10"
                                           DisplayMemberPath="Label"
                                           FieldWidth="160"
                                           IconKind="ShapeOutline"
                                           ItemsSource="{Binding StudyOptions}"
                                           Label="Option"
                                           SelectedItem="{Binding SelectedStudyOption, Mode=TwoWay}" />
                        <erp:ErpComboField Margin="0,0,10,10"
                                           DisplayMemberPath="Name"
                                           FieldWidth="170"
                                           IconKind="TagOutline"
                                           ItemsSource="{Binding PricingCategories}"
                                           Label="Catégorie tarifaire"
                                           SelectedItem="{Binding SelectedPricingCategory, Mode=TwoWay}" />
                    </WrapPanel>

                    <Border Margin="0,0,0,10"
                            Padding="10"
                            Background="#F8FAFC"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding IsInstallmentScope, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,8"
                                       FontWeight="SemiBold"
                                       Text="Tranches à inclure" />
                            <ItemsControl ItemsSource="{Binding Installments}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Margin="0,0,16,6"
                                                  Content="{Binding Name}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal">
                        <Button Margin="0,0,8,0"
                                Command="{Binding GenerateCommand}"
                                Content="Générer"
                                Style="{StaticResource MaterialDesignRaisedButton}" />
                        <Button Margin="0,0,8,0"
                                Command="{Binding ResetFiltersCommand}"
                                Content="Réinitialiser"
                                Style="{StaticResource MaterialDesignOutlinedButton}" />
                        <Button Margin="0,0,8,0"
                                Command="{Binding PrintCommand}"
                                Content="Imprimer"
                                Style="{StaticResource MaterialDesignOutlinedButton}" />
                        <Button Margin="0,0,8,0"
                                Command="{Binding ExportPdfCommand}"
                                Content="Exporter PDF"
                                Style="{StaticResource MaterialDesignOutlinedButton}" />
                        <Button Command="{Binding ExportExcelCommand}"
                                Content="Exporter Excel"
                                Style="{StaticResource MaterialDesignOutlinedButton}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <UniformGrid Grid.Row="1"
                     Margin="0,0,0,8"
                     Columns="3"
                     Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Margin="0,0,8,0"
                    Padding="12,10"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock FontSize="12" Foreground="#6B7280" Text="Élèves" />
                    <TextBlock FontSize="20" FontWeight="Bold" Foreground="#1E3A8A" Text="{Binding LastResult.TotalCount}" />
                </StackPanel>
            </Border>
            <Border Margin="0,0,8,0"
                    Padding="12,10"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock FontSize="12" Foreground="#6B7280" Text="En ordre / Non en ordre" />
                    <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#1F2937">
                        <Run Text="{Binding LastResult.InOrderCount, Mode=OneWay}" />
                        <Run Text=" / " />
                        <Run Text="{Binding LastResult.NotInOrderCount, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Padding="12,10"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock FontSize="12" Foreground="#6B7280" Text="Reste à payer" />
                    <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#1E3A8A" Text="{Binding TotalsSummary}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="10"
                Padding="8,4,8,8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Margin="4,4,4,8"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"
                               Text="Tableau croisé — ruptures Section / Classe"
                               Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <ItemsControl ItemsSource="{Binding SectionGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,16"
                                        Background="White"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        ClipToBounds="True">
                                    <StackPanel>
                                        <!-- Rupture section (pliable) -->
                                        <Border Padding="8,6"
                                                Background="#EEF2FF"
                                                BorderBrush="#E5E7EB"
                                                BorderThickness="0,0,0,1"
                                                Cursor="Hand">
                                            <Border.InputBindings>
                                                <MouseBinding Command="{Binding ToggleExpandCommand}" MouseAction="LeftClick" />
                                            </Border.InputBindings>
                                            <DockPanel LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Right"
                                                           Margin="12,0,0,0"
                                                           VerticalAlignment="Center"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="#1E3A8A"
                                                           Text="{Binding SectionRemainingDisplay}" />
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Margin="0,0,8,0"
                                                                             VerticalAlignment="Center"
                                                                             Foreground="{StaticResource ErpPrimaryBrush}"
                                                                             Kind="{Binding ExpandIconKind}" />
                                                    <materialDesign:PackIcon Margin="0,0,8,0"
                                                                             VerticalAlignment="Center"
                                                                             Foreground="{StaticResource ErpPrimaryBrush}"
                                                                             Kind="OfficeBuilding" />
                                                    <TextBlock VerticalAlignment="Center"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="#1F2937"
                                                               Text="{Binding SectionName, StringFormat=Section : {0}}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding Classes}"
                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <!-- Rupture classe (pliable) -->
                                                        <Border Padding="8,5"
                                                                Background="#F3F4F6"
                                                                BorderBrush="#E5E7EB"
                                                                BorderThickness="0,0,0,1"
                                                                Cursor="Hand">
                                                            <Border.InputBindings>
                                                                <MouseBinding Command="{Binding ToggleExpandCommand}" MouseAction="LeftClick" />
                                                            </Border.InputBindings>
                                                            <DockPanel LastChildFill="True">
                                                                <TextBlock DockPanel.Dock="Right"
                                                                           Margin="12,0,0,0"
                                                                           VerticalAlignment="Center"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#374151"
                                                                           Text="{Binding ClassRemainingDisplay}" />
                                                                <StackPanel Orientation="Horizontal">
                                                                    <materialDesign:PackIcon Margin="0,0,8,0"
                                                                                             Width="16"
                                                                                             Height="16"
                                                                                             VerticalAlignment="Center"
                                                                                             Foreground="#6B7280"
                                                                                             Kind="{Binding ExpandIconKind}" />
                                                                    <materialDesign:PackIcon Margin="0,0,8,0"
                                                                                             Width="16"
                                                                                             Height="16"
                                                                                             VerticalAlignment="Center"
                                                                                             Foreground="#6B7280"
                                                                                             Kind="GoogleClassroom" />
                                                                    <TextBlock VerticalAlignment="Center"
                                                                               FontSize="12"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="#374151"
                                                                               Text="{Binding ClassName, StringFormat=Classe : {0}}" />
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Border>

                                                        <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <!-- En-tête : Nom + payé par tranche + prévu + reste -->
                                                        <Border Background="#F9FAFB"
                                                                BorderBrush="#E5E7EB"
                                                                BorderThickness="0,0,0,1">
                                                            <DockPanel Height="40" LastChildFill="True">
                                                                <TextBlock Width="240"
                                                                           MinWidth="180"
                                                                           Margin="12,0,8,0"
                                                                           VerticalAlignment="Center"
                                                                           DockPanel.Dock="Left"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#374151"
                                                                           Text="Nom complet" />
                                                                <StackPanel Width="240"
                                                                            DockPanel.Dock="Right"
                                                                            Orientation="Horizontal">
                                                                    <TextBlock Width="120"
                                                                               Margin="0,0,4,0"
                                                                               HorizontalAlignment="Right"
                                                                               VerticalAlignment="Center"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="#374151"
                                                                               Text="Montant global prévu"
                                                                               TextAlignment="Right"
                                                                               TextWrapping="Wrap" />
                                                                    <TextBlock Width="110"
                                                                               Margin="0,0,12,0"
                                                                               HorizontalAlignment="Right"
                                                                               VerticalAlignment="Center"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="#374151"
                                                                               Text="Reste à payer"
                                                                               TextAlignment="Right"
                                                                               TextWrapping="Wrap" />
                                                                </StackPanel>
                                                                <ItemsControl ItemsSource="{Binding DataContext.InstallmentHeaders, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <UniformGrid Rows="1" />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Margin="4,0"
                                                                                       HorizontalAlignment="Right"
                                                                                       VerticalAlignment="Center"
                                                                                       FontWeight="SemiBold"
                                                                                       Foreground="#374151"
                                                                                       Text="{Binding Name}"
                                                                                       TextTrimming="CharacterEllipsis"
                                                                                       ToolTip="{Binding Name}" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </DockPanel>
                                                        </Border>

                                                        <!-- Lignes élèves : payé par tranche -->
                                                        <ItemsControl ItemsSource="{Binding Students}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1">
                                                                        <DockPanel Height="36" LastChildFill="True" Background="White">
                                                                            <TextBlock Width="240"
                                                                                       MinWidth="180"
                                                                                       Margin="12,0,8,0"
                                                                                       VerticalAlignment="Center"
                                                                                       DockPanel.Dock="Left"
                                                                                       Text="{Binding FullName}"
                                                                                       TextTrimming="CharacterEllipsis"
                                                                                       ToolTip="{Binding FullName}" />
                                                                            <StackPanel Width="240"
                                                                                        DockPanel.Dock="Right"
                                                                                        Orientation="Horizontal">
                                                                                <TextBlock Width="120"
                                                                                           Margin="0,0,4,0"
                                                                                           HorizontalAlignment="Right"
                                                                                           VerticalAlignment="Center"
                                                                                           Text="{Binding ExpectedDisplay}"
                                                                                           TextAlignment="Right" />
                                                                                <TextBlock Width="110"
                                                                                           Margin="0,0,12,0"
                                                                                           HorizontalAlignment="Right"
                                                                                           VerticalAlignment="Center"
                                                                                           FontWeight="SemiBold"
                                                                                           Text="{Binding RemainingDisplay}"
                                                                                           TextAlignment="Right" />
                                                                            </StackPanel>
                                                                            <ItemsControl ItemsSource="{Binding InstallmentCells}">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate>
                                                                                        <UniformGrid Rows="1" />
                                                                                    </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate>
                                                                                        <Border Margin="2,2"
                                                                                                MinHeight="28"
                                                                                                ToolTip="{Binding ToolTip}">
                                                                                            <Border.Style>
                                                                                                <Style TargetType="Border">
                                                                                                    <Setter Property="Background" Value="Transparent" />
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Binding="{Binding IsApplicable}" Value="False">
                                                                                                            <Setter Property="Background" Value="{StaticResource PaymentSituationHatchBrush}" />
                                                                                                        </DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </Border.Style>
                                                                                            <TextBlock Margin="4,0"
                                                                                                       HorizontalAlignment="Right"
                                                                                                       VerticalAlignment="Center"
                                                                                                       Text="{Binding Display}" />
                                                                                        </Border>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </DockPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Background="#EEF2FF"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,10"
                            Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DockPanel LastChildFill="False">
                            <TextBlock VerticalAlignment="Center"
                                       FontWeight="Bold"
                                       Foreground="#1E3A8A"
                                       Text="Total général (reste à payer)" />
                            <TextBlock Margin="16,0,0,0"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       DockPanel.Dock="Right"
                                       FontWeight="Bold"
                                       Foreground="#1E3A8A"
                                       Text="{Binding LastResult.TotalBalance, StringFormat=N0, TargetNullValue=0}" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <ProgressBar Width="120"
                         Height="4"
                         DockPanel.Dock="Right"
                         IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock VerticalAlignment="Center"
                       Foreground="#6B7280"
                       Text="{Binding StatusMessage}"
                       TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</UserControl>
