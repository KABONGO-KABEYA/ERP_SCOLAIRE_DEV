<UserControl x:Class="SchoolManagement.Desktop.Views.PersonnelFunctionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:erp="clr-namespace:SchoolManagement.Desktop.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="20" Style="{StaticResource ErpFadeIn}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="240" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource ErpPageTitle}" Text="Fonctions / Postes" />
            <TextBlock Margin="0,4,0,0"
                       Style="{StaticResource ErpBodySecondary}"
                       Text="Référentiel des fonctions et postes" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,0,0,12"
                Padding="14,12"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="12">
            <StackPanel>
                <TextBlock FontWeight="SemiBold"
                           Foreground="#0F1F4A"
                           Text="Nouvelle fonction" />
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <erp:ErpTextField Grid.Column="0"
                                      Margin="0,0,12,0"
                                      HorizontalAlignment="Stretch"
                                      IconKind="BadgeAccountOutline"
                                      Label="Nom de la fonction"
                                      Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" />
                    <erp:ErpComboField Grid.Column="1"
                                       Margin="0,0,12,0"
                                       DisplayMemberPath="Name"
                                       HorizontalAlignment="Stretch"
                                       IconKind="OfficeBuildingOutline"
                                       ItemsSource="{Binding Departments}"
                                       Label="Département"
                                       SelectedItem="{Binding SelectedDepartment, Mode=TwoWay}" />
                    <Button Grid.Column="2"
                            Padding="14,6"
                            VerticalAlignment="Bottom"
                            Command="{Binding AddCommand}"
                            Style="{StaticResource ErpPrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus"
                                                     Margin="0,0,6,0"
                                                     VerticalAlignment="Center" />
                            <TextBlock Text="Ajouter" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="14">
            <DataGrid AutoGenerateColumns="False"
                      BorderThickness="0"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      ItemsSource="{Binding Items}"
                      Style="{StaticResource ErpDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Name}"
                                        Header="FONCTION"
                                        MinWidth="200"
                                        Width="*" />
                    <DataGridCheckBoxColumn Binding="{Binding IsActive}"
                                            Header="ACTIF"
                                            Width="80" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="3"
                   Margin="0,8,0,0"
                   Style="{StaticResource ErpBodySecondary}"
                   Text="{Binding StatusMessage}" />
    </Grid>
</UserControl>
