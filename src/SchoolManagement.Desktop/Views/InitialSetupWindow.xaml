<Window x:Class="SchoolManagement.Desktop.Views.InitialSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuration initiale — ERP Scolaire"
        Height="640" Width="720"
        MinHeight="560" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{StaticResource ErpPageBackgroundBrush}"
        FontFamily="{StaticResource ErpFontFamily}">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
      <TextBlock Text="Assistant de configuration initiale" FontSize="22" FontWeight="SemiBold"
                 Foreground="{StaticResource ErpPrimaryBrush}"/>
      <TextBlock Text="{Binding StepTitle}" Margin="0,4,0,0" Foreground="#64748B"/>
      <TextBlock Text="L'application reste bloquée tant que ces étapes ne sont pas terminées."
                 Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#94A3B8" FontSize="12"/>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Précédent" Width="110" Height="36" Margin="0,0,8,0"
              Command="{Binding BackCommand}"/>
      <Button x:Name="BtnNext" Content="Suivant" Width="120" Height="36" Margin="0,0,8,0"
              Background="{StaticResource ErpPrimaryBrush}" Foreground="White"
              Click="BtnNext_OnClick"/>
      <Button x:Name="BtnFinish" Content="Terminer" Width="120" Height="36" Visibility="Collapsed"
              Background="{StaticResource ErpPrimaryBrush}" Foreground="White"
              Command="{Binding FinishCommand}"/>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <!-- Étape 1 -->
        <StackPanel x:Name="PanelStep1">
          <TextBlock Text="Nom de l'école *" Margin="0,0,0,4"/>
          <TextBox Text="{Binding SchoolName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Height="32"/>
          <TextBlock Text="Raison sociale" Margin="0,0,0,4"/>
          <TextBox Text="{Binding LegalName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Height="32"/>
          <TextBlock Text="Adresse" Margin="0,0,0,4"/>
          <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Height="32"/>
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Ville" Margin="0,0,0,4"/>
              <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Province" Margin="0,0,0,4"/>
              <TextBox Text="{Binding Province, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
            </StackPanel>
          </Grid>
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Téléphone" Margin="0,0,0,4"/>
              <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Email" Margin="0,0,0,4"/>
              <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
            </StackPanel>
          </Grid>
          <TextBlock Text="Devise" Margin="0,0,0,4"/>
          <ComboBox ItemsSource="{Binding Currencies}" SelectedItem="{Binding SelectedCurrency}"
                    Height="32" Margin="0,0,0,10" Width="120" HorizontalAlignment="Left"/>
          <TextBlock Text="Logo" Margin="0,0,0,4"/>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Parcourir…" Width="100" Margin="8,0,0,0"
                    Command="{Binding BrowseLogoCommand}"/>
            <TextBox Text="{Binding LogoFileName}" IsReadOnly="True" Height="32"/>
          </DockPanel>
        </StackPanel>

        <!-- Étape 2 -->
        <StackPanel x:Name="PanelStep2" Visibility="Collapsed">
          <TextBlock Text="Libellé année scolaire *" Margin="0,0,0,4"/>
          <TextBox Text="{Binding AcademicYearLabel, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Height="32"/>
          <TextBlock Text="Date de début" Margin="0,0,0,4"/>
          <DatePicker SelectedDate="{Binding AcademicYearStartDate, Mode=TwoWay}" Margin="0,0,0,10" Width="200" HorizontalAlignment="Left"/>
          <TextBlock Text="Date de fin" Margin="0,0,0,4"/>
          <DatePicker SelectedDate="{Binding AcademicYearEndDate, Mode=TwoWay}" Width="200" HorizontalAlignment="Left"/>
        </StackPanel>

        <!-- Étape 3 -->
        <StackPanel x:Name="PanelStep3" Visibility="Collapsed">
          <TextBlock Text="Nom d'utilisateur *" Margin="0,0,0,4"/>
          <TextBox Text="{Binding AdminUserName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Height="32"/>
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Prénom *" Margin="0,0,0,4"/>
              <TextBox Text="{Binding AdminFirstName, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Nom *" Margin="0,0,0,4"/>
              <TextBox Text="{Binding AdminLastName, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
            </StackPanel>
          </Grid>
          <TextBlock Text="Email *" Margin="0,0,0,4"/>
          <TextBox Text="{Binding AdminEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Height="32"/>
          <TextBlock Text="Mot de passe *" Margin="0,0,0,4"/>
          <PasswordBox x:Name="PwdAdmin" Margin="0,0,0,10" Height="32" PasswordChanged="PwdAdmin_OnPasswordChanged"/>
          <TextBlock Text="Confirmer le mot de passe *" Margin="0,0,0,4"/>
          <PasswordBox x:Name="PwdAdminConfirm" Height="32" PasswordChanged="PwdAdminConfirm_OnPasswordChanged"/>
        </StackPanel>

        <!-- Étape 4 -->
        <StackPanel x:Name="PanelStep4" Visibility="Collapsed">
          <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Foreground="#64748B"
                     Text="Une ligne = un élément. Vous pourrez affiner ensuite dans Paramètres → Frais scolaires."/>
          <TextBlock Text="Types de frais" Margin="0,0,0,4"/>
          <TextBox Text="{Binding FeeTypesText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                   Height="80" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>
          <TextBlock Text="Tranches" Margin="0,0,0,4"/>
          <TextBox Text="{Binding InstallmentsText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                   Height="80" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>
          <TextBlock Text="Catégories tarifaires" Margin="0,0,0,4"/>
          <TextBox Text="{Binding PricingCategoriesText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                   Height="60" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
