<UserControl x:Class="SchoolManagement.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:ui="clr-namespace:SchoolManagement.Desktop.UI"
             xmlns:views="clr-namespace:SchoolManagement.Desktop.Views"
             xmlns:controls="clr-namespace:SchoolManagement.Desktop.Controls"
             xmlns:erp="clr-namespace:SchoolManagement.Desktop.Controls">
    <UserControl.Resources>
        <ui:StringMatchVisibilityConverter x:Key="StringMatchVisibilityConverter" />
        <ui:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <ui:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Style="{StaticResource ErpV2PageHost}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="SettingsScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsScrollableSettingsContent, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Style="{StaticResource ErpCard}" Padding="20,16">
                <StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource ErpPageTitle}"
                                   Text="{Binding SelectedSectionTitle}" />
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="{StaticResource ErpTextSecondaryBrush}"
                                   Text="{Binding SelectedSectionDescription}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Margin="0,20,0,0"
                                Visibility="{Binding IsAnneesScolairesSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource ErpSubtitle}"
                                       Text="Années scolaires" />
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding LoadAcademicYearsCommand}"
                                    Content="Actualiser"
                                    Style="{StaticResource ErpSecondaryButton}" />
                        </DockPanel>
                        <DataGrid Margin="0,12,0,0"
                                  Style="{StaticResource ErpDataGrid}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  ItemsSource="{Binding AcademicYears}"
                                  MaxHeight="300"
                                  SelectedItem="{Binding SelectedAcademicYear}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Label}" Header="Libellé" Width="*" />
                                <DataGridTextColumn Binding="{Binding StartDate}" Header="Début" Width="120" />
                                <DataGridTextColumn Binding="{Binding EndDate}" Header="Fin" Width="120" />
                                <DataGridCheckBoxColumn Binding="{Binding IsCurrent}" Header="Courante" Width="80" />
                                <DataGridCheckBoxColumn Binding="{Binding IsClosed}" Header="Clôturée" Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <Button Command="{Binding SetCurrentAcademicYearCommand}"
                                    Content="Définir comme année courante"
                                    Style="{StaticResource ErpPrimaryButton}" />
                        </StackPanel>

                        <Border Margin="0,16,0,0"
                                Padding="12"
                                Background="#F9FAFB"
                                BorderBrush="{StaticResource ErpBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource ErpBody}"
                                           Text="Nouvelle année scolaire" />
                                <WrapPanel Margin="0,8,0,0">
                                    <TextBox Width="180"
                                             Margin="4"
                                             materialDesign:HintAssist.Hint="Libellé"
                                             Style="{StaticResource ErpTextBox}"
                                             Text="{Binding NewAcademicYearLabel}" />
                                    <DatePicker Width="150"
                                                Margin="4"
                                                SelectedDate="{Binding NewAcademicYearStartDate}"
                                                Style="{StaticResource ErpDatePicker}"
                                                materialDesign:HintAssist.Hint="Date de début" />
                                    <DatePicker Width="150"
                                                Margin="4"
                                                SelectedDate="{Binding NewAcademicYearEndDate}"
                                                Style="{StaticResource ErpDatePicker}"
                                                materialDesign:HintAssist.Hint="Date de fin" />
                                    <CheckBox Margin="8,8,8,0"
                                              VerticalAlignment="Center"
                                              Content="Définir comme année courante"
                                              IsChecked="{Binding NewAcademicYearSetAsCurrent}" />
                                    <Button Margin="4"
                                            Command="{Binding CreateAcademicYearCommand}"
                                            Content="Créer l'année"
                                            Style="{StaticResource ErpPrimaryButton}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Margin="0,20,0,0"
                                Visibility="{Binding IsReglementSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource ErpSubtitle}"
                                       Text="Règlement d'ordre intérieur" />
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding LoadRegulationCommand}"
                                    Content="Actualiser"
                                    Style="{StaticResource ErpSecondaryButton}" />
                        </DockPanel>

                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{StaticResource ErpTextSecondaryBrush}"
                                   Text="{Binding RegulationUpdatedAt, StringFormat=Dernière mise à jour : {0:dd/MM/yyyy HH:mm}}" />

                        <TextBox Margin="0,12,0,0"
                                 MinHeight="260"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 TextWrapping="Wrap"
                                 materialDesign:HintAssist.Hint="Saisissez ici le règlement d'ordre intérieur de l'établissement"
                                 Style="{StaticResource ErpTextBox}"
                                 Text="{Binding RegulationContent, UpdateSourceTrigger=PropertyChanged}" />

                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                            <Button Command="{Binding SaveRegulationCommand}"
                                    Content="Enregistrer le règlement"
                                    Style="{StaticResource ErpPrimaryButton}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Margin="0,20,0,0"
                                Visibility="{Binding IsMatieresSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource ErpSubtitle}"
                                       Text="Matières par classe active" />
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding LoadSubjectClassesCommand}"
                                    Content="Actualiser"
                                    Style="{StaticResource ErpSecondaryButton}" />
                        </DockPanel>

                        <StackPanel Margin="0,12,0,8" Orientation="Horizontal">
                            <ComboBox Width="220"
                                      Margin="4"
                                      DisplayMemberPath="Label"
                                      ItemsSource="{Binding AcademicYears}"
                                      SelectedItem="{Binding SelectedAcademicYear}"
                                      materialDesign:HintAssist.Hint="Année scolaire" />
                            <ComboBox Width="320"
                                      Margin="4"
                                      DisplayMemberPath="FullDisplayName"
                                      ItemsSource="{Binding SubjectClasses}"
                                      SelectedItem="{Binding SelectedSubjectClass}"
                                      materialDesign:HintAssist.Hint="Classe active" />
                        </StackPanel>

                        <DataGrid Style="{StaticResource ErpDataGrid}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  ItemsSource="{Binding SubjectCourses}"
                                  MaxHeight="280">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Code}" Header="Code" Width="120" />
                                <DataGridTextColumn Binding="{Binding Name}" Header="Matière" Width="*" />
                                <DataGridTextColumn Binding="{Binding Coefficient}" Header="Coef." Width="70" />
                                <DataGridTextColumn Binding="{Binding MaxScore}" Header="/20" Width="60" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Margin="0,12,0,0"
                                Padding="12"
                                Background="#F9FAFB"
                                BorderBrush="{StaticResource ErpBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource ErpBody}"
                                           Text="Nouvelle matière" />
                                <WrapPanel Margin="0,8,0,0">
                                    <TextBox Width="140"
                                             Margin="4"
                                             materialDesign:HintAssist.Hint="Code matière"
                                             Style="{StaticResource ErpTextBox}"
                                             Text="{Binding NewSubjectCode}" />
                                    <TextBox Width="240"
                                             Margin="4"
                                             materialDesign:HintAssist.Hint="Nom matière"
                                             Style="{StaticResource ErpTextBox}"
                                             Text="{Binding NewSubjectName}" />
                                    <Button Margin="4"
                                            Command="{Binding CreateSubjectCourseCommand}"
                                            Content="Créer matière"
                                            Style="{StaticResource ErpPrimaryButton}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Margin="0,20,0,0"
                                Visibility="{Binding IsGeographieSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource ErpSubtitle}"
                                   Text="Pays, provinces, villes et communes" />
                        <TextBlock Margin="0,6,0,12"
                                   Foreground="{StaticResource ErpTextSecondaryBrush}"
                                   Text="Enregistrez manuellement ou importez un fichier Excel conforme au modèle téléchargeable."
                                   TextWrapping="Wrap" />
                        <controls:GeographyAdminControl DataContext="{Binding GeographyAdmin}" />
                    </StackPanel>

                    <StackPanel Margin="0,20,0,0"
                                Visibility="{Binding IsUtilisateursSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource ErpSubtitle}"
                                       Text="Utilisateurs de l'établissement" />
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding LoadUsersCommand}"
                                    Content="Actualiser"
                                    Style="{StaticResource ErpSecondaryButton}" />
                        </DockPanel>

                        <DataGrid Margin="0,12,0,8"
                                  Style="{StaticResource ErpDataGrid}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  ItemsSource="{Binding AdminUsers}"
                                  SelectedItem="{Binding SelectedAdminUser}"
                                  MaxHeight="260">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding UserName}" Header="Identifiant" Width="120" />
                                <DataGridTextColumn Binding="{Binding FullName}" Header="Nom complet" Width="*" />
                                <DataGridTextColumn Binding="{Binding Email}" Header="Email" Width="*" />
                                <DataGridCheckBoxColumn Binding="{Binding IsActive}" Header="Actif" Width="60" />
                                <DataGridTextColumn Binding="{Binding RolesDisplay}" Header="Rôles" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Padding="12"
                                Background="#F9FAFB"
                                BorderBrush="{StaticResource ErpBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource ErpBody}"
                                           Text="Nouvel utilisateur" />
                                <WrapPanel Margin="0,8,0,0">
                                    <TextBox Width="120" Margin="4" materialDesign:HintAssist.Hint="Identifiant" Text="{Binding NewAdminUserName}" Style="{StaticResource ErpTextBox}" />
                                    <TextBox Width="180" Margin="4" materialDesign:HintAssist.Hint="Email" Text="{Binding NewAdminEmail}" Style="{StaticResource ErpTextBox}" />
                                    <TextBox Width="140" Margin="4" materialDesign:HintAssist.Hint="Mot de passe" Text="{Binding NewAdminPassword}" Style="{StaticResource ErpTextBox}" />
                                    <TextBox Width="140" Margin="4" materialDesign:HintAssist.Hint="Nom" Text="{Binding NewAdminLastName}" Style="{StaticResource ErpTextBox}" />
                                    <TextBox Width="140" Margin="4" materialDesign:HintAssist.Hint="Prénom" Text="{Binding NewAdminFirstName}" Style="{StaticResource ErpTextBox}" />
                                    <ComboBox Width="180" Margin="4" DisplayMemberPath="Name" ItemsSource="{Binding AdminRoles}" SelectedItem="{Binding SelectedAdminRole}" materialDesign:HintAssist.Hint="Rôle" />
                                </WrapPanel>
                                <TextBlock Margin="4,8,4,0"
                                           Style="{StaticResource ErpBodySecondary}"
                                           Text="Adresse (facultative)" />
                                <erp:ErpAddressControl Margin="4,4,4,0"
                                                     Editor="{Binding NewAdminUserAddressEditor}" />
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Margin="4" Command="{Binding CreateAdminUserCommand}" Content="Créer" Style="{StaticResource ErpPrimaryButton}" />
                                    <Button Margin="4" Command="{Binding AssignAdminRoleCommand}" Content="Assigner rôle" Style="{StaticResource ErpSecondaryButton}" />
                                    <Button Margin="4" Command="{Binding ToggleAdminUserActiveCommand}" Content="Activer/Désactiver" Style="{StaticResource ErpSecondaryButton}" />
                                </WrapPanel>
                                <TextBlock Margin="4,16,4,0"
                                           Style="{StaticResource ErpBody}"
                                           Text="Utilisateur sélectionné — adresse" />
                                <erp:ErpAddressControl Margin="4,4,4,0"
                                                     Editor="{Binding SelectedAdminUserAddressEditor}" />
                                <Button Margin="4,8,4,0"
                                        HorizontalAlignment="Left"
                                        Command="{Binding SaveSelectedAdminUserCommand}"
                                        Content="Enregistrer l'adresse"
                                        Style="{StaticResource ErpPrimaryButton}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Margin="0,20,0,0"
                                Visibility="{Binding IsEnseignantsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource ErpSubtitle}"
                                       Text="Personnel enseignant" />
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding LoadTeachersCommand}"
                                    Content="Actualiser"
                                    Style="{StaticResource ErpSecondaryButton}" />
                        </DockPanel>

                        <DataGrid Margin="0,12,0,8"
                                  Style="{StaticResource ErpDataGrid}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  ItemsSource="{Binding AdminTeachers}"
                                  SelectedItem="{Binding SelectedAdminTeacher}"
                                  MaxHeight="260">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding EmployeeNumber}" Header="Matricule" Width="100" />
                                <DataGridTextColumn Binding="{Binding FullName}" Header="Nom complet" Width="*" />
                                <DataGridTextColumn Binding="{Binding Email}" Header="Email" Width="*" />
                                <DataGridTextColumn Binding="{Binding Phone}" Header="Téléphone" Width="120" />
                                <DataGridCheckBoxColumn Binding="{Binding IsActive}" Header="Actif" Width="60" />
                                <DataGridTextColumn Binding="{Binding AddressLine}" Header="Adresse" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Padding="12"
                                Background="#F9FAFB"
                                BorderBrush="{StaticResource ErpBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource ErpBody}"
                                           Text="Nouvel enseignant" />
                                <WrapPanel Margin="0,8,0,0">
                                    <TextBox Width="120" Margin="4" materialDesign:HintAssist.Hint="Matricule" Text="{Binding NewTeacherEmployeeNumber}" Style="{StaticResource ErpTextBox}" />
                                    <TextBox Width="140" Margin="4" materialDesign:HintAssist.Hint="Nom" Text="{Binding NewTeacherLastName}" Style="{StaticResource ErpTextBox}" />
                                    <TextBox Width="140" Margin="4" materialDesign:HintAssist.Hint="Prénom" Text="{Binding NewTeacherFirstName}" Style="{StaticResource ErpTextBox}" />
                                    <TextBox Width="140" Margin="4" materialDesign:HintAssist.Hint="Téléphone" Text="{Binding NewTeacherPhone}" Style="{StaticResource ErpTextBox}" />
                                    <TextBox Width="180" Margin="4" materialDesign:HintAssist.Hint="Email" Text="{Binding NewTeacherEmail}" Style="{StaticResource ErpTextBox}" />
                                    <TextBox Width="160" Margin="4" materialDesign:HintAssist.Hint="Spécialisation" Text="{Binding NewTeacherSpecialization}" Style="{StaticResource ErpTextBox}" />
                                    <DatePicker Width="160" Margin="4" materialDesign:HintAssist.Hint="Date d'embauche" SelectedDate="{Binding NewTeacherHireDate}" Style="{StaticResource ErpDatePicker}" />
                                </WrapPanel>
                                <TextBlock Margin="4,8,4,0"
                                           Style="{StaticResource ErpBodySecondary}"
                                           Text="Adresse (facultative)" />
                                <erp:ErpAddressControl Margin="4,4,4,0"
                                                     Editor="{Binding NewTeacherAddressEditor}" />
                                <Button Margin="4,8,4,0"
                                        HorizontalAlignment="Left"
                                        Command="{Binding CreateAdminTeacherCommand}"
                                        Content="Créer l'enseignant"
                                        Style="{StaticResource ErpPrimaryButton}" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0"
                                Padding="12"
                                Background="#F9FAFB"
                                BorderBrush="{StaticResource ErpBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource ErpBody}"
                                           Text="Enseignant sélectionné" />
                                <WrapPanel Margin="0,8,0,0">
                                    <TextBox Width="120" Margin="4" materialDesign:HintAssist.Hint="Matricule" Text="{Binding EditTeacherEmployeeNumber}" Style="{StaticResource ErpTextBox}" />
                                    <TextBox Width="140" Margin="4" materialDesign:HintAssist.Hint="Nom" Text="{Binding EditTeacherLastName}" Style="{StaticResource ErpTextBox}" />
                                    <TextBox Width="140" Margin="4" materialDesign:HintAssist.Hint="Prénom" Text="{Binding EditTeacherFirstName}" Style="{StaticResource ErpTextBox}" />
                                    <TextBox Width="140" Margin="4" materialDesign:HintAssist.Hint="Téléphone" Text="{Binding EditTeacherPhone}" Style="{StaticResource ErpTextBox}" />
                                    <TextBox Width="180" Margin="4" materialDesign:HintAssist.Hint="Email" Text="{Binding EditTeacherEmail}" Style="{StaticResource ErpTextBox}" />
                                    <TextBox Width="160" Margin="4" materialDesign:HintAssist.Hint="Spécialisation" Text="{Binding EditTeacherSpecialization}" Style="{StaticResource ErpTextBox}" />
                                    <DatePicker Width="160" Margin="4" materialDesign:HintAssist.Hint="Date d'embauche" SelectedDate="{Binding EditTeacherHireDate}" Style="{StaticResource ErpDatePicker}" />
                                    <CheckBox Margin="4,12,4,4" Content="Actif" IsChecked="{Binding EditTeacherIsActive}" />
                                </WrapPanel>
                                <TextBlock Margin="4,8,4,0"
                                           Style="{StaticResource ErpBodySecondary}"
                                           Text="Adresse" />
                                <erp:ErpAddressControl Margin="4,4,4,0"
                                                     Editor="{Binding SelectedTeacherAddressEditor}" />
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Margin="4" Command="{Binding SaveSelectedAdminTeacherCommand}" Content="Enregistrer" Style="{StaticResource ErpPrimaryButton}" />
                                    <Button Margin="4" Command="{Binding ToggleAdminTeacherActiveCommand}" Content="Activer/Désactiver" Style="{StaticResource ErpSecondaryButton}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Margin="0,20,0,0" Padding="32" Background="#F9FAFB" BorderBrush="{StaticResource ErpBorderBrush}" BorderThickness="1" CornerRadius="12"
                            Visibility="{Binding ActivePlaceholderKey, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource StringMatchVisibilityConverter}, ConverterParameter=calendrier}">
                        <StackPanel HorizontalAlignment="Center" MaxWidth="520">
                            <materialDesign:PackIcon Kind="CalendarMonth" Width="48" Height="48" Foreground="{StaticResource ErpPrimaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Margin="0,16,0,8" Style="{StaticResource ErpSubtitle}" Text="Calendrier scolaire" HorizontalAlignment="Center" />
                            <TextBlock Style="{StaticResource ErpBodySecondary}" Text="Planification des périodes, vacances et événements scolaires." TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,20,0,0" Padding="32" Background="#F9FAFB" BorderBrush="{StaticResource ErpBorderBrush}" BorderThickness="1" CornerRadius="12"
                            Visibility="{Binding ActivePlaceholderKey, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource StringMatchVisibilityConverter}, ConverterParameter=types-evaluations}">
                        <StackPanel HorizontalAlignment="Center" MaxWidth="520">
                            <materialDesign:PackIcon Kind="ClipboardListOutline" Width="48" Height="48" Foreground="{StaticResource ErpPrimaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Margin="0,16,0,8" Style="{StaticResource ErpSubtitle}" Text="Types d'évaluations" HorizontalAlignment="Center" />
                            <TextBlock Style="{StaticResource ErpBodySecondary}" Text="Définition des types d'évaluations utilisés dans le système de notes." TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,20,0,0" Padding="32" Background="#F9FAFB" BorderBrush="{StaticResource ErpBorderBrush}" BorderThickness="1" CornerRadius="12"
                            Visibility="{Binding ActivePlaceholderKey, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource StringMatchVisibilityConverter}, ConverterParameter=coefficients}">
                        <StackPanel HorizontalAlignment="Center" MaxWidth="520">
                            <materialDesign:PackIcon Kind="Numeric" Width="48" Height="48" Foreground="{StaticResource ErpPrimaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Margin="0,16,0,8" Style="{StaticResource ErpSubtitle}" Text="Coefficients" HorizontalAlignment="Center" />
                            <TextBlock Style="{StaticResource ErpBodySecondary}" Text="Gestion des coefficients par matière et par niveau." TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,20,0,0" Padding="32" Background="#F9FAFB" BorderBrush="{StaticResource ErpBorderBrush}" BorderThickness="1" CornerRadius="12"
                            Visibility="{Binding ActivePlaceholderKey, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource StringMatchVisibilityConverter}, ConverterParameter=sauvegarde}">
                        <StackPanel HorizontalAlignment="Center" MaxWidth="520">
                            <materialDesign:PackIcon Kind="DatabaseOutline" Width="48" Height="48" Foreground="{StaticResource ErpPrimaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Margin="0,16,0,8" Style="{StaticResource ErpSubtitle}" Text="Sauvegarde &amp; restauration" HorizontalAlignment="Center" />
                            <TextBlock Style="{StaticResource ErpBodySecondary}" Text="Sauvegarde et restauration des données de l'établissement." TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,20,0,0" Padding="32" Background="#F9FAFB" BorderBrush="{StaticResource ErpBorderBrush}" BorderThickness="1" CornerRadius="12"
                            Visibility="{Binding ActivePlaceholderKey, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource StringMatchVisibilityConverter}, ConverterParameter=journal}">
                        <StackPanel HorizontalAlignment="Center" MaxWidth="520">
                            <materialDesign:PackIcon Kind="History" Width="48" Height="48" Foreground="{StaticResource ErpPrimaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Margin="0,16,0,8" Style="{StaticResource ErpSubtitle}" Text="Journal d'activités" HorizontalAlignment="Center" />
                            <TextBlock Style="{StaticResource ErpBodySecondary}" Text="Historique des actions effectuées dans le système." TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,20,0,0" Padding="32" Background="#F9FAFB" BorderBrush="{StaticResource ErpBorderBrush}" BorderThickness="1" CornerRadius="12"
                            Visibility="{Binding ActivePlaceholderKey, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource StringMatchVisibilityConverter}, ConverterParameter=parametres-systeme}">
                        <StackPanel HorizontalAlignment="Center" MaxWidth="520">
                            <materialDesign:PackIcon Kind="CogOutline" Width="48" Height="48" Foreground="{StaticResource ErpPrimaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Margin="0,16,0,8" Style="{StaticResource ErpSubtitle}" Text="Paramètres système" HorizontalAlignment="Center" />
                            <TextBlock Style="{StaticResource ErpBodySecondary}" Text="Configuration technique et paramètres globaux du système." TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,20,0,0" Padding="32" Background="#F9FAFB" BorderBrush="{StaticResource ErpBorderBrush}" BorderThickness="1" CornerRadius="12"
                            Visibility="{Binding ActivePlaceholderKey, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource StringMatchVisibilityConverter}, ConverterParameter=personnalisation}">
                        <StackPanel HorizontalAlignment="Center" MaxWidth="520">
                            <materialDesign:PackIcon Kind="PaletteOutline" Width="48" Height="48" Foreground="{StaticResource ErpPrimaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Margin="0,16,0,8" Style="{StaticResource ErpSubtitle}" Text="Personnalisation" HorizontalAlignment="Center" />
                            <TextBlock Style="{StaticResource ErpBodySecondary}" Text="Personnalisation de l'identité visuelle et des préférences." TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,20,0,0" Padding="32" Background="#F9FAFB" BorderBrush="{StaticResource ErpBorderBrush}" BorderThickness="1" CornerRadius="12"
                            Visibility="{Binding ActivePlaceholderKey, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource StringMatchVisibilityConverter}, ConverterParameter=design}">
                        <StackPanel HorizontalAlignment="Center" MaxWidth="520">
                            <materialDesign:PackIcon Kind="BrushOutline" Width="48" Height="48" Foreground="{StaticResource ErpPrimaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Margin="0,16,0,8" Style="{StaticResource ErpSubtitle}" Text="Design" HorizontalAlignment="Center" />
                            <TextBlock Style="{StaticResource ErpBodySecondary}" Text="Thème, couleurs et apparence de l'interface ERP." TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="0,16,0,0"
                               Foreground="{StaticResource ErpTextSecondaryBrush}"
                               Text="{Binding StatusMessage}" />
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Grid Grid.Row="0"
              Margin="20,16"
              Visibility="{Binding IsEtablissementSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
            <controls:EstablishmentSettingsControl HorizontalAlignment="Stretch"
                                                     VerticalAlignment="Stretch"
                                                     DataContext="{Binding}" />
        </Grid>

        <Grid Grid.Row="0"
              Margin="20,16"
              Visibility="{Binding IsFraisScolairesSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
            <controls:SchoolFeeConfigurationControl HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch"
                                                      DataContext="{Binding SchoolFeeConfiguration}" />
        </Grid>

        <Grid Grid.Row="0"
              Margin="20,16"
              Visibility="{Binding IsRepartitionRecettesSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
            <controls:RevenueAllocationConfigControl HorizontalAlignment="Stretch"
                                                       VerticalAlignment="Stretch"
                                                       DataContext="{Binding RevenueAllocationConfig}" />
        </Grid>

        <Grid Grid.Row="0"
              Margin="20,16"
              Visibility="{Binding IsRetenuesSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
            <controls:WithholdingConfigControl HorizontalAlignment="Stretch"
                                               VerticalAlignment="Stretch"
                                               DataContext="{Binding WithholdingConfig}" />
        </Grid>

        <views:PedagogicalStructureWizardControl Grid.Row="0"
                                                 DataContext="{Binding}"
                                                 Margin="20,16"
